sEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":7,\"preferredProductType\":null,\"productCategories\":[\"groceries\",\"gifts\"],\"brandDescription\":\"* Bring convenience to their fingertips. Send a Pandamart gift card and let them shop essentials online anytime 📦\\n* Perfect for busy schedules, late-night needs, and effortless everyday shopping\\n* Fast to send and easy to use—just share the code and let them enjoy smooth, on-demand delivery\",\"brandShortDescription\":\"Groceries & essentials at their fingertips 🛒\",\"promoText\":null,\"expiry\":\"Valid for 6 months from the date of purchase.\",\"fees\":\"\",\"additionalTerms\":\"- This e-gift card is non-refundable, non-transferable, and cannot be exchanged for cash.\\n- Valid for one-time use only.\\n- Unused balance will be lost.\\n- Any extra cost beyond voucher value must be paid by the customer shopping in Bangladesh.\\n- Valid for regular-priced items only.\",\"howToRedeem\":\"1. You’ll get an e-gift card code.\\n2. Share it with your loved ones in Bangladesh.\\n3. They can redeem it by following these steps:\\n\\n    - Visit [Foodpanda](https://www.foodpanda.com.bd/groceries)\\n    - Add items to the cart\\n    - At checkout, enter the e-voucher code in the Promo code / Gift voucher field\\n\\nThat’s it! Quick and simple 🎉\",\"contact\":\"**Support Hotline**📞 +88 01765 900 999\",\"locations\":\"Only redeemable online at Pandamart via Foodpanda: [https://www.foodpanda.com.bd/groceries](https://www.foodpanda.com.bd/groceries)\",\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-PG\",\"time\":1780430588,\"operatorCode\":\"PG\",\"operatorId\":\"BD-PG\",\"countryIso\":\"BD\",\"name\":\"PUBG Mobile\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":500,\"preferredProductType\":null,\"productCategories\":[\"gaming\"],\"brandDescription\":\"* Make their day with a battle ready boost. Send a PUBG Mobile gift card instantly and let them unlock UC, upgrade gear, and stand out on the battlefield \\n* PUBG Mobile credit unlocks UC, skins, battle passes, and in-game upgrades for the global battle royale. 🎮\\n* Fast, simple, and game changing. Just send, redeem, and jump straight into the action with more power and style\",\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":\"\",\"additionalTerms\":\"\",\"howToRedeem\":\"It's super easy and instant:\\n\\n1. You’ll get a PUBG Mobile gift card code.\\n2. Share it with your loved one.\\n3. They’ll redeem it at [midasbuy.com](https://midasbuy.com) by logging into their PUBG account via Facebook (or creating a Midasbuy account) and use it for PUBG Mobile UC.\\n\\nYes, it's that easy! 😄\",\"contact\":\"\",\"locations\":\"\",\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-I3\",\"time\":1780430588,\"operatorCode\":\"I3\",\"operatorId\":\"BD-I3\",\"countryIso\":\"BD\",\"name\":\"Razer Gold\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":500,\"preferredProductType\":null,\"productCategories\":[\"gifts\"],\"brandDescription\":\"* Power up their play across games and more. Send a Razer Gold gift card instantly and let them buy games, in-game content, and subscriptions with ease \\n* Razer Gold is a digital credit for games, in-game items, and subscriptions across thousands of titles. 🎮\\n* Fast, flexible, and game ready. Just send, redeem, and let them level up their experience instantly\",\"brandShortDescription\":\"A card that gives gamers credit to buy games & more!\",\"promoText\":null,\"expiry\":\"Valid for 12 months from date of purchase.\",\"fees\":\"\",\"additionalTerms\":\"Exchanges, returns and refunds are NOT applicable for Razer Gold PINs.\",\"howToRedeem\":\"1. You'll get a voucher PIN code.\\n2. Share that with your loved one.\\n3. They'll login to their Razer Gold account click on *Reload Now* and select *Razer Gold Pin* from payment methods, and enter the PIN to redeem it.\",\"contact\":\"\",\"locations\":\"Razer Gold vouchers  can be redeemed on [gold.razer.com](https://gold.razer.com/).\",\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-4R\",\"time\":1780430588,\"operatorCode\":\"4R\",\"operatorId\":\"BD-4R\",\"countryIso\":\"BD\",\"name\":\"Roblox\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":500,\"preferredProductType\":null,\"productCategories\":[\"gaming\"],\"brandDescription\":\"* Make their day with endless ways to play. Send a Roblox gift card instantly and let them unlock Robux, customise their avatar, and jump into new worlds in seconds 🎮\\n* From upgrading looks to accessing exclusive experiences, it’s the perfect gift for players who love to create, explore, and stand out\\n* No guesswork needed. Just send, redeem, and let them choose how they play, spend, and express themselves\",\"brandShortDescription\":\"Gift endless adventures with Roblox\",\"promoText\":null,\"expiry\":null,\"fees\":\"\",\"additionalTerms\":\"This gift card can only be used once. It is non-refundable and cannot be exchanged for cash or returned.\",\"howToRedeem\":\"It's super easy and instant:\\n\\n1. You'll get a gift card PIN code.\\n2. Share it with your loved one.\\n3. They'll redeem it at [roblox.com/redeem](https://roblox.com/redeem).\\n\\nYes, it's that easy! 😄\",\"contact\":\"For more information you can visit: [en.help.roblox.com](https://en.help.roblox.com/hc/en-us/articles/115005566223-How-to-Redeem-and-Spend-Your-Gift-Card)\",\"locations\":\"Redeemable only through the recipient's Roblox account online via [roblox.com/redeem](https://roblox.com/redeem).\",\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-61F67C\",\"time\":1780430588,\"operatorCode\":\"61F67C\",\"operatorId\":\"BD-61F67C\",\"countryIso\":\"BD\",\"name\":\"ShareTrip\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":200,\"preferredProductType\":\"Voucher\",\"productCategories\":[\"travel\"],\"brandDescription\":null,\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":null,\"additionalTerms\":null,\"howToRedeem\":null,\"contact\":null,\"locations\":null,\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-204429\",\"time\":1780430588,\"operatorCode\":\"204429\",\"operatorId\":\"BD-204429\",\"countryIso\":\"BD\",\"name\":\"Star Tech Ltd\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"dome