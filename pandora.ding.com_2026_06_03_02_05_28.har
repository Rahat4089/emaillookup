0000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":200,\"preferredProductType\":\"Voucher\",\"productCategories\":[\"entertainment\"],\"brandDescription\":null,\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":null,\"additionalTerms\":null,\"howToRedeem\":null,\"contact\":null,\"locations\":null,\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-54EB63\",\"time\":1780430588,\"operatorCode\":\"54EB63\",\"operatorId\":\"BD-54EB63\",\"countryIso\":\"BD\",\"name\":\"Ace Racer\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":200,\"preferredProductType\":\"Voucher\",\"productCategories\":[\"gaming\"],\"brandDescription\":null,\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":null,\"additionalTerms\":null,\"howToRedeem\":null,\"contact\":null,\"locations\":null,\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-QT\",\"time\":1780430588,\"operatorCode\":\"QT\",\"operatorId\":\"BD-QT\",\"countryIso\":\"BD\",\"name\":\"Apex Legends\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":200,\"preferredProductType\":\"Voucher\",\"productCategories\":[\"gaming\"],\"brandDescription\":null,\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":null,\"additionalTerms\":null,\"howToRedeem\":null,\"contact\":null,\"locations\":null,\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-IA\",\"time\":1780430588,\"operatorCode\":\"IA\",\"operatorId\":\"BD-IA\",\"countryIso\":\"BD\",\"name\":\"Apple Gift Card\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":500,\"preferredProductType\":null,\"productCategories\":[\"gifts\"],\"brandDescription\":\"* Unlock their favourite apps, music, and more in one go. Send an Apple Gift Card instantly and let them enjoy movies, subscriptions, iCloud storage, and everything across Apple services \\n* Apple gift cards can be used for apps, games, music, movies, and iCloud storage, all in one place. 🍏\\n* Sent in seconds, ready to use instantly. Just share the code, redeem, and let them enjoy what they love\",\"brandShortDescription\":\"Music, apps, iCloud+ and more - gift endless fun with Apple\",\"promoText\":null,\"expiry\":\"Apple e-gift cards do not expire once added to an Apple account.\",\"fees\":\"\",\"additionalTerms\":\"1. This e-gift card is non-refundable and cannot be exchanged for cash.\\n2. Valid for one-time redemption.\\n3. Any remaining balance stays in the recipient’s U.S. Apple ID for future purchases.\\n4. Content availability varies by region.\",\"howToRedeem\":\"1. You will receive a PIN code for the Apple (USA) e-gift card.\\n2. Share it with your loved ones – no matter where in the world they are.\\n3. You can redeem the card by using a US Apple ID and entering the PIN to add the USD balance\\n\\nThat’s it - quick and simple! 🎉\\n\\n* * *\\n\\n**Tips for them💡**\\n\\n- They can **create a separate U.S. Apple ID** just for redeeming and using U.S. gift cards - this is the easiest and most common method.\\n- Or, they can **change their current Apple ID to the U.S. region** (after spending any existing balance and cancelling active subscriptions). This might require having a U.S. address.\",\"contact\":\"\",\"locations\":\"Redeemable **only** on the **U.S. App Store**, **U.S. Apple Store**, and **U.S. Apple services** (Apple Music, iCloud+, Apple TV+, etc.). This e-gift card is issued in **USD**.\\n\\n❗**Important Regional Restriction:**\\n\\n- Apple gift cards **cannot be redeemed outside the country or region of purchase**\\n- A **U.S. Apple ID **is required to redeem and use this gift card.\\n\\nTo learn more about Apple’s regional rules, visit Apple’s support page: [https://support.apple.com/en-us/118242](https://support.apple.com/en-us/118242)\",\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-8E962A\",\"time\":1780430588,\"operatorCode\":\"8E962A\",\"operatorId\":\"BD-8E962A\",\"countryIso\":\"BD\",\"name\":\"ArcheAge\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":200,\"preferredProductType\":\"Voucher\",\"productCategories\":[\"gaming\"],\"brandDescription\":null,\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":null,\"additionalTerms\":null,\"howToRedeem\":null,\"contact\":null,\"locations\":null,\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-X8\",\"time\":1780430588,\"operatorCode\":\"X8\",\"operatorId\":\"BD-X8\",\"countryIso\":\"BD\",\"name\":\"Arena Breakout\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":200,\"preferredProductType\":\"Voucher\",\"productCategories\":[\"gaming\"],\"brandDescription\":null,\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":null,\"additionalTerms\":null,\"howToRedeem\":null,\"contact\":null,\"locations\":null,\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-4DEAE1\",\"time\":1780430588,\"operatorCode\":\"4DEAE1\",\"operatorId\":\"BD-4DEAE1\",\"countryIso\":\"BD\",\"name\":\"Assassin's Creed Shadows\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":200,\"preferredProductType\":\"Voucher\",\"productCategories\":[\"gaming\"],\"brandDescription\":null,\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":null,\"additionalTerms\":null,\"howToRedeem\":null,\"contact\":null,\"locations\":null,\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-AFEE29\",\"time\":1780430588,\"operatorCode\":\"AFEE29\",\"operatorId\":\"BD-AFEE29\",\"countryIso\":\"BD\",\"name\":\"Badlanders\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":200,\"preferredProductType\":\"Voucher\",\"productCategories\":[\"gaming\"],\"brandDescription\":null,\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":null,\"additionalTerms\":null,\"howToRedeem\":null,\"contact\":null,\"locations\":null,\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-CA015A\",\"time\":1780430588,\"operatorCode\":\"CA015A\",\"operatorId\":\"BD-CA015A\",\"countryIso\":\"BD\",\"name\":\"Bata\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":11,\"preferredProductType\":null,\"productCategories\":[\"shopping\"],\"brandDescription\":\"👟 A Bata e-gift card is the perfect way to surprise your loved ones in Bangladesh with stylish and comfortable footwear. 🎁 Share the e-gift card, and they can redeem it at Bata outlets, online, or at select partner stores.\",\"brandShortDescription\":\"Gift them comfort & style 👞\",\"promoText\":null,\"expiry\":\"Valid for 2 months from the date of purchase.\",\"fees\":\"**Support Hotline **📞 +88 01765 900 999\",\"additionalTerms\":\"- This e-gift card is non-refundable, non-transferable, and cannot be exchanged for cash.\\n- Valid for one-time use only.\\n- Unused balance will be lost.\\n- Any extra cost beyond the e-gift card value must be paid by the customer.\",\"howToRedeem\":\"1. You’ll receive an e-gift card code and PIN number.\\n2. Share it with your loved one in Bangladesh.\\n3. They can redeem it by following these steps:\\n\\n    - Visit Bata's website/  a participating outlet.\\n    - Add items to the cart\\n    - At checkout online, enter the e-voucher code and PIN number or show these details to the cashier in store.\\n\\nThat’s it! Quick and simple 🎉\",\"contact\":\"**Support Hotline **📞 +88 01765 900 999\",\"locations\":\"Redeemable online and at these select outlets across Bangladesh:\\n\\n- Country Boy\\n- Focallure Bangladesh\\n- Go Zayaan Flight\\n- Go Zayaan Hotels\",\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-D47EBF\",\"time\":1780430588,\"operatorCode\":\"D47EBF\",\"operatorId\":\"BD-D47EBF\",\"countryIso\":\"BD\",\"name\":\"Berger Paints\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":217,\"preferredProductType\":\"Voucher\",\"productCategories\":[\"shopping\"],\"brandDescription\":null,\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":null,\"additionalTerms\":null,\"howToRedeem\":null,\"contact\":null,\"locations\":null,\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-BF93EB\",\"time\":1780430588,\"operatorCode\":\"BF93EB\",\"operatorId\":\"BD-BF93EB\",\"countryIso\":\"BD\",\"name\":\"Best Electronics\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":fals