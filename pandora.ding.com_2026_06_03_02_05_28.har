92344f-731c-4b92-8d34-09c6bb773eaf\",\"promotionDescription\":{\"languageCode\":\"en\",\"title\":\" MTN Ivory Coast 100% Bonus Offer (Ding Exclusive)!\",\"textMarkdown\":\" MTN Ivory Coast 100% Bonus Offer (Ding Exclusive)!\",\"validityMarkdown\":\"7 days\",\"termsAndConditionsMarkdown\":\"<ul>\\n<li>This promotion is carried out by  MTN Ivory Coast.</li>\\n<li>Offer to run every week Tuesday and Friday</li>\\n<li>100% bonus on all topups done on Tuesday’s and Fridays</li>\\n<li>Bonus amount has a validity of 7 days and to be used on On-Net calls &amp; SMS</li>\\n<li>To check the bonus amount, please dial USSD code #100#.</li>\\n</ul>\\n\"},\"denominations\":[{\"from\":1.0,\"to\":999999999999999.0,\"bonuses\":[{\"quantity\":100.0,\"descriptionCode\":\"30A02\",\"validityInDays\":7}]}],\"operators\":[{\"operatorId\":null,\"operatorCode\":\"MT\",\"providerCode\":\"CI-MT\"}],\"startDate\":\"2026-01-13T00:00:00\",\"endDate\":\"2026-12-31T23:59:00\",\"applicableDays\":[\"Tuesday\",\"Friday\"],\"priority\":0,\"currecyISO\":\"XOF\",\"countryISO\":\"CI\",\"operator\":\"MTN Ivory Coast\",\"availability\":[\"Web\",\"Apps\",\"Retail\"],\"applicableTo\":[\"Topup\"]},{\"fType\":\"OperatorPromotionsRequest\",\"subject\":\"/api/operatorpromotions\",\"time\":1780430577,\"promotionId\":\"b6709c30-972c-4625-99f7-4b552476d759\",\"promotionDescription\":{\"languageCode\":\"en\",\"title\":\"25% Bonus!\",\"textMarkdown\":\"25% airtime bonus for recipients ETB 200 and above\",\"validityMarkdown\":\"15 days \",\"termsAndConditionsMarkdown\":\"<ul>\\n<li>This promotion is carried out by Ethio Telecom.</li>\\n<li>This promotion starts on 27th April 2026 and ends on 30th June 2026.</li>\\n<li>Send a top-up of 200 Birr and receive 50 bonus</li>\\n<li>The bonus is valid for 15 days.</li>\\n<li>25% airtime bonus for recipients ETB 200 and above IAT or packages of the same value.</li>\\n</ul>\\n<ul>\\n<li>The bonus is valid for 15 days.</li>\\n<li>The bonus is used for any telecom usage to purchase package (self and gift)</li>\\n</ul>\\n\"},\"denominations\":[{\"from\":200.0,\"to\":99999999999.0,\"bonuses\":[{\"quantity\":25.0,\"descriptionCode\":\"BBA86\",\"validityInDays\":15}]}],\"operators\":[{\"operatorId\":null,\"operatorCode\":\"BH\",\"providerCode\":\"ET-BH\"}],\"startDate\":\"2026-04-27T00:00:00\",\"endDate\":\"2026-06-30T23:59:00\",\"applicableDays\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"priority\":1,\"currecyISO\":\"ETB\",\"countryISO\":\"ET\",\"operator\":\"Ethio Telecom\",\"availability\":[\"Web\",\"Apps\",\"Retail\"],\"applicableTo\":[\"Topup\"]},{\"fType\":\"OperatorPromotionsRequest\",\"subject\":\"/api/operatorpromotions\",\"time\":1780430577,\"promotionId\":\"f27c2601-0f45-4497-8fd6-d9b1c38a6eb0\",\"promotionDescription\":{\"languageCode\":\"en\",\"title\":\"Tigo Honduras 25GB Super Recarga at special price!\",\"textMarkdown\":\"For limited time, Super Recarga 25GB at special price\",\"validityMarkdown\":\"7 days\",\"termsAndConditionsMarkdown\":\"<ul>\\n<li>Promotion carried out by Tigo Honduras &amp; Ding.</li>\\n<li>Offer valid on the $8 USD only.</li>\\n<li>Get Paquetigos Super Recarga for $8 (20% off the regular $10 price).</li>\\n<li>Dial #123# to check your balances (main and promotional).</li>\\n<li>Bonus validity: 7 days.</li>\\n<li>The bonus is applied automatically; the receiver does not need to take any action to redeem it.</li>\\n</ul>\\n\"},\"denominations\":[{\"from\":1.0,\"to\":210.0,\"bonuses\":[{\"quantity\":1.0,\"descriptionCode\":\"5EB60\",\"validityInDays\":30}]}],\"operators\":[{\"operatorId\":null,\"operatorCode\":\"PQ\",\"providerCode\":\"HN-PQ\"}],\"startDate\":\"2026-04-07T00:00:00\",\"endDate\":\"2026-06-30T23:59:00\",\"applicableDays\":[\"Monday\",\"Wednesday\",\"Friday\",\"Saturday\",\"Sunday\",\"Tuesday\",\"Thursday\"],\"priority\":0,\"currecyISO\":\"HNL\",\"countryISO\":\"HN\",\"operator\":\"Tigo Paquetigo Honduras\",\"availability\":[\"Web\",\"Apps\"],\"applicableTo\":[\"Plans\"]},{\"fType\":\"OperatorPromotionsRequest\",\"subject\":\"/api/operatorpromotions\",\"time\":1780430577,\"promotionId\":\"0831cfce-d0db-47c6-8777-5bdb6b88c817\",\"promotionDescription\":{\"languageCode\":\"en\",\"title\":\"Digicel Haiti 5X Bonus + 5GB Data!\",\"textMarkdown\":\"Digicel Haiti 5X Bonus + 5GB Data!\",\"validityMarkdown\":\"3 days\",\"termsAndConditionsMarkdown\":\"<ul>\\n<li>The promotion will run from 12:00 am Wednesday, April 1, 2026 through to and including 11:59 pm Tuesday, June 30, 2026 (“The Promotional Period”).</li>\\n<li>Top up by $15USD</li>\\n<li>Bonus credit lasts 3 days</li>\\n<li>The bonus credit on the recipient’s Digicel mobile number can be used for Digicel to Digicel (on-net) calls and SMS only.\\n* The bonus credit is non-transferable.</li>\\n<li> Bonus data can only be used for streaming/browsing and Digicel Apps usage.</li>\\n<li>Bonus data is valid on the recipient’s mobile number for a total of 3 days from when it is applied.</li>\\n<li>Recipients can check the bonus credit and data by dialling the USSD short code <em>120</em>14# and press send on their mobile phone.</li>\\n</ul>\\n\"},\"denominations\":[{\"from\":1965.0,\"to\":999999.0,\"bonuses\":[{\"quantity\":5.0,\"descriptionCode\":\"5EB60\",\"validityInDays\":3},{\"quantity\":5.0,\"descriptionCode\":\"468FE\",\"validityInDays\":3}]}],\"operators\":[{\"operatorId\":null,\"operatorCode\":\"DC\",\"providerCode\":\"HT-DC\"}],\"startDate\":\"2026-04-01T00:00:00\",\"endDate\":\"2026-06-30T23:59:00\",\"applicableDays\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"priority\":1,\"currecyISO\":\"HTG\",\"countryISO\":\"HT\",\"operator\":\"Digicel Haiti\",\"availability\":[\"Web\",\"Apps\",\"Retail\"],\"applicableTo\":[\"Topup\"]},{\"fType\":\"OperatorPromotionsRequest\",\"subject\":\"/api/operatorpromotions\",\"time\":1780430577,\"promotionId\":\"0aa24d1f-b3eb-4c1d-8c3c-5de52ae4b929\",\"promotionDescription\":{\"languageC