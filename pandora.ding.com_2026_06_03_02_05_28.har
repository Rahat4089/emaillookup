$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":13,\"preferredProductType\":null,\"productCategories\":[\"restaurants\"],\"brandDescription\":\"* Make their day with flavours they love. Send a Tasty Treat gift card instantly and let them enjoy their favourites anytime 🍔\\n* From quick bites to casual hangouts, it’s the perfect gift for cravings, catch-ups, and feel-good moments\\n* Fast, simple, and always satisfying—just share the PIN and let them enjoy a delicious experience with ease\",\"brandShortDescription\":\"Because sharing good food is the best gift 🎉\",\"promoText\":null,\"expiry\":\"Valid for 6 months from the date of purchase.\",\"fees\":\"\",\"additionalTerms\":\"- This e-gift card is non-refundable, non-transferable, and cannot be exchanged for cash.\\n- Valid for one-time use only.\\n- Unused balance will be lost.\\n- Any extra cost beyond voucher value must be paid by the customer shopping in Bangladesh.\\n- Valid for regular-priced items only, not valid on discounted items.\",\"howToRedeem\":\"1. You’ll receive an e-gift card code and PIN number.\\n2. Share it with your loved one in Bangladesh.\\n3. They can redeem it by showing the code and card PIN number at checkout at participating TastyTreat outlets.\\n\\nThat’s it! Quick and simple 🎉\",\"contact\":\"\",\"locations\":\"Redeemable only at selected TastyTreat outlets across Bangladesh:\\n\\n- The Great Kabab Factory\\n- The Raymond Shop\\n- Vroom Services Limited\\n- Wholesale Club\\n\\nValid for regular-priced items only, not valid on discounted items.\",\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-DD8FCE\",\"time\":1780430585,\"operatorCode\":\"DD8FCE\",