teps:\\n\\n    - Visit Infinity's website/  a participating outlet.\\n    - Add items to the cart\\n    - At checkout online, enter the e-voucher code and PIN number or show these details to the cashier in store.\\n\\nThat’s it! Quick and simple 🎉\",\"contact\":\"**Support Hotline **📞 +88 01765 900 999\",\"locations\":\"Redeemable online at Infinity’s website and at these select Infinity outlets across Bangladesh:\\n\\n- Infinity\\n- Khaas Food Limited\\n- Lubnan-Richman\\n- Menz Klub\\n- Minister-MYONE Park\\n- MK Electronics\\n- Orion Footwear Ltd.\\n- Plus Point\",\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-9ED538\",\"time\":1780430588,\"operatorCode\":\"9ED538\",\"operatorId\":\"BD-9ED538\",\"countryIso\":\"BD\",\"name\":\"Jurassic World Evolution 2\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromotions\":[],\"pricingVariants\":null,\"productsAvailability\":\"ProductsMayBeAvailable\",\"itemOrder\":200,\"preferredProductType\":\"Voucher\",\"productCategories\":[\"gaming\"],\"brandDescription\":null,\"brandShortDescription\":null,\"promoText\":null,\"expiry\":null,\"fees\":null,\"additionalTerms\":null,\"howToRedeem\":null,\"contact\":null,\"locations\":null,\"seoMeta\":null,\"seoTitle\":null,\"banners\":[],\"productGroups\":[]},{\"fType\":\"Operator\",\"subject\":\"/api/operators/BD-6EF7BF\",\"time\":1780430588,\"operatorCode\":\"6EF7BF\",\"operatorId\":\"BD-6EF7BF\",\"countryIso\":\"BD\",\"name\":\"Khaas Food Limited\",\"accountRegex\":\"^(?:8800000000000|0000000000)$\",\"productsAreOmitted\":true,\"hasPinProducts\":false,\"hasAutoTopup\":false,\"domesticContext\":false,\"productTypes\":[\"Voucher\"],\"autoProductTypes\":[],\"products\":[],\"bonuses\":[],\"bonusEnginePromo