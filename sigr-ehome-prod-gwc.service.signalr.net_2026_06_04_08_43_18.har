assword\",\"meaChangeEmailNewLabel\":\"New email address\",\"meaChangeEmailSuccessTitle\":\"We sent you an email\",\"meaChangeEmailSuccessMessage\":\"We sent you a verification email. Please check your inbox and verify your new email address.\",\"meaChangeEmailConfirmEmailChange\":\"Confirm email change\",\"meaChangeEmailConfirmBtn\":\"Confirm\",\"meaChangeEmailConfirmSuccess\":\"Your email was changed\",\"meaChangeEmailRollbackEmailChange\":\"Rollback email change\",\"meaChangeEmailRollbackBtn\":\"Rollback\",\"meaChangeEmailRollbackSuccess\":\"Your email was rolled back\",\"meaAccountLogOutDevice\":\"Log out device\",\"meaAccountLogOutDeviceDecsription\":\"Are you sure you want to log out the device <0>{{deviceName}}</0> from your account?\",\"meaAccountDeviceLoggedOut\":\"The device was logged out.\",\"meaAccountLogoutProblem\":\"Logout problem\",\"meaAccountLogoutProblemDescription\":\"There was a problem with logging out the device <0>{{deviceName}}</0>. Please try it again later.\",\"meaMenuNotifications\":\"Notifications\",\"meaMenuActivityFeed\":\"Activity feed\",\"meaMenuFeedback\":\"Feedback\",\"meaMenuSendFeedbackDescription\":\"Help us create the best possible experience by sending us your feedback.\",\"meaMenuSendFeedbackContactSupport\":\"Use this form to share your feedback with us. While we may reach out for more details on your feedback, we won't respond to every submission. For technical issues or assistance with ESET HOME, please contact our <0>Technical Support</0>.\",\"meaMenuSendFeedbackThankYou\":\"Thank you for helping us improve ESET HOME.\",\"meaMenuHelp\":\"Help\",\"meaMenuReportIssueDescription\":\"Something's not working? Let us know, and our Technical Support team will contact you soon.\",\"meaMenuAppSettings\":\"App settings\",\"meaProtectYourDevice\":\"Protect your device\",\"meaThisDevice\":\"This device\",\"meaProtectionSent\":\"Protection sent\",\"meaChooseALicense\":\"Choose a subscription\",\"meaDownloadProtection\":\"Download pro