aint_5\":\"The minimum limit is {{count}} characters.\",\"meaLicenseKey\":\"Activation key\",\"meaAddLicense\":\"Add subscription\",\"meaBuyALicense\":\"Buy a subscription\",\"generalEmail\":\"Email address\",\"generalExampleEmail\":\"example@example.com\",\"generalInvalidEmail\":\"The entered email address is in the wrong format. Please use example@example.com.\",\"generalLoading\":\"Loading\",\"generalToday\":\"Today\",\"generalYesterday\":\"Yesterday\",\"generalClose\":\"Close\",\"generalGotIt\":\"Got it\",\"licenseShareInvitationSent\":\"Invitation sent\",\"meaLogOut\":\"Log out\",\"meaActiveNow\":\"Active now\",\"meaAccount\":\"My account\",\"meaAccountLoggedInDevices\":\"Logged in devices\",\"meaAccountLoginHistory\":\"Login history\",\"meaYourPasswordWasChanged\":\"Password was changed.\",\"meaChangePasswordOld\":\"Current password\",\"meaChangePasswordNew\":\"New password\",\"meaChangePasswordPreviousPasswords\":\"Your new password can't be the same as your previous 3 passwords.\",\"meaPasswordWasCompromised\":\"This password was compromised in a data breach elsewhere on the internet. Please use a different password. <0>Read more</0>\",\"meaSendProtection\":\"Send protection\",\"meaRemoveLicenseTitle\":\"Remove subscription\",\"meaRemoveLicenseBtn\":\"Remove subscription\",\"meaRemoveLicenseText\":\"All devices protected by this subscription will be removed from this ESET HOME account. However, they will remain protected even after the removal.\",\"meaRemoveLicenseAreYouSureText\":\" Are you sure you want to remove this subscription?\",\"meaRemoveLicenseSuccess\":\"Subscription was removed\",\"meaRemoveLicenseSuccessText\":\"Your subscription was successfully removed from your ESET HOME account.\",\"meaWeSentYouAnEmail\":\"We sent you an email\",\"meaEnterYourPersonalInfo\":\"Enter your personal info\",\"meaLicenseAddedSuccess\":\"Subscription added successfully\",\"meaLicenseAddedSuccessText\":\"Your subscription is verified and was successfully added to ESET HOME.\",\"meaSendingVerifyEmailProblem\":\"There is a problem with sending you the verification email.\",\"meaCancel\":\"Cancel\",\"meaNoLicenseAdded\":\"You have no subscription added.\",\"meaFree\":\"Available\",\"meaOutOf\":\"out of\",\"meaEsetLicense\":\"ESET subscription\",\"meaLicenseModel\":\"Type\",\"meaShared\":\"Shared\",\"meaExpirationDate\":\"Valid until\",\"meaGeneralInformation\":\"General information\",\"meaOverview\":\"Overview\",\"meaDevices\":\"Devices\",\"meaAccountMyAccount\":\"My account\",\"meaAccountChangeEmail\":\"Change email address\",\"meaAccountChangePasswordTitle\":\"Change password\",\"meaAccountChangePasswordBtn\":\"Change password\",\"meaAccountRegionalSettingsHeader\":\"Regional settings\",\"meaAccountRegionalSettingsEdit\":\"Edit\",\"meaAccountRegionalSettingsCountry\":\"Country\",\"meaAccountRegionalSettingsLanguageOfEmails\":\"Language of emails\",\"meaAccountRegionalSettingsTimeZone\":\"Time zone\",\"meaAccountRegionalSettingsDateFormat\":\"Date format\",\"meaAccountRegionalSettingsTimeFormat\":\"Time format\",\"meaAccountLoggedInDevicesHeader\":\"Logged in devices\",\"meaAccountLoggedInDevicesBtn\":\"Logged in devices\",\"meaAccountNewsCheckboxLabel\":\"I would like to receive special offers, useful support and product information via electronic channels in compliance with <0>Privacy Policy.</0>\",\"meaAccountDeleteAccountLabel\":\"Delete the entire ESET HOME account and all services and information associated with it. This action does not affect the subscriptions you purchased.\",\"meaDeleteAccountDesc1\":\"You're about to delete your ESET HOME account.\",\"meaDeleteAccountDesc2\":\"Deleting your account will permanently remove all your data, including member information and features.\",\"meaDeleteAccountDesc3\":\"Your and your members' antivirus protection will remain active, but if you share your subscription with others, they will no longer be covered once your account is deleted.\",\"meaDeleteAccountDesc4\":\"To proceed,