son?d=login.eset.com","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":method","value":"GET"},{"name":":authority","value":"help.eset.com"},{"name":":path","value":"/tools/consent/strings_4td_essentials.json?d=login.eset.com"},{"name":":scheme","value":"https"},{"name":"pragma","value":"no-cache"},{"name":"cache-control","value":"no-cache"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.7390.55 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Not/A)Brand\";v=\"8\", \"Chromium\";v=\"141\", \"Google Chrome\";v=\"141\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"accept","value":"*/*"},{"name":"origin","value":"https://login.eset.com"},{"name":"sec-fetch-site","value":"same-site"},{"name":"sec-fetch-mode","value":"cors"},{"name":"sec-fetch-dest","value":"empty"},{"name":"referer","value":"https://login.eset.com/"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"en-US,en;q=0.9"},{"name":"priority","value":"u=1, i"}],"queryString":[{"name":"d","value":"login.eset.com"}],"headersSize":671,"bodySize":0,"_status":"completed","_startTimestamp":1780540281245709,"_endTimestamp":1780540281260034},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":status","value":"200"},{"name":"server","value":"nginx"},{"name":"date","value":"Thu, 04 Jun 2026 02:31:21 GMT"},{"name":"content-type","value":"application/json"},{"name":"content-length","value":"40382"},{"name":"last-modified","value":"Tue, 17 Feb 2026 09:00:07 GMT"},{"name":"vary","value":"Accept-Encoding"},{"name":"etag","value":"\"69942e17-9dbe\""},{"name":"content-encoding","value":"br"},{"name":"access-control-allow-origin","value":"https://login.eset.com"},{"name":"x-frame-options","value":"SAMEORIGIN"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-xss-protection","value":"1; mode=block"},{"name":"strict-transport-security","value":"max-age=31536000"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"permissions-policy","value":"geolocation=(), camera=(), microphone=()"},{"name":"alt-svc","value":"h3=\":443\"; ma=86400"},{"name":"cache-control","value":"public, max-age=604800"}],"content":{"size":147675,"mimeType":"application/json","text":"{\r\n  \"en-US\":{\"title\":\"Your cookie choice, your privacy\",\"description\":\"We and our partners use cookies to give you the best optimized online experience, analyze our website traffic, and serve you with personalized ads. You can agree to the collection of all cookies by clicking 'Accept all and close', decline all non-essential cookies by choosing 'Accept essential cookies only', or adjust your cookie settings by clicking 'Manage cookies'. You also have the right to withdraw your consent or change your cookie preferences anytime by clicking the 'Manage cookies' link in our website footer or in your account settings (if available). For more information, see our <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=en-US>Cookie Policy</a>.\",\"essential_title\":\"Essential cookies\",\"basic_title\":\"Basic analytical cookies\",\"advanced_title\":\"Advanced analytical cookies\",\"marketing_title\":\"Marketing cookies\",\"btn_decline\":\"Accept essential cookies only\",\"btn_back\":\"Back\",\"btn_accept_selected\":\"Confirm my choices\",\"btn_accept\":\"Accept all and close\",\"btn_manage\":\"Manage cookies\",\"essential_text\":\"These first-party cookies are necessary for the functioning and security of our website and the services you require. They are usually set in response to your actions to enable the use of certain functionality, such as remembering your cookie preferences, logging in, or holding items in your cart. You cannot opt out of these cookies, and blocking them via a browser may affect site functionality.\",\"basic_text\":\"These first-party cookies enable us to measure the number of visitors/users of our website and create aggregated usage and performance statistics with the help of our trusted partners. We use them to get the basic insight into our website traffic and our campaign performance and to solve bugs on our website.\",\"advanced_text\":\"These first or third-party cookies help us understand how you interact with our website and each offered service by enriching our datasets with data from third-party tools. We use these cookies to improve our website, services, and user experience, find and solve bugs or other problems with them, and evaluate our campaigns' effectiveness. \",\"marketing_text\":\"These third-party cookies allow our marketing partners to track some of your activities on our website (for example, when you download or buy our product) to learn about your interests and needs and to show you more relevant targeted ads.\"},\r\n  \"ar-EG\":{\"title\":\"اختار ملفات تعريف الارتباط الخاصة بك، خصوصيتك\",\"description\":\"نستخدم نحن وشركاؤنا ملفات تعريف الارتباط لمنحك أفضل تجربة ممكنة لتجربتك على موقعنا ونحلل حركة مرور موقعنا على الإنترنت، وخدمتك من خلال إعلانات مخصصة. يمكنك الموافقة على جميع ملفات تعريف الارتباط بالنقر على 'قبول الكل وإغلاق' أو رفض كافة ملفات تعريف الارتباط غير الضرورية من خلال اختيار 'قبول ملفات تعريف الارتباط الأساسية فقط' أو ضبط إعدادات ملفات تعريف الارتباط بالنقر على 'إدارة ملفات تعريف الارتباط'. لديك الحق أيضاً في سحب موافقتك أو تغيير تفضيلاتك لملفات تعريف الارتباط في أي وقت بالنقر على رابط 'إدارة ملفات تعريف الارتباط' الموجودة اسفل الموقع أو في إعدادات حسابك (إذا كان متوفراً). لمزيد من المعلومات، اطلع على <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ar-EG>سياسة ملفات تعريف الارتباط</a>.\",\"essential_title\":\"ملفات تعريف الارتباط الأساسية\",\"basic_title\":\"ملفات تعريف الارتباط التحليلية الأساسية\",\"advanced_title\":\"ملفات تعريف الارتباط التحليلية المتقدمة\",\"marketing_title\":\"ملفات تعريف الارتباط التسويقية\",\"btn_decline\":\"قبول ملفات تعريف الارتباط الأساسية فقط\",\"btn_back\":\"رجوع\",\"btn_accept_selected\":\"تأكيد اختياراتي\",\"btn_accept\":\"قبول الكل وإغلاق\",\"btn_manage\":\"إدارة ملفات تعريف الارتباط\",\"essential_text\":\"تعد ملفات تعريف الارتباط للموقع ضرورية لعمل وأمان لموقعنا والخدمات التي تحتاجها. يتم تعيينها عادةً استجابةً لإجراءاتك لتمكين استخدام وظائف معينة، مثل تذكّر تفضيلات ملفات تعريف الارتباط أو تسجيل الدخول أو الاحتفاظ بعناصر في سلة التسوق لديك. لا يمكنك إلغاء الاشتراك في ملفات تعريف الارتباط هذه، وقد يؤثر حظرها عبر المتصفح على وظائف الموقع.\",\"basic_text\":\"تمنحنا ملفات تعريف الارتباط لموقعنا القدرة على قياس عدد الزوار / المستخدمين للموقع وإنشاء إحصائيات مجمعة عن الاستخدام والأداء بمساعدة شركائنا الموثوقين. نستخدمها للحصول على نظرة ثاقبة حول حركة مرور الموقعنا وأداء الحملات الإعلانية ولحل الأخطاء الموجودة على الموقع.\",\"advanced_text\":\"تساعدنا ملفات تعريف الارتباط لموقعنا أو التابعة لجهات خارجية في فهم كيفية تفاعلك مع موقعنا وكل خدمة مقدمة من خلال إثراء مجموعات البيانات لدينا ببيانات من أدوات تابعة لجهة خارجية. نستخدم ملفات تعريف الارتباط هذه لتحسين موقعنا وخدماتنا وتجربة المستخدم والعثور على الأخطاء أو المشكلات الأخرى وحلها وتقييم فعالية حملاتنا. \",\"marketing_text\":\"تعمل ملفات تعريف الارتباط التابعة لجهات خارجية على السماح لشركائنا في التسويق بتتبع بعض أنشطتك على موقعنا (على سبيل المثال، عند تنزيل المنتج أو شرائه) للتعرف على اهتماماتك واحتياجاتك ولإظهار المزيد من الإعلانات المستهدفة ذات الصلة.\"},\r\n  \"bg-BG\":{\"title\":\"Вашият избор на бисквитки, вашата поверителност\",\"description\":\"Ние и нашите партньори използваме бисквитки, за да ви предоставяме най-оптимизирано онлайн изживяване, да анализираме трафика на уеб сайта си и да ви предлагаме персонализирани реклами. Можете да се съгласите със събирането от всички бисквитки, като щракнете върху „Приемане на всички и затваряне“, да отхвърлите бисквитките, които не са основни, като изберете „Приемане само на основни бисквитки“ или да коригирате настройките си за бисквитки, като щракнете върху „Управление на бисквитките“. Също така имате право да оттеглите съгласието си или да промените предпочитанията си за бисквитки по всяко време, като щракнете върху връзката „Управление на бисквитките“ в долния колонтитул на уеб сайта ни или в настройките на акаунта ви (ако е приложимо). За повече информация вижте нашите <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=bg-BG>Правила за бисквитките</a>.\",\"essential_title\":\"Основни бисквитки\",\"basic_title\":\"Основни аналитични бисквитки\",\"advanced_title\":\"Разширени аналитични бисквитки\",\"marketing_title\":\"Маркетингови бисквитки\",\"btn_decline\":\"Приемане само на основни бисквитки\",\"btn_back\":\"Назад\",\"btn_accept_selected\":\"Потвърждаване на моя избор\",\"btn_accept\":\"Приемане на всички и затваряне\",\"btn_manage\":\"Управление на бисквитките\",\"essential_text\":\"Тези бисквитки от първа страна са необходими за функционирането и сигурността на нашия уеб сайт и на услугите, които изисквате. Те обикновено се задават в отговор на вашите действия, за да се разреши използването на определена функционалност, като запомняне на вашите предпочитания за бисквитки, данни за влизане или запазване на артикули в количката. Не може да се откажете от тези бисквитки и блокирането им с помощта на браузър може да повлияе на функционалността на сайта.\",\"basic_text\":\"Тези бисквитки от първа страна ни дават възможност да измерим броя на посетителите/потребителите на нашия уеб сайт и да създадем обобщени статистически данни за използването и ефективността с помощта на нашите доверени партньори. Използваме ги, за да придобием обща представа за трафика на уеб сайта ни и ефективността на кампанията ни и за решаване на грешки на нашия уеб сайт.\",\"advanced_text\":\"Тези бисквитки от първа или трета страна ни помагат да разберем как взаимодействате с нашия уеб сайт и с всяка предлагана услуга, като обогатяват нашите набори от данни с данни от инструменти на трети страни. Използваме тези бисквитки, за да подобряваме уеб сайта, услугите и потребителското изживяване, да намираме и отстраняваме грешки или други проблеми с тях и да оценяваме ефективността на своите кампании. \",\"marketing_text\":\"Тези бисквитки на трети страни позволяват на нашите маркетингови партньори да проследяват някои от вашите дейности на нашия уеб сайт (например, когато изтегляте или купувате наш продукт), за да се запознаят с вашите интереси и нужди и да ви показват по-подходящи целенасочени реклами.\"},\r\n  \"zh-CN\":{\"title\":\"您的 Cookie 选择, 您的隐私\",\"description\":\"我们和我们的合作伙伴使用 Cookie 来为您提供经优化的最佳在线体验、分析我们的网站流量以及为您提供个性化广告。可以通过单击“全部接受并关闭”来同意收集所有 Cookie、通过选择“仅接受必要 Cookie”来拒绝所有非必要的 Cookie，也可以通过单击“管理 Cookie”来调整 Cookie 设置。您还有权随时通过单击我们网站页脚或您的帐户设置（如果有）中的“管理 Cookie”链接来撤回您的同意或更改 Cookie 偏好。您也有权随时撤销您对 Cookie 的同意。有关详细信息，请参阅我们的 <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=zh-CN>Cookie 策略</a>。\",\"essential_title\":\"基本 Cookie\",\"basic_title\":\"基本分析 Cookie\",\"advanced_title\":\"高级分析 Cookie\",\"marketing_title\":\"营销 Cookie\",\"btn_decline\":\"仅接受必要 Cookie\",\"btn_back\":\"返回\",\"btn_accept_selected\":\"确认我的选择\",\"btn_accept\":\"全部接受并关闭\",\"btn_manage\":\"管理 Cookie\",\"essential_text\":\"这些第一方 Cookie 对于我们网站的运行和安全以及您所需的服务都是必要的。它们通常是根据您的操作设置的，以支持使用某些功能（例如，记住您的 Cookie 偏好、登录或在您的购物车中保存物品）。您不能选择退出这些 Cookie，并且通过浏览器阻止它们可能会影响站点功能。\",\"basic_text\":\"这些第一方 Cookie 使我们能够衡量我们网站的访问者/用户数量，并在我们值得信赖的合作伙伴的帮助下创建汇总的使用情况和性能统计数据。我们使用它们来基本了解我们的网站流量和活动效果，并解决我们网站存在的错误。\",\"advanced_text\":\"这些第一方或第三方 Cookie 通过使用来自第三方工具的数据丰富我们的数据集，从而帮助我们了解您如何与我们的网站以及每个提供的服务进行交互。我们使用这些 Cookie 来改进我们的网站、服务和用户体验，查找并解决它们的错误或其他问题，以及评估我们活动的有效性。 \",\"marketing_text\":\"这些第三方 Cookie 允许我们的营销合作伙伴跟踪您在我们网站上的一些活动（例如，当下载或购买我们的产品时），以了解您的兴趣和需求，并向您展示更多相关的定向广告。\"},\r\n  \"zh-TW\":{\"title\":\"您的 Cookie 選擇，您的隱私權\",\"description\":\"我們和我們的合作夥伴使用 Cookie 為您提供最佳化的線上體驗、分析我們的網站流量並為您提供個人化的廣告。您可以藉由按一下 [全部接受並關閉] 以同意收集所有的 Cookie，或選擇 [僅接受基本 Cookie] 拒絕所有非必要的 Cookie，或按一下 [管理 Cookie] 調整您的 Cookie 設定。您也有權隨時按一下我們網站頁尾或您的帳戶設定 (如果有的話) 中的「管理 Cookie」連結來撤銷您的同意或變更您的 Cookie 喜好設定。如需詳細資訊，請參閱我們的 <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=zh-TW>Cookie 原則</a>。\",\"essential_title\":\"基本 Cookie\",\"basic_title\":\"基本分析 Cookie\",\"advanced_title\":\"進階分析 cookie\",\"marketing_title\":\"行銷 Cookie\",\"btn_decline\":\"僅接受基本 Cookie\",\"btn_back\":\"上一步\",\"btn_accept_selected\":\"確認我的選擇\",\"btn_accept\":\"全部接受並關閉\",\"btn_manage\":\"管理 Cookie\",\"essential_text\":\"這些第一方 Cookie 對於我們網站的運作和安全性以及您所需的服務而言是必要的。它們通常是根據您的動作而進行設定，以啟用特定功能的使用，例如記住您的 Cookie 喜好設定、登入或在您的購物車中保留項目。您無法選擇退出這些 Cookie，透過瀏覽器將其封鎖可能會影響網站功能。\",\"basic_text\":\"這些第一方 Cookie 讓我們能夠測量我們網站的造訪者/使用者的數量，並在我們值得信賴的合作夥伴的協助下建立彙總的使用量和性能統計資料。我們使用它們來對我們的網站流量和行銷活動績效進行基本了解，並且解決我們網站上的錯誤。\",\"advanced_text\":\"這些第一方或第三方 Cookie 藉由使用第三方工具的資料來豐富我們的資料集，幫助我們了解您如何與我們的網站以及每項提供的服務進行互動。我們使用這些 Cookie 來改善我們的網站、服務和使用者體驗，尋找並解決錯誤或與其相關的其他問題，並評估我們行銷活動的效益。 \",\"marketing_text\":\"這些第三方 Cookie 允許我們的行銷活動合作夥伴追蹤您在我們網站上的一些活動 (例如，在您下載或購買我們的產品時)，以了解您的興趣和需求並向您顯示更多相關的目標廣告。\"},\r\n  \"hr-HR\":{\"title\":\"Vaš izbor kolačića, vaša privatnost\",\"description\":\"Mi i naši partneri upotrebljavamo kolačiće kako bismo vam pružili optimizirano online iskustvo, analizirali promet na našoj web stranici i prikazivali vam personalizirane oglase. Pristati na prikupljanje svih kolačića možete klikom na 'Prihvati sve i zatvori', odbiti sve kolačiće koji nisu osnovni možete odabirom 'Prihvati samo osnovne kolačiće' ili možete prilagoditi postavke kolačića klikom na 'Upravljanje kolačićima'. Isto tako, imate pravo povući svoj pristanak ili promijeniti preference o kolačićima u bilo kojem trenutku klikom na vezu 'Upravljanje kolačićima' u podnožju naše web stranice ili u postavkama svojeg računa (ako je dostupno). Više informacija potražite u našim <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=hr-HR>Pravilima o kolačićima</a>.\",\"essential_title\":\"Osnovni kolačići\",\"basic_title\":\"Osnovni analitički kolačići\",\"advanced_title\":\"Napredni analitički kolačići\",\"marketing_title\":\"Marketinški kolačići\",\"btn_decline\":\"Prihvati samo osnovne kolačiće\",\"btn_back\":\"Natrag\",\"btn_accept_selected\":\"Potvrdi moj izbor\",\"btn_accept\":\"Prihvati sve i zatvori\",\"btn_manage\":\"Upravljanje kolačićima\",\"essential_text\":\"Ovi kolačići prve strane potrebni su za funkcioniranje i sigurnost naše web stranice i usluga koje su vam potrebne. Obično se postavljaju kao odgovor na vaše radnje kako bi vam se omogućila upotreba određenih funkcija, kao što su pamćenje postavki kolačića, prijava ili držanje proizvoda u košarici. Ove kolačiće ne možete isključiti, a njihovo blokiranje putem preglednika može utjecati na funkcionalnost stranice.\",\"basic_text\":\"Ovi kolačići prve strane omogućuju nam mjerenje broja posjetitelja/korisnika naše web stranice i stvaranje agregiranih statistika o upotrebi i rezultatima uz pomoć naših pouzdanih partnera. Upotrebljavamo ih kako bismo dobili osnovni uvid u promet naše web stranice i rezultate naše kampanje, kao i za rješavanje pogrešaka na našoj web stranici.\",\"advanced_text\":\"Ovi kolačići prve ili treće strane pomažu nam da razumijemo kako komunicirate s našom web stranicom i svakom ponuđenom uslugom tako što obogaćuju naše skupove podataka podacima iz alata trećih strana. Ove kolačiće upotrebljavamo za poboljšanje naše web stranice, usluga i korisničkog iskustva, pronalaženje i rješavanje programskih pogrešaka ili drugih problema s njima i procjenu učinkovitosti naših kampanja. \",\"marketing_text\":\"Ovi kolačići trećih strana omogućuju našim marketinškim partnerima da prate neke od vaših aktivnosti na našoj web stranici (na primjer, kada preuzmete ili kupite naš program) kako bi saznali više o vašim interesima i potrebama i prikazivali vam relevantnije ciljane oglase.\"},\r\n  \"cs-CZ\":{\"title\":\"Vaše soukromí, váš výběr cookies\",\"description\":\"My a naši partneři používáme soubory cookie, abychom vám poskytli co nejlepší online zážitek, personalizovanou reklamu a dokázali jsme analyzovat návštěvnost webových stránek. Se shromažďováním všech cookies můžete souhlasit kliknutím na tlačítko <strong>Přijmout vše a zavřít</strong>, všechny volitelné soubory cookies můžete odmítnout vybráním možnosti <strong>Přijmout pouze nezbytné cookies</strong>, nebo si jejich nastavení přizpůsobit kliknutím na <strong>Spravovat cookies</strong>. Svůj souhlas se soubory cookie můžete kdykoli zrušit, případně změnit svůj výběr, po kliknutí na odkaz umístěný v patičce webové stránky nebo v nastavení vašeho účtu. Další informace naleznete v <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=cs-CZ>Zásadách používání souborů cookies</a>.\",\"essential_title\":\"Nezbytné cookies\",\"basic_title\":\"Základní analytické soubory cookies\",\"advanced_title\":\"Rozšířené analytické soubory cookies\",\"marketing_title\":\"Marketingové soubory cookies\",\"btn_decline\":\"Přijmout pouze nezbytné cookies\",\"btn_back\":\"Zpět\",\"btn_accept_selected\":\"Potvrdit moje volby\",\"btn_accept\":\"Přijmout vše a zavřít\",\"btn_manage\":\"Spravovat cookies\",\"essential_text\":\"Tyto soubory cookies první strany jsou nezbytné pro fungování a zajištění bezpečnosti naší webové stránky a vámi požadovaných služeb. Obvykle se nastavují v reakci na vámi provedené akce abyste mohli využít konkrétní funkce, jako je například zapamatování vašeho souhlasu se soubory cookies, přihlášení nebo uložení položek v košíku. Pro tento typ cookies proto není vyžadován váš souhlas. Jejich blokování ve vašem prohlížeči může ovlivnit funkčnost webové stránky.\",\"basic_text\":\"Tyto soubory cookies první strany nám umožňují měřit počet návštěvníků/uživatelů našich webových stránek a vytvářet souhrnné statistiky o používání a výkonnosti s pomocí našich důvěryhodných partnerů. Používáme je k získání základního přehledu o návštěvnosti našich webových stránek, výkonnosti našich kampaní a při řešení chyb na našich webových stránkách.\",\"advanced_text\":\"Tyto soubory cookies první nebo třetí strany nám pomáhají získat přehled o tom, jak používáte naši webovou stránku a jednotlivé služby tak, že doplňují naše data o údaje z nástrojů třetích stran. Používáme je k vylepšování našeho webu, služeb a uživatelského prostředí, k identifikaci a opravě chyb nebo jiných souvisejících problémů a vyhodnocování efektivity našich kampaní. \",\"marketing_text\":\"Tyto soubory cookies třetích stran umožňují našim marketingovým partnerům sledovat některé vaše aktivity na našich webových stránkách, například stažení nebo nákup produktu. Díky nim vám zobrazujeme jen relevantní reklamy.\"},\r\n  \"da-DK\":{\"title\":\"Dit valg af cookies, dine personlige oplysninger\",\"description\":\"Vi og vores partnere bruger cookies til at give dig den mest optimerede onlineoplevelse, analysere vores webstedstrafik og vise dig personligt tilpassede annoncer. Du kan acceptere indsamling af alle cookies ved at klikke på 'Acceptér alle, og luk', afvise alle uvæsentlige cookies ved at vælge 'Acceptér kun vigtige cookies' eller justere dine cookieindstillinger ved at klikke på 'Administrer cookies'. Du har også ret til når som helst at trække dit samtykke tilbage eller at ændre dine cookieindstillinger ved at klikke på linket 'Administrer cookies' i sidefoden på vores websted eller i dine kontoindstillinger (hvis de er tilgængelige). Du kan finde flere oplysninger i vores <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=da-DK>cookiepolitik</a>.\",\"essential_title\":\"Vigtige cookies\",\"basic_title\":\"Grundlæggende analytiske cookies\",\"advanced_title\":\"Avancerede analytiske cookies\",\"marketing_title\":\"Markedsføringscookies\",\"btn_decline\":\"Acceptér kun vigtige cookies\",\"btn_back\":\"Tilbage\",\"btn_accept_selected\":\"Bekræft mine valg\",\"btn_accept\":\"Acceptér alle, og luk\",\"btn_manage\":\"Administrer cookies\",\"essential_text\":\"Disse førstepartscookies er nødvendige for, at vores websted og de tjenester, du har brug for, kan fungere og er sikre. De er normalt indstillet i overensstemmelse med dine handlinger for at aktivere brugen af visse funktioner, såsom at huske dine cookieindstillinger, logge på eller bevare varer i din indkøbskurv. Du kan ikke fravælge disse cookies, og hvis du blokerer dem via en browser, kan det påvirke webstedets funktionalitet.\",\"basic_text\":\"Disse førstepartscookies gør det muligt for os at måle antallet af besøgende/brugere på vores websted og at oprette aggregerede brugs- og ydeevnestatistikker ved hjælp af vores betroede partnere. Vi bruger dem til at få grundlæggende indsigt i vores webstedstrafik og i vores kampagners effektivitet og til at løse fejl på vores websted.\",\"advanced_text\":\"Disse første- eller tredjepartscookies hjælper os med at forstå, hvordan du interagerer med vores websted og alle tilbudte tjenester, ved at forsyne vores datasæt med data fra tredjepartsværktøjer. Vi bruger disse cookies til at forbedre vores websted, tjenester og brugeroplevelse, finde og løse fejl eller andre problemer med dem og evaluere vores kampagners effektivitet. \",\"marketing_text\":\"Disse tredjepartscookies gør det muligt for vores marketingpartnere at spore nogle af dine aktiviteter på vores websted (f.eks. når du downloader eller køber vores produkt) for at få mere at vide om dine interesser og behov og vise dig mere relevante målrettede annoncer.\"},\r\n  \"nl-NL\":{\"title\":\"Uw cookiekeuze, uw privacy\",\"description\":\"Wij en onze partners maken gebruik van cookies om u een geoptimaliseerde online ervaring te bieden, ons websiteverkeer te analyseren en u gepersonaliseerde advertenties aan te bieden. U kunt akkoord gaan met het verzamelen van alle cookies door op 'Alles accepteren en sluiten' te klikken, alle niet-essentiële cookies te weigeren door 'Alleen essentiële cookies accepteren' te kiezen, of door uw cookie-instellingen aan te passen door op 'Cookies beheren' te klikken. U hebt ook het recht om uw toestemming omtrent cookies op elk gewenst moment in te trekken of uw cookievoorkeuren te wijzigen door op de koppeling 'Cookies beheren' te klikken in de voettekst op onze website of in uw accountinstellingen (indien beschikbaar). Voor meer informatie verwijzen u naar ons <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=nl-NL>Cookiebeleid</a>.\",\"essential_title\":\"Essentiële cookies\",\"basic_title\":\"Elementaire analytische cookies\",\"advanced_title\":\"Geavanceerde analytische cookies\",\"marketing_title\":\"Marketingcookies\",\"btn_decline\":\"Alleen essentiële cookies accepteren\",\"btn_back\":\"Vorige\",\"btn_accept_selected\":\"Mijn keuzes bevestigen\",\"btn_accept\":\"Alles accepteren en sluiten\",\"btn_manage\":\"Cookies beheren\",\"essential_text\":\"Deze cookies van onszelf zijn noodzakelijk voor het functioneren en de veiligheid van onze website en de diensten die u nodig hebt. Ze worden meestal ingesteld als reactie op uw acties om bepaalde functionaliteit mogelijk te maken, zoals het onthouden van uw cookievoorkeuren, aanmelden of het bewaren van items in uw winkelwagentje. U kunt zich niet afmelden voor deze cookies en het blokkeren ervan in een browser kan gevolgen hebben voor de functionaliteit van de website.\",\"basic_text\":\"Deze first-party cookies stellen ons in staat om het aantal bezoekers/gebruikers van onze website te meten en geaggregeerde gebruiks- en prestatiestatistieken samen te stellen met de hulp van onze vertrouwde partners. We gebruiken deze om basisinzicht te krijgen in ons websiteverkeer en onze campagneprestaties, en om bugs op onze website op te lossen.\",\"advanced_text\":\"Aan de hand van deze cookies van onszelf of cookies van derden kunnen wij begrijpen hoe u omgaat met onze website en elke aangeboden service doordat we onze gegevens uitbreiden met gegevens uit hulpmiddelen van derden. We gebruiken deze cookies om onze website, diensten en gebruikerservaring te verbeteren, bugs of andere problemen te vinden en op te lossen, en de effectiviteit van onze campagnes te beoordelen. \",\"marketing_text\":\"Dankzij deze cookies van derden kunnen onze marketingpartners sommige van uw activiteiten op onze website volgen (bijvoorbeeld wanneer u ons product downloadt of koopt) om meer te weten te komen over uw interesses en behoeften en om u relevantere, gerichte advertenties te tonen.\"},\r\n  \"et-EE\":{\"title\":\"Teie valitud küpsised, teie privaatsus\",\"description\":\"Kasutame koos partneritega küpsiseid, et pakkuda teile parimat optimeeritud veebilahendust, analüüsida veebisaidi liiklust ja pakkuda teile isikupärastatud reklaame. Kõigi küpsiste kogumisega nõustumiseks klõpsake nuppu <strong>Aktsepteeri kõik ja sule</strong>, kõigist ebaolulistest küpsistest keeldumiseks valige <strong>Nõustu ainult oluliste küpsistega</strong> või kohandage oma küpsiste sätteid, klõpsates nuppu <strong>Halda küpsiseid</strong>. Teil on ka igal ajal õigus nõusolek tagasi võtta või küpsiste eelistusi muuta, kui klõpsate linki <strong>Halda küpsiseid</strong> meie veebisaidi jaluses või oma kontosätetes (kui on saadaval). Lisateavet leiate lingilt <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=et-EE>Küpsiste poliitika</a>.\",\"essential_title\":\"Olulised küpsised\",\"basic_title\":\"Peamised analüütilised küpsised\",\"advanced_title\":\"Täpsemad analüütilised küpsised\",\"marketing_title\":\"Turundusküpsised\",\"btn_decline\":\"Nõustu ainult oluliste küpsistega\",\"btn_back\":\"Tagasi\",\"btn_accept_selected\":\"Kinnita minu valikud\",\"btn_accept\":\"Aktsepteeri kõik ja sule\",\"btn_manage\":\"Halda küpsiseid\",\"essential_text\":\"Need esimese osapoole küpsised on vajalikud meie veebisaidi ja vajalike teenuste toimimiseks ning turvalisuse tagamiseks. Need määratakse tavaliselt vastuseks teie toimingutele, et võimaldada teatud funktsioonide kasutamist, näiteks küpsise-eelistuste meeldejätmist, sisselogimist või toodete hoidmist ostukorvis. Te ei saa nendest küpsistest loobuda ja nende blokeerimine brauseri kaudu võib mõjutada saidi funktsionaalsust.\",\"basic_text\":\"Need esimese osapoole küpsised võimaldavad meil mõõta meie veebisaidi külastajate/kasutajate arvu ning luua meie usaldusväärsete partnerite abil koondatud kasutus- ja jõudlusstatistikat. Kasutame neid, et saada peamine ülevaade meie veebisaidi liiklusest ja kampaania tulemuslikkusest, ning et parandada meie veebisaidil olevaid vigu.\",\"advanced_text\":\"Need esimese või kolmanda osapoole küpsised aitavad meil aru saada sellest, kuidas te meie veebisaiti ja iga pakutavat teenust kasutate, rikastades meie andmekomplekte kolmanda osapoole tööriistade andmetega. Kasutame neid küpsiseid veebisaidi, teenuste ja kasutajaliidese parandamiseks, vigade või muude nendega seotud probleemide leidmiseks ja lahendamiseks ning kampaaniate tõhususe hindamiseks. \",\"marketing_text\":\"Need kolmanda osapoole küpsised võimaldavad meie turunduspartneritel jälgida mõningaid teie tegevusi meie veebisaidil (näiteks kui laadite alla või ostate meie toote), et saada teavet teie huvide ja vajaduste kohta ning näidata teile asjakohasemaid sihitud reklaame.\"},\r\n  \"fi-FI\":{\"title\":\"Evästevalintasi, yksityisyytesi\",\"description\":\"Me ja kumppanimme käytämme evästeitä, jotta voimme tarjota sinulle optimoidun verkon käyttökokemuksen, analysoida verkkosivustomme liikennettä ja näyttää sinulle räätälöityjä mainoksia. Voit hyväksyä kaikkien evästeiden keräämisen valitsemalla 'Hyväksy kaikki ja sulje', hylätä kaikki muut paitsi välttämättömät evästeet valitsemalla 'Hyväksy vain välttämättömät evästeet' tai säätää evästeasetuksia valitsemalla 'Evästeiden hallinta' -linkin verkkosivustomme alaviitteestä tai tilisi asetuksista (jos se on käytettävissä). Sinulla on myös oikeus peruuttaa evästesuostumuksesi milloin tahansa. Lisätietoja on <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=fi-FI>evästekäytännössämme</a>.\",\"essential_title\":\"Välttämättömät evästeet\",\"basic_title\":\"Analyyttiset perusevästeet\",\"advanced_title\":\"Edistyneet analyyttiset evästeet\",\"marketing_title\":\"Markkinointievästeet\",\"btn_decline\":\"Hyväksy vain välttämättömät evästeet\",\"btn_back\":\"Edellinen\",\"btn_accept_selected\":\"Vahvista valinnat\",\"btn_accept\":\"Hyväksy kaikki ja sulje\",\"btn_manage\":\"Evästeiden hallinta\",\"essential_text\":\"Nämä ensimmäisen osapuolen evästeet ovat välttämättömiä verkkosivustomme ja tarvitsemiesi palvelujen toiminnan ja turvallisuuden kannalta. Ne asetetaan yleensä tekemiesi toimien mukaisesti tietyille toiminnoille, kuten evästeasetustesi muistamiseen, sisäänkirjautumiseen ja tuotteiden säilyttämiseen ostoskorissa. Näistä evästeistä ei voi kieltäytyä, ja niiden estäminen selaimen kautta voi vaikuttaa sivuston toimimiseen.\",\"basic_text\":\"Näiden ensimmäisen osapuolen evästeiden avulla voimme mitata verkkosivustomme kävijöiden/käyttäjien määrää ja luoda koostettuja käyttö- ja suorituskykytilastoja luotettavien kumppaneidemme avulla. Käytämme niitä saadaksemme perustietoja verkkosivustomme tietoliikenteestä ja kampanjoidemme suorituskyvystä sekä ratkaistaksemme verkkosivustojemme vikatilanteita.\",\"advanced_text\":\"Näistä ensimmäisen tai kolmannen osapuolen evästeistä saamme käsityksen siitä, miten olet vuorovaikutuksessa verkkosivustomme ja kunkin tarjotun palvelun kanssa, kolmansien osapuolten työkalujen laajennettujen tietojen kautta. Käytämme näitä evästeitä, jotta voimme parantaa verkkosivustoamme, palvelujamme ja käyttökokemusta, löytää ja ratkaista niihin liittyviä virheitä tai muita ongelmia sekä arvioida kampanjoidemme tehokkuutta. \",\"marketing_text\":\"Näiden kolmansien osapuolten evästeiden avulla markkinointikumppanimme voivat seurata joitakin toimiasi verkkosivustollamme (esimerkiksi tuotteidemme lataamista ja ostamista), jotta he saavat tietoa kiinnostuksen kohteistasi ja tarpeistasi ja voivat näyttää sinulle osuvampia kohdennettuja mainoksia.\"},\r\n  \"fr-CA\":{\"title\":\"Choisissez vos préférences en matière de témoins et protégez la confidentialité de vos données\",\"description\":\"Nos partenaires et nous utilisons des témoins pour vous offrir la meilleure expérience optimisée en ligne, analyser le trafic sur notre site Web et vous fournir des publicités personnalisées. Vous pouvez accepter la collecte de tous les témoins en cliquant sur « Tout accepter et fermer », refuser tous les témoins non essentiels en choisissant « Accepter uniquement les témoins essentiels » ou régler vos paramètres concernant les témoins en cliquant sur « Gérer les témoins ». Vous avez également le droit de retirer votre consentement ou de modifier vos préférences en matière de témoins à tout moment en cliquant sur le lien « Gérer les témoins » dans le pied de notre page Web ou dans les paramètres de votre compte (le cas échéant). Pour en savoir plus, veuillez consulter notre <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=fr-CA>Politique relative aux témoins</a>.\",\"essential_title\":\"Témoins essentiels\",\"basic_title\":\"Témoins analytiques de base\",\"advanced_title\":\"Témoins analytiques avancés\",\"marketing_title\":\"Témoins de marketing\",\"btn_decline\":\"Acceptez uniquement les témoins essentiels\",\"btn_back\":\"Précédent\",\"btn_accept_selected\":\"Confirmer mes choix\",\"btn_accept\":\"Tous accepter et fermer\",\"btn_manage\":\"Gérer les témoins\",\"essential_text\":\"Ces témoins internes sont essentiels au bon fonctionnement et à la sécurité de notre site Web et des services dont vous avez besoin. Ils sont généralement définis en réponse à vos actions pour permettre l’utilisation de certaines fonctionnalités, telles que la mémorisation de vos préférences en matière de témoins, votre connexion ou le maintien d’articles dans votre panier. Vous ne pouvez pas refuser ces témoins, et les bloquer au moyen d’un navigateur peut nuire à la fonctionnalité du site.\",\"basic_text\":\"Ces témoins internes nous permettent de compter le nombre de visiteurs ou d’utilisateurs de notre site Web et de créer des statistiques agrégées d’utilisation et de performance avec l’aide de nos partenaires de confiance. Nous les utilisons pour obtenir les informations de base sur le trafic de notre site Web et les performances de notre campagne et pour résoudre les bogues sur notre site Web.\",\"advanced_text\":\"Ces témoins internes ou de tiers nous aident à mieux comprendre comment vous interagissez avec notre site Web et chacun des services offerts en enrichissant nos ensembles de données avec des données provenant d’outils tiers. Nous utilisons ces témoins dans le but d’améliorer notre site Web, nos services et l’expérience utilisateur, de trouver et de résoudre des bogues ou d’autres problèmes en lien avec ceux-ci, et d’évaluer l’efficacité de nos campagnes. \",\"marketing_text\":\"Ces témoins tiers permettent à nos partenaires marketing de suivre certaines de vos activités sur notre site Web (par exemple, lorsque vous téléchargez ou achetez notre produit) afin d’en savoir plus sur vos intérêts et vos besoins et pour vous fournir des publicités ciblées plus pertinentes.\"},\r\n  \"fr-FR\":{\"title\":\"Votre choix de cookies, votre vie privée\",\"description\":\"Nos partenaires et nous, utilisons des cookies pour optimiser votre expérience en ligne, analyser le trafic de notre site internet et vous proposer des annonces personnalisées. Vous pouvez accepter la collecte de tous les cookies en cliquant sur « Tout accepter et fermer », refuser ceux qui ne sont pas essentiels en cliquant sur « Accepter uniquement les cookies essentiels » ou ajuster vos paramètres en cliquant sur « Gérer les cookies ». Vous pouvez également retirer votre consentement ou modifier vos préférences à tout moment en cliquant sur « Gérer les cookies » en bas de page ou depuis les paramètres de votre compte (si disponible). Pour plus d’informations, veuillez consulter notre <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=fr-FR>politique en matière de cookies</a>.\",\"essential_title\":\"Cookies essentiels\",\"basic_title\":\"Cookies analytiques de base\",\"advanced_title\":\"Cookies analytiques avancés\",\"marketing_title\":\"Cookies marketing\",\"btn_decline\":\"Accepter uniquement les cookies essentiels\",\"btn_back\":\"Précédent\",\"btn_accept_selected\":\"Confirmer mes choix\",\"btn_accept\":\"Tout accepter et fermer\",\"btn_manage\":\"Gérer les cookies\",\"essential_text\":\"Ces cookies sont nécessaires au fonctionnement et à la sécurité de notre site web et des services dont vous avez besoin. Ils sont généralement définis en réponse à vos actions pour permettre l’utilisation de certaines fonctionnalités, telles que la mémorisation de vos préférences en matière de cookies, la connexion ou encore le maintien d’articles dans votre panier. Vous ne pouvez pas refuser ces cookies et essayer de les bloquer via un navigateur peut avoir une incidence sur les fonctionnalités du site.\",\"basic_text\":\"Ces cookies internes nous permettent de mesurer le nombre de visiteurs/d’utilisateurs sur notre site web et de créer des statistiques agrégées d’utilisation et de performances avec l’aide de nos partenaires de confiance. Nous les utilisons pour obtenir des informations sur le trafic de notre site web, les performances de nos campagnes et pour résoudre les bugs.\",\"advanced_text\":\"Ces cookies internes ou tiers permettent de comprendre la façon dont vous interagissez avec notre site web et avec chaque service proposé en enrichissant nos données avec des informations provenant d’outils tiers. Nous utilisons ces cookies pour améliorer notre site, nos services et l’expérience utilisateurs mais également pour trouver et résoudre des bogues ou d’autres problèmes, et évaluer l’efficacité de nos campagnes.\",\"marketing_text\":\"Ces cookies tiers permettent à nos partenaires marketing de suivre certaines de vos activités sur notre site web (par exemple, lorsque vous téléchargez ou achetez nos produit) afin de connaître vos intérêts et vos besoins et de vous montrer des publicités ciblées plus pertinentes.\"},\r\n  \"de-DE\":{\"title\":\"Ihre Cookie-Auswahl, Ihr Datenschutz\",\"description\":\"Wir und unsere Partner verwenden Cookies, um Ihnen ein optimales Onlineerlebnis zu bieten, den Datenverkehr unserer Website zu analysieren und Sie mit personalisierten Werbungen zu unterstützen. Sie können der Erfassung aller Cookies zustimmen, indem Sie auf 'Alle akzeptieren und schließen' klicken, alle unwichtigen Cookies ablehnen, indem Sie auf 'Nur wichtige Cookies akzeptieren' klicken, oder Ihre Cookie-Einstellungen anpassen, indem Sie auf 'Cookies verwalten' klicken. Außerdem haben Sie das Recht, Ihre Zustimmung zu Cookies jederzeit zu widerrufen oder Ihre Cookie-Einstellungen zu ändern, indem Sie in der Fußzeile Ihrer Website oder in den Einstellungen Ihres Benutzerkontos (sofern verfügbar) auf den Link 'Cookies verwalten' klicken. Weitere Informationen finden Sie in unserer <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=de-DE>Cookie-Richtlinie</a>.\",\"essential_title\":\"Wichtige Cookies\",\"basic_title\":\"Allgemeine Analyse-Cookies\",\"advanced_title\":\"Erweiterte Analyse-Cookies\",\"marketing_title\":\"Marketing-Cookies\",\"btn_decline\":\"Nur wichtige Cookies akzeptieren\",\"btn_back\":\"Zurück\",\"btn_accept_selected\":\"Auswahl bestätigen\",\"btn_accept\":\"Alle akzeptieren und schließen\",\"btn_manage\":\"Cookies verwalten\",\"essential_text\":\"Diese Erstanbieter-Cookies sind für die Funktion und Sicherheit unserer Website und der benötigten Dienste erforderlich. Die Cookies werden üblicherweise als Folge Ihrer Aktionen gesetzt, um die Nutzung bestimmter Funktionen zu ermöglichen, z. B. um Ihre Cookie-Einstellungen zu speichern, sich zu anmelden oder um Elemente in Ihrem Einkaufswagen abzulegen. Sie können diese Cookies nicht deaktivieren und wenn Sie sie in einem Browser blockieren, kann die Funktion der Website beeinträchtigt werden.\",\"basic_text\":\"Mit diesen Erstanbieter-Cookies können wir die Anzahl der Besuchern/Benutzer unserer Website messen und aggregierte Nutzungs- und Leistungsstatistiken mithilfe unserer vertrauenswürdigen Partner erstellen. Wir verwenden diese, um einen grundlegenden Überblick über den Website-Datenverkehr und die Kampagnenleistung zu erhalten und um Bugs auf unserer Website zu beheben.\",\"advanced_text\":\"Mithilfe dieser Erstanbieter- oder Drittanbieter-Cookies können wir besser verstehen, wie Sie mit unserer Webseite und mit den angebotenen Diensten interagieren, da sie unsere Datensätze mit Daten von Drittanbieter-Tools anreichern. Wir verwenden diese Cookies, um unsere Website, unsere Dienste und das Benutzererlebnis zu verbessern, Fehler oder andere Probleme zu ermitteln und zu beheben und die Wirksamkeit unserer Kampagnen zu bewerten. \",\"marketing_text\":\"Mit diesen Cookies von Drittanbietern können unsere Marketingpartner einige Ihrer Aktivitäten auf unserer Website nachverfolgen, z. B. wenn Sie unser Produkt herunterladen oder kaufen, um mehr über Ihre Interessen und Bedürfnisse zu erfahren und Ihnen relevante, personalisierte Werbungen anzuzeigen.\"},\r\n  \"el-GR\":{\"title\":\"Επιλογή cookies, το απόρρητό σας\",\"description\":\"Η εταιρεία και οι συνεργάτες της χρησιμοποιούν cookies για να παρέχουν βελτιστοποιημένη διαδικτυακή εμπειρία στον χρήστη, να αναλύουν την επισκεψιμότητα του ιστότοπου και να προβάλλουν στον χρήστη εξατομικευμένες διαφημίσεις. Μπορείτε να συμφωνήσετε με τη συλλογή όλων των cookies, κάνοντας κλικ στην επιλογή «Αποδοχή όλων και κλείσιμο», να απορρίψετε όλα τα μη απαραίτητα cookies επιλέγοντας «Αποδοχή μόνο των απαραίτητων cookies» ή να προσαρμόσετε τις ρυθμίσεις για τα cookies κάνοντας κλικ στην επιλογή «Διαχείριση cookies». Επίσης, έχετε το δικαίωμα να αποσύρετε τη συγκατάθεσή σας για τα cookies ή να αλλάξετε τις προτιμήσεις σας για τα cookies ανά πάσα στιγμή, κάνοντας κλικ στον σύνδεσμο «Διαχείριση cookies» που βρίσκεται στο υποσέλιδο του ιστότοπου της εταιρείας ή στις ρυθμίσεις λογαριασμού σας (εάν είναι διαθέσιμος). Για περισσότερες πληροφορίες, ανατρέξτε στην <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=el-GR>Πολιτική για τα cookies</a>.\",\"essential_title\":\"Απαραίτητα cookies\",\"basic_title\":\"Βασικά cookies ανάλυσης\",\"advanced_title\":\"Προηγμένα cookies ανάλυσης\",\"marketing_title\":\"Cookies εμπορικής προώθησης\",\"btn_decline\":\"Αποδοχή μόνο των απαραίτητων cookies\",\"btn_back\":\"Πίσω\",\"btn_accept_selected\":\"Επιβεβαίωση των επιλογών μου\",\"btn_accept\":\"Αποδοχή όλων και κλείσιμο\",\"btn_manage\":\"Διαχείριση cookies\",\"essential_text\":\"Αυτά τα cookies της εταιρείας είναι απαραίτητα για τη λειτουργία και την ασφάλεια του ιστότοπου, καθώς και των υπηρεσιών που χρειάζεστε. Συνήθως, αυτά εφαρμόζονται ως απόκριση στις ενέργειές σας έτσι ώστε να επιτρέπουν τη χρήση ορισμένων λειτουργιών, όπως την απομνημόνευση των προτιμήσεων για τα cookies και τη σύνδεση ή τη διατήρηση αντικειμένων στο καλάθι σας. Δεν μπορείτε να εξαιρεθείτε από τα cookies αυτά, ενώ ο αποκλεισμός τους μέσω ενός προγράμματος περιήγησης μπορεί να επηρεάσει τη λειτουργικότητα του ιστότοπου.\",\"basic_text\":\"Αυτά τα cookies της εταιρείας επιτρέπουν στην εταιρεία να μετράει τον αριθμό επισκεπτών/χρηστών του ιστότοπου και να δημιουργεί συγκεντρωτικά στατιστικά στοιχεία χρήσης και επιδόσεων με τη βοήθεια των αξιόπιστων συνεργατών της. Αυτά τα στατιστικά στοιχεία χρησιμοποιούνται για να έχει η εταιρεία μια βασική εικόνα για την επισκεψιμότητα στον ιστότοπο και για τις επιδόσεις της διαφημιστικής εκστρατείας της εταιρείας, καθώς και για την επίλυση σφαλμάτων στον ιστότοπο της εταιρείας.\",\"advanced_text\":\"Αυτά τα cookies της εταιρείας ή άλλων κατασκευαστών βοηθούν την εταιρεία να αποκτήσει πληροφορίες σχετικά με τον τρόπο που αλληλεπιδρούν οι χρήστες με τον ιστότοπο και κάθε προσφερόμενη υπηρεσία, εμπλουτίζοντας τα σύνολα δεδομένων της εταιρείας με δεδομένα από εργαλεία άλλων κατασκευαστών. Η εταιρεία χρησιμοποιεί αυτά τα cookies για τη βελτίωση του ιστότοπου, των υπηρεσιών και της εμπειρίας του χρήστη, καθώς επίσης και για τον εντοπισμό και την επίλυση σφαλμάτων ή άλλων προβλημάτων που σχετίζονται με τα παραπάνω, αλλά και για την αξιολόγηση της αποτελεσματικότητας των διαφημιστικών εκστρατειών της εταιρείας. \",\"marketing_text\":\"Αυτά τα cookies τρίτων μερών επιτρέπουν στους συνεργάτες μάρκετινγκ να καταγράφουν ορισμένες από τις δραστηριότητες των χρηστών στον ιστότοπο (για παράδειγμα, τη λήψη ή αγορά προϊόντος της εταιρείας) έτσι ώστε να μάθουν για τα ενδιαφέροντα και τις ανάγκες σας και για να προβάλλουν στο χρήστη πιο στοχευμένες διαφημίσεις σχετικά.\"},\r\n  \"he-IL\":{\"title\":\"בחירת קובצי ה-Cookie שלך, הפרטיות שלך\",\"description\":\"אנו והשותפים שלנו משתמשים בקובצי Cookie כדי להעניק לך את החוויה המקוונת הטובה ביותר, לנתח את התעבורה באתר שלנו ולהציג לך מודעות מותאמות אישית. ניתן לאשר איסוף של כל קובצי ה-Cookie על ידי לחיצה על 'קבל הכול וסגור', לדחות את כל קובצי ה-Cookie הלא חיוניים על ידי בחירת 'קבל קובצי Cookie חיוניים בלבד' או להתאים את הגדרות קובצי ה-Cookie על ידי לחיצה על 'ניהול קובצי Cookie'. בנוסף, יש לך זכות לבטל את הסכמתך או לשנות את העדפות קובצי ה-Cookie שלך בכל עת על ידי לחיצה על הקישור 'ניהול קובצי Cookie' בכותרת התחתונה של האתר או בהגדרות החשבון שלך (אם זמין). לקבלת מידע נוסף, יש לעיין ב<a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=he-IL>מדיניות קובצי ה-Cookie</a> שלנו.\",\"essential_title\":\"קובצי Cookie חיוניים\",\"basic_title\":\"קובצי Cookie אנליטיים בסיסיים\",\"advanced_title\":\"קובצי Cookie אנליטיים מתקדמים\",\"marketing_title\":\"קובצי Cookie של שיווק\",\"btn_decline\":\"קבל קובצי Cookie חיוניים בלבד\",\"btn_back\":\"חזרה\",\"btn_accept_selected\":\"אשר את הבחירות שלי\",\"btn_accept\":\"קבל הכול וסגור\",\"btn_manage\":\"ניהול קובצי Cookie\",\"essential_text\":\"קובצי Cookie של צד ראשון נחוצים לתפקוד ולאבטחה של אתר האינטרנט שלנו והשירותים הדרושים לך. הם בדרך כלל מוגדרים בתגובה לפעולות שלך כדי לאפשר שימוש בפונקציונליות מסוימת, כגון שמירת העדפות קובצי ה-Cookie שלך, התחברות או שמירת פריטים בעגלת הקניות. לא ניתן לבטל את השימוש בקובצי Cookie אלה, וחסימתם באמצעות דפדפן עשויה להשפיע על פונקציונליות האתר.\",\"basic_text\":\"קובצי Cookie אלה של צד ראשון מאפשרים לנו למדוד את מספר המבקרים/המשתמשים באתר שלנו וליצור נתונים סטטיסטיים מצטברים של שימוש וביצועים בעזרת השותפים המהימנים שלנו. אנו משתמשים בהם כדי לקבל תובנות בסיסיות לגבי התנועה באתר שלנו וביצועי הקמפיין שלנו וכדי לפתור באגים באתר שלנו.\",\"advanced_text\":\"קובצי Cookie של צד ראשון או שלישי עוזרים לנו להבין את האינטראקציה שלך עם אתר האינטרנט שלנו ועם כל שירות שמוצע על ידי העשרת ערכות הנתונים שלנו בנתונים מכלים של צד שלישי. אנו משתמשים בקובצי Cookie אלה כדי לשפר את אתר האינטרנט, השירותים וחוויית המשתמש שלנו, למצוא ולפתור באגים או בעיות אחרות בהם ולהעריך את יעילות הקמפיינים שלנו. \",\"marketing_text\":\"קובצי Cookie אלה של צד שלישי מאפשרים לשותפי השיווק שלנו לעקוב אחר חלק מהפעילויות שלך באתר האינטרנט שלנו (לדוגמה, כאשר אתה מוריד או קונה את המוצר שלנו) כדי ללמוד על תחומי העניין והצרכים שלך ולהציג לך מודעות ממוקדות ורלוונטיות יותר.\"},\r\n  \"hu-HU\":{\"title\":\"A kiválasztott sütik és az adatvédelem\",\"description\":\"Mi és partnereink sütiket használunk, hogy a legjobb optimalizált online élményt nyújthassuk Önnek, elemezzük weboldalunk forgalmát, hogy személyre szabott hirdetésekkel szolgálhassunk Önnek. A 'Mindet elfogadom és bezárom' gombra kattintva hozzájárulhat az összes süti begyűjtéséhez, a 'Csak az alapvető sütik elfogadása' gombra kattintva elutasíthatja az összes nem alapvető süti gyűjtését, a 'Sütik kezelése' gombra kattintva pedig módosíthatja a sütibeállításokat. Emellett bármikor joga van visszavonni a hozzájárulását vagy módosítani a sütibeállításokat a 'Sütik kezelése' gombra kattintva a webhelyünk láblécében vagy a fiókbeállításokban (ha van ilyen lehetőség). További információkért tekintse meg a <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=hu-HU>sütik kezelésével kapcsolatos szabályzatunkat</a>.\",\"essential_title\":\"Alapvető sütik\",\"basic_title\":\"Alapvető analitikai sütik\",\"advanced_title\":\"Fejlett analitikai sütik\",\"marketing_title\":\"Marketing sütik\",\"btn_decline\":\"Csak az alapvető sütik elfogadása\",\"btn_back\":\"Vissza\",\"btn_accept_selected\":\"A kiválasztott beállítások megerősítése\",\"btn_accept\":\"Mindet elfogadom és bezárom\",\"btn_manage\":\"Sütik kezelése\",\"essential_text\":\"Ezek az első féltől származó sütik a weboldalunk és az Ön által igényelt szolgáltatások működéséhez és védelméhez szükségesek. A sütik az Ön igényeinek figyelembevételével kerülnek beállításra, hogy lehetővé tegyük bizonyos funkciók használatát, például a sütibeállítások megjegyzését, a bejelentkezést, illetve a kosárba tett tételek megőrzését. Ezeket a sütiket nem lehet letiltani, és a böngészőn keresztül történő blokkolásuk befolyásolhatja a webhely működését.\",\"basic_text\":\"Az első féltől származó sütik lehetővé teszik számunkra, hogy lemérjük webhelyünk látogatóinak/felhasználóinak számát, és megbízható partnereink segítségével összesített használati és teljesítménybeli statisztikákat hozzunk létre. Ezeket a statisztikákat arra használjuk, hogy alapvető betekintést nyerhessünk webhelyünk forgalmi- és kampányaink teljesítmény-adataiba, valamint arra, hogy kijavíthassuk a webhelyünkön található hibákat.\",\"advanced_text\":\"Az első vagy harmadik féltől származó sütik segítségével jobban meg tudjuk érteni az Ön és a webhely, illetve az egyes felkínált szolgáltatások között történő interakciót azáltal, hogy adatkészleteinket harmadik féltől származó eszközök adataival töltjük fel. A sütiket arra használjuk, hogy fejlesszük webhelyünket, szolgáltatásainkat, növeljük a felhasználói élményt, megtaláljuk és elhárítsuk a hibákat vagy egyéb problémákat, és kiértékeljük kampányaink hatékonyságát. \",\"marketing_text\":\"A harmadik féltől származó sütik lehetővé teszik marketingpartnereink számára, hogy nyomon követhessék az Ön tevékenységeit a webhelyünkön (például amikor letölti vagy megvásárolja termékünket), ezáltal felmérhessék az Ön érdeklődési köreit és igényeit, és így relevánsabb célzott hirdetéseket jeleníthessenek meg Önnek.\"},\r\n  \"id-ID\":{\"title\":\"Pilihan cookie Anda, privasi Anda\",\"description\":\"Kami dan mitra kami menggunakan cookie untuk memberikan pengalaman online terbaik yang dioptimalkan, menganalisis lalu lintas situs web, dan melayani Anda dengan iklan yang dipersonalisasi. Anda dapat menyetujui pengumpulan semua cookie dengan mengeklik 'Terima semua dan tutup', menolak semua cookie non-esensial dengan memilih 'Terima cookie penting saja', atau menyesuaikan pengaturan cookie Anda dengan mengeklik 'Kelola cookie'. Anda juga memiliki hak untuk membatalkan persetujuan cookie kapan saja dengan mengeklik tautan 'Kelola cookie' di footer situs web kami atau di penyiapan akun (jika ada). Untuk informasi selengkapnya, silakan lihat <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=id-ID>Kebijakan Cookie</a> kami.\",\"essential_title\":\"Cookie penting\",\"basic_title\":\"Cookie analitis dasar\",\"advanced_title\":\"Cookie analitis tingkat lanjut\",\"marketing_title\":\"Cookie pemasaran\",\"btn_decline\":\"Terima cookie penting saja\",\"btn_back\":\"Kembali\",\"btn_accept_selected\":\"Konfirmasi pilihan saya\",\"btn_accept\":\"Terima semua dan tutup\",\"btn_manage\":\"Kelola cookie\",\"essential_text\":\"Cookie pihak pertama ini diperlukan untuk fungsi dan keamanan situs web kami serta layanan yang Anda butuhkan. Cookie ini biasanya diatur sebagai tanggapan atas tindakan Anda untuk memungkinkan penggunaan fungsi tertentu, seperti mengingat preferensi cookie, akses masuk, atau menyimpan barang di keranjang. Anda tidak dapat memilih keluar dari cookie ini, dan memblokir cookie melalui browser dapat memengaruhi fungsionalitas situs.\",\"basic_text\":\"Cookie pihak pertama ini memungkinkan kami mengukur jumlah pengunjung/pengguna situs web dan membuat statistik penggunaan dan kinerja agregat dengan bantuan mitra tepercaya kami. Kami menggunakannya untuk mendapatkan wawasan dasar tentang lalu lintas situs web dan kinerja kampanye, dan untuk memecahkan bug di situs web kami.\",\"advanced_text\":\"Cookie pihak pertama atau ketiga ini membantu kami memahami cara Anda berinteraksi dengan situs web kami dan setiap layanan yang ditawarkan dengan memperkaya kumpulan data kami menggunakan data dari perangkat pihak ketiga. Kami menggunakan cookie ini untuk meningkatkan situs web, layanan, dan pengalaman pengguna, menemukan dan memecahkan bug atau masalah lain, serta mengevaluasi efektivitas kampanye kami. \",\"marketing_text\":\"Cookie pihak ketiga ini memungkinkan mitra pemasaran kami untuk melacak beberapa aktivitas Anda di situs web kami (misalnya, ketika Anda mengunduh atau membeli produk kami) untuk mempelajari minat dan kebutuhan Anda serta untuk menunjukkan iklan bertarget yang lebih relevan.\"},\r\n  \"it-IT\":{\"title\":\"Gestisci la scelta dei cookie e della privacy\",\"description\":\"La Società e i relativi partner utilizzano i cookie per offrire all’utente un’esperienza online ottimizzata, analizzare il traffico sul proprio sito web e fornire annunci pubblicitari personalizzati. L’utente può accettare la raccolta di tutti i cookie facendo clic su “Accetta tutto e chiudi”, rifiutare tutti i cookie non essenziali scegliendo “Accetta solo cookie essenziali” o modificare le impostazioni relative ai cookie facendo clic su “Gestisci cookie”. L’utente ha anche il diritto di revocare il consenso ai cookie o di modificare le preferenze relative ai cookie in qualsiasi momento facendo clic sul collegamento “Gestisci cookie” presente nella nota a piè di pagina del sito web aziendale o nelle impostazioni dell’account (se disponibili). Per ulteriori informazioni, consultare la <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=it-IT>Politica aziendale sui cookie</a>.\",\"essential_title\":\"Cookie essenziali\",\"basic_title\":\"Cookie analitici di base\",\"advanced_title\":\"Cookie analitici avanzati\",\"marketing_title\":\"Cookie di marketing\",\"btn_decline\":\"Accetta solo cookie essenziali\",\"btn_back\":\"Indietro\",\"btn_accept_selected\":\"Conferma le scelte\",\"btn_accept\":\"Accetta tutto e chiudi\",\"btn_manage\":\"Gestisci cookie\",\"essential_text\":\"Questi cookie di prima parte sono necessari ai fini del funzionamento e della sicurezza del sito web aziendale e dei servizi richiesti dall’utente. Vengono solitamente impostati in risposta alle azioni dell’utente allo scopo di abilitare l’utilizzo di specifiche funzionalità, come ad esempio la memorizzazione delle preferenze relative ai cookie, l’autenticazione o il posizionamento di articoli nel carrello. Non è possibile rifiutarli e il blocco tramite browser potrebbe compromettere la funzionalità del sito.\",\"basic_text\":\"Questi cookie di prima parte consentono alla Società di misurare il numero di visitatori/utenti del proprio sito web e di creare statistiche aggregate sull’utilizzo e sulle prestazioni con l’aiuto dei propri partner fidati. Vengono utilizzati per ottenere informazioni di base sul traffico sul sito web aziendale e sulle prestazioni delle campagne e per risolvere bug sul sito web aziendale.\",\"advanced_text\":\"Questi cookie di prima o terza parte aiutano la Società a comprendere le modalità di interazione dell’utente con il sito web aziendale e con ciascun servizio offerto attraverso l’arricchimento dei set di dati aziendali con i dati ricavati dall’utilizzo di strumenti di terze parti. La Società utilizza questi cookie allo scopo di migliorare il sito web aziendale, i servizi e l’esperienza degli utenti, individuare e risolvere bug o altri problemi con questi cookie e valutare l’efficacia delle proprie campagne. \",\"marketing_text\":\"Questi cookie di terze parti consentono ai partner di marketing della Società di monitorare alcune attività dell’utente sul sito web aziendale (ad esempio, durante il download o l’acquisto del prodotto) allo scopo di conoscerne gli interessi, le esigenze e di mostrare gli annunci pubblicitari mirati più rilevanti.\"},\r\n  \"ja-JP\":{\"title\":\"Cookieの選択、プライバシー\",\"description\":\"ESETおよびESETのパートナーはCookieを使用して、最も最適化されたオンラインエクスペリエンスを実現し、ESET Webサイトのトラフィックを分析し、お客様にパーソナル化された広告を提供します。[すべてに同意して閉じる]をクリックしてすべてのCookieの収集に同意するか、[必須のCookieのみを許可]をクリックして、必須ではないCookieのすべてを拒否するか、[Cookieの管理]をクリックしてCookie設定を調整できます。また、お客様はいつでも、Webサイトのフッターまたはアカウント設定(使用可能な場合)の[Cookieの管理]リンクをクリックして、Cookieに対する同意を取り消したり、Cookie設定を変更したりする権利があります。詳細については、<a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ja-JP>Cookieポリシー</a>を参照してください。\",\"essential_title\":\"必須のCookie\",\"basic_title\":\"基本分析のためのCookie\",\"advanced_title\":\"高度な分析のためのCookie\",\"marketing_title\":\"マーケティングCookie\",\"btn_decline\":\"必須のCookieのみを許可\",\"btn_back\":\"戻る\",\"btn_accept_selected\":\"選択内容の確認\",\"btn_accept\":\"すべてに同意して閉じる\",\"btn_manage\":\"Cookieの管理\",\"essential_text\":\"これらのファーストパーティCookieは、当社のWebサイトおよびお客様が必要とするサービスの機能とセキュリティに必要です。これらは通常、Cookie設定の記憶、ログイン、カート内の品物の保存などの特定の機能の使用を有効にするために、ユーザーアクションに対応して設定されます。これらのCookieをオプトアウトし、ブラウザー経由でブロックすると、サイト機能に影響する可能性があります。\",\"basic_text\":\"このファーストパーティCookieを使用することによって、ESETは、信頼できるパートナーの支援を受け、ESET Webサイトの訪問者数/ユーザー数を測定し、集約された使用状況とパフォーマンス統計情報を作成できます。ESETはそれらを使用して、Webサイトトラフィックとキャンペーンパフォーマンスに関する基本的な分析情報を得て、Webサイトの不具合を解決します。\",\"advanced_text\":\"これらのファーストパーティCookieとサードパーティCookieは、サードパーティツールのデータを使用してデータセットを充実させることで、お客様がESETのWebサイトおよび各サービスを操作する方法を分析するために役立ちます。ESETは、これらのCookieを使用して、Webサイト、サービス、ユーザーエクスペリエンスの向上、不具合や他の問題の検出と解決、キャンペーン効果の評価を行います。\",\"marketing_text\":\"これらのサードパーティCookieを使用すると、ESETのマーケティングパートナーは、Webサイトでのアクティビティの一部(製品のダウンロードまたは購入など)を追跡して、お客様の関心とニーズを把握し、関連性が高いターゲット広告を表示できます。\"},\r\n  \"kk-KZ\":{\"title\":\"Құпиялылығыңыз қандай cookie файл таңдағаныңызға байланысты болады\",\"description\":\"Біз және серіктестеріміз сізге ең жақсы оңтайландырылған онлайн тәжірибені беру, веб-сайт трафигін талдау және сізге дербестендірілген хабарландырулармен қызмет көрсету үшін cookie файлдарын пайдаланамыз. «Барлығын қабылдау және жабу» түймешігін басу арқылы барлық cookie файлын жинауға келісе аласыз немесе «Негізгі Cookie файлдарын қабылдау» түймешігін таңдау арқылы барлық маңызды емес cookie файлынан бас тарта аласыз, я болмаса «Cookie файлдарын басқару» түймешігін басу арқылы cookie файлы орнатуларын реттей аласыз. Сондай-ақ кез келген уақытта cookie файлдарына қатысты берген келісіміңізді қайтарып алуға немесе cookie файлы параметрлерін өзгертуге құқығыңыз бар. Ол үшін кез келген уақытта веб-сайтымыздың төменгі жағындағы немесе есептік жазба орнатуларындағы (егер болса) «Cookie файлдарын басқару» сілтемесін басыңыз. Қосымша ақпарат алу үшін <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=kk-KZ>Cookie саясатын</a> қараңыз.\",\"essential_title\":\"Негізгі cookie файлдары\",\"basic_title\":\"Негізгі аналитикалық cookie файлдары\",\"advanced_title\":\"Алдыңғы қатарлы аналитикалық cookie файлдары\",\"marketing_title\":\"Маркетингтік cookies файлдары\",\"btn_decline\":\"Тек маңызды cookie файлдарын қабылдау\",\"btn_back\":\"Артқа\",\"btn_accept_selected\":\"Таңдауларымды растау\",\"btn_accept\":\"Барлығын қабылдау және жабу\",\"btn_manage\":\"Cookie файлдарын басқару\",\"essential_text\":\"Осы бірінші тарап cookie файлдары веб-сайтымыздың және қажетті қызметтердің жұмыс істеуі мен қауіпсіздігін қамтамасыз ету үшін қажет. Олар әдетте cookie параметрлерін есте сақтау, кіру немесе заттарды арбада ұстап тұру сияқты белгілі бір функцияларды пайдалануға мүмкіндік беретін әрекеттеріңізге жауап ретінде орнатылады. Бұл cookie файлдарынан бас тарту мүмкін емес және оларды браузер арқылы блоктау сайттың функционалдығына әсер етуі мүмкін.\",\"basic_text\":\"Осы бірінші тарап cookie файлдары веб-сайтымызға келушілер/пайдаланушылар санын есептеуге және сенімді серіктестеріміздің көмегімен біріктірілген пайдалану және өнімділік статистикасын жасауға мүмкіндік береді. Біз оларды веб-сайт трафигі мен үгіт-насихат көрсеткіштері туралы негізгі мағлұмат алу үшін және веб-сайтымыздағы қателерді шешу үшін пайдаланамыз.\",\"advanced_text\":\"Бірінші немесе үшінші тараптың осы cookie файлдары веб-сайтымызбен және ұсынылатын әр қызметпен қалай қарым-қатынас жасайтыныңызды түсінуге көмектеседі, дерекқорымызды үшінші тарап құралдарынан алынған мәліметтермен байытады. Біз осы cookie файлдарын веб-сайтымызды, қызметтерімізді және пайдаланушыларға ыңғайлылығымызды жақсарту, қателерді немесе басқа мәселелерді табу және жою, сондай-ақ науқандарымыздың тиімділігін бағалау үшін қолданамыз. \",\"marketing_text\":\"Бұл үшінші тараптық cookie файлдары біздің маркетингтік серіктестерімізге сіздің мүдделеріңіз бен қажеттіліктеріңіз туралы білу және сізге неғұрлым өзекті мақсатты хабарландыруларды көрсету үшін біздің веб-сайтымыздағы кейбір әрекеттеріңізді (мысалы, біздің өнімімізді жүктеген немесе сатып алған кезде) қадағалауға мүмкіндік береді.\"},\r\n  \"ko-KR\":{\"title\":\"쿠키 선택 사항, 개인 정보 보호\",\"description\":\"당사와 당사의 파트너는 쿠키를 사용하여 최적의 온라인 환경을 제공하고, 웹 사이트 트래픽을 분석하고, 개인화된 광고를 제공합니다. '모두 수락 및 닫기'를 클릭하여 모든 쿠키 수집에 동의하거나 '필수 쿠키만 수락'을 선택하여 필수가 아닌 쿠키를 모두 거부하거나 '쿠키 관리'를 클릭하여 쿠키 설정을 조정할 수 있습니다. 또한 웹 사이트 바닥글 또는 계정 설정(사용 가능한 경우)에서 '쿠키 관리' 링크를 클릭하여 언제든지 동의를 철회하거나 쿠키 기본 설정을 변경할 권한이 있습니다. 자세한 내용은 <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ko-KR>쿠키 정책</a>을 참조하십시오.\",\"essential_title\":\"필수 쿠키\",\"basic_title\":\"기본 분석 쿠키\",\"advanced_title\":\"고급 분석 쿠키\",\"marketing_title\":\"마케팅 쿠키\",\"btn_decline\":\"필수 쿠키만 수락\",\"btn_back\":\"뒤로\",\"btn_accept_selected\":\"선택 확인\",\"btn_accept\":\"모두 수락 및 닫기\",\"btn_manage\":\"쿠키 관리\",\"essential_text\":\"이러한 자사 쿠키는 당사 웹 사이트의 기능 및 보안과 귀하에게 필요한 서비스에 필요합니다. 해당 쿠키는 일반적으로 쿠키 기본 설정 기억, 로그인 또는 장바구니에 항목을 보관하는 등 특정 기능을 사용할 수 있도록 작업에 대한 응답으로 설정됩니다. 이러한 쿠키를 수신 거부할 수 없으며 브라우저를 통해 쿠키를 차단하면 사이트 기능에 영향을 줄 수 있습니다.\",\"basic_text\":\"이러한 자사 쿠키를 사용하면 웹 사이트의 방문자/사용자 수를 측정하고 신뢰할 수 있는 파트너의 도움을 받아 집계된 사용 및 성능 통계를 생성할 수 있습니다. 당사는 웹 사이트 트래픽과 캠페인 성과에 대한 기본적인 통찰력을 얻고 웹 사이트의 버그를 해결하기 위해 이를 사용합니다.\",\"advanced_text\":\"이러한 자사 또는 타사 쿠키는 타사 도구의 데이터로 데이터 집합을 보강하여 당사 웹 사이트 및 제공되는 각 서비스와 상호 작용하는 방식을 이해할 수 있도록 도와줍니다. 당사는 이러한 쿠키를 사용하여 웹 사이트, 서비스 및 사용자 환경을 개선하고 버그 또는 기타 문제를 찾아 해결하며 캠페인의 효과를 평가합니다. \",\"marketing_text\":\"당사의 마케팅 파트너는 이러한 타사 쿠키를 통해 당사 웹 사이트에서 귀하의 일부 활동을 추적하여(예: 귀하가 당사 제품을 다운로드하거나 구매할 때) 귀하의 관심사와 요구에 대해 알아보고 관련성이 있는 타겟 광고를 게재할 수 있습니다.\"},\r\n  \"lv-LV\":{\"title\":\"Jūsu sīkfailu izvēle, jūsu konfidencialitāte\",\"description\":\"Mūsu uzņēmums un mūsu partneri izmanto sīkfailus, lai nodrošinātu jums vislabāko optimizēto pieredzi tiešsaistē, analizētu mūsu tīmekļa vietnes datplūsmu un rādītu jums personalizētas reklāmas. Jūs varat piekrist visu sīkfailu vākšanai, noklikšķinot uz “Pieņemt visu un aizvērt”, noraidīt visus nebūtiskos sīkfailus, izvēloties “Pieņemt tikai būtiskos sīkfailus”, vai pielāgot sīkfailu iestatījumus, noklikšķinot uz “Pārvaldīt sīkfailus”. Jums ir arī tiesības jebkurā laikā atsaukt savu piekrišanu attiecībā uz sīkfailiem vai mainīt preferences attiecībā uz sīkfailiem, noklikšķinot uz saites “Pārvaldīt sīkfailus” mūsu tīmekļa vietnes kājenē vai konta iestatījumu sadaļā (ja tā ir pieejama). Papildinformāciju skatiet mūsu <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=lv-LV>sīkfailu politikā</a>.\",\"essential_title\":\"Būtiskie sīkfaili\",\"basic_title\":\"Pamata analītiskie sīkfaili\",\"advanced_title\":\"Papildu analītiskie sīkfaili\",\"marketing_title\":\"Mārketinga sīkfaili\",\"btn_decline\":\"Pieņemt tikai būtiskos sīkfailus\",\"btn_back\":\"Atpakaļ\",\"btn_accept_selected\":\"Apstiprināt manas izvēles\",\"btn_accept\":\"Pieņemt visu un aizvērt\",\"btn_manage\":\"Pārvaldīt sīkfailus\",\"essential_text\":\"Šie pirmās puses sīkfaili ir nepieciešami mūsu tīmekļa vietnes un jums nepieciešamo pakalpojumu darbības un drošības nodrošināšanai. Tie parasti tiek iestatīti, reaģējot uz jūsu darbībām, lai iespējotu noteiktas funkcijas izmantošanu, piemēram, atcerētos jūsu sīkfailu preferences, pieteikšanās informāciju vai saglabātu jūsu preces grozā. Jūs nevar atteikties no šiem sīkfailiem, un to bloķēšana, izmantojot pārlūkprogrammu, var ietekmēt vietnes funkcionalitāti.\",\"basic_text\":\"Šie pirmās puses sīkfaili sniedz iespēju noteikt mūsu tīmekļa vietnes apmeklētāju/lietotāju skaitu un izveidot apkopotu lietojuma un veiktspējas statistiku, izmantojot mūsu uzticamo partneru sniegto palīdzību. Mēs izmantojam šos sīkfailus, lai iegūtu pamata ieskatus par mūsu tīmekļa vietnes datplūsmu un kampaņu veiktspēju, kā arī, lai novērstu tīmekļa vietnes kļūdas.\",\"advanced_text\":\"Šie pirmās vai trešās puses sīkfaili palīdz mums izprast lietotāju mijiedarbību ar mūsu tīmekļa vietni un katru piedāvāto pakalpojumu, bagātinot mūsu datu kopas ar datiem no trešo pušu rīkiem. Mēs izmantojam šos sīkfailus, lai uzlabotu savu tīmekļa vietni, pakalpojumus un lietotāju pieredzi, atrastu un novērstu kļūdas vai citas problēmas un novērtētu savu kampaņu efektivitāti. \",\"marketing_text\":\"Šie trešo pušu sīkfaili ļauj mūsu mārketinga partneriem izsekot dažas no jūsu darbībām mūsu tīmekļa vietnē (piemēram, kad lejupielādējat vai iegādājaties mūsu produktu), lai uzzinātu par jūsu interesēm un vajadzībām un parādītu jums atbilstošākas mērķētas reklāmas.\"},\r\n  \"lt-LT\":{\"title\":\"Jūsų slapukų pasirinkimas, jūsų privatumas\",\"description\":\"Mes ir mūsų partneriai naudojame slapukus tam, kad suteiktume jums geriausią optimizuotą patirtį internete, analizuotume svetainės srautą ir teiktume jums pritaikytus skelbimus. Galite sutikti su visų slapukų rinkimu spustelėdami „Priimti visus ir uždaryti“, atmesti visus netechninius slapukus pasirinkdami „Priimti tik techninius slapukus“ arba koreguoti slapukų nustatymus spustelėdami „Tvarkyti slapukus“. Taip pat turite teisę bet kada atšaukti savo sutikimą arba pakeisti slapukų nustatymus spustelėdami nuorodą „Tvarkyti slapukus“ mūsų svetainės poraštėje arba savo paskyros nustatymuose (jei yra). Daugiau informacijos rasite mūsų <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=lt-LT>slapukų politikoje</a>.\",\"essential_title\":\"Techniniai slapukai\",\"basic_title\":\"Pagrindiniai veiklos slapukai\",\"advanced_title\":\"Išplėstiniai veiklos slapukai\",\"marketing_title\":\"Tiksliniai ar reklaminiai slapukai\",\"btn_decline\":\"Priimti tik techninius slapukus\",\"btn_back\":\"Atgal\",\"btn_accept_selected\":\"Patvirtinti mano pasirinkimus\",\"btn_accept\":\"Priimti visus ir uždaryti\",\"btn_manage\":\"Tvarkyti slapukus\",\"essential_text\":\"Šie slapukai yra būtini mūsų svetainės veikimui ir saugumui bei reikalingoms paslaugoms užtikrinti. Paprastai jie nustatomi atsižvelgiant į jūsų veiksmus, kad būtų galima naudotis tam tikromis funkcijomis, pvz., prisiminti jūsų slapukų nuostatas, prisijungti ar laikyti prekes krepšelyje. Negalite atsisakyti šių slapukų, o jų blokavimas naršyklėje gali turėti įtakos korektiškam svetainės veikimui.\",\"basic_text\":\"Šie pirmosios šalies slapukai leidžia įvertinti svetainės lankytojų skaičių ir, padedant patikimiems partneriams, kaupti naudojimo ir našumo statistiką. Juos naudojame norėdami gauti pagrindinę informaciją apie mūsų svetainės srautą ir našumą bei pašalinti klaidas svetainėje.\",\"advanced_text\":\"Šie slapukai padeda mums suprasti, kaip sąveikaujate su mūsų svetaine bei kiekviena siūloma paslauga, ir praturtina mūsų duomenų rinkinius trečiųjų šalių įrankių duomenimis. Šiuos slapukus naudojame norėdami patobulinti savo svetainę, paslaugas ir naudotojų patirtį, rasti ir išspręsti susijusias klaidas ar kitas problemas ir įvertinti kampanijų veiksmingumą. \",\"marketing_text\":\"Šie slapukai naudojami tam, kad rodytų reklaminius skelbimus, kurie turėtų būti įdomūs būtent Jums ir atitikti Jūsų interesus. Šie slapukai nerenka informacijos, leidžiančios atpažinti Svetainės lankytoją. Šie slapukai gali būti išjungti, o reklaminiai skelbimai nebus rodomi.\"},\r\n  \"nn-NO\":{\"title\":\"Ditt valg av informasjonskapsler – ditt personvern\",\"description\":\"Vi og partnerne våre bruker informasjonskapsler for å gi deg den best optimaliserte nettopplevelsen, analysere trafikken på nettstedet vårt og vise deg personlig tilpassede annonser. Du kan godta innsamling av alle informasjonskapsler ved å klikke på «Godta alle og lukk», avvise alle ikke-essensielle informasjonskapsler ved å velge «Godta kun essensielle informasjonskapsler» eller justere oppsettene for informasjonskapsler ved å klikke på «Administrer informasjonskapsler». Du har også rett til å trekke tilbake samtykket eller endre preferansene dine for informasjonskapsler når som helst ved å klikke på koblingen «Administrer informasjonskapsler» i bunnteksten på nettstedet vårt eller i kontooppsettene dine (dersom disse er tilgjengelige). For å få mer informasjon, se <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=nb-NO>retningslinjene våre for informasjonskapsler</a>.\",\"essential_title\":\"Viktige informasjonskapsler\",\"basic_title\":\"Grunnleggende analytiske informasjonskapsler\",\"advanced_title\":\"Avanserte analytiske informasjonskapsler\",\"marketing_title\":\"Markedsføringsinformasjonskapsler\",\"btn_decline\":\"Godta kun essensielle informasjonskapsler\",\"btn_back\":\"Tilbake\",\"btn_accept_selected\":\"Bekreft mine valg\",\"btn_accept\":\"Godta alle og lukk\",\"btn_manage\":\"Administrer informasjonskapsler\",\"essential_text\":\"Disse førsteparts informasjonskapslene er nødvendige for funksjonaliteten og sikkerheten til nettstedet vårt og tjenestene du trenger. De blir vanligvis angitt som følge av handlingene dine for å aktivere bruken av visse funksjoner, for eksempel for å huske preferansene dine for informasjonskapsler, logge på eller huske varer i handlekurven. Du kan ikke velge bort disse informasjonskapslene, og hvis du blokkerer dem via nettleseren, kan det påvirke nettstedets funksjonalitet.\",\"basic_text\":\"Med disse førsteparts informasjonskapslene kan vi måle antall besøkende / brukere av nettstedet vårt og lage sammenstilt bruks- og ytelsesstatistikk med hjelp fra våre betrodde partnere. Vi bruker dem til å få grunnleggende innsikt i nettstedstrafikken vår og kampanjeresultatene våre samt for å løse feil på nettstedet vårt.\",\"advanced_text\":\"Med disse første- eller tredjeparts informasjonskapslene kan vi forstå hvordan du samhandler med nettstedet vårt og de ulike tjenestene vi tilbyr, ved å berike datasettene våre med data fra tredjepartsverktøy. Vi bruker disse informasjonskapslene til å forbedre nettstedet vårt, tjenestene våre og brukeropplevelsen vår, finne og løse feil eller andre problemer samt evaluere effektiviteten av kampanjene våre. \",\"marketing_text\":\"Disse tredjeparts informasjonskapslene lar markedsføringspartnerne våre spore noen av aktivitetene dine på nettstedet vårt (for eksempel når du laster ned eller kjøper produktet vårt) for å lære om interessene og behovene dine og vise deg mer relevante målrettede annonser.\"},\r\n  \"nb-NO\":{\"title\":\"Ditt valg av informasjonskapsler – ditt personvern\",\"description\":\"Vi og partnerne våre bruker informasjonskapsler for å gi deg den best optimaliserte nettopplevelsen, analysere trafikken på nettstedet vårt og vise deg personlig tilpassede annonser. Du kan godta innsamling av alle informasjonskapsler ved å klikke på «Godta alle og lukk», avvise alle ikke-essensielle informasjonskapsler ved å velge «Godta kun essensielle informasjonskapsler» eller justere oppsettene for informasjonskapsler ved å klikke på «Administrer informasjonskapsler». Du har også rett til å trekke tilbake samtykket eller endre preferansene dine for informasjonskapsler når som helst ved å klikke på koblingen «Administrer informasjonskapsler» i bunnteksten på nettstedet vårt eller i kontooppsettene dine (dersom disse er tilgjengelige). For å få mer informasjon, se <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=nb-NO>retningslinjene våre for informasjonskapsler</a>.\",\"essential_title\":\"Viktige informasjonskapsler\",\"basic_title\":\"Grunnleggende analytiske informasjonskapsler\",\"advanced_title\":\"Avanserte analytiske informasjonskapsler\",\"marketing_title\":\"Markedsføringsinformasjonskapsler\",\"btn_decline\":\"Godta kun essensielle informasjonskapsler\",\"btn_back\":\"Tilbake\",\"btn_accept_selected\":\"Bekreft mine valg\",\"btn_accept\":\"Godta alle og lukk\",\"btn_manage\":\"Administrer informasjonskapsler\",\"essential_text\":\"Disse førsteparts informasjonskapslene er nødvendige for funksjonaliteten og sikkerheten til nettstedet vårt og tjenestene du trenger. De blir vanligvis angitt som følge av handlingene dine for å aktivere bruken av visse funksjoner, for eksempel for å huske preferansene dine for informasjonskapsler, logge på eller huske varer i handlekurven. Du kan ikke velge bort disse informasjonskapslene, og hvis du blokkerer dem via nettleseren, kan det påvirke nettstedets funksjonalitet.\",\"basic_text\":\"Med disse førsteparts informasjonskapslene kan vi måle antall besøkende / brukere av nettstedet vårt og lage sammenstilt bruks- og ytelsesstatistikk med hjelp fra våre betrodde partnere. Vi bruker dem til å få grunnleggende innsikt i nettstedstrafikken vår og kampanjeresultatene våre samt for å løse feil på nettstedet vårt.\",\"advanced_text\":\"Med disse første- eller tredjeparts informasjonskapslene kan vi forstå hvordan du samhandler med nettstedet vårt og de ulike tjenestene vi tilbyr, ved å berike datasettene våre med data fra tredjepartsverktøy. Vi bruker disse informasjonskapslene til å forbedre nettstedet vårt, tjenestene våre og brukeropplevelsen vår, finne og løse feil eller andre problemer samt evaluere effektiviteten av kampanjene våre. \",\"marketing_text\":\"Disse tredjeparts informasjonskapslene lar markedsføringspartnerne våre spore noen av aktivitetene dine på nettstedet vårt (for eksempel når du laster ned eller kjøper produktet vårt) for å lære om interessene og behovene dine og vise deg mer relevante målrettede annonser.\"},\r\n  \"pl-PL\":{\"title\":\"Twój wybór plików cookie, Twoja prywatność\",\"description\":\"Wraz z naszymi partnerami używamy plików cookie, aby zapewnić Ci optymalną obsługę online, analizować ruch na naszej stronie internetowej i dostarczać Ci spersonalizowane reklamy. Możesz zgodzić się na gromadzenie wszystkich plików cookie, klikając przycisk „Zaakceptuj wszystkie i zamknij”, odrzucić wszystkie niepotrzebne pliki cookie, wybierając opcję „Akceptuj tylko niezbędne pliki cookie”, lub dostosować ustawienia plików cookie, klikając link „Zarządzaj plikami cookie” w stopce naszej witryny lub w ustawieniach konta (jeśli są dostępne). Aby uzyskać więcej informacji, zapoznaj się z naszą <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=pl-PL>Polityką dotyczącą plików cookie</a>.\",\"essential_title\":\"Niezbędne pliki cookie\",\"basic_title\":\"Podstawowe analityczne pliki cookie\",\"advanced_title\":\"Zaawansowane analityczne pliki cookie\",\"marketing_title\":\"Marketingowe pliki cookie\",\"btn_decline\":\"Akceptuj tylko niezbędne pliki cookie\",\"btn_back\":\"Wstecz\",\"btn_accept_selected\":\"Potwierdź wybór\",\"btn_accept\":\"Zaakceptuj wszystkie i zamknij\",\"btn_manage\":\"Zarządzaj plikami cookie\",\"essential_text\":\"Własne pliki cookie są niezbędne do funkcjonowania i bezpieczeństwa naszej witryny oraz usług wymaganych przez użytkownika. Zazwyczaj są one ustawiane w odpowiedzi na działania użytkownika, aby umożliwić korzystanie z określonych funkcji, takich jak zapamiętywanie preferencji dotyczących plików cookie, logowanie lub przechowywanie produktów w koszyku. Nie można zrezygnować z tych plików cookie, a blokowanie ich przez przeglądarkę może negatywnie wpłynąć na funkcjonalność witryny.\",\"basic_text\":\"Własne pliki cookie umożliwiają nam pomiar liczby odwiedzających/użytkowników naszej strony internetowej i tworzenie zagregowanych statystyk użytkowania i wydajności z pomocą naszych zaufanych partnerów. Używamy ich, aby uzyskać podstawowy wgląd w ruch na naszej stronie i wydajność naszej kampanii oraz rozwiązywać błędy na naszej stronie internetowej.\",\"advanced_text\":\"Własne lub zewnętrzne pliki cookie pomagają nam rozumieć sposób interakcji użytkownika z naszą witryną i każdą oferowaną usługą przez wzbogacenie naszych zbiorów danych o dane pochodzące z narzędzi innych firm. Używamy tych plików cookie do ulepszania naszej witryny, usług i obsługi użytkownika, znajdowania i rozwiązywania błędów lub innych problemów oraz do oceny skuteczności naszych kampanii. \",\"marketing_text\":\"Zewnętrzne pliki cookie umożliwiają naszym partnerom marketingowym śledzenie niektórych działań użytkownika w naszej witrynie (na przykład podczas pobierania lub kupowania naszego produktu) w celu poznania jego zainteresowań i potrzeb oraz wyświetlania bardziej odpowiednich, ukierunkowanych reklam.\"},\r\n  \"pt-BR\":{\"title\":\"Sua escolha de cookies, sua privacidade\",\"description\":\"Nós e nossos parceiros usamos cookies para dar a você a melhor experiência on-line otimizada, analisar nosso tráfego de site e entregar a você anúncios personalizados. Você pode concordar com a coleta de todos os cookies clicando em 'Aceitar tudo e fechar', negar todos os cookies não essenciais escolhendo 'Aceitar apenas cookies essenciais' ou ajustar suas configurações de cookies clicando em 'Gerenciar cookies'. Você também tem o direito de retirar seu consentimento em relação aos cookies a qualquer momento clicando no link 'Gerenciar cookies' no rodapé do nosso site ou nas configurações da sua conta (se disponível). Para obter mais informações, consulte nossa <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=pt-BR>Política de Cookies</a>.\",\"essential_title\":\"Cookies essenciais\",\"basic_title\":\"Cookies analíticos básicos\",\"advanced_title\":\"Cookies analíticos avançados\",\"marketing_title\":\"Cookies de marketing\",\"btn_decline\":\"Aceitar apenas cookies essenciais\",\"btn_back\":\"Voltar\",\"btn_accept_selected\":\"Confirmar minha escolha\",\"btn_accept\":\"Aceitar tudo e fechar\",\"btn_manage\":\"Gerenciar cookies\",\"essential_text\":\"Esses cookies de primeira parte são necessários para o funcionamento e segurança de nosso site e para os serviços que você precisa. Normalmente eles são definidos em resposta a suas ações para permitir o uso de determinadas funcionalidades, como lembrar de suas preferências de cookies, entrar ou manter itens no seu carrinho. Não é possível optar por não coletar esses cookies, e bloqueá-los através de um navegador pode afetar a funcionalidade do site.\",\"basic_text\":\"Esses cookies de primeira parte nos permitem medir o número de visitantes/usuários de nosso site e criar estatísticas de uso e desempenho agregadas com a ajuda de nossos parceiros confiáveis. Usamos para obter informações básicas sobre o tráfego de nosso site e nosso desempenho de campanha e para resolver bugs em nosso site.\",\"advanced_text\":\"Esses cookies de primeira parte ou de terceiros nos ajudam a entender como você interage com nosso site e cada serviço oferecido, enriquecendo nossos conjuntos de dados com dados de ferramentas de terceiros. Usamos esses cookies para melhorar nosso site, serviços e experiência do usuário, encontrar e solucionar bugs ou outros problemas com eles, e avaliar a eficácia de nossas campanhas. \",\"marketing_text\":\"Esses cookies de terceiros permitem que nossos parceiros de marketing rastreiem algumas de suas atividades em nosso site (por exemplo, quando você faz download ou compra nosso produto) para aprender sobre seus interesses e necessidades e para mostrar a você anúncios direcionados mais relevantes.\"},\r\n  \"ro-RO\":{\"title\":\"Opțiunile dvs. pentru modulele cookie, confidențialitatea dvs.\",\"description\":\"Împreună cu partenerii noștri, folosim module cookie pentru a vă oferi cea mai bună experiență online optimizată, pentru a analiza traficul site-ului nostru web și pentru a vă prezenta reclame personalizate. Puteți fi de acord cu colectarea tuturor modulelor cookie făcând clic pe „Acceptare toate și închidere”, puteți să refuzați toate modulele cookie neesențiale făcând clic pe „Acceptare doar module cookie esențiale” sau puteți să ajustați setările privind modulele cookie făcând clic pe „Gestionare module cookie”. De asemenea, aveți dreptul să retrageți consimțământul sau să vă modificați preferințele pentru module cookie oricând, făcând clic pe linkul „Gestionare module cookie” din subsolul site-ului nostru web sau în setările contului dvs. (dacă opțiunea este disponibilă). Pentru mai multe informații, vă rugăm să consultați <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ro-RO>Politica noastră privind modulele cookie</a>.\",\"essential_title\":\"Module cookie esențiale\",\"basic_title\":\"Module cookie analitice de bază\",\"advanced_title\":\"Module cookie analitice avansate\",\"marketing_title\":\"Module cookie de marketing\",\"btn_decline\":\"Acceptare doar module cookie esențiale\",\"btn_back\":\"Înapoi\",\"btn_accept_selected\":\"Confirmare opțiuni\",\"btn_accept\":\"Acceptare toate și închidere\",\"btn_manage\":\"Gestionare module cookie\",\"essential_text\":\"Această categorie directă de module cookie sunt necesare pentru funcționarea și securitatea site-ului nostru web și a serviciilor de care aveți nevoie. Acestea sunt de obicei setate ca răspuns la acțiunile dvs., pentru a permite utilizarea anumitor funcționalități, cum ar fi memorarea preferințelor dvs. privind modulele cookie, conectarea sau păstrarea articolelor în coșul de cumpărături. Nu puteți renunța la aceste module cookie, iar blocarea lor prin intermediul unui browser poate afecta funcționarea optimă a site-ului.\",\"basic_text\":\"Această categorie directă de module cookie ne permit să măsurăm numărul de vizitatori/utilizatori ai site-ului nostru web și să creăm statistici agregate de utilizare și performanță, cu ajutorul partenerilor noștri de încredere. Le folosim pentru a obține informații de bază despre traficul de pe site-ul nostru web și performanța campaniei noastre și pentru a rezolva bug-uri pe site-ul nostru web.\",\"advanced_text\":\"Această categorie directă/ terță de module cookie ne ajută să înțelegem modul în care interacționați cu site-ul nostru web și cu fiecare serviciu oferit, completând seturile noastre de date cu date de la instrumente terțe. Utilizăm aceste module cookie pentru a ne îmbunătăți site-ul web, serviciile și experiența utilizatorului, pentru a găsi și rezolva bug-uri sau alte probleme cu acestea și pentru a evalua eficiența campaniilor noastre. \",\"marketing_text\":\"Această categorie terță de module cookie permite partenerilor noștri de marketing să urmărească unele dintre activitățile dvs. pe site-ul nostru web (de exemplu, atunci când descărcați sau cumpărați produsul nostru), pentru a afla mai multe despre interesele și nevoile dvs. și pentru a vă afișa reclame direcționate mai relevante.\"},\r\n  \"ro-MD\":{\"title\":\"Opțiunile dvs. pentru modulele cookie, confidențialitatea dvs.\",\"description\":\"Împreună cu partenerii noștri, folosim module cookie pentru a vă oferi cea mai bună experiență online optimizată, pentru a analiza traficul site-ului nostru web și pentru a vă prezenta reclame personalizate. Puteți fi de acord cu colectarea tuturor modulelor cookie făcând clic pe „Acceptare toate și închidere”, puteți să refuzați toate modulele cookie neesențiale făcând clic pe „Acceptare doar module cookie esențiale” sau puteți să ajustați setările privind modulele cookie făcând clic pe „Gestionare module cookie”. De asemenea, aveți dreptul să retrageți consimțământul sau să vă modificați preferințele pentru module cookie oricând, făcând clic pe linkul „Gestionare module cookie” din subsolul site-ului nostru web sau în setările contului dvs. (dacă opțiunea este disponibilă). Pentru mai multe informații, vă rugăm să consultați <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ro-RO>Politica noastră privind modulele cookie</a>.\",\"essential_title\":\"Module cookie esențiale\",\"basic_title\":\"Module cookie analitice de bază\",\"advanced_title\":\"Module cookie analitice avansate\",\"marketing_title\":\"Module cookie de marketing\",\"btn_decline\":\"Acceptare doar module cookie esențiale\",\"btn_back\":\"Înapoi\",\"btn_accept_selected\":\"Confirmare opțiuni\",\"btn_accept\":\"Acceptare toate și închidere\",\"btn_manage\":\"Gestionare module cookie\",\"essential_text\":\"Această categorie directă de module cookie sunt necesare pentru funcționarea și securitatea site-ului nostru web și a serviciilor de care aveți nevoie. Acestea sunt de obicei setate ca răspuns la acțiunile dvs., pentru a permite utilizarea anumitor funcționalități, cum ar fi memorarea preferințelor dvs. privind modulele cookie, conectarea sau păstrarea articolelor în coșul de cumpărături. Nu puteți renunța la aceste module cookie, iar blocarea lor prin intermediul unui browser poate afecta funcționarea optimă a site-ului.\",\"basic_text\":\"Această categorie directă de module cookie ne permit să măsurăm numărul de vizitatori/utilizatori ai site-ului nostru web și să creăm statistici agregate de utilizare și performanță, cu ajutorul partenerilor noștri de încredere. Le folosim pentru a obține informații de bază despre traficul de pe site-ul nostru web și performanța campaniei noastre și pentru a rezolva bug-uri pe site-ul nostru web.\",\"advanced_text\":\"Această categorie directă/ terță de module cookie ne ajută să înțelegem modul în care interacționați cu site-ul nostru web și cu fiecare serviciu oferit, completând seturile noastre de date cu date de la instrumente terțe. Utilizăm aceste module cookie pentru a ne îmbunătăți site-ul web, serviciile și experiența utilizatorului, pentru a găsi și rezolva bug-uri sau alte probleme cu acestea și pentru a evalua eficiența campaniilor noastre. \",\"marketing_text\":\"Această categorie terță de module cookie permite partenerilor noștri de marketing să urmărească unele dintre activitățile dvs. pe site-ul nostru web (de exemplu, atunci când descărcați sau cumpărați produsul nostru), pentru a afla mai multe despre interesele și nevoile dvs. și pentru a vă afișa reclame direcționate mai relevante.\"},\r\n  \"ru-RU\":{\"title\":\"Ваши настройки для файлов cookie — ваша конфиденциальность\",\"description\":\"Мы и наши партнеры используем файлы cookie, чтобы обеспечить для вас оптимальную работу в Интернете, анализировать трафик нашего веб-сайта и показывать вам персонализированную рекламу. Вы можете разрешить сбор всех файлов cookie, щелкнув 'Принять все и закрыть', отклонить все файлы cookie, кроме базовых, выбрав 'Принять только базовые файлы cookie', или настроить параметры файлов cookie, щелкнув 'Управлять файлами cookie'. Кроме того, вы можете в любой момент отозвать свое разрешение или изменить параметры файлов cookie, перейдя по ссылке 'Управлять файлами cookie' в нижней части нашего веб-сайта или в настройках вашей учетной записи (при наличии). Дополнительные сведения можно найти в нашей <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ru-RU>политике в отношении файлов cookie</a>.\",\"essential_title\":\"Базовые файлы cookie\",\"basic_title\":\"Основные аналитические файлы cookie\",\"advanced_title\":\"Расширенные аналитические файлы cookie\",\"marketing_title\":\"Маркетинговые файлы cookie\",\"btn_decline\":\"Принять только базовые файлы cookie\",\"btn_back\":\"Назад\",\"btn_accept_selected\":\"Подтвердить мой выбор\",\"btn_accept\":\"Принять все и закрыть\",\"btn_manage\":\"Управлять файлами cookie\",\"essential_text\":\"Эти основные файлы cookie нужны для работы и защиты нашего веб-сайта и необходимых вам служб. Обычно они устанавливаются в ответ на ваши действия, чтобы обеспечить использование определенных функций, таких как запоминание ваших настроек cookie, авторизация или хранение элементов в корзине покупателя. От таких файлов cookie отказаться нельзя, а их блокировка через браузер может негативно повлиять на работу сайта.\",\"basic_text\":\"Эти основные файлы cookie позволяют нам измерять количество посетителей/пользователей нашего веб-сайта и создавать комплексную статистику использования и работоспособности с помощью наших надежных партнеров. Мы используем их для получения базового представления о трафике нашего веб-сайта и эффективности наших кампаний, а также для устранения ошибок на нашем веб-сайте.\",\"advanced_text\":\"Эти основные или сторонние файлы cookie дополняют наши наборы данных данными из сторонних средств и помогают нам понять, как вы взаимодействуете с нашим веб-сайтом и каждой из предлагаемых служб. Мы используем эти файлы cookie для улучшения нашего веб-сайта, служб и пользовательского опыта, для поиска и устранения ошибок и других проблем, а также для оценки эффективности наших кампаний. \",\"marketing_text\":\"Эти сторонние файлы cookie позволяют нашим маркетинговым партнерам отслеживать некоторые ваши действия на нашем веб-сайте (например, когда вы загружаете или покупаете наш продукт), чтобы узнать о ваших интересах и потребностях и показывать вам более актуальную целевую рекламу.\"},\r\n  \"sr-Latn-RS\":{\"title\":\"Vaš izbor kolačića, vaša privatnost\",\"description\":\"Mi i naši partneri koristimo kolačiće da bismo vam pružili najbolje optimizovano iskustvo na mreži, za analizu saobraćaja naše veb-lokacije i prikazivanje personalizovanih oglasa. Možete da prihvatite prikupljanje svih kolačića klikom na „Prihvati sve i zatvori“, da odbijete sve kolačiće koji nisu osnovni kolačići tako što ćete izabrati „Prihvati samo osnovne kolačiće“ ili da prilagodite podešavanja kolačića klikom na „Upravljanje kolačićima“. Takođe imate pravo da opozovete svoju saglasnost za kolačiće u bilo kom trenutku klikom na vezu „Upravljanje kolačićima“ u podnožju naše veb-lokacije ili u podešavanjima naloga (ako je dostupno). Više informacija potražite u delu <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sr-Latn-RS>Smernice u vezi sa kolačićima</a>.\",\"essential_title\":\"Osnovne kolačiće\",\"basic_title\":\"Osnovne analitičke kolačiće\",\"advanced_title\":\"Napredne analitičke kolačiće\",\"marketing_title\":\"Marketinške kolačiće\",\"btn_decline\":\"Prihvati samo osnovne kolačiće\",\"btn_back\":\"Nazad\",\"btn_accept_selected\":\"Potvrdi moj izbor\",\"btn_accept\":\"Prihvati sve i zatvori\",\"btn_manage\":\"Upravljanje kolačićima\",\"essential_text\":\"Ovi kolačići prve strane su neophodni za funkcionisanje i bezbednost naše veb-lokacije i usluga koje su vam potrebne. Obično se postavljaju kao odgovor na radnje koje ste obavili kako bi se omogućilo korišćenje određenih funkcionalnosti, kao što su beleženje vaših preferenci za kolačiće, prijavljivanje ili držanje stavki u korpi za kupovinu. Ne možete da odbijete ove kolačiće, a njihovo blokiranje preko pregledača može da utiče na funkcionalnost lokacije.\",\"basic_text\":\"Ovi kolačići prve strane nam omogućavaju da izmerimo broj posetilaca/korisnika naše veb-lokacije i kreiramo zbirnu statistiku korišćenja i učinka uz pomoć naših pouzdanih partnera. Koristimo ih da bismo dobili uvid u saobraćaj na našoj veb-lokaciji i učinak kampanje, kao i da bismo otklonili greške na našoj veb-lokaciji.\",\"advanced_text\":\"Ovi kolačići prve ili treće strane pomažu nam da razumemo način na koji komunicirate sa našom veb-lokacijom i svakom ponuđenom uslugom. Na taj način dobijamo podatke od alatki trećih strana koji obogaćuju naše skupove podataka. Ove kolačiće koristimo kako bismo poboljšali našu veb-lokaciju, usluge i korisničko iskustvo, pronašli i otklonili greške ili druge probleme sa njima i procenili efikasnost naših kampanja. \",\"marketing_text\":\"Ovi kolačići trećih strana omogućavaju našim marketinškim partnerima da prate neke od vaših aktivnosti na našoj veb-lokaciji (na primer, kada preuzmete ili kupite naš proizvod) kako bi se upoznali sa vašim interesovanjima i potrebama, i prikazali vam relevantnije ciljane oglase.\"},\r\n  \"sk-SK\":{\"title\":\"Váš výber súborov cookie, vaše súkromie\",\"description\":\"Spolu s partnermi používame súbory cookie s cieľom poskytnúť vám čo najlepšie optimalizované online prostredie, analyzovať návštevnosť stránky a ponúknuť vám prispôsobené reklamy. Zbieranie všetkých súborov cookie môžete odsúhlasiť kliknutím na tlačidlo „Prijať všetko a zavrieť“, všetky voliteľné súbory cookie môžete odmietnuť výberom možnosti „Prijať iba základné súbory cookie“ alebo môžete upraviť ich nastavenie kliknutím na možnosť „Spravovať súbory cookie“. Udelený súhlas s používaním súborov cookie môžete kedykoľvek zrušiť alebo svoj výber upraviť, a to kliknutím na odkaz „Spravovať súbory cookie“ uvedený v spodnej časti našej webovej stránky, prípadne v nastaveniach účtu. Viac informácií nájdete v dokumente <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sk-SK>Zásady používania súborov cookie</a>.\",\"essential_title\":\"Základné súbory cookie\",\"basic_title\":\"Základné analytické súbory cookie\",\"advanced_title\":\"Rozšírené analytické súbory cookie\",\"marketing_title\":\"Marketingové súbory cookie\",\"btn_decline\":\"Prijať iba základné súbory cookie\",\"btn_back\":\"Späť\",\"btn_accept_selected\":\"Potvrdiť môj výber\",\"btn_accept\":\"Prijať všetko a zavrieť\",\"btn_manage\":\"Spravovať súbory cookie\",\"essential_text\":\"Tieto súbory cookie prvej strany sú nevyhnutné na správne fungovanie a zabezpečenie webovej stránky a požadovaných služieb. Zvyčajne sa nastavia na základe vašej akcie a umožňujú využívanie funkcií, ako je napríklad zapamätanie si preferencií pre cookies, prihlásenie či uloženie položiek v nákupnom košíku. Stránka si vyžaduje súhlas s týmito súbormi cookie, ich blokovanie v prehliadači môže ovplyvniť funkčnosť nášho webu.\",\"basic_text\":\"Tieto súbory cookie prvej strany nám umožňujú merať počet návštevníkov/používateľov našej webovej stránky a vytvárať agregované štatistiky používania a výkonnosti s pomocou našich dôveryhodných partnerov. Používame ich na to, aby sme získali základný prehľad o návštevnosti nášho webu a účinnosti našich kampaní, ako aj na riešenie chýb na našej webovej stránke.\",\"advanced_text\":\"Tieto súbory cookie prvej alebo tretej strany nám poskytujú prehľad o tom, ako návštevníci pracujú s webovou stránkou a ponúkanými službami, a to vďaka rozširovaniu našich dát o údaje z nástrojov tretích strán. Používame ich na zlepšovanie nášho webu, služieb a používateľského prostredia, na hľadanie a riešenie chýb či iných súvisiacich problémov, ako aj na vyhodnocovanie účinnosti našich kampaní. \",\"marketing_text\":\"Tieto súbory cookie tretích strán umožňujú našim marketingovým partnerom sledovať niektoré činnosti na našej stránke (napríklad keď sťahujete alebo kupujete náš produkt), aby sa vám zobrazovali cielenejšie reklamy na základe vašich potrieb.\"},\r\n  \"sl-SI\":{\"title\":\"Vaša izbira piškotkov, vaša zasebnost\",\"description\":\"Mi in naši partnerji uporabljamo piškotke, da vam zagotovimo najoptimalnejšo izkušnjo v spletu, analiziramo promet našega spletnega mesta ter vam prikazujemo prilagojene oglase. Lahko privolite v zbiranje vseh piškotkov tako, da kliknete možnost »Sprejmi vse in zapri«, zavrnete vse neosnovne piškotke tako, da kliknete »Sprejmi samo osnovne piškotke«, ali pa prilagodite nastavitve piškotkov tako, da kliknete »Upravljanje piškotkov«. Svojo privolitev glede piškotkov imate pravico kadar koli preklicati ali spremeniti nastavitve piškotkov tako, da kliknete povezavo za »Upravljanje piškotkov« v nogi našega spletnega mesta ali v nastavitvah računa (če je na voljo). Za več informacij si oglejte naš <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sl-SI>pravilnik o piškotkih</a>.\",\"essential_title\":\"Osnovni piškotki\",\"basic_title\":\"Osnovni analitični piškotki\",\"advanced_title\":\"Napredni analitični piškotki\",\"marketing_title\":\"Marketinški piškotki\",\"btn_decline\":\"Sprejmi samo osnovne piškotke\",\"btn_back\":\"Nazaj\",\"btn_accept_selected\":\"Potrdi moje izbire\",\"btn_accept\":\"Sprejmi vse in zapri\",\"btn_manage\":\"Upravljanje piškotkov\",\"essential_text\":\"Ti lastni piškotki so potrebni za delovanje in varnost našega spletnega mesta in storitev, ki jih potrebujete. Običajno so nastavljeni kot odgovor na vaša dejanja, da omogočijo uporabo določene funkcije, kot je pomnjenje vaših nastavitev piškotkov, prijava ali hranjenje izdelkov v košarici. Teh piškotkov ne morete onemogočiti, njihovo blokiranje prek brskalnika pa lahko vpliva na delovanje spletnega mesta.\",\"basic_text\":\"Ti lastni piškotki nam omogočajo merjenje števila obiskovalcev/uporabnikov našega spletnega mesta ter ustvarjanje zbirne statistike uporabe in uspešnosti s pomočjo naših zaupanja vrednih partnerjev. Uporabljamo jih, da bi dobili osnovni vpogled v promet na našem spletnem mestu in uspešnost naše kampanje ter za reševanje napak na našem spletnem mestu.\",\"advanced_text\":\"Ti lastni piškotki ali piškotki drugih ponudnikov nam pomagajo razumeti, kako uporabljate naše spletno mesto in posamezno zagotovljeno storitev, in sicer z obogatitvijo naših naborov podatkov z orodji drugih ponudnikov. Te piškotke uporabljamo za izboljšanje svojega spletnega mesta, storitev in uporabniške izkušnje, iskanje in odpravljanje napak ali drugih težav s spletnim mestom ali storitvami ter ocenjevanje učinkovitosti naših kampanj. \",\"marketing_text\":\"Ti piškotki drugih ponudnikov omogočajo našim partnerjem pri trženju, da spremljajo nekatere vaše dejavnosti na našem spletnem mestu (npr. prenos ali nakup našega izdelka), s čimer pridobijo več informacij o vaših interesih in potrebah ter vam lahko prikazujejo ustreznejše ciljane oglase.\"},\r\n  \"es-CL\":{\"title\":\"Su elección de cookies, su privacidad\",\"description\":\"Tanto nosotros como nuestros socios usamos cookies para ofrecerle la mejor experiencia optimizada en línea, para analizar el tráfico de nuestro sitio web y para mostrarle anuncios personalizados. Para aceptar la recopilación de todas las cookies, haga clic en 'Aceptar todas y cerrar'; para rechazar todas las cookies que no son esenciales, seleccione 'Aceptar solo las cookies esenciales'; para ajustar la configuración de sus cookies, haga clic en 'Administrar cookies'. También tiene derecho a revocar su consentimiento o cambiar su preferencia de cookies en cualquier momento al hacer clic en el enlace 'Administrar cookies' en el pie de página de nuestro sitio web o en la configuración de su cuenta (si está disponible). Para obtener más información, consulte nuestra <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=es-CL>Política de cookies</a>.\",\"essential_title\":\"Cookies esenciales\",\"basic_title\":\"Cookies analíticas básicas\",\"advanced_title\":\"Cookies analíticas avanzadas\",\"marketing_title\":\"Cookies de marketing\",\"btn_decline\":\"Aceptar únicamente las cookies esenciales\",\"btn_back\":\"Atrás\",\"btn_accept_selected\":\"Confirmar mis elecciones\",\"btn_accept\":\"Aceptar todas y cerrar\",\"btn_manage\":\"Administrar perfiles\",\"essential_text\":\"Estas cookies de terceros son necesarias para el funcionamiento y la seguridad de nuestro sitio web y los servicios que usted solicite. Normalmente se crean en respuesta a sus acciones y permiten el uso de determinadas funciones, como recordar sus preferencias de cookies, iniciar sesión o añadir elementos a su carrito de compras. No puede excluir estas cookies, y bloquearlas desde un navegador podría afectar a la funcionalidad del sitio.\",\"basic_text\":\"Estas cookies de terceros nos permiten evaluar el número de visitantes o usuarios de nuestro sitio web, así como crear estadísticas de uso y rendimiento agregadas con la ayuda de nuestros socios de confianza. Las usamos para obtener información básica sobre el tráfico de sitios web y el rendimiento de la campaña y para resolver errores en nuestro sitio web.\",\"advanced_text\":\"Estas cookies directas o de terceros nos ayudan a comprender cómo interactúa usted con nuestro sitio web y con los servicios que ofrecemos complementando nuestros conjuntos de datos con datos obtenidos de herramientas de terceros. Usamos estas cookies para mejorar nuestro sitio web, nuestros servicios y la experiencia que le brindamos como usuario, para encontrar y resolver errores u otros problemas con ellos, y para evaluar la eficacia de nuestras campañas. \",\"marketing_text\":\"Estas cookies de terceros permiten a nuestros socios de marketing hacer un seguimiento de algunas de sus actividades en nuestro sitio web (por ejemplo, cuando descarga o compra nuestro producto), obtener más información sobre sus intereses y necesidades, y mostrarle anuncios dirigidos más relevantes.\"},\r\n  \"es-ES\":{\"title\":\"Su elección de cookies, su privacidad\",\"description\":\"Tanto nosotros como nuestros socios usamos cookies para ofrecer la experiencia en línea más optimizada posible, analizar el tráfico de nuestro sitio web y mostrarle anuncios personalizados. Para aceptar la recopilación de todas las cookies, haga clic en 'Aceptar todo y cerrar'; para rechazar todas las cookies que no sean esenciales, haga clic en 'Aceptar solo las cookies esenciales'; y para ajustar la configuración de las cookies, haga clic en 'Administrar cookies'. También tiene derecho a revocar su consentimiento y a cambiar sus preferencias para las cookies en cualquier momento. Para ello, haga clic en el vínculo 'Administrar cookies' ubicado en el pie de página de nuestro sitio web o en la configuración de su cuenta (si está disponible). Para obtener más información, consulte nuestra <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=es-ES>Política de cookies</a>.\",\"essential_title\":\"Cookies esenciales\",\"basic_title\":\"Cookies analíticas básicas\",\"advanced_title\":\"Cookies analíticas avanzadas\",\"marketing_title\":\"Cookies de marketing\",\"btn_decline\":\"Aceptar solo las cookies esenciales\",\"btn_back\":\"Atrás\",\"btn_accept_selected\":\"Confirmar mis elecciones\",\"btn_accept\":\"Aceptar todo y cerrar\",\"btn_manage\":\"Administrar cookies\",\"essential_text\":\"Estas cookies de origen son necesarias para el funcionamiento y la seguridad de nuestro sitio web y los servicios que usted necesita. Normalmente se establecen en respuesta a sus acciones para permitir el uso de determinadas funciones, como recordar sus preferencias de cookies, iniciar sesión o mantener elementos en su carro de la compra. No puede excluir estas cookies, y bloquearlas en el navegador podría afectar a la funcionalidad del sitio.\",\"basic_text\":\"Estas cookies de origen nos permiten medir el número de visitantes/usuarios de nuestro sitio web, así como crear estadísticas de uso y rendimiento agregadas con la ayuda de nuestros socios de confianza. Las usamos para obtener información básica sobre el tráfico de nuestro sitio web y el rendimiento de nuestras campañas, y para resolver errores en nuestro sitio web.\",\"advanced_text\":\"Estas cookies de origen o de terceros nos ayudan a entender cómo interactúa con nuestro sitio web y con cada servicio ofrecido al completar nuestros conjuntos de datos con datos procedentes de herramientas de terceros. Usamos estas cookies para mejorar nuestro sitio web, nuestros servicios y nuestra experiencia de usuario, encontrar y resolver errores u otros problemas en ellos, y evaluar la eficacia de nuestras campañas. \",\"marketing_text\":\"Estas cookies de terceros permiten a nuestros socios de marketing realizar un seguimiento de algunas de sus actividades en nuestro sitio web (por ejemplo, descargar o comprar nuestro producto) para obtener más información sobre sus intereses y necesidades, y para mostrarle anuncios dirigidos más pertinentes.\"},\r\n  \"sv-SE\":{\"title\":\"Ditt val av cookies, din integritet\",\"description\":\"Vi och våra partner använder cookies för att ge dig den bästa optimerade onlineupplevelsen, analysera vår webbplatstrafik och visa anpassade annonser. Du kan godkänna insamlingen av alla cookies genom att klicka på Godkänn alla och stäng, neka alla icke-nödvändiga cookies genom att välja Godkänn endast nödvändiga cookies eller justera dina cookieinställningar genom att klicka på Hantera cookies. Du har även rätt att återkalla ditt samtycke till cookies eller ändra dina cookiepreferenser när som helst genom att klicka på länken Hantera cookies i webbplatsens sidfot eller i kontoinställningarna (om dessa är tillgängliga). För mer information, se vår <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sv-SE>cookiepolicy</a>.\",\"essential_title\":\"Viktiga cookies\",\"basic_title\":\"Grundläggande analytiska cookies\",\"advanced_title\":\"Avancerade analytiska cookies\",\"marketing_title\":\"Marknadsföringscookies\",\"btn_decline\":\"Godkänn endast nödvändiga cookies\",\"btn_back\":\"Bakåt\",\"btn_accept_selected\":\"Bekräfta mina val\",\"btn_accept\":\"Godkänn alla och stäng\",\"btn_manage\":\"Hantera cookies\",\"essential_text\":\"Dessa förstapartscookies är nödvändiga för att vår webbplats och de tjänster du behöver ska fungera och vara säkra. De ställs vanligtvis in som svar på dina åtgärder för att möjliggöra användning av vissa funktioner, till exempel att komma ihåg dina cookieinställningar, logga in eller behålla artiklar i kundvagnen. Du kan inte välja bort dessa cookies, och att blockera dem via en webbläsare kan påverka webbplatsens funktionalitet.\",\"basic_text\":\"Dessa förstapartscookies gör det möjligt för oss att mäta antalet besökare/användare på vår webbplats och skapa aggregerad användnings- och prestandastatistik med hjälp av våra betrodda partners. Vi använder detta för att få en grundläggande inblick i vår webbplatstrafik och våra kampanjer samt för att korrigera fel på vår webbplats.\",\"advanced_text\":\"Dessa första- eller tredjepartscookies hjälper oss att förstå hur du interagerar med vår webbplats och varje erbjuden tjänst genom att berika våra datamängder med data från tredjepartsverktyg. Vi använder dessa cookies för att förbättra vår webbplats, våra tjänster och användarupplevelse, hitta och lösa buggar eller andra problem med dem och utvärdera våra kampanjers effektivitet. \",\"marketing_text\":\"Dessa tredjepartscookies gör det möjligt för våra marknadsföringspartner att spåra vissa av dina aktiviteter på vår webbplats (till exempel när du laddar ned eller köper vår produkt), för att lära sig om dina intressen och behov och för att visa dig mer relevanta riktade annonser.\"},\r\n  \"th-TH\":{\"title\":\"ตัวเลือกคุกกี้ส่งผลต่อความเป็นส่วนตัวของคุณ\",\"description\":\"เราและพาร์ทเนอร์ของเราใช้คุกกี้เพื่อมอบประสบการณ์ออนไลน์ที่ดีที่สุดให้แก่คุณ วิเคราะห์การเข้าชมเว็บไซต์ของเรา และแสดงโฆษณาที่เกี่ยวข้องกับความสนใจของคุณ คุณสามารถยอมรับการเก็บรวบรวมคุกกี้ได้โดยคลิก 'ยอมรับทั้งหมดและปิด', ปฏิเสธคุกกี้ที่ไม่จำเป็นทั้งหมดโดยเลือก 'ยอมรับคุกกี้ที่จำเป็นเท่านั้น' หรือปรับการตั้งค่าคุกกี้ของคุณโดยคลิกที่ 'จัดการคุกกี้' นอกจากนี้คุณยังมีสิทธิยกเลิกการยินยอมหรือเปลี่ยนการตั้งค่าคุกกี้เมื่อใดก็ได้โดยคลิกที่ลิงก์ 'จัดการคุกกี้' ในส่วนท้ายของหน้าเว็บไซต์ของเราหรือในการตั้งค่าบัญชีของคุณ (หากมี) สำหรับข้อมูลเพิ่มเติมโปรดดู<a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=th-TH>นโยบายคุกกี้</a>ของเรา\",\"essential_title\":\"คุกกี้ที่จำเป็น\",\"basic_title\":\"คุกกี้เชิงวิเคราะห์ขั้นพื้นฐาน\",\"advanced_title\":\"คุกกี้เชิงวิเคราะห์ขั้นสูง\",\"marketing_title\":\"คุกกี้เพื่อการตลาด\",\"btn_decline\":\"ยอมรับคุกกี้ที่จำเป็นเท่านั้น\",\"btn_back\":\"ย้อนกลับ\",\"btn_accept_selected\":\"ยืนยันการตั้งค่าของฉัน\",\"btn_accept\":\"ยอมรับทั้งหมดและปิด\",\"btn_manage\":\"จัดการคุกกี้\",\"essential_text\":\"คุกกี้ของเราเหล่านี้เป็นสิ่งจำเป็นสำหรับการทำงานและความปลอดภัยของเว็บไซต์ของเรารวมถึงบริการที่คุณต้องการ โดยปกติแล้วระบบจะตั้งค่าคุกกี้เหล่านี้ให้ตอบสนองต่อการกระทำของคุณเพื่อให้ใช้ฟังก์ชันการทำงานบางอย่างได้ เช่น การจดจำการตั้งค่าคุกกี้ของคุณ การเข้าสู่ระบบ หรือการเก็บสินค้าไว้ในรถเข็น เป็นต้น คุณไม่สามารถเลือกไม่รับคุกกี้เหล่านี้ได้ และการบล็อกคุกกี้นี้ผ่านเบราว์เซอร์อาจส่งผลต่อการทำงานของเว็บไซต์\",\"basic_text\":\"คุกกี้ของเราเหล่านี้ช่วยให้เราสามารถวัดจำนวนผู้เข้าชม/ผู้ใช้เว็บไซต์ของเราและสร้างสถิติการใช้งานและประสิทธิภาพโดยรวมด้วยความช่วยเหลือจากพาร์ทเนอร์ที่เชื่อถือได้ของเรา เราใช้คุกกี้เหล่านี้เพื่อรับข้อมูลเชิงลึกขั้นพื้นฐานเกี่ยวกับการเข้าชมเว็บไซต์และประสิทธิภาพของแคมเปญของเรา รวมถึงเพื่อแก้ปัญหาข้อบกพร่องในเว็บไซต์ของเรา\",\"advanced_text\":\"คุกกี้ของเราหรือพาร์ทเนอร์เหล่านี้ช่วยให้เราเข้าใจลักษณะที่คุณใช้งานเว็บไซต์ของเราและบริการแต่ละรายการที่นำเสนอด้วยการนำข้อมูลจากเครื่องมือของพาร์ทเนอร์มาเสริมให้ชุดข้อมูลของเรา เราใช้คุกกี้เหล่านี้เพื่อปรับปรุงเว็บไซต์ บริการ และประสบการณ์ใช้งานของผู้ใช้ รวมถึงใช้ในการค้นหาและแก้ไขข้อบกพร่องหรือปัญหาอื่นๆ ที่เกิดขึ้น ตลอดจนประเมินประสิทธิภาพของแคมเปญของเรา \",\"marketing_text\":\"คุกกี้ของพาร์ทเนอร์ช่วยให้ทีมงานการตลาดของเราสามารถติดตามกิจกรรมบางอย่างของคุณขณะใช้งานเว็บไซต์ของเรา (ตัวอย่างเช่น เมื่อคุณดาวน์โหลดหรือซื้อผลิตภัณฑ์ของเรา) เพื่อเรียนรู้เกี่ยวกับความสนใจและความต้องการของคุณ และแสดงโฆษณาได้ตรงตามความต้องการของคุณได้ดียิ่งขึ้น\"},\r\n  \"tr-TR\":{\"title\":\"Sizin çerez seçiminiz, sizin gizliliğiniz\",\"description\":\"İş ortaklarımızla birlikte, sizin için en iyi şekilde optimize edilmiş bir çevrimiçi deneyim sunmak, web sitesi trafiğimizi analiz etmek ve size kişiselleştirilmiş reklamlar sunmak için çerezleri kullanırız. 'Tümünü kabul et ve kapat' seçeneğini tıklayarak tüm çerezlerin toplanmasını kabul edebilir, 'Yalnızca gerekli çerezleri kabul et' seçeneğini tıklayarak gerekli olmayan tüm çerezleri reddedebilir veya 'Çerezleri yönet' seçeneğini tıklayarak çerez ayarlarınızı yapabilirsiniz. Ayrıca dilediğiniz zaman web sitemizin altbilgi bölümünde 'Çerezleri yönet' bağlantısını tıklayarak veya hesap ayarlarınızda (varsa) çerezlere verdiğiniz onayı geri çekebilir ya da çerez tercihlerinizi değiştirebilirsiniz. Daha fazla bilgi için <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=tr-TR>Çerez Politikamıza</a> bakın.\",\"essential_title\":\"Zorunlu çerezler\",\"basic_title\":\"Temel analitik çerezler\",\"advanced_title\":\"Gelişmiş analitik çerezler\",\"marketing_title\":\"Pazarlama çerezleri\",\"btn_decline\":\"Yalnızca gerekli çerezleri kabul et\",\"btn_back\":\"Geri\",\"btn_accept_selected\":\"Seçimlerimi onayla\",\"btn_accept\":\"Tümünü kabul et ve kapat\",\"btn_manage\":\"Çerezleri yönet\",\"essential_text\":\"Bu birinci grup çerezler, web sitemizin işleyişi ve güvenliğinin yanı sıra ihtiyaç duyduğunuz hizmetler için de gereklidir. Bunlar genellikle, çerez tercihlerinizi hatırlama, giriş yapma veya öğeleri sepetinizde tutma gibi belirli işlevlerin kullanımını etkinleştirmek için işlemlerinize yanıt olarak ayarlanır. Bu çerezleri devre dışı bırakamazsınız ve bunların bir tarayıcı üzerinden engellenmesi site işlevselliğini etkileyebilir.\",\"basic_text\":\"Bu birinci grup çerezler, web sitemizin ziyaretçi/kullanıcı sayısını ölçmemize ve güvenilir iş ortaklarımızın yardımıyla toplu kullanım ve performans istatistikleri oluşturmamıza olanak sağlar. Bunları, web sitesi trafiğimiz ve kampanya performansımızla ilgili temel bilgileri almak ve web sitemizdeki hataları gidermek için kullanırız.\",\"advanced_text\":\"Bu birinci veya üçüncü grup çerezler, üçüncü taraf araçlardan elde edilen veriler sayesinde veri kümelerimizi zenginleştirerek web sitemizle ve sunulan her bir hizmetle nasıl etkileşim kurduğunuzu anlamamıza yardımcı olur. Bu çerezleri web sitemizi, hizmetlerimizi ve kullanıcı deneyimini iyileştirmek, hataları veya diğer sorunları bulup çözmek ve kampanyalarımızın etkinliğini değerlendirmek için kullanırız. \",\"marketing_text\":\"Bu üçüncü grup çerezler, pazarlama iş ortaklarımızın web sitemizdeki etkinliklerinizden bazılarını (örneğin ürünümüzü indirme veya satın alma gibi) izlemelerine, ilgi alanlarınız ve ihtiyaçlarınız hakkında bilgi edinmelerine ve sizinle daha alakalı olan hedefli reklamlar göstermelerine olanak sağlar.\"},\r\n  \"uk-UA\":{\"title\":\"Ваш вибір файлів cookie, ваша конфіденційність\",\"description\":\"Файли cookie, які використовуємо ми й наші партнери, дають змогу найкращим чином оптимізувати для вас інтернет-середовище, аналізувати трафік веб-сайту, а також персоналізувати рекламні оголошення залежно від ваших уподобань. Щоб надати згоду на збирання файлів cookie всіх типів, клацніть 'Прийняти все й закрити'. Щоб заборонити збір всіх файлів cookie, які не є основними, виберіть 'Приймати лише основні файли cookie'. Щоб надати згоду на збирання лише певних типів файлів cookie, клацніть посилання 'Керувати файлами cookie' в нижній частині нашого веб-сайту або в параметрах облікового запису (якщо вони доступні). Докладніше див. в нашому документі <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=uk-UA>Політика щодо файлів cookie</a>.\",\"essential_title\":\"Основні файли cookie\",\"basic_title\":\"Базові аналітичні файли cookie\",\"advanced_title\":\"Розширені аналітичні файли cookie\",\"marketing_title\":\"Рекламні файли cookie\",\"btn_decline\":\"Приймати лише основні файли cookie\",\"btn_back\":\"Назад\",\"btn_accept_selected\":\"Підтвердити вибрані варіанти\",\"btn_accept\":\"Прийняти все й закрити\",\"btn_manage\":\"Керувати файлами cookie\",\"essential_text\":\"Ці основні файли cookie необхідні для роботи й безпеки нашого веб-сайту й потрібних вам служб. Вони зазвичай активуються після виконання вами певних дій, щоб забезпечити роботу відповідних функцій (зокрема, щоб запам’ятати налаштування файлів cookie, облікові дані для входу, вибрані позиції в кошику). Не можна відмовитися від використання цих файлів cookie. Якщо заблокувати їх у браузері, це може вплинути на функціональність веб-сайту.\",\"basic_text\":\"Ці основні файли cookie дають нам змогу відстежувати кількість відвідувачів (користувачів) нашого веб-сайту, а також створювати агреговану статистику про використання й роботу за допомогою наших довірених партнерів. Ці дані допомагають нам краще розуміти характеристики трафіку нашого веб-сайту й нашої кампанії, а також усувати помилки на нашому веб-сайті.\",\"advanced_text\":\"Ці основні або сторонні файли cookie дають нам змогу поповнювати набори даних даними зі сторонніх інструментів і допомагають нам дізнатися, як саме ви користуєтеся нашим веб-сайтом і всіма запропонованими службами. Ми використовуємо ці файли cookie для вдосконалення веб-сайту, служб і взаємодії з користувачами, для пошуку й усунення помилок і проблем, а також для оцінювання ефективності наших кампаній. \",\"marketing_text\":\"Ці сторонні файли cookie дають змогу нашим партнерам із маркетингу відстежувати певні операції, які ви виконуєте на нашому веб-сайті (наприклад, завантаження або покупка нашого продукту), щоб дізнатися про ваші інтереси й потреби та краще персоналізувати рекламні оголошення.\"},\r\n  \"vi-VN\":{\"title\":\"Lựa chọn cookie của bạn, quyền riêng tư của bạn\",\"description\":\"Chúng tôi và các đối tác của chúng tôi sử dụng cookie để đem tới cho bạn trải nghiệm trực tuyến được tối ưu hóa tốt nhất, bạn có thể phân tích lưu lượng truy cập trang web của chúng tôi và chúng tôi sẽ mang tới quảng cáo phù hợp cho bạn. Bạn có thể đồng ý với việc thu thập tất cả cookie bằng cách nhấp vào 'Chấp nhận tất cả và đóng', từ chối tất cả các cookie không cần thiết bằng cách chọn 'Chỉ chấp nhận các cookie cần thiết' hoặc điều chỉnh cài đặt cookie của bạn bằng cách nhấp vào 'Quản lý cookie'. Bạn cũng có quyền thu hồi lại sự đồng ý của mình với cookie hoặc thay đổi các tùy chọn cookie bất cứ lúc nào bằng cách nhấp vào đường dẫn 'Quản lý cookie' ngay tại chân trang web của chúng tôi hoặc trong phần cài đặt tài khoản của bạn (nếu có). Để biết thêm thông tin, vui lòng xem <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=vi-VN>Chính sách Cookie</a> của chúng tôi.\",\"essential_title\":\"Cookie thiết yếu\",\"basic_title\":\"Cookie phân tích cơ bản\",\"advanced_title\":\"Cookie phân tích nâng cao\",\"marketing_title\":\"Cookie tiếp thị\",\"btn_decline\":\"Chỉ chấp nhận các cookie cần thiết\",\"btn_back\":\"Trở lại\",\"btn_accept_selected\":\"Xác nhận lựa chọn của tôi\",\"btn_accept\":\"Chấp nhận tất cả và đóng\",\"btn_manage\":\"Quản lý cookie\",\"essential_text\":\"Những cookie của bên thứ nhất này rất cần thiết để trang web của chúng tôi và các dịch vụ mà bạn yêu cầu có thể hoạt động và được bảo mật. Chúng thường được thiết lập để đáp ứng các hoạt động của bạn nhằm cho phép sử dụng một số chức năng nhất định, như ghi nhớ tùy chọn cookie, đăng nhập hoặc lưu các mặt hàng trong giỏ hàng của bạn. Bạn không thể từ chối những cookie này và việc chặn chúng thông qua trình duyệt có thể ảnh hưởng đến chức năng của trang web.\",\"basic_text\":\"Các cookie của bên thứ nhất này cho phép chúng tôi đo lường số lượng khách/người dùng truy cập trên trang web của chúng tôi và tạo số liệu thống kê tổng hợp về việc sử dụng cũng như hiệu suất với sự trợ giúp của các đối tác mà chúng tôi tin cậy. Chúng tôi sử dụng chúng để phân tích cơ bản về lưu lượng truy cập trang web và hiệu suất chiến dịch của mình và để giải quyết các lỗi trên trang web.\",\"advanced_text\":\"Những cookie của bên thứ nhất hoặc thứ ba này giúp chúng tôi hiểu rõ hơn về cách bạn tương tác với trang web và mỗi dịch vụ được cung cấp bằng cách đa dạng hóa các tập dữ liệu của mình với dữ liệu từ các công cụ của bên thứ ba. Chúng tôi sử dụng những cookie này để cải thiện trang web, dịch vụ và trải nghiệm người dùng nhằm tìm kiếm cũng như giải quyết các lỗi hoặc các vấn đề khác, đồng thời đánh giá hiệu quả chiến dịch của chúng tôi. \",\"marketing_text\":\"Những cookie của bên thứ ba này cho phép các đối tác tiếp thị của chúng tôi theo dõi một số hoạt động của bạn trên trang web của chúng tôi (ví dụ: khi bạn tải xuống hoặc mua sản phẩm của chúng tôi) để tìm hiểu về sở thích và nhu cầu của bạn và để hiển thị cho bạn những quảng cáo được nhắm mục tiêu phù hợp hơn.\"},\r\n  \"hy-AM\":{\"title\":\"Թխուկների ձեր ընտրությունը՝ ձեր գաղտնիությունն է\",\"description\":\"Մենք և մեր գործընկերներն օգտագործում ենք թխուկներ՝ ձեզ լավագույնս օպտիմիլացված առցանց աշխատանք ապահովելու, մեր կայքի տվյալների հոսքը վերլուծելու և ձեզ անհատականացված գովազդներ տրամադրելու համար: Դուք կարող եք համաձայնել բոլոր թխուկների հավաքմանը՝ սեղմելով «Ընդունել բոլորը և փակել», մերժել բոլոր ոչ կարևոր թխուկները՝ սեղմելով «Ընդունել միայն կարևոր թխուկները» կամ սահմանել ձեր թխուկների կարգավորումները՝ սեղմելով «Կառավարել թխուկները»: Դուք նաև իրավունք ունեք ցանկացած պահի չեղարկել թխուկների համար տրված ձեր համաձայնությունը կամ փոխել թխուկների նախընտրությունները՝ մեր կայքի էջատակում կամ ձեր հաշվի կարգավորումներում (առկայության դեպքում) սեղմելով «Կառավարել թխուկները» հղումը։ Լրացուցիչ տեղեկությունների համար ծանոթացեք մեր <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=hy-AM>Թխուկների քաղաքականությանը</a>։\",\"essential_title\":\"Հիմնական թխուկներ\",\"basic_title\":\"Հիմնական վերլուծական թխուկներ\",\"advanced_title\":\"Ընդլայնված վերլուծական թխուկներ\",\"marketing_title\":\"Մարքեթինգային թխուկներ\",\"btn_decline\":\"Ընդունել միայն կարևոր թխուկները\",\"btn_back\":\"Հետ\",\"btn_accept_selected\":\"Հաստատել իմ ընտրությունները\",\"btn_accept\":\"Ընդունել բոլորը և փակել\",\"btn_manage\":\"Կառավարել թխուկները\",\"essential_text\":\"Այս առաջին կողմի թխուկներն անհրաժեշտ են մեր կայքի աշխատանքի և ձեր պահանջած ծառայությունների տրամադրման և անվտանգության համար: Դրանք սովորաբար տեղադրվում են ի պատասխան ձեր գործողությունների՝ կոնկրետ գործառույթի օգտագործման հնարավորություն ընձեռելու համար, ինչպես օրինակ՝ ձեր թխուկների նախապատությունները հիշելը, մուտք գործելը կամ ձեր զամբյուղում առարկաները պահելը: Դուք չեք կարող հրաժարվել այս թխուկներից, իսկ դրանց արգելափակումը զննիչի միջոցով կարող է ազդել կայքի աշխատանքի վրա։\",\"basic_text\":\"Այս առաջին կողմի թխուկները հնարավորություն են տալիս տեսնել մեր կայքի այցելուների/օգտվողների քանակը և մեր վստահելի գործընկերների օգնությամբ ստեղծել օգտագործման և արտադրողականության ընդհանուր վիճակագրություն: Մենք օգտագործում ենք դրանք մեր կայքի տվյալների հոսքի մասին հիմնական պատկերացում ունենալու, մեր քարոզարշավի իրականացման, ինչպես նաև մեր կայքի վրիպակները շտկելու համար:\",\"advanced_text\":\"Այս առաջին կամ երրորդ կողմի թխուկներն օգնում են մեզ հասկանալ, թե ինչպես եք օգտագործում մեր կայքը և յուրաքանչյուր առաջարկվող ծառայությունը՝ ընդլայնելով մեր տվյալների բազաները երրորդ կողմի գործիքների միջոցով ստացված տվյալներով: Մենք օգտագործում ենք այդ թխուկները` մեր կայքը, ծառայությունները և օգտագործողի աշխատանքը բարելավելու, սխալներ կամ դրանց հետ կապված այլ խնդիրներ գտնելու ու լուծելու և մեր քարոզարշավների արդյունավետությունը գնահատելու նպատակով:\",\"marketing_text\":\"Այս երրորդ կողմի թխուկները մեր մարքեթինգային գործընկերներին հնարավորություն են տալիս հետևել ձեր որոշ գործողություններին մեր կայքում (օրինակ՝ երբ եք դուք ներբեռնում կամ գնում մեր ապրանքները)՝ ձեր հետաքրքրությունների և կարիքների մասին տեղեկանալու և ձեզ ավելի համապատասխան ու նպատակային գովազդներ ցուցադրելու համար:\"},\r\n  \"ca-ES\":{\"title\":\"La teva elecció de galetes, la teva privacitat\",\"description\":\"Nosaltres i els nostres socis utilitzem galetes per oferir-te la millor experiència en línia optimitzada, analitzar el trànsit del nostre lloc web i oferir-te anuncis personalitzats. Pots acceptar la recopilació de totes les galetes fent clic a \\\"Acceptar-ho tot i tancar\\\", rebutjar totes les galetes no essencials escollint \\\"Acceptar només les galetes essencials\\\", o ajustar la configuració de les galetes fent clic a \\\"Administrar les galetes\\\". També tens dret a retirar el teu consentiment o canviar les teves preferències de galetes en qualsevol moment fent clic a l'enllaç \\\"Administrar les galetes\\\" al peu de pàgina del nostre lloc web o a la configuració del teu compte (si està disponible). Per a més informació, consulta la nostra <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=en-US>Política de galetes</link>.\",\"essential_title\":\"Galetes essencials\",\"basic_title\":\"Galetes analítiques bàsiques\",\"advanced_title\":\"Galetes analítiques avançades\",\"marketing_title\":\"Galetes de màrqueting\",\"btn_decline\":\"Acceptar només les galetes essencials\",\"btn_back\":\"Tornar\",\"btn_accept_selected\":\"Confirmar les meves opcions\",\"btn_accept\":\"Acceptar-ho tot i tancar\",\"btn_manage\":\"Administrar les galetes\",\"essential_text\":\"Aquestes galetes pròpies són necessàries per al funcionament i la seguretat del nostre lloc web i dels serveis que necessites. Normalment s'estableixen en resposta a les teves accions per permetre l'ús de determinades funcionalitats, com ara recordar les teves preferències de galetes, iniciar la sessió o mantenir articles al carret de la compra. No pots desactivar aquestes galetes, i bloquejar-les mitjançant un navegador pot afectar la funcionalitat del lloc.\",\"basic_text\":\"Aquestes galetes pròpies ens permeten mesurar el nombre de visitants / usuaris del nostre lloc web i crear estadístiques agregades d'ús i rendiment amb l'ajuda dels nostres socis de confiança. Les utilitzem per obtenir informació bàsica sobre el trànsit del nostre lloc web i el rendiment de les nostres campanyes i per resoldre errors al nostre lloc web.\",\"advanced_text\":\"Aquestes galetes pròpies o de tercers ens ajuden a entendre com interactues amb el nostre lloc web i amb cada servei ofert enriquint els nostres conjunts de dades amb dades d'eines de tercers. Utilitzem aquestes galetes per millorar el nostre lloc web, els serveis i l'experiència de l'usuari, detectar i resoldre errors o altres problemes i avaluar l'eficàcia de les nostres campanyes.\",\"marketing_text\":\"Aquestes galetes de tercers permeten als nostres socis de màrqueting fer un seguiment d'algunes de les teves activitats al nostre lloc web (per exemple, quan descarregues o compres el nostre producte) per conèixer els teus interessos i necessitats i mostrar-te anuncis personalitzats més rellevants.\"}\r\n}"},"redirectURL":"","headersSize":609,"bodySize":40382,"_status":"completed","_startTimestamp":1780540281472522,"_endTimestamp":1780540281846051},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"91.228.167.61","connection":"19","comment":"","_id":54,"_uid":"2a73754b-9ed8-4c9f-92e7-5860578a89cd","_cid":19,"_ctime":1780540280479,"_sid":1,"_stime":1780540280479,"_serverAddress":"91.228.167.61","_serverAddressFamily":0,"_serverPort":443,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":64570,"_app":{"name":"chrome","id":"chrome.exe","path":"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe","stackTrace":null}},{"startedDateTime":"2026-06-04T02:32:15.756Z","time":1342,"request":{"method":"GET","url":"https://help.eset.com/tools/consent/strings_4td_essentials.json?d=home.eset.com","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":method","value":"GET"},{"name":":authority","value":"help.eset.com"},{"name":":path","value":"/tools/consent/strings_4td_essentials.json?d=home.eset.com"},{"name":":scheme","value":"https"},{"name":"pragma","value":"no-cache"},{"name":"cache-control","value":"no-cache"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.7390.55 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Not/A)Brand\";v=\"8\", \"Chromium\";v=\"141\", \"Google Chrome\";v=\"141\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"accept","value":"*/*"},{"name":"origin","value":"https://home.eset.com"},{"name":"sec-fetch-site","value":"same-site"},{"name":"sec-fetch-mode","value":"cors"},{"name":"sec-fetch-dest","value":"empty"},{"name":"referer","value":"https://home.eset.com/"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"en-US,en;q=0.9"},{"name":"priority","value":"u=1, i"}],"queryString":[{"name":"d","value":"home.eset.com"}],"headersSize":668,"bodySize":0,"_status":"completed","_startTimestamp":1780540335756213,"_endTimestamp":1780540335761717},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":status","value":"200"},{"name":"server","value":"nginx"},{"name":"date","value":"Thu, 04 Jun 2026 02:32:16 GMT"},{"name":"content-type","value":"application/json"},{"name":"content-length","value":"40382"},{"name":"last-modified","value":"Tue, 17 Feb 2026 09:00:04 GMT"},{"name":"vary","value":"Accept-Encoding"},{"name":"etag","value":"\"69942e14-9dbe\""},{"name":"content-encoding","value":"br"},{"name":"access-control-allow-origin","value":"https://home.eset.com"},{"name":"x-frame-options","value":"SAMEORIGIN"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-xss-protection","value":"1; mode=block"},{"name":"strict-transport-security","value":"max-age=31536000"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"permissions-policy","value":"geolocation=(), camera=(), microphone=()"},{"name":"alt-svc","value":"h3=\":443\"; ma=86400"},{"name":"cache-control","value":"public, max-age=604800"}],"content":{"size":147675,"mimeType":"application/json","text":"{\r\n  \"en-US\":{\"title\":\"Your cookie choice, your privacy\",\"description\":\"We and our partners use cookies to give you the best optimized online experience, analyze our website traffic, and serve you with personalized ads. You can agree to the collection of all cookies by clicking 'Accept all and close', decline all non-essential cookies by choosing 'Accept essential cookies only', or adjust your cookie settings by clicking 'Manage cookies'. You also have the right to withdraw your consent or change your cookie preferences anytime by clicking the 'Manage cookies' link in our website footer or in your account settings (if available). For more information, see our <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=en-US>Cookie Policy</a>.\",\"essential_title\":\"Essential cookies\",\"basic_title\":\"Basic analytical cookies\",\"advanced_title\":\"Advanced analytical cookies\",\"marketing_title\":\"Marketing cookies\",\"btn_decline\":\"Accept essential cookies only\",\"btn_back\":\"Back\",\"btn_accept_selected\":\"Confirm my choices\",\"btn_accept\":\"Accept all and close\",\"btn_manage\":\"Manage cookies\",\"essential_text\":\"These first-party cookies are necessary for the functioning and security of our website and the services you require. They are usually set in response to your actions to enable the use of certain functionality, such as remembering your cookie preferences, logging in, or holding items in your cart. You cannot opt out of these cookies, and blocking them via a browser may affect site functionality.\",\"basic_text\":\"These first-party cookies enable us to measure the number of visitors/users of our website and create aggregated usage and performance statistics with the help of our trusted partners. We use them to get the basic insight into our website traffic and our campaign performance and to solve bugs on our website.\",\"advanced_text\":\"These first or third-party cookies help us understand how you interact with our website and each offered service by enriching our datasets with data from third-party tools. We use these cookies to improve our website, services, and user experience, find and solve bugs or other problems with them, and evaluate our campaigns' effectiveness. \",\"marketing_text\":\"These third-party cookies allow our marketing partners to track some of your activities on our website (for example, when you download or buy our product) to learn about your interests and needs and to show you more relevant targeted ads.\"},\r\n  \"ar-EG\":{\"title\":\"اختار ملفات تعريف الارتباط الخاصة بك، خصوصيتك\",\"description\":\"نستخدم نحن وشركاؤنا ملفات تعريف الارتباط لمنحك أفضل تجربة ممكنة لتجربتك على موقعنا ونحلل حركة مرور موقعنا على الإنترنت، وخدمتك من خلال إعلانات مخصصة. يمكنك الموافقة على جميع ملفات تعريف الارتباط بالنقر على 'قبول الكل وإغلاق' أو رفض كافة ملفات تعريف الارتباط غير الضرورية من خلال اختيار 'قبول ملفات تعريف الارتباط الأساسية فقط' أو ضبط إعدادات ملفات تعريف الارتباط بالنقر على 'إدارة ملفات تعريف الارتباط'. لديك الحق أيضاً في سحب موافقتك أو تغيير تفضيلاتك لملفات تعريف الارتباط في أي وقت بالنقر على رابط 'إدارة ملفات تعريف الارتباط' الموجودة اسفل الموقع أو في إعدادات حسابك (إذا كان متوفراً). لمزيد من المعلومات، اطلع على <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ar-EG>سياسة ملفات تعريف الارتباط</a>.\",\"essential_title\":\"ملفات تعريف الارتباط الأساسية\",\"basic_title\":\"ملفات تعريف الارتباط التحليلية الأساسية\",\"advanced_title\":\"ملفات تعريف الارتباط التحليلية المتقدمة\",\"marketing_title\":\"ملفات تعريف الارتباط التسويقية\",\"btn_decline\":\"قبول ملفات تعريف الارتباط الأساسية فقط\",\"btn_back\":\"رجوع\",\"btn_accept_selected\":\"تأكيد اختياراتي\",\"btn_accept\":\"قبول الكل وإغلاق\",\"btn_manage\":\"إدارة ملفات تعريف الارتباط\",\"essential_text\":\"تعد ملفات تعريف الارتباط للموقع ضرورية لعمل وأمان لموقعنا والخدمات التي تحتاجها. يتم تعيينها عادةً استجابةً لإجراءاتك لتمكين استخدام وظائف معينة، مثل تذكّر تفضيلات ملفات تعريف الارتباط أو تسجيل الدخول أو الاحتفاظ بعناصر في سلة التسوق لديك. لا يمكنك إلغاء الاشتراك في ملفات تعريف الارتباط هذه، وقد يؤثر حظرها عبر المتصفح على وظائف الموقع.\",\"basic_text\":\"تمنحنا ملفات تعريف الارتباط لموقعنا القدرة على قياس عدد الزوار / المستخدمين للموقع وإنشاء إحصائيات مجمعة عن الاستخدام والأداء بمساعدة شركائنا الموثوقين. نستخدمها للحصول على نظرة ثاقبة حول حركة مرور الموقعنا وأداء الحملات الإعلانية ولحل الأخطاء الموجودة على الموقع.\",\"advanced_text\":\"تساعدنا ملفات تعريف الارتباط لموقعنا أو التابعة لجهات خارجية في فهم كيفية تفاعلك مع موقعنا وكل خدمة مقدمة من خلال إثراء مجموعات البيانات لدينا ببيانات من أدوات تابعة لجهة خارجية. نستخدم ملفات تعريف الارتباط هذه لتحسين موقعنا وخدماتنا وتجربة المستخدم والعثور على الأخطاء أو المشكلات الأخرى وحلها وتقييم فعالية حملاتنا. \",\"marketing_text\":\"تعمل ملفات تعريف الارتباط التابعة لجهات خارجية على السماح لشركائنا في التسويق بتتبع بعض أنشطتك على موقعنا (على سبيل المثال، عند تنزيل المنتج أو شرائه) للتعرف على اهتماماتك واحتياجاتك ولإظهار المزيد من الإعلانات المستهدفة ذات الصلة.\"},\r\n  \"bg-BG\":{\"title\":\"Вашият избор на бисквитки, вашата поверителност\",\"description\":\"Ние и нашите партньори използваме бисквитки, за да ви предоставяме най-оптимизирано онлайн изживяване, да анализираме трафика на уеб сайта си и да ви предлагаме персонализирани реклами. Можете да се съгласите със събирането от всички бисквитки, като щракнете върху „Приемане на всички и затваряне“, да отхвърлите бисквитките, които не са основни, като изберете „Приемане само на основни бисквитки“ или да коригирате настройките си за бисквитки, като щракнете върху „Управление на бисквитките“. Също така имате право да оттеглите съгласието си или да промените предпочитанията си за бисквитки по всяко време, като щракнете върху връзката „Управление на бисквитките“ в долния колонтитул на уеб сайта ни или в настройките на акаунта ви (ако е приложимо). За повече информация вижте нашите <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=bg-BG>Правила за бисквитките</a>.\",\"essential_title\":\"Основни бисквитки\",\"basic_title\":\"Основни аналитични бисквитки\",\"advanced_title\":\"Разширени аналитични бисквитки\",\"marketing_title\":\"Маркетингови бисквитки\",\"btn_decline\":\"Приемане само на основни бисквитки\",\"btn_back\":\"Назад\",\"btn_accept_selected\":\"Потвърждаване на моя избор\",\"btn_accept\":\"Приемане на всички и затваряне\",\"btn_manage\":\"Управление на бисквитките\",\"essential_text\":\"Тези бисквитки от първа страна са необходими за функционирането и сигурността на нашия уеб сайт и на услугите, които изисквате. Те обикновено се задават в отговор на вашите действия, за да се разреши използването на определена функционалност, като запомняне на вашите предпочитания за бисквитки, данни за влизане или запазване на артикули в количката. Не може да се откажете от тези бисквитки и блокирането им с помощта на браузър може да повлияе на функционалността на сайта.\",\"basic_text\":\"Тези бисквитки от първа страна ни дават възможност да измерим броя на посетителите/потребителите на нашия уеб сайт и да създадем обобщени статистически данни за използването и ефективността с помощта на нашите доверени партньори. Използваме ги, за да придобием обща представа за трафика на уеб сайта ни и ефективността на кампанията ни и за решаване на грешки на нашия уеб сайт.\",\"advanced_text\":\"Тези бисквитки от първа или трета страна ни помагат да разберем как взаимодействате с нашия уеб сайт и с всяка предлагана услуга, като обогатяват нашите набори от данни с данни от инструменти на трети страни. Използваме тези бисквитки, за да подобряваме уеб сайта, услугите и потребителското изживяване, да намираме и отстраняваме грешки или други проблеми с тях и да оценяваме ефективността на своите кампании. \",\"marketing_text\":\"Тези бисквитки на трети страни позволяват на нашите маркетингови партньори да проследяват някои от вашите дейности на нашия уеб сайт (например, когато изтегляте или купувате наш продукт), за да се запознаят с вашите интереси и нужди и да ви показват по-подходящи целенасочени реклами.\"},\r\n  \"zh-CN\":{\"title\":\"您的 Cookie 选择, 您的隐私\",\"description\":\"我们和我们的合作伙伴使用 Cookie 来为您提供经优化的最佳在线体验、分析我们的网站流量以及为您提供个性化广告。可以通过单击“全部接受并关闭”来同意收集所有 Cookie、通过选择“仅接受必要 Cookie”来拒绝所有非必要的 Cookie，也可以通过单击“管理 Cookie”来调整 Cookie 设置。您还有权随时通过单击我们网站页脚或您的帐户设置（如果有）中的“管理 Cookie”链接来撤回您的同意或更改 Cookie 偏好。您也有权随时撤销您对 Cookie 的同意。有关详细信息，请参阅我们的 <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=zh-CN>Cookie 策略</a>。\",\"essential_title\":\"基本 Cookie\",\"basic_title\":\"基本分析 Cookie\",\"advanced_title\":\"高级分析 Cookie\",\"marketing_title\":\"营销 Cookie\",\"btn_decline\":\"仅接受必要 Cookie\",\"btn_back\":\"返回\",\"btn_accept_selected\":\"确认我的选择\",\"btn_accept\":\"全部接受并关闭\",\"btn_manage\":\"管理 Cookie\",\"essential_text\":\"这些第一方 Cookie 对于我们网站的运行和安全以及您所需的服务都是必要的。它们通常是根据您的操作设置的，以支持使用某些功能（例如，记住您的 Cookie 偏好、登录或在您的购物车中保存物品）。您不能选择退出这些 Cookie，并且通过浏览器阻止它们可能会影响站点功能。\",\"basic_text\":\"这些第一方 Cookie 使我们能够衡量我们网站的访问者/用户数量，并在我们值得信赖的合作伙伴的帮助下创建汇总的使用情况和性能统计数据。我们使用它们来基本了解我们的网站流量和活动效果，并解决我们网站存在的错误。\",\"advanced_text\":\"这些第一方或第三方 Cookie 通过使用来自第三方工具的数据丰富我们的数据集，从而帮助我们了解您如何与我们的网站以及每个提供的服务进行交互。我们使用这些 Cookie 来改进我们的网站、服务和用户体验，查找并解决它们的错误或其他问题，以及评估我们活动的有效性。 \",\"marketing_text\":\"这些第三方 Cookie 允许我们的营销合作伙伴跟踪您在我们网站上的一些活动（例如，当下载或购买我们的产品时），以了解您的兴趣和需求，并向您展示更多相关的定向广告。\"},\r\n  \"zh-TW\":{\"title\":\"您的 Cookie 選擇，您的隱私權\",\"description\":\"我們和我們的合作夥伴使用 Cookie 為您提供最佳化的線上體驗、分析我們的網站流量並為您提供個人化的廣告。您可以藉由按一下 [全部接受並關閉] 以同意收集所有的 Cookie，或選擇 [僅接受基本 Cookie] 拒絕所有非必要的 Cookie，或按一下 [管理 Cookie] 調整您的 Cookie 設定。您也有權隨時按一下我們網站頁尾或您的帳戶設定 (如果有的話) 中的「管理 Cookie」連結來撤銷您的同意或變更您的 Cookie 喜好設定。如需詳細資訊，請參閱我們的 <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=zh-TW>Cookie 原則</a>。\",\"essential_title\":\"基本 Cookie\",\"basic_title\":\"基本分析 Cookie\",\"advanced_title\":\"進階分析 cookie\",\"marketing_title\":\"行銷 Cookie\",\"btn_decline\":\"僅接受基本 Cookie\",\"btn_back\":\"上一步\",\"btn_accept_selected\":\"確認我的選擇\",\"btn_accept\":\"全部接受並關閉\",\"btn_manage\":\"管理 Cookie\",\"essential_text\":\"這些第一方 Cookie 對於我們網站的運作和安全性以及您所需的服務而言是必要的。它們通常是根據您的動作而進行設定，以啟用特定功能的使用，例如記住您的 Cookie 喜好設定、登入或在您的購物車中保留項目。您無法選擇退出這些 Cookie，透過瀏覽器將其封鎖可能會影響網站功能。\",\"basic_text\":\"這些第一方 Cookie 讓我們能夠測量我們網站的造訪者/使用者的數量，並在我們值得信賴的合作夥伴的協助下建立彙總的使用量和性能統計資料。我們使用它們來對我們的網站流量和行銷活動績效進行基本了解，並且解決我們網站上的錯誤。\",\"advanced_text\":\"這些第一方或第三方 Cookie 藉由使用第三方工具的資料來豐富我們的資料集，幫助我們了解您如何與我們的網站以及每項提供的服務進行互動。我們使用這些 Cookie 來改善我們的網站、服務和使用者體驗，尋找並解決錯誤或與其相關的其他問題，並評估我們行銷活動的效益。 \",\"marketing_text\":\"這些第三方 Cookie 允許我們的行銷活動合作夥伴追蹤您在我們網站上的一些活動 (例如，在您下載或購買我們的產品時)，以了解您的興趣和需求並向您顯示更多相關的目標廣告。\"},\r\n  \"hr-HR\":{\"title\":\"Vaš izbor kolačića, vaša privatnost\",\"description\":\"Mi i naši partneri upotrebljavamo kolačiće kako bismo vam pružili optimizirano online iskustvo, analizirali promet na našoj web stranici i prikazivali vam personalizirane oglase. Pristati na prikupljanje svih kolačića možete klikom na 'Prihvati sve i zatvori', odbiti sve kolačiće koji nisu osnovni možete odabirom 'Prihvati samo osnovne kolačiće' ili možete prilagoditi postavke kolačića klikom na 'Upravljanje kolačićima'. Isto tako, imate pravo povući svoj pristanak ili promijeniti preference o kolačićima u bilo kojem trenutku klikom na vezu 'Upravljanje kolačićima' u podnožju naše web stranice ili u postavkama svojeg računa (ako je dostupno). Više informacija potražite u našim <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=hr-HR>Pravilima o kolačićima</a>.\",\"essential_title\":\"Osnovni kolačići\",\"basic_title\":\"Osnovni analitički kolačići\",\"advanced_title\":\"Napredni analitički kolačići\",\"marketing_title\":\"Marketinški kolačići\",\"btn_decline\":\"Prihvati samo osnovne kolačiće\",\"btn_back\":\"Natrag\",\"btn_accept_selected\":\"Potvrdi moj izbor\",\"btn_accept\":\"Prihvati sve i zatvori\",\"btn_manage\":\"Upravljanje kolačićima\",\"essential_text\":\"Ovi kolačići prve strane potrebni su za funkcioniranje i sigurnost naše web stranice i usluga koje su vam potrebne. Obično se postavljaju kao odgovor na vaše radnje kako bi vam se omogućila upotreba određenih funkcija, kao što su pamćenje postavki kolačića, prijava ili držanje proizvoda u košarici. Ove kolačiće ne možete isključiti, a njihovo blokiranje putem preglednika može utjecati na funkcionalnost stranice.\",\"basic_text\":\"Ovi kolačići prve strane omogućuju nam mjerenje broja posjetitelja/korisnika naše web stranice i stvaranje agregiranih statistika o upotrebi i rezultatima uz pomoć naših pouzdanih partnera. Upotrebljavamo ih kako bismo dobili osnovni uvid u promet naše web stranice i rezultate naše kampanje, kao i za rješavanje pogrešaka na našoj web stranici.\",\"advanced_text\":\"Ovi kolačići prve ili treće strane pomažu nam da razumijemo kako komunicirate s našom web stranicom i svakom ponuđenom uslugom tako što obogaćuju naše skupove podataka podacima iz alata trećih strana. Ove kolačiće upotrebljavamo za poboljšanje naše web stranice, usluga i korisničkog iskustva, pronalaženje i rješavanje programskih pogrešaka ili drugih problema s njima i procjenu učinkovitosti naših kampanja. \",\"marketing_text\":\"Ovi kolačići trećih strana omogućuju našim marketinškim partnerima da prate neke od vaših aktivnosti na našoj web stranici (na primjer, kada preuzmete ili kupite naš program) kako bi saznali više o vašim interesima i potrebama i prikazivali vam relevantnije ciljane oglase.\"},\r\n  \"cs-CZ\":{\"title\":\"Vaše soukromí, váš výběr cookies\",\"description\":\"My a naši partneři používáme soubory cookie, abychom vám poskytli co nejlepší online zážitek, personalizovanou reklamu a dokázali jsme analyzovat návštěvnost webových stránek. Se shromažďováním všech cookies můžete souhlasit kliknutím na tlačítko <strong>Přijmout vše a zavřít</strong>, všechny volitelné soubory cookies můžete odmítnout vybráním možnosti <strong>Přijmout pouze nezbytné cookies</strong>, nebo si jejich nastavení přizpůsobit kliknutím na <strong>Spravovat cookies</strong>. Svůj souhlas se soubory cookie můžete kdykoli zrušit, případně změnit svůj výběr, po kliknutí na odkaz umístěný v patičce webové stránky nebo v nastavení vašeho účtu. Další informace naleznete v <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=cs-CZ>Zásadách používání souborů cookies</a>.\",\"essential_title\":\"Nezbytné cookies\",\"basic_title\":\"Základní analytické soubory cookies\",\"advanced_title\":\"Rozšířené analytické soubory cookies\",\"marketing_title\":\"Marketingové soubory cookies\",\"btn_decline\":\"Přijmout pouze nezbytné cookies\",\"btn_back\":\"Zpět\",\"btn_accept_selected\":\"Potvrdit moje volby\",\"btn_accept\":\"Přijmout vše a zavřít\",\"btn_manage\":\"Spravovat cookies\",\"essential_text\":\"Tyto soubory cookies první strany jsou nezbytné pro fungování a zajištění bezpečnosti naší webové stránky a vámi požadovaných služeb. Obvykle se nastavují v reakci na vámi provedené akce abyste mohli využít konkrétní funkce, jako je například zapamatování vašeho souhlasu se soubory cookies, přihlášení nebo uložení položek v košíku. Pro tento typ cookies proto není vyžadován váš souhlas. Jejich blokování ve vašem prohlížeči může ovlivnit funkčnost webové stránky.\",\"basic_text\":\"Tyto soubory cookies první strany nám umožňují měřit počet návštěvníků/uživatelů našich webových stránek a vytvářet souhrnné statistiky o používání a výkonnosti s pomocí našich důvěryhodných partnerů. Používáme je k získání základního přehledu o návštěvnosti našich webových stránek, výkonnosti našich kampaní a při řešení chyb na našich webových stránkách.\",\"advanced_text\":\"Tyto soubory cookies první nebo třetí strany nám pomáhají získat přehled o tom, jak používáte naši webovou stránku a jednotlivé služby tak, že doplňují naše data o údaje z nástrojů třetích stran. Používáme je k vylepšování našeho webu, služeb a uživatelského prostředí, k identifikaci a opravě chyb nebo jiných souvisejících problémů a vyhodnocování efektivity našich kampaní. \",\"marketing_text\":\"Tyto soubory cookies třetích stran umožňují našim marketingovým partnerům sledovat některé vaše aktivity na našich webových stránkách, například stažení nebo nákup produktu. Díky nim vám zobrazujeme jen relevantní reklamy.\"},\r\n  \"da-DK\":{\"title\":\"Dit valg af cookies, dine personlige oplysninger\",\"description\":\"Vi og vores partnere bruger cookies til at give dig den mest optimerede onlineoplevelse, analysere vores webstedstrafik og vise dig personligt tilpassede annoncer. Du kan acceptere indsamling af alle cookies ved at klikke på 'Acceptér alle, og luk', afvise alle uvæsentlige cookies ved at vælge 'Acceptér kun vigtige cookies' eller justere dine cookieindstillinger ved at klikke på 'Administrer cookies'. Du har også ret til når som helst at trække dit samtykke tilbage eller at ændre dine cookieindstillinger ved at klikke på linket 'Administrer cookies' i sidefoden på vores websted eller i dine kontoindstillinger (hvis de er tilgængelige). Du kan finde flere oplysninger i vores <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=da-DK>cookiepolitik</a>.\",\"essential_title\":\"Vigtige cookies\",\"basic_title\":\"Grundlæggende analytiske cookies\",\"advanced_title\":\"Avancerede analytiske cookies\",\"marketing_title\":\"Markedsføringscookies\",\"btn_decline\":\"Acceptér kun vigtige cookies\",\"btn_back\":\"Tilbage\",\"btn_accept_selected\":\"Bekræft mine valg\",\"btn_accept\":\"Acceptér alle, og luk\",\"btn_manage\":\"Administrer cookies\",\"essential_text\":\"Disse førstepartscookies er nødvendige for, at vores websted og de tjenester, du har brug for, kan fungere og er sikre. De er normalt indstillet i overensstemmelse med dine handlinger for at aktivere brugen af visse funktioner, såsom at huske dine cookieindstillinger, logge på eller bevare varer i din indkøbskurv. Du kan ikke fravælge disse cookies, og hvis du blokerer dem via en browser, kan det påvirke webstedets funktionalitet.\",\"basic_text\":\"Disse førstepartscookies gør det muligt for os at måle antallet af besøgende/brugere på vores websted og at oprette aggregerede brugs- og ydeevnestatistikker ved hjælp af vores betroede partnere. Vi bruger dem til at få grundlæggende indsigt i vores webstedstrafik og i vores kampagners effektivitet og til at løse fejl på vores websted.\",\"advanced_text\":\"Disse første- eller tredjepartscookies hjælper os med at forstå, hvordan du interagerer med vores websted og alle tilbudte tjenester, ved at forsyne vores datasæt med data fra tredjepartsværktøjer. Vi bruger disse cookies til at forbedre vores websted, tjenester og brugeroplevelse, finde og løse fejl eller andre problemer med dem og evaluere vores kampagners effektivitet. \",\"marketing_text\":\"Disse tredjepartscookies gør det muligt for vores marketingpartnere at spore nogle af dine aktiviteter på vores websted (f.eks. når du downloader eller køber vores produkt) for at få mere at vide om dine interesser og behov og vise dig mere relevante målrettede annoncer.\"},\r\n  \"nl-NL\":{\"title\":\"Uw cookiekeuze, uw privacy\",\"description\":\"Wij en onze partners maken gebruik van cookies om u een geoptimaliseerde online ervaring te bieden, ons websiteverkeer te analyseren en u gepersonaliseerde advertenties aan te bieden. U kunt akkoord gaan met het verzamelen van alle cookies door op 'Alles accepteren en sluiten' te klikken, alle niet-essentiële cookies te weigeren door 'Alleen essentiële cookies accepteren' te kiezen, of door uw cookie-instellingen aan te passen door op 'Cookies beheren' te klikken. U hebt ook het recht om uw toestemming omtrent cookies op elk gewenst moment in te trekken of uw cookievoorkeuren te wijzigen door op de koppeling 'Cookies beheren' te klikken in de voettekst op onze website of in uw accountinstellingen (indien beschikbaar). Voor meer informatie verwijzen u naar ons <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=nl-NL>Cookiebeleid</a>.\",\"essential_title\":\"Essentiële cookies\",\"basic_title\":\"Elementaire analytische cookies\",\"advanced_title\":\"Geavanceerde analytische cookies\",\"marketing_title\":\"Marketingcookies\",\"btn_decline\":\"Alleen essentiële cookies accepteren\",\"btn_back\":\"Vorige\",\"btn_accept_selected\":\"Mijn keuzes bevestigen\",\"btn_accept\":\"Alles accepteren en sluiten\",\"btn_manage\":\"Cookies beheren\",\"essential_text\":\"Deze cookies van onszelf zijn noodzakelijk voor het functioneren en de veiligheid van onze website en de diensten die u nodig hebt. Ze worden meestal ingesteld als reactie op uw acties om bepaalde functionaliteit mogelijk te maken, zoals het onthouden van uw cookievoorkeuren, aanmelden of het bewaren van items in uw winkelwagentje. U kunt zich niet afmelden voor deze cookies en het blokkeren ervan in een browser kan gevolgen hebben voor de functionaliteit van de website.\",\"basic_text\":\"Deze first-party cookies stellen ons in staat om het aantal bezoekers/gebruikers van onze website te meten en geaggregeerde gebruiks- en prestatiestatistieken samen te stellen met de hulp van onze vertrouwde partners. We gebruiken deze om basisinzicht te krijgen in ons websiteverkeer en onze campagneprestaties, en om bugs op onze website op te lossen.\",\"advanced_text\":\"Aan de hand van deze cookies van onszelf of cookies van derden kunnen wij begrijpen hoe u omgaat met onze website en elke aangeboden service doordat we onze gegevens uitbreiden met gegevens uit hulpmiddelen van derden. We gebruiken deze cookies om onze website, diensten en gebruikerservaring te verbeteren, bugs of andere problemen te vinden en op te lossen, en de effectiviteit van onze campagnes te beoordelen. \",\"marketing_text\":\"Dankzij deze cookies van derden kunnen onze marketingpartners sommige van uw activiteiten op onze website volgen (bijvoorbeeld wanneer u ons product downloadt of koopt) om meer te weten te komen over uw interesses en behoeften en om u relevantere, gerichte advertenties te tonen.\"},\r\n  \"et-EE\":{\"title\":\"Teie valitud küpsised, teie privaatsus\",\"description\":\"Kasutame koos partneritega küpsiseid, et pakkuda teile parimat optimeeritud veebilahendust, analüüsida veebisaidi liiklust ja pakkuda teile isikupärastatud reklaame. Kõigi küpsiste kogumisega nõustumiseks klõpsake nuppu <strong>Aktsepteeri kõik ja sule</strong>, kõigist ebaolulistest küpsistest keeldumiseks valige <strong>Nõustu ainult oluliste küpsistega</strong> või kohandage oma küpsiste sätteid, klõpsates nuppu <strong>Halda küpsiseid</strong>. Teil on ka igal ajal õigus nõusolek tagasi võtta või küpsiste eelistusi muuta, kui klõpsate linki <strong>Halda küpsiseid</strong> meie veebisaidi jaluses või oma kontosätetes (kui on saadaval). Lisateavet leiate lingilt <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=et-EE>Küpsiste poliitika</a>.\",\"essential_title\":\"Olulised küpsised\",\"basic_title\":\"Peamised analüütilised küpsised\",\"advanced_title\":\"Täpsemad analüütilised küpsised\",\"marketing_title\":\"Turundusküpsised\",\"btn_decline\":\"Nõustu ainult oluliste küpsistega\",\"btn_back\":\"Tagasi\",\"btn_accept_selected\":\"Kinnita minu valikud\",\"btn_accept\":\"Aktsepteeri kõik ja sule\",\"btn_manage\":\"Halda küpsiseid\",\"essential_text\":\"Need esimese osapoole küpsised on vajalikud meie veebisaidi ja vajalike teenuste toimimiseks ning turvalisuse tagamiseks. Need määratakse tavaliselt vastuseks teie toimingutele, et võimaldada teatud funktsioonide kasutamist, näiteks küpsise-eelistuste meeldejätmist, sisselogimist või toodete hoidmist ostukorvis. Te ei saa nendest küpsistest loobuda ja nende blokeerimine brauseri kaudu võib mõjutada saidi funktsionaalsust.\",\"basic_text\":\"Need esimese osapoole küpsised võimaldavad meil mõõta meie veebisaidi külastajate/kasutajate arvu ning luua meie usaldusväärsete partnerite abil koondatud kasutus- ja jõudlusstatistikat. Kasutame neid, et saada peamine ülevaade meie veebisaidi liiklusest ja kampaania tulemuslikkusest, ning et parandada meie veebisaidil olevaid vigu.\",\"advanced_text\":\"Need esimese või kolmanda osapoole küpsised aitavad meil aru saada sellest, kuidas te meie veebisaiti ja iga pakutavat teenust kasutate, rikastades meie andmekomplekte kolmanda osapoole tööriistade andmetega. Kasutame neid küpsiseid veebisaidi, teenuste ja kasutajaliidese parandamiseks, vigade või muude nendega seotud probleemide leidmiseks ja lahendamiseks ning kampaaniate tõhususe hindamiseks. \",\"marketing_text\":\"Need kolmanda osapoole küpsised võimaldavad meie turunduspartneritel jälgida mõningaid teie tegevusi meie veebisaidil (näiteks kui laadite alla või ostate meie toote), et saada teavet teie huvide ja vajaduste kohta ning näidata teile asjakohasemaid sihitud reklaame.\"},\r\n  \"fi-FI\":{\"title\":\"Evästevalintasi, yksityisyytesi\",\"description\":\"Me ja kumppanimme käytämme evästeitä, jotta voimme tarjota sinulle optimoidun verkon käyttökokemuksen, analysoida verkkosivustomme liikennettä ja näyttää sinulle räätälöityjä mainoksia. Voit hyväksyä kaikkien evästeiden keräämisen valitsemalla 'Hyväksy kaikki ja sulje', hylätä kaikki muut paitsi välttämättömät evästeet valitsemalla 'Hyväksy vain välttämättömät evästeet' tai säätää evästeasetuksia valitsemalla 'Evästeiden hallinta' -linkin verkkosivustomme alaviitteestä tai tilisi asetuksista (jos se on käytettävissä). Sinulla on myös oikeus peruuttaa evästesuostumuksesi milloin tahansa. Lisätietoja on <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=fi-FI>evästekäytännössämme</a>.\",\"essential_title\":\"Välttämättömät evästeet\",\"basic_title\":\"Analyyttiset perusevästeet\",\"advanced_title\":\"Edistyneet analyyttiset evästeet\",\"marketing_title\":\"Markkinointievästeet\",\"btn_decline\":\"Hyväksy vain välttämättömät evästeet\",\"btn_back\":\"Edellinen\",\"btn_accept_selected\":\"Vahvista valinnat\",\"btn_accept\":\"Hyväksy kaikki ja sulje\",\"btn_manage\":\"Evästeiden hallinta\",\"essential_text\":\"Nämä ensimmäisen osapuolen evästeet ovat välttämättömiä verkkosivustomme ja tarvitsemiesi palvelujen toiminnan ja turvallisuuden kannalta. Ne asetetaan yleensä tekemiesi toimien mukaisesti tietyille toiminnoille, kuten evästeasetustesi muistamiseen, sisäänkirjautumiseen ja tuotteiden säilyttämiseen ostoskorissa. Näistä evästeistä ei voi kieltäytyä, ja niiden estäminen selaimen kautta voi vaikuttaa sivuston toimimiseen.\",\"basic_text\":\"Näiden ensimmäisen osapuolen evästeiden avulla voimme mitata verkkosivustomme kävijöiden/käyttäjien määrää ja luoda koostettuja käyttö- ja suorituskykytilastoja luotettavien kumppaneidemme avulla. Käytämme niitä saadaksemme perustietoja verkkosivustomme tietoliikenteestä ja kampanjoidemme suorituskyvystä sekä ratkaistaksemme verkkosivustojemme vikatilanteita.\",\"advanced_text\":\"Näistä ensimmäisen tai kolmannen osapuolen evästeistä saamme käsityksen siitä, miten olet vuorovaikutuksessa verkkosivustomme ja kunkin tarjotun palvelun kanssa, kolmansien osapuolten työkalujen laajennettujen tietojen kautta. Käytämme näitä evästeitä, jotta voimme parantaa verkkosivustoamme, palvelujamme ja käyttökokemusta, löytää ja ratkaista niihin liittyviä virheitä tai muita ongelmia sekä arvioida kampanjoidemme tehokkuutta. \",\"marketing_text\":\"Näiden kolmansien osapuolten evästeiden avulla markkinointikumppanimme voivat seurata joitakin toimiasi verkkosivustollamme (esimerkiksi tuotteidemme lataamista ja ostamista), jotta he saavat tietoa kiinnostuksen kohteistasi ja tarpeistasi ja voivat näyttää sinulle osuvampia kohdennettuja mainoksia.\"},\r\n  \"fr-CA\":{\"title\":\"Choisissez vos préférences en matière de témoins et protégez la confidentialité de vos données\",\"description\":\"Nos partenaires et nous utilisons des témoins pour vous offrir la meilleure expérience optimisée en ligne, analyser le trafic sur notre site Web et vous fournir des publicités personnalisées. Vous pouvez accepter la collecte de tous les témoins en cliquant sur « Tout accepter et fermer », refuser tous les témoins non essentiels en choisissant « Accepter uniquement les témoins essentiels » ou régler vos paramètres concernant les témoins en cliquant sur « Gérer les témoins ». Vous avez également le droit de retirer votre consentement ou de modifier vos préférences en matière de témoins à tout moment en cliquant sur le lien « Gérer les témoins » dans le pied de notre page Web ou dans les paramètres de votre compte (le cas échéant). Pour en savoir plus, veuillez consulter notre <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=fr-CA>Politique relative aux témoins</a>.\",\"essential_title\":\"Témoins essentiels\",\"basic_title\":\"Témoins analytiques de base\",\"advanced_title\":\"Témoins analytiques avancés\",\"marketing_title\":\"Témoins de marketing\",\"btn_decline\":\"Acceptez uniquement les témoins essentiels\",\"btn_back\":\"Précédent\",\"btn_accept_selected\":\"Confirmer mes choix\",\"btn_accept\":\"Tous accepter et fermer\",\"btn_manage\":\"Gérer les témoins\",\"essential_text\":\"Ces témoins internes sont essentiels au bon fonctionnement et à la sécurité de notre site Web et des services dont vous avez besoin. Ils sont généralement définis en réponse à vos actions pour permettre l’utilisation de certaines fonctionnalités, telles que la mémorisation de vos préférences en matière de témoins, votre connexion ou le maintien d’articles dans votre panier. Vous ne pouvez pas refuser ces témoins, et les bloquer au moyen d’un navigateur peut nuire à la fonctionnalité du site.\",\"basic_text\":\"Ces témoins internes nous permettent de compter le nombre de visiteurs ou d’utilisateurs de notre site Web et de créer des statistiques agrégées d’utilisation et de performance avec l’aide de nos partenaires de confiance. Nous les utilisons pour obtenir les informations de base sur le trafic de notre site Web et les performances de notre campagne et pour résoudre les bogues sur notre site Web.\",\"advanced_text\":\"Ces témoins internes ou de tiers nous aident à mieux comprendre comment vous interagissez avec notre site Web et chacun des services offerts en enrichissant nos ensembles de données avec des données provenant d’outils tiers. Nous utilisons ces témoins dans le but d’améliorer notre site Web, nos services et l’expérience utilisateur, de trouver et de résoudre des bogues ou d’autres problèmes en lien avec ceux-ci, et d’évaluer l’efficacité de nos campagnes. \",\"marketing_text\":\"Ces témoins tiers permettent à nos partenaires marketing de suivre certaines de vos activités sur notre site Web (par exemple, lorsque vous téléchargez ou achetez notre produit) afin d’en savoir plus sur vos intérêts et vos besoins et pour vous fournir des publicités ciblées plus pertinentes.\"},\r\n  \"fr-FR\":{\"title\":\"Votre choix de cookies, votre vie privée\",\"description\":\"Nos partenaires et nous, utilisons des cookies pour optimiser votre expérience en ligne, analyser le trafic de notre site internet et vous proposer des annonces personnalisées. Vous pouvez accepter la collecte de tous les cookies en cliquant sur « Tout accepter et fermer », refuser ceux qui ne sont pas essentiels en cliquant sur « Accepter uniquement les cookies essentiels » ou ajuster vos paramètres en cliquant sur « Gérer les cookies ». Vous pouvez également retirer votre consentement ou modifier vos préférences à tout moment en cliquant sur « Gérer les cookies » en bas de page ou depuis les paramètres de votre compte (si disponible). Pour plus d’informations, veuillez consulter notre <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=fr-FR>politique en matière de cookies</a>.\",\"essential_title\":\"Cookies essentiels\",\"basic_title\":\"Cookies analytiques de base\",\"advanced_title\":\"Cookies analytiques avancés\",\"marketing_title\":\"Cookies marketing\",\"btn_decline\":\"Accepter uniquement les cookies essentiels\",\"btn_back\":\"Précédent\",\"btn_accept_selected\":\"Confirmer mes choix\",\"btn_accept\":\"Tout accepter et fermer\",\"btn_manage\":\"Gérer les cookies\",\"essential_text\":\"Ces cookies sont nécessaires au fonctionnement et à la sécurité de notre site web et des services dont vous avez besoin. Ils sont généralement définis en réponse à vos actions pour permettre l’utilisation de certaines fonctionnalités, telles que la mémorisation de vos préférences en matière de cookies, la connexion ou encore le maintien d’articles dans votre panier. Vous ne pouvez pas refuser ces cookies et essayer de les bloquer via un navigateur peut avoir une incidence sur les fonctionnalités du site.\",\"basic_text\":\"Ces cookies internes nous permettent de mesurer le nombre de visiteurs/d’utilisateurs sur notre site web et de créer des statistiques agrégées d’utilisation et de performances avec l’aide de nos partenaires de confiance. Nous les utilisons pour obtenir des informations sur le trafic de notre site web, les performances de nos campagnes et pour résoudre les bugs.\",\"advanced_text\":\"Ces cookies internes ou tiers permettent de comprendre la façon dont vous interagissez avec notre site web et avec chaque service proposé en enrichissant nos données avec des informations provenant d’outils tiers. Nous utilisons ces cookies pour améliorer notre site, nos services et l’expérience utilisateurs mais également pour trouver et résoudre des bogues ou d’autres problèmes, et évaluer l’efficacité de nos campagnes.\",\"marketing_text\":\"Ces cookies tiers permettent à nos partenaires marketing de suivre certaines de vos activités sur notre site web (par exemple, lorsque vous téléchargez ou achetez nos produit) afin de connaître vos intérêts et vos besoins et de vous montrer des publicités ciblées plus pertinentes.\"},\r\n  \"de-DE\":{\"title\":\"Ihre Cookie-Auswahl, Ihr Datenschutz\",\"description\":\"Wir und unsere Partner verwenden Cookies, um Ihnen ein optimales Onlineerlebnis zu bieten, den Datenverkehr unserer Website zu analysieren und Sie mit personalisierten Werbungen zu unterstützen. Sie können der Erfassung aller Cookies zustimmen, indem Sie auf 'Alle akzeptieren und schließen' klicken, alle unwichtigen Cookies ablehnen, indem Sie auf 'Nur wichtige Cookies akzeptieren' klicken, oder Ihre Cookie-Einstellungen anpassen, indem Sie auf 'Cookies verwalten' klicken. Außerdem haben Sie das Recht, Ihre Zustimmung zu Cookies jederzeit zu widerrufen oder Ihre Cookie-Einstellungen zu ändern, indem Sie in der Fußzeile Ihrer Website oder in den Einstellungen Ihres Benutzerkontos (sofern verfügbar) auf den Link 'Cookies verwalten' klicken. Weitere Informationen finden Sie in unserer <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=de-DE>Cookie-Richtlinie</a>.\",\"essential_title\":\"Wichtige Cookies\",\"basic_title\":\"Allgemeine Analyse-Cookies\",\"advanced_title\":\"Erweiterte Analyse-Cookies\",\"marketing_title\":\"Marketing-Cookies\",\"btn_decline\":\"Nur wichtige Cookies akzeptieren\",\"btn_back\":\"Zurück\",\"btn_accept_selected\":\"Auswahl bestätigen\",\"btn_accept\":\"Alle akzeptieren und schließen\",\"btn_manage\":\"Cookies verwalten\",\"essential_text\":\"Diese Erstanbieter-Cookies sind für die Funktion und Sicherheit unserer Website und der benötigten Dienste erforderlich. Die Cookies werden üblicherweise als Folge Ihrer Aktionen gesetzt, um die Nutzung bestimmter Funktionen zu ermöglichen, z. B. um Ihre Cookie-Einstellungen zu speichern, sich zu anmelden oder um Elemente in Ihrem Einkaufswagen abzulegen. Sie können diese Cookies nicht deaktivieren und wenn Sie sie in einem Browser blockieren, kann die Funktion der Website beeinträchtigt werden.\",\"basic_text\":\"Mit diesen Erstanbieter-Cookies können wir die Anzahl der Besuchern/Benutzer unserer Website messen und aggregierte Nutzungs- und Leistungsstatistiken mithilfe unserer vertrauenswürdigen Partner erstellen. Wir verwenden diese, um einen grundlegenden Überblick über den Website-Datenverkehr und die Kampagnenleistung zu erhalten und um Bugs auf unserer Website zu beheben.\",\"advanced_text\":\"Mithilfe dieser Erstanbieter- oder Drittanbieter-Cookies können wir besser verstehen, wie Sie mit unserer Webseite und mit den angebotenen Diensten interagieren, da sie unsere Datensätze mit Daten von Drittanbieter-Tools anreichern. Wir verwenden diese Cookies, um unsere Website, unsere Dienste und das Benutzererlebnis zu verbessern, Fehler oder andere Probleme zu ermitteln und zu beheben und die Wirksamkeit unserer Kampagnen zu bewerten. \",\"marketing_text\":\"Mit diesen Cookies von Drittanbietern können unsere Marketingpartner einige Ihrer Aktivitäten auf unserer Website nachverfolgen, z. B. wenn Sie unser Produkt herunterladen oder kaufen, um mehr über Ihre Interessen und Bedürfnisse zu erfahren und Ihnen relevante, personalisierte Werbungen anzuzeigen.\"},\r\n  \"el-GR\":{\"title\":\"Επιλογή cookies, το απόρρητό σας\",\"description\":\"Η εταιρεία και οι συνεργάτες της χρησιμοποιούν cookies για να παρέχουν βελτιστοποιημένη διαδικτυακή εμπειρία στον χρήστη, να αναλύουν την επισκεψιμότητα του ιστότοπου και να προβάλλουν στον χρήστη εξατομικευμένες διαφημίσεις. Μπορείτε να συμφωνήσετε με τη συλλογή όλων των cookies, κάνοντας κλικ στην επιλογή «Αποδοχή όλων και κλείσιμο», να απορρίψετε όλα τα μη απαραίτητα cookies επιλέγοντας «Αποδοχή μόνο των απαραίτητων cookies» ή να προσαρμόσετε τις ρυθμίσεις για τα cookies κάνοντας κλικ στην επιλογή «Διαχείριση cookies». Επίσης, έχετε το δικαίωμα να αποσύρετε τη συγκατάθεσή σας για τα cookies ή να αλλάξετε τις προτιμήσεις σας για τα cookies ανά πάσα στιγμή, κάνοντας κλικ στον σύνδεσμο «Διαχείριση cookies» που βρίσκεται στο υποσέλιδο του ιστότοπου της εταιρείας ή στις ρυθμίσεις λογαριασμού σας (εάν είναι διαθέσιμος). Για περισσότερες πληροφορίες, ανατρέξτε στην <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=el-GR>Πολιτική για τα cookies</a>.\",\"essential_title\":\"Απαραίτητα cookies\",\"basic_title\":\"Βασικά cookies ανάλυσης\",\"advanced_title\":\"Προηγμένα cookies ανάλυσης\",\"marketing_title\":\"Cookies εμπορικής προώθησης\",\"btn_decline\":\"Αποδοχή μόνο των απαραίτητων cookies\",\"btn_back\":\"Πίσω\",\"btn_accept_selected\":\"Επιβεβαίωση των επιλογών μου\",\"btn_accept\":\"Αποδοχή όλων και κλείσιμο\",\"btn_manage\":\"Διαχείριση cookies\",\"essential_text\":\"Αυτά τα cookies της εταιρείας είναι απαραίτητα για τη λειτουργία και την ασφάλεια του ιστότοπου, καθώς και των υπηρεσιών που χρειάζεστε. Συνήθως, αυτά εφαρμόζονται ως απόκριση στις ενέργειές σας έτσι ώστε να επιτρέπουν τη χρήση ορισμένων λειτουργιών, όπως την απομνημόνευση των προτιμήσεων για τα cookies και τη σύνδεση ή τη διατήρηση αντικειμένων στο καλάθι σας. Δεν μπορείτε να εξαιρεθείτε από τα cookies αυτά, ενώ ο αποκλεισμός τους μέσω ενός προγράμματος περιήγησης μπορεί να επηρεάσει τη λειτουργικότητα του ιστότοπου.\",\"basic_text\":\"Αυτά τα cookies της εταιρείας επιτρέπουν στην εταιρεία να μετράει τον αριθμό επισκεπτών/χρηστών του ιστότοπου και να δημιουργεί συγκεντρωτικά στατιστικά στοιχεία χρήσης και επιδόσεων με τη βοήθεια των αξιόπιστων συνεργατών της. Αυτά τα στατιστικά στοιχεία χρησιμοποιούνται για να έχει η εταιρεία μια βασική εικόνα για την επισκεψιμότητα στον ιστότοπο και για τις επιδόσεις της διαφημιστικής εκστρατείας της εταιρείας, καθώς και για την επίλυση σφαλμάτων στον ιστότοπο της εταιρείας.\",\"advanced_text\":\"Αυτά τα cookies της εταιρείας ή άλλων κατασκευαστών βοηθούν την εταιρεία να αποκτήσει πληροφορίες σχετικά με τον τρόπο που αλληλεπιδρούν οι χρήστες με τον ιστότοπο και κάθε προσφερόμενη υπηρεσία, εμπλουτίζοντας τα σύνολα δεδομένων της εταιρείας με δεδομένα από εργαλεία άλλων κατασκευαστών. Η εταιρεία χρησιμοποιεί αυτά τα cookies για τη βελτίωση του ιστότοπου, των υπηρεσιών και της εμπειρίας του χρήστη, καθώς επίσης και για τον εντοπισμό και την επίλυση σφαλμάτων ή άλλων προβλημάτων που σχετίζονται με τα παραπάνω, αλλά και για την αξιολόγηση της αποτελεσματικότητας των διαφημιστικών εκστρατειών της εταιρείας. \",\"marketing_text\":\"Αυτά τα cookies τρίτων μερών επιτρέπουν στους συνεργάτες μάρκετινγκ να καταγράφουν ορισμένες από τις δραστηριότητες των χρηστών στον ιστότοπο (για παράδειγμα, τη λήψη ή αγορά προϊόντος της εταιρείας) έτσι ώστε να μάθουν για τα ενδιαφέροντα και τις ανάγκες σας και για να προβάλλουν στο χρήστη πιο στοχευμένες διαφημίσεις σχετικά.\"},\r\n  \"he-IL\":{\"title\":\"בחירת קובצי ה-Cookie שלך, הפרטיות שלך\",\"description\":\"אנו והשותפים שלנו משתמשים בקובצי Cookie כדי להעניק לך את החוויה המקוונת הטובה ביותר, לנתח את התעבורה באתר שלנו ולהציג לך מודעות מותאמות אישית. ניתן לאשר איסוף של כל קובצי ה-Cookie על ידי לחיצה על 'קבל הכול וסגור', לדחות את כל קובצי ה-Cookie הלא חיוניים על ידי בחירת 'קבל קובצי Cookie חיוניים בלבד' או להתאים את הגדרות קובצי ה-Cookie על ידי לחיצה על 'ניהול קובצי Cookie'. בנוסף, יש לך זכות לבטל את הסכמתך או לשנות את העדפות קובצי ה-Cookie שלך בכל עת על ידי לחיצה על הקישור 'ניהול קובצי Cookie' בכותרת התחתונה של האתר או בהגדרות החשבון שלך (אם זמין). לקבלת מידע נוסף, יש לעיין ב<a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=he-IL>מדיניות קובצי ה-Cookie</a> שלנו.\",\"essential_title\":\"קובצי Cookie חיוניים\",\"basic_title\":\"קובצי Cookie אנליטיים בסיסיים\",\"advanced_title\":\"קובצי Cookie אנליטיים מתקדמים\",\"marketing_title\":\"קובצי Cookie של שיווק\",\"btn_decline\":\"קבל קובצי Cookie חיוניים בלבד\",\"btn_back\":\"חזרה\",\"btn_accept_selected\":\"אשר את הבחירות שלי\",\"btn_accept\":\"קבל הכול וסגור\",\"btn_manage\":\"ניהול קובצי Cookie\",\"essential_text\":\"קובצי Cookie של צד ראשון נחוצים לתפקוד ולאבטחה של אתר האינטרנט שלנו והשירותים הדרושים לך. הם בדרך כלל מוגדרים בתגובה לפעולות שלך כדי לאפשר שימוש בפונקציונליות מסוימת, כגון שמירת העדפות קובצי ה-Cookie שלך, התחברות או שמירת פריטים בעגלת הקניות. לא ניתן לבטל את השימוש בקובצי Cookie אלה, וחסימתם באמצעות דפדפן עשויה להשפיע על פונקציונליות האתר.\",\"basic_text\":\"קובצי Cookie אלה של צד ראשון מאפשרים לנו למדוד את מספר המבקרים/המשתמשים באתר שלנו וליצור נתונים סטטיסטיים מצטברים של שימוש וביצועים בעזרת השותפים המהימנים שלנו. אנו משתמשים בהם כדי לקבל תובנות בסיסיות לגבי התנועה באתר שלנו וביצועי הקמפיין שלנו וכדי לפתור באגים באתר שלנו.\",\"advanced_text\":\"קובצי Cookie של צד ראשון או שלישי עוזרים לנו להבין את האינטראקציה שלך עם אתר האינטרנט שלנו ועם כל שירות שמוצע על ידי העשרת ערכות הנתונים שלנו בנתונים מכלים של צד שלישי. אנו משתמשים בקובצי Cookie אלה כדי לשפר את אתר האינטרנט, השירותים וחוויית המשתמש שלנו, למצוא ולפתור באגים או בעיות אחרות בהם ולהעריך את יעילות הקמפיינים שלנו. \",\"marketing_text\":\"קובצי Cookie אלה של צד שלישי מאפשרים לשותפי השיווק שלנו לעקוב אחר חלק מהפעילויות שלך באתר האינטרנט שלנו (לדוגמה, כאשר אתה מוריד או קונה את המוצר שלנו) כדי ללמוד על תחומי העניין והצרכים שלך ולהציג לך מודעות ממוקדות ורלוונטיות יותר.\"},\r\n  \"hu-HU\":{\"title\":\"A kiválasztott sütik és az adatvédelem\",\"description\":\"Mi és partnereink sütiket használunk, hogy a legjobb optimalizált online élményt nyújthassuk Önnek, elemezzük weboldalunk forgalmát, hogy személyre szabott hirdetésekkel szolgálhassunk Önnek. A 'Mindet elfogadom és bezárom' gombra kattintva hozzájárulhat az összes süti begyűjtéséhez, a 'Csak az alapvető sütik elfogadása' gombra kattintva elutasíthatja az összes nem alapvető süti gyűjtését, a 'Sütik kezelése' gombra kattintva pedig módosíthatja a sütibeállításokat. Emellett bármikor joga van visszavonni a hozzájárulását vagy módosítani a sütibeállításokat a 'Sütik kezelése' gombra kattintva a webhelyünk láblécében vagy a fiókbeállításokban (ha van ilyen lehetőség). További információkért tekintse meg a <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=hu-HU>sütik kezelésével kapcsolatos szabályzatunkat</a>.\",\"essential_title\":\"Alapvető sütik\",\"basic_title\":\"Alapvető analitikai sütik\",\"advanced_title\":\"Fejlett analitikai sütik\",\"marketing_title\":\"Marketing sütik\",\"btn_decline\":\"Csak az alapvető sütik elfogadása\",\"btn_back\":\"Vissza\",\"btn_accept_selected\":\"A kiválasztott beállítások megerősítése\",\"btn_accept\":\"Mindet elfogadom és bezárom\",\"btn_manage\":\"Sütik kezelése\",\"essential_text\":\"Ezek az első féltől származó sütik a weboldalunk és az Ön által igényelt szolgáltatások működéséhez és védelméhez szükségesek. A sütik az Ön igényeinek figyelembevételével kerülnek beállításra, hogy lehetővé tegyük bizonyos funkciók használatát, például a sütibeállítások megjegyzését, a bejelentkezést, illetve a kosárba tett tételek megőrzését. Ezeket a sütiket nem lehet letiltani, és a böngészőn keresztül történő blokkolásuk befolyásolhatja a webhely működését.\",\"basic_text\":\"Az első féltől származó sütik lehetővé teszik számunkra, hogy lemérjük webhelyünk látogatóinak/felhasználóinak számát, és megbízható partnereink segítségével összesített használati és teljesítménybeli statisztikákat hozzunk létre. Ezeket a statisztikákat arra használjuk, hogy alapvető betekintést nyerhessünk webhelyünk forgalmi- és kampányaink teljesítmény-adataiba, valamint arra, hogy kijavíthassuk a webhelyünkön található hibákat.\",\"advanced_text\":\"Az első vagy harmadik féltől származó sütik segítségével jobban meg tudjuk érteni az Ön és a webhely, illetve az egyes felkínált szolgáltatások között történő interakciót azáltal, hogy adatkészleteinket harmadik féltől származó eszközök adataival töltjük fel. A sütiket arra használjuk, hogy fejlesszük webhelyünket, szolgáltatásainkat, növeljük a felhasználói élményt, megtaláljuk és elhárítsuk a hibákat vagy egyéb problémákat, és kiértékeljük kampányaink hatékonyságát. \",\"marketing_text\":\"A harmadik féltől származó sütik lehetővé teszik marketingpartnereink számára, hogy nyomon követhessék az Ön tevékenységeit a webhelyünkön (például amikor letölti vagy megvásárolja termékünket), ezáltal felmérhessék az Ön érdeklődési köreit és igényeit, és így relevánsabb célzott hirdetéseket jeleníthessenek meg Önnek.\"},\r\n  \"id-ID\":{\"title\":\"Pilihan cookie Anda, privasi Anda\",\"description\":\"Kami dan mitra kami menggunakan cookie untuk memberikan pengalaman online terbaik yang dioptimalkan, menganalisis lalu lintas situs web, dan melayani Anda dengan iklan yang dipersonalisasi. Anda dapat menyetujui pengumpulan semua cookie dengan mengeklik 'Terima semua dan tutup', menolak semua cookie non-esensial dengan memilih 'Terima cookie penting saja', atau menyesuaikan pengaturan cookie Anda dengan mengeklik 'Kelola cookie'. Anda juga memiliki hak untuk membatalkan persetujuan cookie kapan saja dengan mengeklik tautan 'Kelola cookie' di footer situs web kami atau di penyiapan akun (jika ada). Untuk informasi selengkapnya, silakan lihat <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=id-ID>Kebijakan Cookie</a> kami.\",\"essential_title\":\"Cookie penting\",\"basic_title\":\"Cookie analitis dasar\",\"advanced_title\":\"Cookie analitis tingkat lanjut\",\"marketing_title\":\"Cookie pemasaran\",\"btn_decline\":\"Terima cookie penting saja\",\"btn_back\":\"Kembali\",\"btn_accept_selected\":\"Konfirmasi pilihan saya\",\"btn_accept\":\"Terima semua dan tutup\",\"btn_manage\":\"Kelola cookie\",\"essential_text\":\"Cookie pihak pertama ini diperlukan untuk fungsi dan keamanan situs web kami serta layanan yang Anda butuhkan. Cookie ini biasanya diatur sebagai tanggapan atas tindakan Anda untuk memungkinkan penggunaan fungsi tertentu, seperti mengingat preferensi cookie, akses masuk, atau menyimpan barang di keranjang. Anda tidak dapat memilih keluar dari cookie ini, dan memblokir cookie melalui browser dapat memengaruhi fungsionalitas situs.\",\"basic_text\":\"Cookie pihak pertama ini memungkinkan kami mengukur jumlah pengunjung/pengguna situs web dan membuat statistik penggunaan dan kinerja agregat dengan bantuan mitra tepercaya kami. Kami menggunakannya untuk mendapatkan wawasan dasar tentang lalu lintas situs web dan kinerja kampanye, dan untuk memecahkan bug di situs web kami.\",\"advanced_text\":\"Cookie pihak pertama atau ketiga ini membantu kami memahami cara Anda berinteraksi dengan situs web kami dan setiap layanan yang ditawarkan dengan memperkaya kumpulan data kami menggunakan data dari perangkat pihak ketiga. Kami menggunakan cookie ini untuk meningkatkan situs web, layanan, dan pengalaman pengguna, menemukan dan memecahkan bug atau masalah lain, serta mengevaluasi efektivitas kampanye kami. \",\"marketing_text\":\"Cookie pihak ketiga ini memungkinkan mitra pemasaran kami untuk melacak beberapa aktivitas Anda di situs web kami (misalnya, ketika Anda mengunduh atau membeli produk kami) untuk mempelajari minat dan kebutuhan Anda serta untuk menunjukkan iklan bertarget yang lebih relevan.\"},\r\n  \"it-IT\":{\"title\":\"Gestisci la scelta dei cookie e della privacy\",\"description\":\"La Società e i relativi partner utilizzano i cookie per offrire all’utente un’esperienza online ottimizzata, analizzare il traffico sul proprio sito web e fornire annunci pubblicitari personalizzati. L’utente può accettare la raccolta di tutti i cookie facendo clic su “Accetta tutto e chiudi”, rifiutare tutti i cookie non essenziali scegliendo “Accetta solo cookie essenziali” o modificare le impostazioni relative ai cookie facendo clic su “Gestisci cookie”. L’utente ha anche il diritto di revocare il consenso ai cookie o di modificare le preferenze relative ai cookie in qualsiasi momento facendo clic sul collegamento “Gestisci cookie” presente nella nota a piè di pagina del sito web aziendale o nelle impostazioni dell’account (se disponibili). Per ulteriori informazioni, consultare la <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=it-IT>Politica aziendale sui cookie</a>.\",\"essential_title\":\"Cookie essenziali\",\"basic_title\":\"Cookie analitici di base\",\"advanced_title\":\"Cookie analitici avanzati\",\"marketing_title\":\"Cookie di marketing\",\"btn_decline\":\"Accetta solo cookie essenziali\",\"btn_back\":\"Indietro\",\"btn_accept_selected\":\"Conferma le scelte\",\"btn_accept\":\"Accetta tutto e chiudi\",\"btn_manage\":\"Gestisci cookie\",\"essential_text\":\"Questi cookie di prima parte sono necessari ai fini del funzionamento e della sicurezza del sito web aziendale e dei servizi richiesti dall’utente. Vengono solitamente impostati in risposta alle azioni dell’utente allo scopo di abilitare l’utilizzo di specifiche funzionalità, come ad esempio la memorizzazione delle preferenze relative ai cookie, l’autenticazione o il posizionamento di articoli nel carrello. Non è possibile rifiutarli e il blocco tramite browser potrebbe compromettere la funzionalità del sito.\",\"basic_text\":\"Questi cookie di prima parte consentono alla Società di misurare il numero di visitatori/utenti del proprio sito web e di creare statistiche aggregate sull’utilizzo e sulle prestazioni con l’aiuto dei propri partner fidati. Vengono utilizzati per ottenere informazioni di base sul traffico sul sito web aziendale e sulle prestazioni delle campagne e per risolvere bug sul sito web aziendale.\",\"advanced_text\":\"Questi cookie di prima o terza parte aiutano la Società a comprendere le modalità di interazione dell’utente con il sito web aziendale e con ciascun servizio offerto attraverso l’arricchimento dei set di dati aziendali con i dati ricavati dall’utilizzo di strumenti di terze parti. La Società utilizza questi cookie allo scopo di migliorare il sito web aziendale, i servizi e l’esperienza degli utenti, individuare e risolvere bug o altri problemi con questi cookie e valutare l’efficacia delle proprie campagne. \",\"marketing_text\":\"Questi cookie di terze parti consentono ai partner di marketing della Società di monitorare alcune attività dell’utente sul sito web aziendale (ad esempio, durante il download o l’acquisto del prodotto) allo scopo di conoscerne gli interessi, le esigenze e di mostrare gli annunci pubblicitari mirati più rilevanti.\"},\r\n  \"ja-JP\":{\"title\":\"Cookieの選択、プライバシー\",\"description\":\"ESETおよびESETのパートナーはCookieを使用して、最も最適化されたオンラインエクスペリエンスを実現し、ESET Webサイトのトラフィックを分析し、お客様にパーソナル化された広告を提供します。[すべてに同意して閉じる]をクリックしてすべてのCookieの収集に同意するか、[必須のCookieのみを許可]をクリックして、必須ではないCookieのすべてを拒否するか、[Cookieの管理]をクリックしてCookie設定を調整できます。また、お客様はいつでも、Webサイトのフッターまたはアカウント設定(使用可能な場合)の[Cookieの管理]リンクをクリックして、Cookieに対する同意を取り消したり、Cookie設定を変更したりする権利があります。詳細については、<a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ja-JP>Cookieポリシー</a>を参照してください。\",\"essential_title\":\"必須のCookie\",\"basic_title\":\"基本分析のためのCookie\",\"advanced_title\":\"高度な分析のためのCookie\",\"marketing_title\":\"マーケティングCookie\",\"btn_decline\":\"必須のCookieのみを許可\",\"btn_back\":\"戻る\",\"btn_accept_selected\":\"選択内容の確認\",\"btn_accept\":\"すべてに同意して閉じる\",\"btn_manage\":\"Cookieの管理\",\"essential_text\":\"これらのファーストパーティCookieは、当社のWebサイトおよびお客様が必要とするサービスの機能とセキュリティに必要です。これらは通常、Cookie設定の記憶、ログイン、カート内の品物の保存などの特定の機能の使用を有効にするために、ユーザーアクションに対応して設定されます。これらのCookieをオプトアウトし、ブラウザー経由でブロックすると、サイト機能に影響する可能性があります。\",\"basic_text\":\"このファーストパーティCookieを使用することによって、ESETは、信頼できるパートナーの支援を受け、ESET Webサイトの訪問者数/ユーザー数を測定し、集約された使用状況とパフォーマンス統計情報を作成できます。ESETはそれらを使用して、Webサイトトラフィックとキャンペーンパフォーマンスに関する基本的な分析情報を得て、Webサイトの不具合を解決します。\",\"advanced_text\":\"これらのファーストパーティCookieとサードパーティCookieは、サードパーティツールのデータを使用してデータセットを充実させることで、お客様がESETのWebサイトおよび各サービスを操作する方法を分析するために役立ちます。ESETは、これらのCookieを使用して、Webサイト、サービス、ユーザーエクスペリエンスの向上、不具合や他の問題の検出と解決、キャンペーン効果の評価を行います。\",\"marketing_text\":\"これらのサードパーティCookieを使用すると、ESETのマーケティングパートナーは、Webサイトでのアクティビティの一部(製品のダウンロードまたは購入など)を追跡して、お客様の関心とニーズを把握し、関連性が高いターゲット広告を表示できます。\"},\r\n  \"kk-KZ\":{\"title\":\"Құпиялылығыңыз қандай cookie файл таңдағаныңызға байланысты болады\",\"description\":\"Біз және серіктестеріміз сізге ең жақсы оңтайландырылған онлайн тәжірибені беру, веб-сайт трафигін талдау және сізге дербестендірілген хабарландырулармен қызмет көрсету үшін cookie файлдарын пайдаланамыз. «Барлығын қабылдау және жабу» түймешігін басу арқылы барлық cookie файлын жинауға келісе аласыз немесе «Негізгі Cookie файлдарын қабылдау» түймешігін таңдау арқылы барлық маңызды емес cookie файлынан бас тарта аласыз, я болмаса «Cookie файлдарын басқару» түймешігін басу арқылы cookie файлы орнатуларын реттей аласыз. Сондай-ақ кез келген уақытта cookie файлдарына қатысты берген келісіміңізді қайтарып алуға немесе cookie файлы параметрлерін өзгертуге құқығыңыз бар. Ол үшін кез келген уақытта веб-сайтымыздың төменгі жағындағы немесе есептік жазба орнатуларындағы (егер болса) «Cookie файлдарын басқару» сілтемесін басыңыз. Қосымша ақпарат алу үшін <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=kk-KZ>Cookie саясатын</a> қараңыз.\",\"essential_title\":\"Негізгі cookie файлдары\",\"basic_title\":\"Негізгі аналитикалық cookie файлдары\",\"advanced_title\":\"Алдыңғы қатарлы аналитикалық cookie файлдары\",\"marketing_title\":\"Маркетингтік cookies файлдары\",\"btn_decline\":\"Тек маңызды cookie файлдарын қабылдау\",\"btn_back\":\"Артқа\",\"btn_accept_selected\":\"Таңдауларымды растау\",\"btn_accept\":\"Барлығын қабылдау және жабу\",\"btn_manage\":\"Cookie файлдарын басқару\",\"essential_text\":\"Осы бірінші тарап cookie файлдары веб-сайтымыздың және қажетті қызметтердің жұмыс істеуі мен қауіпсіздігін қамтамасыз ету үшін қажет. Олар әдетте cookie параметрлерін есте сақтау, кіру немесе заттарды арбада ұстап тұру сияқты белгілі бір функцияларды пайдалануға мүмкіндік беретін әрекеттеріңізге жауап ретінде орнатылады. Бұл cookie файлдарынан бас тарту мүмкін емес және оларды браузер арқылы блоктау сайттың функционалдығына әсер етуі мүмкін.\",\"basic_text\":\"Осы бірінші тарап cookie файлдары веб-сайтымызға келушілер/пайдаланушылар санын есептеуге және сенімді серіктестеріміздің көмегімен біріктірілген пайдалану және өнімділік статистикасын жасауға мүмкіндік береді. Біз оларды веб-сайт трафигі мен үгіт-насихат көрсеткіштері туралы негізгі мағлұмат алу үшін және веб-сайтымыздағы қателерді шешу үшін пайдаланамыз.\",\"advanced_text\":\"Бірінші немесе үшінші тараптың осы cookie файлдары веб-сайтымызбен және ұсынылатын әр қызметпен қалай қарым-қатынас жасайтыныңызды түсінуге көмектеседі, дерекқорымызды үшінші тарап құралдарынан алынған мәліметтермен байытады. Біз осы cookie файлдарын веб-сайтымызды, қызметтерімізді және пайдаланушыларға ыңғайлылығымызды жақсарту, қателерді немесе басқа мәселелерді табу және жою, сондай-ақ науқандарымыздың тиімділігін бағалау үшін қолданамыз. \",\"marketing_text\":\"Бұл үшінші тараптық cookie файлдары біздің маркетингтік серіктестерімізге сіздің мүдделеріңіз бен қажеттіліктеріңіз туралы білу және сізге неғұрлым өзекті мақсатты хабарландыруларды көрсету үшін біздің веб-сайтымыздағы кейбір әрекеттеріңізді (мысалы, біздің өнімімізді жүктеген немесе сатып алған кезде) қадағалауға мүмкіндік береді.\"},\r\n  \"ko-KR\":{\"title\":\"쿠키 선택 사항, 개인 정보 보호\",\"description\":\"당사와 당사의 파트너는 쿠키를 사용하여 최적의 온라인 환경을 제공하고, 웹 사이트 트래픽을 분석하고, 개인화된 광고를 제공합니다. '모두 수락 및 닫기'를 클릭하여 모든 쿠키 수집에 동의하거나 '필수 쿠키만 수락'을 선택하여 필수가 아닌 쿠키를 모두 거부하거나 '쿠키 관리'를 클릭하여 쿠키 설정을 조정할 수 있습니다. 또한 웹 사이트 바닥글 또는 계정 설정(사용 가능한 경우)에서 '쿠키 관리' 링크를 클릭하여 언제든지 동의를 철회하거나 쿠키 기본 설정을 변경할 권한이 있습니다. 자세한 내용은 <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ko-KR>쿠키 정책</a>을 참조하십시오.\",\"essential_title\":\"필수 쿠키\",\"basic_title\":\"기본 분석 쿠키\",\"advanced_title\":\"고급 분석 쿠키\",\"marketing_title\":\"마케팅 쿠키\",\"btn_decline\":\"필수 쿠키만 수락\",\"btn_back\":\"뒤로\",\"btn_accept_selected\":\"선택 확인\",\"btn_accept\":\"모두 수락 및 닫기\",\"btn_manage\":\"쿠키 관리\",\"essential_text\":\"이러한 자사 쿠키는 당사 웹 사이트의 기능 및 보안과 귀하에게 필요한 서비스에 필요합니다. 해당 쿠키는 일반적으로 쿠키 기본 설정 기억, 로그인 또는 장바구니에 항목을 보관하는 등 특정 기능을 사용할 수 있도록 작업에 대한 응답으로 설정됩니다. 이러한 쿠키를 수신 거부할 수 없으며 브라우저를 통해 쿠키를 차단하면 사이트 기능에 영향을 줄 수 있습니다.\",\"basic_text\":\"이러한 자사 쿠키를 사용하면 웹 사이트의 방문자/사용자 수를 측정하고 신뢰할 수 있는 파트너의 도움을 받아 집계된 사용 및 성능 통계를 생성할 수 있습니다. 당사는 웹 사이트 트래픽과 캠페인 성과에 대한 기본적인 통찰력을 얻고 웹 사이트의 버그를 해결하기 위해 이를 사용합니다.\",\"advanced_text\":\"이러한 자사 또는 타사 쿠키는 타사 도구의 데이터로 데이터 집합을 보강하여 당사 웹 사이트 및 제공되는 각 서비스와 상호 작용하는 방식을 이해할 수 있도록 도와줍니다. 당사는 이러한 쿠키를 사용하여 웹 사이트, 서비스 및 사용자 환경을 개선하고 버그 또는 기타 문제를 찾아 해결하며 캠페인의 효과를 평가합니다. \",\"marketing_text\":\"당사의 마케팅 파트너는 이러한 타사 쿠키를 통해 당사 웹 사이트에서 귀하의 일부 활동을 추적하여(예: 귀하가 당사 제품을 다운로드하거나 구매할 때) 귀하의 관심사와 요구에 대해 알아보고 관련성이 있는 타겟 광고를 게재할 수 있습니다.\"},\r\n  \"lv-LV\":{\"title\":\"Jūsu sīkfailu izvēle, jūsu konfidencialitāte\",\"description\":\"Mūsu uzņēmums un mūsu partneri izmanto sīkfailus, lai nodrošinātu jums vislabāko optimizēto pieredzi tiešsaistē, analizētu mūsu tīmekļa vietnes datplūsmu un rādītu jums personalizētas reklāmas. Jūs varat piekrist visu sīkfailu vākšanai, noklikšķinot uz “Pieņemt visu un aizvērt”, noraidīt visus nebūtiskos sīkfailus, izvēloties “Pieņemt tikai būtiskos sīkfailus”, vai pielāgot sīkfailu iestatījumus, noklikšķinot uz “Pārvaldīt sīkfailus”. Jums ir arī tiesības jebkurā laikā atsaukt savu piekrišanu attiecībā uz sīkfailiem vai mainīt preferences attiecībā uz sīkfailiem, noklikšķinot uz saites “Pārvaldīt sīkfailus” mūsu tīmekļa vietnes kājenē vai konta iestatījumu sadaļā (ja tā ir pieejama). Papildinformāciju skatiet mūsu <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=lv-LV>sīkfailu politikā</a>.\",\"essential_title\":\"Būtiskie sīkfaili\",\"basic_title\":\"Pamata analītiskie sīkfaili\",\"advanced_title\":\"Papildu analītiskie sīkfaili\",\"marketing_title\":\"Mārketinga sīkfaili\",\"btn_decline\":\"Pieņemt tikai būtiskos sīkfailus\",\"btn_back\":\"Atpakaļ\",\"btn_accept_selected\":\"Apstiprināt manas izvēles\",\"btn_accept\":\"Pieņemt visu un aizvērt\",\"btn_manage\":\"Pārvaldīt sīkfailus\",\"essential_text\":\"Šie pirmās puses sīkfaili ir nepieciešami mūsu tīmekļa vietnes un jums nepieciešamo pakalpojumu darbības un drošības nodrošināšanai. Tie parasti tiek iestatīti, reaģējot uz jūsu darbībām, lai iespējotu noteiktas funkcijas izmantošanu, piemēram, atcerētos jūsu sīkfailu preferences, pieteikšanās informāciju vai saglabātu jūsu preces grozā. Jūs nevar atteikties no šiem sīkfailiem, un to bloķēšana, izmantojot pārlūkprogrammu, var ietekmēt vietnes funkcionalitāti.\",\"basic_text\":\"Šie pirmās puses sīkfaili sniedz iespēju noteikt mūsu tīmekļa vietnes apmeklētāju/lietotāju skaitu un izveidot apkopotu lietojuma un veiktspējas statistiku, izmantojot mūsu uzticamo partneru sniegto palīdzību. Mēs izmantojam šos sīkfailus, lai iegūtu pamata ieskatus par mūsu tīmekļa vietnes datplūsmu un kampaņu veiktspēju, kā arī, lai novērstu tīmekļa vietnes kļūdas.\",\"advanced_text\":\"Šie pirmās vai trešās puses sīkfaili palīdz mums izprast lietotāju mijiedarbību ar mūsu tīmekļa vietni un katru piedāvāto pakalpojumu, bagātinot mūsu datu kopas ar datiem no trešo pušu rīkiem. Mēs izmantojam šos sīkfailus, lai uzlabotu savu tīmekļa vietni, pakalpojumus un lietotāju pieredzi, atrastu un novērstu kļūdas vai citas problēmas un novērtētu savu kampaņu efektivitāti. \",\"marketing_text\":\"Šie trešo pušu sīkfaili ļauj mūsu mārketinga partneriem izsekot dažas no jūsu darbībām mūsu tīmekļa vietnē (piemēram, kad lejupielādējat vai iegādājaties mūsu produktu), lai uzzinātu par jūsu interesēm un vajadzībām un parādītu jums atbilstošākas mērķētas reklāmas.\"},\r\n  \"lt-LT\":{\"title\":\"Jūsų slapukų pasirinkimas, jūsų privatumas\",\"description\":\"Mes ir mūsų partneriai naudojame slapukus tam, kad suteiktume jums geriausią optimizuotą patirtį internete, analizuotume svetainės srautą ir teiktume jums pritaikytus skelbimus. Galite sutikti su visų slapukų rinkimu spustelėdami „Priimti visus ir uždaryti“, atmesti visus netechninius slapukus pasirinkdami „Priimti tik techninius slapukus“ arba koreguoti slapukų nustatymus spustelėdami „Tvarkyti slapukus“. Taip pat turite teisę bet kada atšaukti savo sutikimą arba pakeisti slapukų nustatymus spustelėdami nuorodą „Tvarkyti slapukus“ mūsų svetainės poraštėje arba savo paskyros nustatymuose (jei yra). Daugiau informacijos rasite mūsų <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=lt-LT>slapukų politikoje</a>.\",\"essential_title\":\"Techniniai slapukai\",\"basic_title\":\"Pagrindiniai veiklos slapukai\",\"advanced_title\":\"Išplėstiniai veiklos slapukai\",\"marketing_title\":\"Tiksliniai ar reklaminiai slapukai\",\"btn_decline\":\"Priimti tik techninius slapukus\",\"btn_back\":\"Atgal\",\"btn_accept_selected\":\"Patvirtinti mano pasirinkimus\",\"btn_accept\":\"Priimti visus ir uždaryti\",\"btn_manage\":\"Tvarkyti slapukus\",\"essential_text\":\"Šie slapukai yra būtini mūsų svetainės veikimui ir saugumui bei reikalingoms paslaugoms užtikrinti. Paprastai jie nustatomi atsižvelgiant į jūsų veiksmus, kad būtų galima naudotis tam tikromis funkcijomis, pvz., prisiminti jūsų slapukų nuostatas, prisijungti ar laikyti prekes krepšelyje. Negalite atsisakyti šių slapukų, o jų blokavimas naršyklėje gali turėti įtakos korektiškam svetainės veikimui.\",\"basic_text\":\"Šie pirmosios šalies slapukai leidžia įvertinti svetainės lankytojų skaičių ir, padedant patikimiems partneriams, kaupti naudojimo ir našumo statistiką. Juos naudojame norėdami gauti pagrindinę informaciją apie mūsų svetainės srautą ir našumą bei pašalinti klaidas svetainėje.\",\"advanced_text\":\"Šie slapukai padeda mums suprasti, kaip sąveikaujate su mūsų svetaine bei kiekviena siūloma paslauga, ir praturtina mūsų duomenų rinkinius trečiųjų šalių įrankių duomenimis. Šiuos slapukus naudojame norėdami patobulinti savo svetainę, paslaugas ir naudotojų patirtį, rasti ir išspręsti susijusias klaidas ar kitas problemas ir įvertinti kampanijų veiksmingumą. \",\"marketing_text\":\"Šie slapukai naudojami tam, kad rodytų reklaminius skelbimus, kurie turėtų būti įdomūs būtent Jums ir atitikti Jūsų interesus. Šie slapukai nerenka informacijos, leidžiančios atpažinti Svetainės lankytoją. Šie slapukai gali būti išjungti, o reklaminiai skelbimai nebus rodomi.\"},\r\n  \"nn-NO\":{\"title\":\"Ditt valg av informasjonskapsler – ditt personvern\",\"description\":\"Vi og partnerne våre bruker informasjonskapsler for å gi deg den best optimaliserte nettopplevelsen, analysere trafikken på nettstedet vårt og vise deg personlig tilpassede annonser. Du kan godta innsamling av alle informasjonskapsler ved å klikke på «Godta alle og lukk», avvise alle ikke-essensielle informasjonskapsler ved å velge «Godta kun essensielle informasjonskapsler» eller justere oppsettene for informasjonskapsler ved å klikke på «Administrer informasjonskapsler». Du har også rett til å trekke tilbake samtykket eller endre preferansene dine for informasjonskapsler når som helst ved å klikke på koblingen «Administrer informasjonskapsler» i bunnteksten på nettstedet vårt eller i kontooppsettene dine (dersom disse er tilgjengelige). For å få mer informasjon, se <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=nb-NO>retningslinjene våre for informasjonskapsler</a>.\",\"essential_title\":\"Viktige informasjonskapsler\",\"basic_title\":\"Grunnleggende analytiske informasjonskapsler\",\"advanced_title\":\"Avanserte analytiske informasjonskapsler\",\"marketing_title\":\"Markedsføringsinformasjonskapsler\",\"btn_decline\":\"Godta kun essensielle informasjonskapsler\",\"btn_back\":\"Tilbake\",\"btn_accept_selected\":\"Bekreft mine valg\",\"btn_accept\":\"Godta alle og lukk\",\"btn_manage\":\"Administrer informasjonskapsler\",\"essential_text\":\"Disse førsteparts informasjonskapslene er nødvendige for funksjonaliteten og sikkerheten til nettstedet vårt og tjenestene du trenger. De blir vanligvis angitt som følge av handlingene dine for å aktivere bruken av visse funksjoner, for eksempel for å huske preferansene dine for informasjonskapsler, logge på eller huske varer i handlekurven. Du kan ikke velge bort disse informasjonskapslene, og hvis du blokkerer dem via nettleseren, kan det påvirke nettstedets funksjonalitet.\",\"basic_text\":\"Med disse førsteparts informasjonskapslene kan vi måle antall besøkende / brukere av nettstedet vårt og lage sammenstilt bruks- og ytelsesstatistikk med hjelp fra våre betrodde partnere. Vi bruker dem til å få grunnleggende innsikt i nettstedstrafikken vår og kampanjeresultatene våre samt for å løse feil på nettstedet vårt.\",\"advanced_text\":\"Med disse første- eller tredjeparts informasjonskapslene kan vi forstå hvordan du samhandler med nettstedet vårt og de ulike tjenestene vi tilbyr, ved å berike datasettene våre med data fra tredjepartsverktøy. Vi bruker disse informasjonskapslene til å forbedre nettstedet vårt, tjenestene våre og brukeropplevelsen vår, finne og løse feil eller andre problemer samt evaluere effektiviteten av kampanjene våre. \",\"marketing_text\":\"Disse tredjeparts informasjonskapslene lar markedsføringspartnerne våre spore noen av aktivitetene dine på nettstedet vårt (for eksempel når du laster ned eller kjøper produktet vårt) for å lære om interessene og behovene dine og vise deg mer relevante målrettede annonser.\"},\r\n  \"nb-NO\":{\"title\":\"Ditt valg av informasjonskapsler – ditt personvern\",\"description\":\"Vi og partnerne våre bruker informasjonskapsler for å gi deg den best optimaliserte nettopplevelsen, analysere trafikken på nettstedet vårt og vise deg personlig tilpassede annonser. Du kan godta innsamling av alle informasjonskapsler ved å klikke på «Godta alle og lukk», avvise alle ikke-essensielle informasjonskapsler ved å velge «Godta kun essensielle informasjonskapsler» eller justere oppsettene for informasjonskapsler ved å klikke på «Administrer informasjonskapsler». Du har også rett til å trekke tilbake samtykket eller endre preferansene dine for informasjonskapsler når som helst ved å klikke på koblingen «Administrer informasjonskapsler» i bunnteksten på nettstedet vårt eller i kontooppsettene dine (dersom disse er tilgjengelige). For å få mer informasjon, se <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=nb-NO>retningslinjene våre for informasjonskapsler</a>.\",\"essential_title\":\"Viktige informasjonskapsler\",\"basic_title\":\"Grunnleggende analytiske informasjonskapsler\",\"advanced_title\":\"Avanserte analytiske informasjonskapsler\",\"marketing_title\":\"Markedsføringsinformasjonskapsler\",\"btn_decline\":\"Godta kun essensielle informasjonskapsler\",\"btn_back\":\"Tilbake\",\"btn_accept_selected\":\"Bekreft mine valg\",\"btn_accept\":\"Godta alle og lukk\",\"btn_manage\":\"Administrer informasjonskapsler\",\"essential_text\":\"Disse førsteparts informasjonskapslene er nødvendige for funksjonaliteten og sikkerheten til nettstedet vårt og tjenestene du trenger. De blir vanligvis angitt som følge av handlingene dine for å aktivere bruken av visse funksjoner, for eksempel for å huske preferansene dine for informasjonskapsler, logge på eller huske varer i handlekurven. Du kan ikke velge bort disse informasjonskapslene, og hvis du blokkerer dem via nettleseren, kan det påvirke nettstedets funksjonalitet.\",\"basic_text\":\"Med disse førsteparts informasjonskapslene kan vi måle antall besøkende / brukere av nettstedet vårt og lage sammenstilt bruks- og ytelsesstatistikk med hjelp fra våre betrodde partnere. Vi bruker dem til å få grunnleggende innsikt i nettstedstrafikken vår og kampanjeresultatene våre samt for å løse feil på nettstedet vårt.\",\"advanced_text\":\"Med disse første- eller tredjeparts informasjonskapslene kan vi forstå hvordan du samhandler med nettstedet vårt og de ulike tjenestene vi tilbyr, ved å berike datasettene våre med data fra tredjepartsverktøy. Vi bruker disse informasjonskapslene til å forbedre nettstedet vårt, tjenestene våre og brukeropplevelsen vår, finne og løse feil eller andre problemer samt evaluere effektiviteten av kampanjene våre. \",\"marketing_text\":\"Disse tredjeparts informasjonskapslene lar markedsføringspartnerne våre spore noen av aktivitetene dine på nettstedet vårt (for eksempel når du laster ned eller kjøper produktet vårt) for å lære om interessene og behovene dine og vise deg mer relevante målrettede annonser.\"},\r\n  \"pl-PL\":{\"title\":\"Twój wybór plików cookie, Twoja prywatność\",\"description\":\"Wraz z naszymi partnerami używamy plików cookie, aby zapewnić Ci optymalną obsługę online, analizować ruch na naszej stronie internetowej i dostarczać Ci spersonalizowane reklamy. Możesz zgodzić się na gromadzenie wszystkich plików cookie, klikając przycisk „Zaakceptuj wszystkie i zamknij”, odrzucić wszystkie niepotrzebne pliki cookie, wybierając opcję „Akceptuj tylko niezbędne pliki cookie”, lub dostosować ustawienia plików cookie, klikając link „Zarządzaj plikami cookie” w stopce naszej witryny lub w ustawieniach konta (jeśli są dostępne). Aby uzyskać więcej informacji, zapoznaj się z naszą <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=pl-PL>Polityką dotyczącą plików cookie</a>.\",\"essential_title\":\"Niezbędne pliki cookie\",\"basic_title\":\"Podstawowe analityczne pliki cookie\",\"advanced_title\":\"Zaawansowane analityczne pliki cookie\",\"marketing_title\":\"Marketingowe pliki cookie\",\"btn_decline\":\"Akceptuj tylko niezbędne pliki cookie\",\"btn_back\":\"Wstecz\",\"btn_accept_selected\":\"Potwierdź wybór\",\"btn_accept\":\"Zaakceptuj wszystkie i zamknij\",\"btn_manage\":\"Zarządzaj plikami cookie\",\"essential_text\":\"Własne pliki cookie są niezbędne do funkcjonowania i bezpieczeństwa naszej witryny oraz usług wymaganych przez użytkownika. Zazwyczaj są one ustawiane w odpowiedzi na działania użytkownika, aby umożliwić korzystanie z określonych funkcji, takich jak zapamiętywanie preferencji dotyczących plików cookie, logowanie lub przechowywanie produktów w koszyku. Nie można zrezygnować z tych plików cookie, a blokowanie ich przez przeglądarkę może negatywnie wpłynąć na funkcjonalność witryny.\",\"basic_text\":\"Własne pliki cookie umożliwiają nam pomiar liczby odwiedzających/użytkowników naszej strony internetowej i tworzenie zagregowanych statystyk użytkowania i wydajności z pomocą naszych zaufanych partnerów. Używamy ich, aby uzyskać podstawowy wgląd w ruch na naszej stronie i wydajność naszej kampanii oraz rozwiązywać błędy na naszej stronie internetowej.\",\"advanced_text\":\"Własne lub zewnętrzne pliki cookie pomagają nam rozumieć sposób interakcji użytkownika z naszą witryną i każdą oferowaną usługą przez wzbogacenie naszych zbiorów danych o dane pochodzące z narzędzi innych firm. Używamy tych plików cookie do ulepszania naszej witryny, usług i obsługi użytkownika, znajdowania i rozwiązywania błędów lub innych problemów oraz do oceny skuteczności naszych kampanii. \",\"marketing_text\":\"Zewnętrzne pliki cookie umożliwiają naszym partnerom marketingowym śledzenie niektórych działań użytkownika w naszej witrynie (na przykład podczas pobierania lub kupowania naszego produktu) w celu poznania jego zainteresowań i potrzeb oraz wyświetlania bardziej odpowiednich, ukierunkowanych reklam.\"},\r\n  \"pt-BR\":{\"title\":\"Sua escolha de cookies, sua privacidade\",\"description\":\"Nós e nossos parceiros usamos cookies para dar a você a melhor experiência on-line otimizada, analisar nosso tráfego de site e entregar a você anúncios personalizados. Você pode concordar com a coleta de todos os cookies clicando em 'Aceitar tudo e fechar', negar todos os cookies não essenciais escolhendo 'Aceitar apenas cookies essenciais' ou ajustar suas configurações de cookies clicando em 'Gerenciar cookies'. Você também tem o direito de retirar seu consentimento em relação aos cookies a qualquer momento clicando no link 'Gerenciar cookies' no rodapé do nosso site ou nas configurações da sua conta (se disponível). Para obter mais informações, consulte nossa <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=pt-BR>Política de Cookies</a>.\",\"essential_title\":\"Cookies essenciais\",\"basic_title\":\"Cookies analíticos básicos\",\"advanced_title\":\"Cookies analíticos avançados\",\"marketing_title\":\"Cookies de marketing\",\"btn_decline\":\"Aceitar apenas cookies essenciais\",\"btn_back\":\"Voltar\",\"btn_accept_selected\":\"Confirmar minha escolha\",\"btn_accept\":\"Aceitar tudo e fechar\",\"btn_manage\":\"Gerenciar cookies\",\"essential_text\":\"Esses cookies de primeira parte são necessários para o funcionamento e segurança de nosso site e para os serviços que você precisa. Normalmente eles são definidos em resposta a suas ações para permitir o uso de determinadas funcionalidades, como lembrar de suas preferências de cookies, entrar ou manter itens no seu carrinho. Não é possível optar por não coletar esses cookies, e bloqueá-los através de um navegador pode afetar a funcionalidade do site.\",\"basic_text\":\"Esses cookies de primeira parte nos permitem medir o número de visitantes/usuários de nosso site e criar estatísticas de uso e desempenho agregadas com a ajuda de nossos parceiros confiáveis. Usamos para obter informações básicas sobre o tráfego de nosso site e nosso desempenho de campanha e para resolver bugs em nosso site.\",\"advanced_text\":\"Esses cookies de primeira parte ou de terceiros nos ajudam a entender como você interage com nosso site e cada serviço oferecido, enriquecendo nossos conjuntos de dados com dados de ferramentas de terceiros. Usamos esses cookies para melhorar nosso site, serviços e experiência do usuário, encontrar e solucionar bugs ou outros problemas com eles, e avaliar a eficácia de nossas campanhas. \",\"marketing_text\":\"Esses cookies de terceiros permitem que nossos parceiros de marketing rastreiem algumas de suas atividades em nosso site (por exemplo, quando você faz download ou compra nosso produto) para aprender sobre seus interesses e necessidades e para mostrar a você anúncios direcionados mais relevantes.\"},\r\n  \"ro-RO\":{\"title\":\"Opțiunile dvs. pentru modulele cookie, confidențialitatea dvs.\",\"description\":\"Împreună cu partenerii noștri, folosim module cookie pentru a vă oferi cea mai bună experiență online optimizată, pentru a analiza traficul site-ului nostru web și pentru a vă prezenta reclame personalizate. Puteți fi de acord cu colectarea tuturor modulelor cookie făcând clic pe „Acceptare toate și închidere”, puteți să refuzați toate modulele cookie neesențiale făcând clic pe „Acceptare doar module cookie esențiale” sau puteți să ajustați setările privind modulele cookie făcând clic pe „Gestionare module cookie”. De asemenea, aveți dreptul să retrageți consimțământul sau să vă modificați preferințele pentru module cookie oricând, făcând clic pe linkul „Gestionare module cookie” din subsolul site-ului nostru web sau în setările contului dvs. (dacă opțiunea este disponibilă). Pentru mai multe informații, vă rugăm să consultați <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ro-RO>Politica noastră privind modulele cookie</a>.\",\"essential_title\":\"Module cookie esențiale\",\"basic_title\":\"Module cookie analitice de bază\",\"advanced_title\":\"Module cookie analitice avansate\",\"marketing_title\":\"Module cookie de marketing\",\"btn_decline\":\"Acceptare doar module cookie esențiale\",\"btn_back\":\"Înapoi\",\"btn_accept_selected\":\"Confirmare opțiuni\",\"btn_accept\":\"Acceptare toate și închidere\",\"btn_manage\":\"Gestionare module cookie\",\"essential_text\":\"Această categorie directă de module cookie sunt necesare pentru funcționarea și securitatea site-ului nostru web și a serviciilor de care aveți nevoie. Acestea sunt de obicei setate ca răspuns la acțiunile dvs., pentru a permite utilizarea anumitor funcționalități, cum ar fi memorarea preferințelor dvs. privind modulele cookie, conectarea sau păstrarea articolelor în coșul de cumpărături. Nu puteți renunța la aceste module cookie, iar blocarea lor prin intermediul unui browser poate afecta funcționarea optimă a site-ului.\",\"basic_text\":\"Această categorie directă de module cookie ne permit să măsurăm numărul de vizitatori/utilizatori ai site-ului nostru web și să creăm statistici agregate de utilizare și performanță, cu ajutorul partenerilor noștri de încredere. Le folosim pentru a obține informații de bază despre traficul de pe site-ul nostru web și performanța campaniei noastre și pentru a rezolva bug-uri pe site-ul nostru web.\",\"advanced_text\":\"Această categorie directă/ terță de module cookie ne ajută să înțelegem modul în care interacționați cu site-ul nostru web și cu fiecare serviciu oferit, completând seturile noastre de date cu date de la instrumente terțe. Utilizăm aceste module cookie pentru a ne îmbunătăți site-ul web, serviciile și experiența utilizatorului, pentru a găsi și rezolva bug-uri sau alte probleme cu acestea și pentru a evalua eficiența campaniilor noastre. \",\"marketing_text\":\"Această categorie terță de module cookie permite partenerilor noștri de marketing să urmărească unele dintre activitățile dvs. pe site-ul nostru web (de exemplu, atunci când descărcați sau cumpărați produsul nostru), pentru a afla mai multe despre interesele și nevoile dvs. și pentru a vă afișa reclame direcționate mai relevante.\"},\r\n  \"ro-MD\":{\"title\":\"Opțiunile dvs. pentru modulele cookie, confidențialitatea dvs.\",\"description\":\"Împreună cu partenerii noștri, folosim module cookie pentru a vă oferi cea mai bună experiență online optimizată, pentru a analiza traficul site-ului nostru web și pentru a vă prezenta reclame personalizate. Puteți fi de acord cu colectarea tuturor modulelor cookie făcând clic pe „Acceptare toate și închidere”, puteți să refuzați toate modulele cookie neesențiale făcând clic pe „Acceptare doar module cookie esențiale” sau puteți să ajustați setările privind modulele cookie făcând clic pe „Gestionare module cookie”. De asemenea, aveți dreptul să retrageți consimțământul sau să vă modificați preferințele pentru module cookie oricând, făcând clic pe linkul „Gestionare module cookie” din subsolul site-ului nostru web sau în setările contului dvs. (dacă opțiunea este disponibilă). Pentru mai multe informații, vă rugăm să consultați <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ro-RO>Politica noastră privind modulele cookie</a>.\",\"essential_title\":\"Module cookie esențiale\",\"basic_title\":\"Module cookie analitice de bază\",\"advanced_title\":\"Module cookie analitice avansate\",\"marketing_title\":\"Module cookie de marketing\",\"btn_decline\":\"Acceptare doar module cookie esențiale\",\"btn_back\":\"Înapoi\",\"btn_accept_selected\":\"Confirmare opțiuni\",\"btn_accept\":\"Acceptare toate și închidere\",\"btn_manage\":\"Gestionare module cookie\",\"essential_text\":\"Această categorie directă de module cookie sunt necesare pentru funcționarea și securitatea site-ului nostru web și a serviciilor de care aveți nevoie. Acestea sunt de obicei setate ca răspuns la acțiunile dvs., pentru a permite utilizarea anumitor funcționalități, cum ar fi memorarea preferințelor dvs. privind modulele cookie, conectarea sau păstrarea articolelor în coșul de cumpărături. Nu puteți renunța la aceste module cookie, iar blocarea lor prin intermediul unui browser poate afecta funcționarea optimă a site-ului.\",\"basic_text\":\"Această categorie directă de module cookie ne permit să măsurăm numărul de vizitatori/utilizatori ai site-ului nostru web și să creăm statistici agregate de utilizare și performanță, cu ajutorul partenerilor noștri de încredere. Le folosim pentru a obține informații de bază despre traficul de pe site-ul nostru web și performanța campaniei noastre și pentru a rezolva bug-uri pe site-ul nostru web.\",\"advanced_text\":\"Această categorie directă/ terță de module cookie ne ajută să înțelegem modul în care interacționați cu site-ul nostru web și cu fiecare serviciu oferit, completând seturile noastre de date cu date de la instrumente terțe. Utilizăm aceste module cookie pentru a ne îmbunătăți site-ul web, serviciile și experiența utilizatorului, pentru a găsi și rezolva bug-uri sau alte probleme cu acestea și pentru a evalua eficiența campaniilor noastre. \",\"marketing_text\":\"Această categorie terță de module cookie permite partenerilor noștri de marketing să urmărească unele dintre activitățile dvs. pe site-ul nostru web (de exemplu, atunci când descărcați sau cumpărați produsul nostru), pentru a afla mai multe despre interesele și nevoile dvs. și pentru a vă afișa reclame direcționate mai relevante.\"},\r\n  \"ru-RU\":{\"title\":\"Ваши настройки для файлов cookie — ваша конфиденциальность\",\"description\":\"Мы и наши партнеры используем файлы cookie, чтобы обеспечить для вас оптимальную работу в Интернете, анализировать трафик нашего веб-сайта и показывать вам персонализированную рекламу. Вы можете разрешить сбор всех файлов cookie, щелкнув 'Принять все и закрыть', отклонить все файлы cookie, кроме базовых, выбрав 'Принять только базовые файлы cookie', или настроить параметры файлов cookie, щелкнув 'Управлять файлами cookie'. Кроме того, вы можете в любой момент отозвать свое разрешение или изменить параметры файлов cookie, перейдя по ссылке 'Управлять файлами cookie' в нижней части нашего веб-сайта или в настройках вашей учетной записи (при наличии). Дополнительные сведения можно найти в нашей <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ru-RU>политике в отношении файлов cookie</a>.\",\"essential_title\":\"Базовые файлы cookie\",\"basic_title\":\"Основные аналитические файлы cookie\",\"advanced_title\":\"Расширенные аналитические файлы cookie\",\"marketing_title\":\"Маркетинговые файлы cookie\",\"btn_decline\":\"Принять только базовые файлы cookie\",\"btn_back\":\"Назад\",\"btn_accept_selected\":\"Подтвердить мой выбор\",\"btn_accept\":\"Принять все и закрыть\",\"btn_manage\":\"Управлять файлами cookie\",\"essential_text\":\"Эти основные файлы cookie нужны для работы и защиты нашего веб-сайта и необходимых вам служб. Обычно они устанавливаются в ответ на ваши действия, чтобы обеспечить использование определенных функций, таких как запоминание ваших настроек cookie, авторизация или хранение элементов в корзине покупателя. От таких файлов cookie отказаться нельзя, а их блокировка через браузер может негативно повлиять на работу сайта.\",\"basic_text\":\"Эти основные файлы cookie позволяют нам измерять количество посетителей/пользователей нашего веб-сайта и создавать комплексную статистику использования и работоспособности с помощью наших надежных партнеров. Мы используем их для получения базового представления о трафике нашего веб-сайта и эффективности наших кампаний, а также для устранения ошибок на нашем веб-сайте.\",\"advanced_text\":\"Эти основные или сторонние файлы cookie дополняют наши наборы данных данными из сторонних средств и помогают нам понять, как вы взаимодействуете с нашим веб-сайтом и каждой из предлагаемых служб. Мы используем эти файлы cookie для улучшения нашего веб-сайта, служб и пользовательского опыта, для поиска и устранения ошибок и других проблем, а также для оценки эффективности наших кампаний. \",\"marketing_text\":\"Эти сторонние файлы cookie позволяют нашим маркетинговым партнерам отслеживать некоторые ваши действия на нашем веб-сайте (например, когда вы загружаете или покупаете наш продукт), чтобы узнать о ваших интересах и потребностях и показывать вам более актуальную целевую рекламу.\"},\r\n  \"sr-Latn-RS\":{\"title\":\"Vaš izbor kolačića, vaša privatnost\",\"description\":\"Mi i naši partneri koristimo kolačiće da bismo vam pružili najbolje optimizovano iskustvo na mreži, za analizu saobraćaja naše veb-lokacije i prikazivanje personalizovanih oglasa. Možete da prihvatite prikupljanje svih kolačića klikom na „Prihvati sve i zatvori“, da odbijete sve kolačiće koji nisu osnovni kolačići tako što ćete izabrati „Prihvati samo osnovne kolačiće“ ili da prilagodite podešavanja kolačića klikom na „Upravljanje kolačićima“. Takođe imate pravo da opozovete svoju saglasnost za kolačiće u bilo kom trenutku klikom na vezu „Upravljanje kolačićima“ u podnožju naše veb-lokacije ili u podešavanjima naloga (ako je dostupno). Više informacija potražite u delu <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sr-Latn-RS>Smernice u vezi sa kolačićima</a>.\",\"essential_title\":\"Osnovne kolačiće\",\"basic_title\":\"Osnovne analitičke kolačiće\",\"advanced_title\":\"Napredne analitičke kolačiće\",\"marketing_title\":\"Marketinške kolačiće\",\"btn_decline\":\"Prihvati samo osnovne kolačiće\",\"btn_back\":\"Nazad\",\"btn_accept_selected\":\"Potvrdi moj izbor\",\"btn_accept\":\"Prihvati sve i zatvori\",\"btn_manage\":\"Upravljanje kolačićima\",\"essential_text\":\"Ovi kolačići prve strane su neophodni za funkcionisanje i bezbednost naše veb-lokacije i usluga koje su vam potrebne. Obično se postavljaju kao odgovor na radnje koje ste obavili kako bi se omogućilo korišćenje određenih funkcionalnosti, kao što su beleženje vaših preferenci za kolačiće, prijavljivanje ili držanje stavki u korpi za kupovinu. Ne možete da odbijete ove kolačiće, a njihovo blokiranje preko pregledača može da utiče na funkcionalnost lokacije.\",\"basic_text\":\"Ovi kolačići prve strane nam omogućavaju da izmerimo broj posetilaca/korisnika naše veb-lokacije i kreiramo zbirnu statistiku korišćenja i učinka uz pomoć naših pouzdanih partnera. Koristimo ih da bismo dobili uvid u saobraćaj na našoj veb-lokaciji i učinak kampanje, kao i da bismo otklonili greške na našoj veb-lokaciji.\",\"advanced_text\":\"Ovi kolačići prve ili treće strane pomažu nam da razumemo način na koji komunicirate sa našom veb-lokacijom i svakom ponuđenom uslugom. Na taj način dobijamo podatke od alatki trećih strana koji obogaćuju naše skupove podataka. Ove kolačiće koristimo kako bismo poboljšali našu veb-lokaciju, usluge i korisničko iskustvo, pronašli i otklonili greške ili druge probleme sa njima i procenili efikasnost naših kampanja. \",\"marketing_text\":\"Ovi kolačići trećih strana omogućavaju našim marketinškim partnerima da prate neke od vaših aktivnosti na našoj veb-lokaciji (na primer, kada preuzmete ili kupite naš proizvod) kako bi se upoznali sa vašim interesovanjima i potrebama, i prikazali vam relevantnije ciljane oglase.\"},\r\n  \"sk-SK\":{\"title\":\"Váš výber súborov cookie, vaše súkromie\",\"description\":\"Spolu s partnermi používame súbory cookie s cieľom poskytnúť vám čo najlepšie optimalizované online prostredie, analyzovať návštevnosť stránky a ponúknuť vám prispôsobené reklamy. Zbieranie všetkých súborov cookie môžete odsúhlasiť kliknutím na tlačidlo „Prijať všetko a zavrieť“, všetky voliteľné súbory cookie môžete odmietnuť výberom možnosti „Prijať iba základné súbory cookie“ alebo môžete upraviť ich nastavenie kliknutím na možnosť „Spravovať súbory cookie“. Udelený súhlas s používaním súborov cookie môžete kedykoľvek zrušiť alebo svoj výber upraviť, a to kliknutím na odkaz „Spravovať súbory cookie“ uvedený v spodnej časti našej webovej stránky, prípadne v nastaveniach účtu. Viac informácií nájdete v dokumente <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sk-SK>Zásady používania súborov cookie</a>.\",\"essential_title\":\"Základné súbory cookie\",\"basic_title\":\"Základné analytické súbory cookie\",\"advanced_title\":\"Rozšírené analytické súbory cookie\",\"marketing_title\":\"Marketingové súbory cookie\",\"btn_decline\":\"Prijať iba základné súbory cookie\",\"btn_back\":\"Späť\",\"btn_accept_selected\":\"Potvrdiť môj výber\",\"btn_accept\":\"Prijať všetko a zavrieť\",\"btn_manage\":\"Spravovať súbory cookie\",\"essential_text\":\"Tieto súbory cookie prvej strany sú nevyhnutné na správne fungovanie a zabezpečenie webovej stránky a požadovaných služieb. Zvyčajne sa nastavia na základe vašej akcie a umožňujú využívanie funkcií, ako je napríklad zapamätanie si preferencií pre cookies, prihlásenie či uloženie položiek v nákupnom košíku. Stránka si vyžaduje súhlas s týmito súbormi cookie, ich blokovanie v prehliadači môže ovplyvniť funkčnosť nášho webu.\",\"basic_text\":\"Tieto súbory cookie prvej strany nám umožňujú merať počet návštevníkov/používateľov našej webovej stránky a vytvárať agregované štatistiky používania a výkonnosti s pomocou našich dôveryhodných partnerov. Používame ich na to, aby sme získali základný prehľad o návštevnosti nášho webu a účinnosti našich kampaní, ako aj na riešenie chýb na našej webovej stránke.\",\"advanced_text\":\"Tieto súbory cookie prvej alebo tretej strany nám poskytujú prehľad o tom, ako návštevníci pracujú s webovou stránkou a ponúkanými službami, a to vďaka rozširovaniu našich dát o údaje z nástrojov tretích strán. Používame ich na zlepšovanie nášho webu, služieb a používateľského prostredia, na hľadanie a riešenie chýb či iných súvisiacich problémov, ako aj na vyhodnocovanie účinnosti našich kampaní. \",\"marketing_text\":\"Tieto súbory cookie tretích strán umožňujú našim marketingovým partnerom sledovať niektoré činnosti na našej stránke (napríklad keď sťahujete alebo kupujete náš produkt), aby sa vám zobrazovali cielenejšie reklamy na základe vašich potrieb.\"},\r\n  \"sl-SI\":{\"title\":\"Vaša izbira piškotkov, vaša zasebnost\",\"description\":\"Mi in naši partnerji uporabljamo piškotke, da vam zagotovimo najoptimalnejšo izkušnjo v spletu, analiziramo promet našega spletnega mesta ter vam prikazujemo prilagojene oglase. Lahko privolite v zbiranje vseh piškotkov tako, da kliknete možnost »Sprejmi vse in zapri«, zavrnete vse neosnovne piškotke tako, da kliknete »Sprejmi samo osnovne piškotke«, ali pa prilagodite nastavitve piškotkov tako, da kliknete »Upravljanje piškotkov«. Svojo privolitev glede piškotkov imate pravico kadar koli preklicati ali spremeniti nastavitve piškotkov tako, da kliknete povezavo za »Upravljanje piškotkov« v nogi našega spletnega mesta ali v nastavitvah računa (če je na voljo). Za več informacij si oglejte naš <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sl-SI>pravilnik o piškotkih</a>.\",\"essential_title\":\"Osnovni piškotki\",\"basic_title\":\"Osnovni analitični piškotki\",\"advanced_title\":\"Napredni analitični piškotki\",\"marketing_title\":\"Marketinški piškotki\",\"btn_decline\":\"Sprejmi samo osnovne piškotke\",\"btn_back\":\"Nazaj\",\"btn_accept_selected\":\"Potrdi moje izbire\",\"btn_accept\":\"Sprejmi vse in zapri\",\"btn_manage\":\"Upravljanje piškotkov\",\"essential_text\":\"Ti lastni piškotki so potrebni za delovanje in varnost našega spletnega mesta in storitev, ki jih potrebujete. Običajno so nastavljeni kot odgovor na vaša dejanja, da omogočijo uporabo določene funkcije, kot je pomnjenje vaših nastavitev piškotkov, prijava ali hranjenje izdelkov v košarici. Teh piškotkov ne morete onemogočiti, njihovo blokiranje prek brskalnika pa lahko vpliva na delovanje spletnega mesta.\",\"basic_text\":\"Ti lastni piškotki nam omogočajo merjenje števila obiskovalcev/uporabnikov našega spletnega mesta ter ustvarjanje zbirne statistike uporabe in uspešnosti s pomočjo naših zaupanja vrednih partnerjev. Uporabljamo jih, da bi dobili osnovni vpogled v promet na našem spletnem mestu in uspešnost naše kampanje ter za reševanje napak na našem spletnem mestu.\",\"advanced_text\":\"Ti lastni piškotki ali piškotki drugih ponudnikov nam pomagajo razumeti, kako uporabljate naše spletno mesto in posamezno zagotovljeno storitev, in sicer z obogatitvijo naših naborov podatkov z orodji drugih ponudnikov. Te piškotke uporabljamo za izboljšanje svojega spletnega mesta, storitev in uporabniške izkušnje, iskanje in odpravljanje napak ali drugih težav s spletnim mestom ali storitvami ter ocenjevanje učinkovitosti naših kampanj. \",\"marketing_text\":\"Ti piškotki drugih ponudnikov omogočajo našim partnerjem pri trženju, da spremljajo nekatere vaše dejavnosti na našem spletnem mestu (npr. prenos ali nakup našega izdelka), s čimer pridobijo več informacij o vaših interesih in potrebah ter vam lahko prikazujejo ustreznejše ciljane oglase.\"},\r\n  \"es-CL\":{\"title\":\"Su elección de cookies, su privacidad\",\"description\":\"Tanto nosotros como nuestros socios usamos cookies para ofrecerle la mejor experiencia optimizada en línea, para analizar el tráfico de nuestro sitio web y para mostrarle anuncios personalizados. Para aceptar la recopilación de todas las cookies, haga clic en 'Aceptar todas y cerrar'; para rechazar todas las cookies que no son esenciales, seleccione 'Aceptar solo las cookies esenciales'; para ajustar la configuración de sus cookies, haga clic en 'Administrar cookies'. También tiene derecho a revocar su consentimiento o cambiar su preferencia de cookies en cualquier momento al hacer clic en el enlace 'Administrar cookies' en el pie de página de nuestro sitio web o en la configuración de su cuenta (si está disponible). Para obtener más información, consulte nuestra <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=es-CL>Política de cookies</a>.\",\"essential_title\":\"Cookies esenciales\",\"basic_title\":\"Cookies analíticas básicas\",\"advanced_title\":\"Cookies analíticas avanzadas\",\"marketing_title\":\"Cookies de marketing\",\"btn_decline\":\"Aceptar únicamente las cookies esenciales\",\"btn_back\":\"Atrás\",\"btn_accept_selected\":\"Confirmar mis elecciones\",\"btn_accept\":\"Aceptar todas y cerrar\",\"btn_manage\":\"Administrar perfiles\",\"essential_text\":\"Estas cookies de terceros son necesarias para el funcionamiento y la seguridad de nuestro sitio web y los servicios que usted solicite. Normalmente se crean en respuesta a sus acciones y permiten el uso de determinadas funciones, como recordar sus preferencias de cookies, iniciar sesión o añadir elementos a su carrito de compras. No puede excluir estas cookies, y bloquearlas desde un navegador podría afectar a la funcionalidad del sitio.\",\"basic_text\":\"Estas cookies de terceros nos permiten evaluar el número de visitantes o usuarios de nuestro sitio web, así como crear estadísticas de uso y rendimiento agregadas con la ayuda de nuestros socios de confianza. Las usamos para obtener información básica sobre el tráfico de sitios web y el rendimiento de la campaña y para resolver errores en nuestro sitio web.\",\"advanced_text\":\"Estas cookies directas o de terceros nos ayudan a comprender cómo interactúa usted con nuestro sitio web y con los servicios que ofrecemos complementando nuestros conjuntos de datos con datos obtenidos de herramientas de terceros. Usamos estas cookies para mejorar nuestro sitio web, nuestros servicios y la experiencia que le brindamos como usuario, para encontrar y resolver errores u otros problemas con ellos, y para evaluar la eficacia de nuestras campañas. \",\"marketing_text\":\"Estas cookies de terceros permiten a nuestros socios de marketing hacer un seguimiento de algunas de sus actividades en nuestro sitio web (por ejemplo, cuando descarga o compra nuestro producto), obtener más información sobre sus intereses y necesidades, y mostrarle anuncios dirigidos más relevantes.\"},\r\n  \"es-ES\":{\"title\":\"Su elección de cookies, su privacidad\",\"description\":\"Tanto nosotros como nuestros socios usamos cookies para ofrecer la experiencia en línea más optimizada posible, analizar el tráfico de nuestro sitio web y mostrarle anuncios personalizados. Para aceptar la recopilación de todas las cookies, haga clic en 'Aceptar todo y cerrar'; para rechazar todas las cookies que no sean esenciales, haga clic en 'Aceptar solo las cookies esenciales'; y para ajustar la configuración de las cookies, haga clic en 'Administrar cookies'. También tiene derecho a revocar su consentimiento y a cambiar sus preferencias para las cookies en cualquier momento. Para ello, haga clic en el vínculo 'Administrar cookies' ubicado en el pie de página de nuestro sitio web o en la configuración de su cuenta (si está disponible). Para obtener más información, consulte nuestra <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=es-ES>Política de cookies</a>.\",\"essential_title\":\"Cookies esenciales\",\"basic_title\":\"Cookies analíticas básicas\",\"advanced_title\":\"Cookies analíticas avanzadas\",\"marketing_title\":\"Cookies de marketing\",\"btn_decline\":\"Aceptar solo las cookies esenciales\",\"btn_back\":\"Atrás\",\"btn_accept_selected\":\"Confirmar mis elecciones\",\"btn_accept\":\"Aceptar todo y cerrar\",\"btn_manage\":\"Administrar cookies\",\"essential_text\":\"Estas cookies de origen son necesarias para el funcionamiento y la seguridad de nuestro sitio web y los servicios que usted necesita. Normalmente se establecen en respuesta a sus acciones para permitir el uso de determinadas funciones, como recordar sus preferencias de cookies, iniciar sesión o mantener elementos en su carro de la compra. No puede excluir estas cookies, y bloquearlas en el navegador podría afectar a la funcionalidad del sitio.\",\"basic_text\":\"Estas cookies de origen nos permiten medir el número de visitantes/usuarios de nuestro sitio web, así como crear estadísticas de uso y rendimiento agregadas con la ayuda de nuestros socios de confianza. Las usamos para obtener información básica sobre el tráfico de nuestro sitio web y el rendimiento de nuestras campañas, y para resolver errores en nuestro sitio web.\",\"advanced_text\":\"Estas cookies de origen o de terceros nos ayudan a entender cómo interactúa con nuestro sitio web y con cada servicio ofrecido al completar nuestros conjuntos de datos con datos procedentes de herramientas de terceros. Usamos estas cookies para mejorar nuestro sitio web, nuestros servicios y nuestra experiencia de usuario, encontrar y resolver errores u otros problemas en ellos, y evaluar la eficacia de nuestras campañas. \",\"marketing_text\":\"Estas cookies de terceros permiten a nuestros socios de marketing realizar un seguimiento de algunas de sus actividades en nuestro sitio web (por ejemplo, descargar o comprar nuestro producto) para obtener más información sobre sus intereses y necesidades, y para mostrarle anuncios dirigidos más pertinentes.\"},\r\n  \"sv-SE\":{\"title\":\"Ditt val av cookies, din integritet\",\"description\":\"Vi och våra partner använder cookies för att ge dig den bästa optimerade onlineupplevelsen, analysera vår webbplatstrafik och visa anpassade annonser. Du kan godkänna insamlingen av alla cookies genom att klicka på Godkänn alla och stäng, neka alla icke-nödvändiga cookies genom att välja Godkänn endast nödvändiga cookies eller justera dina cookieinställningar genom att klicka på Hantera cookies. Du har även rätt att återkalla ditt samtycke till cookies eller ändra dina cookiepreferenser när som helst genom att klicka på länken Hantera cookies i webbplatsens sidfot eller i kontoinställningarna (om dessa är tillgängliga). För mer information, se vår <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sv-SE>cookiepolicy</a>.\",\"essential_title\":\"Viktiga cookies\",\"basic_title\":\"Grundläggande analytiska cookies\",\"advanced_title\":\"Avancerade analytiska cookies\",\"marketing_title\":\"Marknadsföringscookies\",\"btn_decline\":\"Godkänn endast nödvändiga cookies\",\"btn_back\":\"Bakåt\",\"btn_accept_selected\":\"Bekräfta mina val\",\"btn_accept\":\"Godkänn alla och stäng\",\"btn_manage\":\"Hantera cookies\",\"essential_text\":\"Dessa förstapartscookies är nödvändiga för att vår webbplats och de tjänster du behöver ska fungera och vara säkra. De ställs vanligtvis in som svar på dina åtgärder för att möjliggöra användning av vissa funktioner, till exempel att komma ihåg dina cookieinställningar, logga in eller behålla artiklar i kundvagnen. Du kan inte välja bort dessa cookies, och att blockera dem via en webbläsare kan påverka webbplatsens funktionalitet.\",\"basic_text\":\"Dessa förstapartscookies gör det möjligt för oss att mäta antalet besökare/användare på vår webbplats och skapa aggregerad användnings- och prestandastatistik med hjälp av våra betrodda partners. Vi använder detta för att få en grundläggande inblick i vår webbplatstrafik och våra kampanjer samt för att korrigera fel på vår webbplats.\",\"advanced_text\":\"Dessa första- eller tredjepartscookies hjälper oss att förstå hur du interagerar med vår webbplats och varje erbjuden tjänst genom att berika våra datamängder med data från tredjepartsverktyg. Vi använder dessa cookies för att förbättra vår webbplats, våra tjänster och användarupplevelse, hitta och lösa buggar eller andra problem med dem och utvärdera våra kampanjers effektivitet. \",\"marketing_text\":\"Dessa tredjepartscookies gör det möjligt för våra marknadsföringspartner att spåra vissa av dina aktiviteter på vår webbplats (till exempel när du laddar ned eller köper vår produkt), för att lära sig om dina intressen och behov och för att visa dig mer relevanta riktade annonser.\"},\r\n  \"th-TH\":{\"title\":\"ตัวเลือกคุกกี้ส่งผลต่อความเป็นส่วนตัวของคุณ\",\"description\":\"เราและพาร์ทเนอร์ของเราใช้คุกกี้เพื่อมอบประสบการณ์ออนไลน์ที่ดีที่สุดให้แก่คุณ วิเคราะห์การเข้าชมเว็บไซต์ของเรา และแสดงโฆษณาที่เกี่ยวข้องกับความสนใจของคุณ คุณสามารถยอมรับการเก็บรวบรวมคุกกี้ได้โดยคลิก 'ยอมรับทั้งหมดและปิด', ปฏิเสธคุกกี้ที่ไม่จำเป็นทั้งหมดโดยเลือก 'ยอมรับคุกกี้ที่จำเป็นเท่านั้น' หรือปรับการตั้งค่าคุกกี้ของคุณโดยคลิกที่ 'จัดการคุกกี้' นอกจากนี้คุณยังมีสิทธิยกเลิกการยินยอมหรือเปลี่ยนการตั้งค่าคุกกี้เมื่อใดก็ได้โดยคลิกที่ลิงก์ 'จัดการคุกกี้' ในส่วนท้ายของหน้าเว็บไซต์ของเราหรือในการตั้งค่าบัญชีของคุณ (หากมี) สำหรับข้อมูลเพิ่มเติมโปรดดู<a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=th-TH>นโยบายคุกกี้</a>ของเรา\",\"essential_title\":\"คุกกี้ที่จำเป็น\",\"basic_title\":\"คุกกี้เชิงวิเคราะห์ขั้นพื้นฐาน\",\"advanced_title\":\"คุกกี้เชิงวิเคราะห์ขั้นสูง\",\"marketing_title\":\"คุกกี้เพื่อการตลาด\",\"btn_decline\":\"ยอมรับคุกกี้ที่จำเป็นเท่านั้น\",\"btn_back\":\"ย้อนกลับ\",\"btn_accept_selected\":\"ยืนยันการตั้งค่าของฉัน\",\"btn_accept\":\"ยอมรับทั้งหมดและปิด\",\"btn_manage\":\"จัดการคุกกี้\",\"essential_text\":\"คุกกี้ของเราเหล่านี้เป็นสิ่งจำเป็นสำหรับการทำงานและความปลอดภัยของเว็บไซต์ของเรารวมถึงบริการที่คุณต้องการ โดยปกติแล้วระบบจะตั้งค่าคุกกี้เหล่านี้ให้ตอบสนองต่อการกระทำของคุณเพื่อให้ใช้ฟังก์ชันการทำงานบางอย่างได้ เช่น การจดจำการตั้งค่าคุกกี้ของคุณ การเข้าสู่ระบบ หรือการเก็บสินค้าไว้ในรถเข็น เป็นต้น คุณไม่สามารถเลือกไม่รับคุกกี้เหล่านี้ได้ และการบล็อกคุกกี้นี้ผ่านเบราว์เซอร์อาจส่งผลต่อการทำงานของเว็บไซต์\",\"basic_text\":\"คุกกี้ของเราเหล่านี้ช่วยให้เราสามารถวัดจำนวนผู้เข้าชม/ผู้ใช้เว็บไซต์ของเราและสร้างสถิติการใช้งานและประสิทธิภาพโดยรวมด้วยความช่วยเหลือจากพาร์ทเนอร์ที่เชื่อถือได้ของเรา เราใช้คุกกี้เหล่านี้เพื่อรับข้อมูลเชิงลึกขั้นพื้นฐานเกี่ยวกับการเข้าชมเว็บไซต์และประสิทธิภาพของแคมเปญของเรา รวมถึงเพื่อแก้ปัญหาข้อบกพร่องในเว็บไซต์ของเรา\",\"advanced_text\":\"คุกกี้ของเราหรือพาร์ทเนอร์เหล่านี้ช่วยให้เราเข้าใจลักษณะที่คุณใช้งานเว็บไซต์ของเราและบริการแต่ละรายการที่นำเสนอด้วยการนำข้อมูลจากเครื่องมือของพาร์ทเนอร์มาเสริมให้ชุดข้อมูลของเรา เราใช้คุกกี้เหล่านี้เพื่อปรับปรุงเว็บไซต์ บริการ และประสบการณ์ใช้งานของผู้ใช้ รวมถึงใช้ในการค้นหาและแก้ไขข้อบกพร่องหรือปัญหาอื่นๆ ที่เกิดขึ้น ตลอดจนประเมินประสิทธิภาพของแคมเปญของเรา \",\"marketing_text\":\"คุกกี้ของพาร์ทเนอร์ช่วยให้ทีมงานการตลาดของเราสามารถติดตามกิจกรรมบางอย่างของคุณขณะใช้งานเว็บไซต์ของเรา (ตัวอย่างเช่น เมื่อคุณดาวน์โหลดหรือซื้อผลิตภัณฑ์ของเรา) เพื่อเรียนรู้เกี่ยวกับความสนใจและความต้องการของคุณ และแสดงโฆษณาได้ตรงตามความต้องการของคุณได้ดียิ่งขึ้น\"},\r\n  \"tr-TR\":{\"title\":\"Sizin çerez seçiminiz, sizin gizliliğiniz\",\"description\":\"İş ortaklarımızla birlikte, sizin için en iyi şekilde optimize edilmiş bir çevrimiçi deneyim sunmak, web sitesi trafiğimizi analiz etmek ve size kişiselleştirilmiş reklamlar sunmak için çerezleri kullanırız. 'Tümünü kabul et ve kapat' seçeneğini tıklayarak tüm çerezlerin toplanmasını kabul edebilir, 'Yalnızca gerekli çerezleri kabul et' seçeneğini tıklayarak gerekli olmayan tüm çerezleri reddedebilir veya 'Çerezleri yönet' seçeneğini tıklayarak çerez ayarlarınızı yapabilirsiniz. Ayrıca dilediğiniz zaman web sitemizin altbilgi bölümünde 'Çerezleri yönet' bağlantısını tıklayarak veya hesap ayarlarınızda (varsa) çerezlere verdiğiniz onayı geri çekebilir ya da çerez tercihlerinizi değiştirebilirsiniz. Daha fazla bilgi için <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=tr-TR>Çerez Politikamıza</a> bakın.\",\"essential_title\":\"Zorunlu çerezler\",\"basic_title\":\"Temel analitik çerezler\",\"advanced_title\":\"Gelişmiş analitik çerezler\",\"marketing_title\":\"Pazarlama çerezleri\",\"btn_decline\":\"Yalnızca gerekli çerezleri kabul et\",\"btn_back\":\"Geri\",\"btn_accept_selected\":\"Seçimlerimi onayla\",\"btn_accept\":\"Tümünü kabul et ve kapat\",\"btn_manage\":\"Çerezleri yönet\",\"essential_text\":\"Bu birinci grup çerezler, web sitemizin işleyişi ve güvenliğinin yanı sıra ihtiyaç duyduğunuz hizmetler için de gereklidir. Bunlar genellikle, çerez tercihlerinizi hatırlama, giriş yapma veya öğeleri sepetinizde tutma gibi belirli işlevlerin kullanımını etkinleştirmek için işlemlerinize yanıt olarak ayarlanır. Bu çerezleri devre dışı bırakamazsınız ve bunların bir tarayıcı üzerinden engellenmesi site işlevselliğini etkileyebilir.\",\"basic_text\":\"Bu birinci grup çerezler, web sitemizin ziyaretçi/kullanıcı sayısını ölçmemize ve güvenilir iş ortaklarımızın yardımıyla toplu kullanım ve performans istatistikleri oluşturmamıza olanak sağlar. Bunları, web sitesi trafiğimiz ve kampanya performansımızla ilgili temel bilgileri almak ve web sitemizdeki hataları gidermek için kullanırız.\",\"advanced_text\":\"Bu birinci veya üçüncü grup çerezler, üçüncü taraf araçlardan elde edilen veriler sayesinde veri kümelerimizi zenginleştirerek web sitemizle ve sunulan her bir hizmetle nasıl etkileşim kurduğunuzu anlamamıza yardımcı olur. Bu çerezleri web sitemizi, hizmetlerimizi ve kullanıcı deneyimini iyileştirmek, hataları veya diğer sorunları bulup çözmek ve kampanyalarımızın etkinliğini değerlendirmek için kullanırız. \",\"marketing_text\":\"Bu üçüncü grup çerezler, pazarlama iş ortaklarımızın web sitemizdeki etkinliklerinizden bazılarını (örneğin ürünümüzü indirme veya satın alma gibi) izlemelerine, ilgi alanlarınız ve ihtiyaçlarınız hakkında bilgi edinmelerine ve sizinle daha alakalı olan hedefli reklamlar göstermelerine olanak sağlar.\"},\r\n  \"uk-UA\":{\"title\":\"Ваш вибір файлів cookie, ваша конфіденційність\",\"description\":\"Файли cookie, які використовуємо ми й наші партнери, дають змогу найкращим чином оптимізувати для вас інтернет-середовище, аналізувати трафік веб-сайту, а також персоналізувати рекламні оголошення залежно від ваших уподобань. Щоб надати згоду на збирання файлів cookie всіх типів, клацніть 'Прийняти все й закрити'. Щоб заборонити збір всіх файлів cookie, які не є основними, виберіть 'Приймати лише основні файли cookie'. Щоб надати згоду на збирання лише певних типів файлів cookie, клацніть посилання 'Керувати файлами cookie' в нижній частині нашого веб-сайту або в параметрах облікового запису (якщо вони доступні). Докладніше див. в нашому документі <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=uk-UA>Політика щодо файлів cookie</a>.\",\"essential_title\":\"Основні файли cookie\",\"basic_title\":\"Базові аналітичні файли cookie\",\"advanced_title\":\"Розширені аналітичні файли cookie\",\"marketing_title\":\"Рекламні файли cookie\",\"btn_decline\":\"Приймати лише основні файли cookie\",\"btn_back\":\"Назад\",\"btn_accept_selected\":\"Підтвердити вибрані варіанти\",\"btn_accept\":\"Прийняти все й закрити\",\"btn_manage\":\"Керувати файлами cookie\",\"essential_text\":\"Ці основні файли cookie необхідні для роботи й безпеки нашого веб-сайту й потрібних вам служб. Вони зазвичай активуються після виконання вами певних дій, щоб забезпечити роботу відповідних функцій (зокрема, щоб запам’ятати налаштування файлів cookie, облікові дані для входу, вибрані позиції в кошику). Не можна відмовитися від використання цих файлів cookie. Якщо заблокувати їх у браузері, це може вплинути на функціональність веб-сайту.\",\"basic_text\":\"Ці основні файли cookie дають нам змогу відстежувати кількість відвідувачів (користувачів) нашого веб-сайту, а також створювати агреговану статистику про використання й роботу за допомогою наших довірених партнерів. Ці дані допомагають нам краще розуміти характеристики трафіку нашого веб-сайту й нашої кампанії, а також усувати помилки на нашому веб-сайті.\",\"advanced_text\":\"Ці основні або сторонні файли cookie дають нам змогу поповнювати набори даних даними зі сторонніх інструментів і допомагають нам дізнатися, як саме ви користуєтеся нашим веб-сайтом і всіма запропонованими службами. Ми використовуємо ці файли cookie для вдосконалення веб-сайту, служб і взаємодії з користувачами, для пошуку й усунення помилок і проблем, а також для оцінювання ефективності наших кампаній. \",\"marketing_text\":\"Ці сторонні файли cookie дають змогу нашим партнерам із маркетингу відстежувати певні операції, які ви виконуєте на нашому веб-сайті (наприклад, завантаження або покупка нашого продукту), щоб дізнатися про ваші інтереси й потреби та краще персоналізувати рекламні оголошення.\"},\r\n  \"vi-VN\":{\"title\":\"Lựa chọn cookie của bạn, quyền riêng tư của bạn\",\"description\":\"Chúng tôi và các đối tác của chúng tôi sử dụng cookie để đem tới cho bạn trải nghiệm trực tuyến được tối ưu hóa tốt nhất, bạn có thể phân tích lưu lượng truy cập trang web của chúng tôi và chúng tôi sẽ mang tới quảng cáo phù hợp cho bạn. Bạn có thể đồng ý với việc thu thập tất cả cookie bằng cách nhấp vào 'Chấp nhận tất cả và đóng', từ chối tất cả các cookie không cần thiết bằng cách chọn 'Chỉ chấp nhận các cookie cần thiết' hoặc điều chỉnh cài đặt cookie của bạn bằng cách nhấp vào 'Quản lý cookie'. Bạn cũng có quyền thu hồi lại sự đồng ý của mình với cookie hoặc thay đổi các tùy chọn cookie bất cứ lúc nào bằng cách nhấp vào đường dẫn 'Quản lý cookie' ngay tại chân trang web của chúng tôi hoặc trong phần cài đặt tài khoản của bạn (nếu có). Để biết thêm thông tin, vui lòng xem <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=vi-VN>Chính sách Cookie</a> của chúng tôi.\",\"essential_title\":\"Cookie thiết yếu\",\"basic_title\":\"Cookie phân tích cơ bản\",\"advanced_title\":\"Cookie phân tích nâng cao\",\"marketing_title\":\"Cookie tiếp thị\",\"btn_decline\":\"Chỉ chấp nhận các cookie cần thiết\",\"btn_back\":\"Trở lại\",\"btn_accept_selected\":\"Xác nhận lựa chọn của tôi\",\"btn_accept\":\"Chấp nhận tất cả và đóng\",\"btn_manage\":\"Quản lý cookie\",\"essential_text\":\"Những cookie của bên thứ nhất này rất cần thiết để trang web của chúng tôi và các dịch vụ mà bạn yêu cầu có thể hoạt động và được bảo mật. Chúng thường được thiết lập để đáp ứng các hoạt động của bạn nhằm cho phép sử dụng một số chức năng nhất định, như ghi nhớ tùy chọn cookie, đăng nhập hoặc lưu các mặt hàng trong giỏ hàng của bạn. Bạn không thể từ chối những cookie này và việc chặn chúng thông qua trình duyệt có thể ảnh hưởng đến chức năng của trang web.\",\"basic_text\":\"Các cookie của bên thứ nhất này cho phép chúng tôi đo lường số lượng khách/người dùng truy cập trên trang web của chúng tôi và tạo số liệu thống kê tổng hợp về việc sử dụng cũng như hiệu suất với sự trợ giúp của các đối tác mà chúng tôi tin cậy. Chúng tôi sử dụng chúng để phân tích cơ bản về lưu lượng truy cập trang web và hiệu suất chiến dịch của mình và để giải quyết các lỗi trên trang web.\",\"advanced_text\":\"Những cookie của bên thứ nhất hoặc thứ ba này giúp chúng tôi hiểu rõ hơn về cách bạn tương tác với trang web và mỗi dịch vụ được cung cấp bằng cách đa dạng hóa các tập dữ liệu của mình với dữ liệu từ các công cụ của bên thứ ba. Chúng tôi sử dụng những cookie này để cải thiện trang web, dịch vụ và trải nghiệm người dùng nhằm tìm kiếm cũng như giải quyết các lỗi hoặc các vấn đề khác, đồng thời đánh giá hiệu quả chiến dịch của chúng tôi. \",\"marketing_text\":\"Những cookie của bên thứ ba này cho phép các đối tác tiếp thị của chúng tôi theo dõi một số hoạt động của bạn trên trang web của chúng tôi (ví dụ: khi bạn tải xuống hoặc mua sản phẩm của chúng tôi) để tìm hiểu về sở thích và nhu cầu của bạn và để hiển thị cho bạn những quảng cáo được nhắm mục tiêu phù hợp hơn.\"},\r\n  \"hy-AM\":{\"title\":\"Թխուկների ձեր ընտրությունը՝ ձեր գաղտնիությունն է\",\"description\":\"Մենք և մեր գործընկերներն օգտագործում ենք թխուկներ՝ ձեզ լավագույնս օպտիմիլացված առցանց աշխատանք ապահովելու, մեր կայքի տվյալների հոսքը վերլուծելու և ձեզ անհատականացված գովազդներ տրամադրելու համար: Դուք կարող եք համաձայնել բոլոր թխուկների հավաքմանը՝ սեղմելով «Ընդունել բոլորը և փակել», մերժել բոլոր ոչ կարևոր թխուկները՝ սեղմելով «Ընդունել միայն կարևոր թխուկները» կամ սահմանել ձեր թխուկների կարգավորումները՝ սեղմելով «Կառավարել թխուկները»: Դուք նաև իրավունք ունեք ցանկացած պահի չեղարկել թխուկների համար տրված ձեր համաձայնությունը կամ փոխել թխուկների նախընտրությունները՝ մեր կայքի էջատակում կամ ձեր հաշվի կարգավորումներում (առկայության դեպքում) սեղմելով «Կառավարել թխուկները» հղումը։ Լրացուցիչ տեղեկությունների համար ծանոթացեք մեր <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=hy-AM>Թխուկների քաղաքականությանը</a>։\",\"essential_title\":\"Հիմնական թխուկներ\",\"basic_title\":\"Հիմնական վերլուծական թխուկներ\",\"advanced_title\":\"Ընդլայնված վերլուծական թխուկներ\",\"marketing_title\":\"Մարքեթինգային թխուկներ\",\"btn_decline\":\"Ընդունել միայն կարևոր թխուկները\",\"btn_back\":\"Հետ\",\"btn_accept_selected\":\"Հաստատել իմ ընտրությունները\",\"btn_accept\":\"Ընդունել բոլորը և փակել\",\"btn_manage\":\"Կառավարել թխուկները\",\"essential_text\":\"Այս առաջին կողմի թխուկներն անհրաժեշտ են մեր կայքի աշխատանքի և ձեր պահանջած ծառայությունների տրամադրման և անվտանգության համար: Դրանք սովորաբար տեղադրվում են ի պատասխան ձեր գործողությունների՝ կոնկրետ գործառույթի օգտագործման հնարավորություն ընձեռելու համար, ինչպես օրինակ՝ ձեր թխուկների նախապատությունները հիշելը, մուտք գործելը կամ ձեր զամբյուղում առարկաները պահելը: Դուք չեք կարող հրաժարվել այս թխուկներից, իսկ դրանց արգելափակումը զննիչի միջոցով կարող է ազդել կայքի աշխատանքի վրա։\",\"basic_text\":\"Այս առաջին կողմի թխուկները հնարավորություն են տալիս տեսնել մեր կայքի այցելուների/օգտվողների քանակը և մեր վստահելի գործընկերների օգնությամբ ստեղծել օգտագործման և արտադրողականության ընդհանուր վիճակագրություն: Մենք օգտագործում ենք դրանք մեր կայքի տվյալների հոսքի մասին հիմնական պատկերացում ունենալու, մեր քարոզարշավի իրականացման, ինչպես նաև մեր կայքի վրիպակները շտկելու համար:\",\"advanced_text\":\"Այս առաջին կամ երրորդ կողմի թխուկներն օգնում են մեզ հասկանալ, թե ինչպես եք օգտագործում մեր կայքը և յուրաքանչյուր առաջարկվող ծառայությունը՝ ընդլայնելով մեր տվյալների բազաները երրորդ կողմի գործիքների միջոցով ստացված տվյալներով: Մենք օգտագործում ենք այդ թխուկները` մեր կայքը, ծառայությունները և օգտագործողի աշխատանքը բարելավելու, սխալներ կամ դրանց հետ կապված այլ խնդիրներ գտնելու ու լուծելու և մեր քարոզարշավների արդյունավետությունը գնահատելու նպատակով:\",\"marketing_text\":\"Այս երրորդ կողմի թխուկները մեր մարքեթինգային գործընկերներին հնարավորություն են տալիս հետևել ձեր որոշ գործողություններին մեր կայքում (օրինակ՝ երբ եք դուք ներբեռնում կամ գնում մեր ապրանքները)՝ ձեր հետաքրքրությունների և կարիքների մասին տեղեկանալու և ձեզ ավելի համապատասխան ու նպատակային գովազդներ ցուցադրելու համար:\"},\r\n  \"ca-ES\":{\"title\":\"La teva elecció de galetes, la teva privacitat\",\"description\":\"Nosaltres i els nostres socis utilitzem galetes per oferir-te la millor experiència en línia optimitzada, analitzar el trànsit del nostre lloc web i oferir-te anuncis personalitzats. Pots acceptar la recopilació de totes les galetes fent clic a \\\"Acceptar-ho tot i tancar\\\", rebutjar totes les galetes no essencials escollint \\\"Acceptar només les galetes essencials\\\", o ajustar la configuració de les galetes fent clic a \\\"Administrar les galetes\\\". També tens dret a retirar el teu consentiment o canviar les teves preferències de galetes en qualsevol moment fent clic a l'enllaç \\\"Administrar les galetes\\\" al peu de pàgina del nostre lloc web o a la configuració del teu compte (si està disponible). Per a més informació, consulta la nostra <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=en-US>Política de galetes</link>.\",\"essential_title\":\"Galetes essencials\",\"basic_title\":\"Galetes analítiques bàsiques\",\"advanced_title\":\"Galetes analítiques avançades\",\"marketing_title\":\"Galetes de màrqueting\",\"btn_decline\":\"Acceptar només les galetes essencials\",\"btn_back\":\"Tornar\",\"btn_accept_selected\":\"Confirmar les meves opcions\",\"btn_accept\":\"Acceptar-ho tot i tancar\",\"btn_manage\":\"Administrar les galetes\",\"essential_text\":\"Aquestes galetes pròpies són necessàries per al funcionament i la seguretat del nostre lloc web i dels serveis que necessites. Normalment s'estableixen en resposta a les teves accions per permetre l'ús de determinades funcionalitats, com ara recordar les teves preferències de galetes, iniciar la sessió o mantenir articles al carret de la compra. No pots desactivar aquestes galetes, i bloquejar-les mitjançant un navegador pot afectar la funcionalitat del lloc.\",\"basic_text\":\"Aquestes galetes pròpies ens permeten mesurar el nombre de visitants / usuaris del nostre lloc web i crear estadístiques agregades d'ús i rendiment amb l'ajuda dels nostres socis de confiança. Les utilitzem per obtenir informació bàsica sobre el trànsit del nostre lloc web i el rendiment de les nostres campanyes i per resoldre errors al nostre lloc web.\",\"advanced_text\":\"Aquestes galetes pròpies o de tercers ens ajuden a entendre com interactues amb el nostre lloc web i amb cada servei ofert enriquint els nostres conjunts de dades amb dades d'eines de tercers. Utilitzem aquestes galetes per millorar el nostre lloc web, els serveis i l'experiència de l'usuari, detectar i resoldre errors o altres problemes i avaluar l'eficàcia de les nostres campanyes.\",\"marketing_text\":\"Aquestes galetes de tercers permeten als nostres socis de màrqueting fer un seguiment d'algunes de les teves activitats al nostre lloc web (per exemple, quan descarregues o compres el nostre producte) per conèixer els teus interessos i necessitats i mostrar-te anuncis personalitzats més rellevants.\"}\r\n}"},"redirectURL":"","headersSize":608,"bodySize":40382,"_status":"completed","_startTimestamp":1780540336187703,"_endTimestamp":1780540337098731},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"91.228.165.46","connection":"24","comment":"","_id":87,"_uid":"f5ac4a3e-f94d-4ef4-9e41-3afbebdcf35e","_cid":24,"_ctime":1780540330016,"_sid":1,"_stime":1780540330016,"_serverAddress":"91.228.165.46","_serverAddressFamily":0,"_serverPort":443,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":59356,"_app":{"name":"chrome","id":"chrome.exe","path":"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe","stackTrace":null}},{"startedDateTime":"2026-06-04T02:32:40.273Z","time":1757,"request":{"method":"GET","url":"https://help.eset.com/tools/consent/strings_4td_essentials.json?d=home.eset.com","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":method","value":"GET"},{"name":":authority","value":"help.eset.com"},{"name":":path","value":"/tools/consent/strings_4td_essentials.json?d=home.eset.com"},{"name":":scheme","value":"https"},{"name":"pragma","value":"no-cache"},{"name":"cache-control","value":"no-cache"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.7390.55 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Not/A)Brand\";v=\"8\", \"Chromium\";v=\"141\", \"Google Chrome\";v=\"141\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"accept","value":"*/*"},{"name":"origin","value":"https://home.eset.com"},{"name":"sec-fetch-site","value":"same-site"},{"name":"sec-fetch-mode","value":"cors"},{"name":"sec-fetch-dest","value":"empty"},{"name":"referer","value":"https://home.eset.com/"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"en-US,en;q=0.9"},{"name":"priority","value":"u=1, i"}],"queryString":[{"name":"d","value":"home.eset.com"}],"headersSize":668,"bodySize":0,"_status":"completed","_startTimestamp":1780540360273306,"_endTimestamp":1780540360488424},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":status","value":"200"},{"name":"server","value":"nginx"},{"name":"date","value":"Thu, 04 Jun 2026 02:32:40 GMT"},{"name":"content-type","value":"application/json"},{"name":"content-length","value":"40382"},{"name":"last-modified","value":"Tue, 17 Feb 2026 09:00:04 GMT"},{"name":"vary","value":"Accept-Encoding"},{"name":"etag","value":"\"69942e14-9dbe\""},{"name":"content-encoding","value":"br"},{"name":"access-control-allow-origin","value":"https://home.eset.com"},{"name":"x-frame-options","value":"SAMEORIGIN"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-xss-protection","value":"1; mode=block"},{"name":"strict-transport-security","value":"max-age=31536000"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"permissions-policy","value":"geolocation=(), camera=(), microphone=()"},{"name":"alt-svc","value":"h3=\":443\"; ma=86400"},{"name":"cache-control","value":"public, max-age=604800"}],"content":{"size":147675,"mimeType":"application/json","text":"{\r\n  \"en-US\":{\"title\":\"Your cookie choice, your privacy\",\"description\":\"We and our partners use cookies to give you the best optimized online experience, analyze our website traffic, and serve you with personalized ads. You can agree to the collection of all cookies by clicking 'Accept all and close', decline all non-essential cookies by choosing 'Accept essential cookies only', or adjust your cookie settings by clicking 'Manage cookies'. You also have the right to withdraw your consent or change your cookie preferences anytime by clicking the 'Manage cookies' link in our website footer or in your account settings (if available). For more information, see our <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=en-US>Cookie Policy</a>.\",\"essential_title\":\"Essential cookies\",\"basic_title\":\"Basic analytical cookies\",\"advanced_title\":\"Advanced analytical cookies\",\"marketing_title\":\"Marketing cookies\",\"btn_decline\":\"Accept essential cookies only\",\"btn_back\":\"Back\",\"btn_accept_selected\":\"Confirm my choices\",\"btn_accept\":\"Accept all and close\",\"btn_manage\":\"Manage cookies\",\"essential_text\":\"These first-party cookies are necessary for the functioning and security of our website and the services you require. They are usually set in response to your actions to enable the use of certain functionality, such as remembering your cookie preferences, logging in, or holding items in your cart. You cannot opt out of these cookies, and blocking them via a browser may affect site functionality.\",\"basic_text\":\"These first-party cookies enable us to measure the number of visitors/users of our website and create aggregated usage and performance statistics with the help of our trusted partners. We use them to get the basic insight into our website traffic and our campaign performance and to solve bugs on our website.\",\"advanced_text\":\"These first or third-party cookies help us understand how you interact with our website and each offered service by enriching our datasets with data from third-party tools. We use these cookies to improve our website, services, and user experience, find and solve bugs or other problems with them, and evaluate our campaigns' effectiveness. \",\"marketing_text\":\"These third-party cookies allow our marketing partners to track some of your activities on our website (for example, when you download or buy our product) to learn about your interests and needs and to show you more relevant targeted ads.\"},\r\n  \"ar-EG\":{\"title\":\"اختار ملفات تعريف الارتباط الخاصة بك، خصوصيتك\",\"description\":\"نستخدم نحن وشركاؤنا ملفات تعريف الارتباط لمنحك أفضل تجربة ممكنة لتجربتك على موقعنا ونحلل حركة مرور موقعنا على الإنترنت، وخدمتك من خلال إعلانات مخصصة. يمكنك الموافقة على جميع ملفات تعريف الارتباط بالنقر على 'قبول الكل وإغلاق' أو رفض كافة ملفات تعريف الارتباط غير الضرورية من خلال اختيار 'قبول ملفات تعريف الارتباط الأساسية فقط' أو ضبط إعدادات ملفات تعريف الارتباط بالنقر على 'إدارة ملفات تعريف الارتباط'. لديك الحق أيضاً في سحب موافقتك أو تغيير تفضيلاتك لملفات تعريف الارتباط في أي وقت بالنقر على رابط 'إدارة ملفات تعريف الارتباط' الموجودة اسفل الموقع أو في إعدادات حسابك (إذا كان متوفراً). لمزيد من المعلومات، اطلع على <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ar-EG>سياسة ملفات تعريف الارتباط</a>.\",\"essential_title\":\"ملفات تعريف الارتباط الأساسية\",\"basic_title\":\"ملفات تعريف الارتباط التحليلية الأساسية\",\"advanced_title\":\"ملفات تعريف الارتباط التحليلية المتقدمة\",\"marketing_title\":\"ملفات تعريف الارتباط التسويقية\",\"btn_decline\":\"قبول ملفات تعريف الارتباط الأساسية فقط\",\"btn_back\":\"رجوع\",\"btn_accept_selected\":\"تأكيد اختياراتي\",\"btn_accept\":\"قبول الكل وإغلاق\",\"btn_manage\":\"إدارة ملفات تعريف الارتباط\",\"essential_text\":\"تعد ملفات تعريف الارتباط للموقع ضرورية لعمل وأمان لموقعنا والخدمات التي تحتاجها. يتم تعيينها عادةً استجابةً لإجراءاتك لتمكين استخدام وظائف معينة، مثل تذكّر تفضيلات ملفات تعريف الارتباط أو تسجيل الدخول أو الاحتفاظ بعناصر في سلة التسوق لديك. لا يمكنك إلغاء الاشتراك في ملفات تعريف الارتباط هذه، وقد يؤثر حظرها عبر المتصفح على وظائف الموقع.\",\"basic_text\":\"تمنحنا ملفات تعريف الارتباط لموقعنا القدرة على قياس عدد الزوار / المستخدمين للموقع وإنشاء إحصائيات مجمعة عن الاستخدام والأداء بمساعدة شركائنا الموثوقين. نستخدمها للحصول على نظرة ثاقبة حول حركة مرور الموقعنا وأداء الحملات الإعلانية ولحل الأخطاء الموجودة على الموقع.\",\"advanced_text\":\"تساعدنا ملفات تعريف الارتباط لموقعنا أو التابعة لجهات خارجية في فهم كيفية تفاعلك مع موقعنا وكل خدمة مقدمة من خلال إثراء مجموعات البيانات لدينا ببيانات من أدوات تابعة لجهة خارجية. نستخدم ملفات تعريف الارتباط هذه لتحسين موقعنا وخدماتنا وتجربة المستخدم والعثور على الأخطاء أو المشكلات الأخرى وحلها وتقييم فعالية حملاتنا. \",\"marketing_text\":\"تعمل ملفات تعريف الارتباط التابعة لجهات خارجية على السماح لشركائنا في التسويق بتتبع بعض أنشطتك على موقعنا (على سبيل المثال، عند تنزيل المنتج أو شرائه) للتعرف على اهتماماتك واحتياجاتك ولإظهار المزيد من الإعلانات المستهدفة ذات الصلة.\"},\r\n  \"bg-BG\":{\"title\":\"Вашият избор на бисквитки, вашата поверителност\",\"description\":\"Ние и нашите партньори използваме бисквитки, за да ви предоставяме най-оптимизирано онлайн изживяване, да анализираме трафика на уеб сайта си и да ви предлагаме персонализирани реклами. Можете да се съгласите със събирането от всички бисквитки, като щракнете върху „Приемане на всички и затваряне“, да отхвърлите бисквитките, които не са основни, като изберете „Приемане само на основни бисквитки“ или да коригирате настройките си за бисквитки, като щракнете върху „Управление на бисквитките“. Също така имате право да оттеглите съгласието си или да промените предпочитанията си за бисквитки по всяко време, като щракнете върху връзката „Управление на бисквитките“ в долния колонтитул на уеб сайта ни или в настройките на акаунта ви (ако е приложимо). За повече информация вижте нашите <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=bg-BG>Правила за бисквитките</a>.\",\"essential_title\":\"Основни бисквитки\",\"basic_title\":\"Основни аналитични бисквитки\",\"advanced_title\":\"Разширени аналитични бисквитки\",\"marketing_title\":\"Маркетингови бисквитки\",\"btn_decline\":\"Приемане само на основни бисквитки\",\"btn_back\":\"Назад\",\"btn_accept_selected\":\"Потвърждаване на моя избор\",\"btn_accept\":\"Приемане на всички и затваряне\",\"btn_manage\":\"Управление на бисквитките\",\"essential_text\":\"Тези бисквитки от първа страна са необходими за функционирането и сигурността на нашия уеб сайт и на услугите, които изисквате. Те обикновено се задават в отговор на вашите действия, за да се разреши използването на определена функционалност, като запомняне на вашите предпочитания за бисквитки, данни за влизане или запазване на артикули в количката. Не може да се откажете от тези бисквитки и блокирането им с помощта на браузър може да повлияе на функционалността на сайта.\",\"basic_text\":\"Тези бисквитки от първа страна ни дават възможност да измерим броя на посетителите/потребителите на нашия уеб сайт и да създадем обобщени статистически данни за използването и ефективността с помощта на нашите доверени партньори. Използваме ги, за да придобием обща представа за трафика на уеб сайта ни и ефективността на кампанията ни и за решаване на грешки на нашия уеб сайт.\",\"advanced_text\":\"Тези бисквитки от първа или трета страна ни помагат да разберем как взаимодействате с нашия уеб сайт и с всяка предлагана услуга, като обогатяват нашите набори от данни с данни от инструменти на трети страни. Използваме тези бисквитки, за да подобряваме уеб сайта, услугите и потребителското изживяване, да намираме и отстраняваме грешки или други проблеми с тях и да оценяваме ефективността на своите кампании. \",\"marketing_text\":\"Тези бисквитки на трети страни позволяват на нашите маркетингови партньори да проследяват някои от вашите дейности на нашия уеб сайт (например, когато изтегляте или купувате наш продукт), за да се запознаят с вашите интереси и нужди и да ви показват по-подходящи целенасочени реклами.\"},\r\n  \"zh-CN\":{\"title\":\"您的 Cookie 选择, 您的隐私\",\"description\":\"我们和我们的合作伙伴使用 Cookie 来为您提供经优化的最佳在线体验、分析我们的网站流量以及为您提供个性化广告。可以通过单击“全部接受并关闭”来同意收集所有 Cookie、通过选择“仅接受必要 Cookie”来拒绝所有非必要的 Cookie，也可以通过单击“管理 Cookie”来调整 Cookie 设置。您还有权随时通过单击我们网站页脚或您的帐户设置（如果有）中的“管理 Cookie”链接来撤回您的同意或更改 Cookie 偏好。您也有权随时撤销您对 Cookie 的同意。有关详细信息，请参阅我们的 <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=zh-CN>Cookie 策略</a>。\",\"essential_title\":\"基本 Cookie\",\"basic_title\":\"基本分析 Cookie\",\"advanced_title\":\"高级分析 Cookie\",\"marketing_title\":\"营销 Cookie\",\"btn_decline\":\"仅接受必要 Cookie\",\"btn_back\":\"返回\",\"btn_accept_selected\":\"确认我的选择\",\"btn_accept\":\"全部接受并关闭\",\"btn_manage\":\"管理 Cookie\",\"essential_text\":\"这些第一方 Cookie 对于我们网站的运行和安全以及您所需的服务都是必要的。它们通常是根据您的操作设置的，以支持使用某些功能（例如，记住您的 Cookie 偏好、登录或在您的购物车中保存物品）。您不能选择退出这些 Cookie，并且通过浏览器阻止它们可能会影响站点功能。\",\"basic_text\":\"这些第一方 Cookie 使我们能够衡量我们网站的访问者/用户数量，并在我们值得信赖的合作伙伴的帮助下创建汇总的使用情况和性能统计数据。我们使用它们来基本了解我们的网站流量和活动效果，并解决我们网站存在的错误。\",\"advanced_text\":\"这些第一方或第三方 Cookie 通过使用来自第三方工具的数据丰富我们的数据集，从而帮助我们了解您如何与我们的网站以及每个提供的服务进行交互。我们使用这些 Cookie 来改进我们的网站、服务和用户体验，查找并解决它们的错误或其他问题，以及评估我们活动的有效性。 \",\"marketing_text\":\"这些第三方 Cookie 允许我们的营销合作伙伴跟踪您在我们网站上的一些活动（例如，当下载或购买我们的产品时），以了解您的兴趣和需求，并向您展示更多相关的定向广告。\"},\r\n  \"zh-TW\":{\"title\":\"您的 Cookie 選擇，您的隱私權\",\"description\":\"我們和我們的合作夥伴使用 Cookie 為您提供最佳化的線上體驗、分析我們的網站流量並為您提供個人化的廣告。您可以藉由按一下 [全部接受並關閉] 以同意收集所有的 Cookie，或選擇 [僅接受基本 Cookie] 拒絕所有非必要的 Cookie，或按一下 [管理 Cookie] 調整您的 Cookie 設定。您也有權隨時按一下我們網站頁尾或您的帳戶設定 (如果有的話) 中的「管理 Cookie」連結來撤銷您的同意或變更您的 Cookie 喜好設定。如需詳細資訊，請參閱我們的 <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=zh-TW>Cookie 原則</a>。\",\"essential_title\":\"基本 Cookie\",\"basic_title\":\"基本分析 Cookie\",\"advanced_title\":\"進階分析 cookie\",\"marketing_title\":\"行銷 Cookie\",\"btn_decline\":\"僅接受基本 Cookie\",\"btn_back\":\"上一步\",\"btn_accept_selected\":\"確認我的選擇\",\"btn_accept\":\"全部接受並關閉\",\"btn_manage\":\"管理 Cookie\",\"essential_text\":\"這些第一方 Cookie 對於我們網站的運作和安全性以及您所需的服務而言是必要的。它們通常是根據您的動作而進行設定，以啟用特定功能的使用，例如記住您的 Cookie 喜好設定、登入或在您的購物車中保留項目。您無法選擇退出這些 Cookie，透過瀏覽器將其封鎖可能會影響網站功能。\",\"basic_text\":\"這些第一方 Cookie 讓我們能夠測量我們網站的造訪者/使用者的數量，並在我們值得信賴的合作夥伴的協助下建立彙總的使用量和性能統計資料。我們使用它們來對我們的網站流量和行銷活動績效進行基本了解，並且解決我們網站上的錯誤。\",\"advanced_text\":\"這些第一方或第三方 Cookie 藉由使用第三方工具的資料來豐富我們的資料集，幫助我們了解您如何與我們的網站以及每項提供的服務進行互動。我們使用這些 Cookie 來改善我們的網站、服務和使用者體驗，尋找並解決錯誤或與其相關的其他問題，並評估我們行銷活動的效益。 \",\"marketing_text\":\"這些第三方 Cookie 允許我們的行銷活動合作夥伴追蹤您在我們網站上的一些活動 (例如，在您下載或購買我們的產品時)，以了解您的興趣和需求並向您顯示更多相關的目標廣告。\"},\r\n  \"hr-HR\":{\"title\":\"Vaš izbor kolačića, vaša privatnost\",\"description\":\"Mi i naši partneri upotrebljavamo kolačiće kako bismo vam pružili optimizirano online iskustvo, analizirali promet na našoj web stranici i prikazivali vam personalizirane oglase. Pristati na prikupljanje svih kolačića možete klikom na 'Prihvati sve i zatvori', odbiti sve kolačiće koji nisu osnovni možete odabirom 'Prihvati samo osnovne kolačiće' ili možete prilagoditi postavke kolačića klikom na 'Upravljanje kolačićima'. Isto tako, imate pravo povući svoj pristanak ili promijeniti preference o kolačićima u bilo kojem trenutku klikom na vezu 'Upravljanje kolačićima' u podnožju naše web stranice ili u postavkama svojeg računa (ako je dostupno). Više informacija potražite u našim <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=hr-HR>Pravilima o kolačićima</a>.\",\"essential_title\":\"Osnovni kolačići\",\"basic_title\":\"Osnovni analitički kolačići\",\"advanced_title\":\"Napredni analitički kolačići\",\"marketing_title\":\"Marketinški kolačići\",\"btn_decline\":\"Prihvati samo osnovne kolačiće\",\"btn_back\":\"Natrag\",\"btn_accept_selected\":\"Potvrdi moj izbor\",\"btn_accept\":\"Prihvati sve i zatvori\",\"btn_manage\":\"Upravljanje kolačićima\",\"essential_text\":\"Ovi kolačići prve strane potrebni su za funkcioniranje i sigurnost naše web stranice i usluga koje su vam potrebne. Obično se postavljaju kao odgovor na vaše radnje kako bi vam se omogućila upotreba određenih funkcija, kao što su pamćenje postavki kolačića, prijava ili držanje proizvoda u košarici. Ove kolačiće ne možete isključiti, a njihovo blokiranje putem preglednika može utjecati na funkcionalnost stranice.\",\"basic_text\":\"Ovi kolačići prve strane omogućuju nam mjerenje broja posjetitelja/korisnika naše web stranice i stvaranje agregiranih statistika o upotrebi i rezultatima uz pomoć naših pouzdanih partnera. Upotrebljavamo ih kako bismo dobili osnovni uvid u promet naše web stranice i rezultate naše kampanje, kao i za rješavanje pogrešaka na našoj web stranici.\",\"advanced_text\":\"Ovi kolačići prve ili treće strane pomažu nam da razumijemo kako komunicirate s našom web stranicom i svakom ponuđenom uslugom tako što obogaćuju naše skupove podataka podacima iz alata trećih strana. Ove kolačiće upotrebljavamo za poboljšanje naše web stranice, usluga i korisničkog iskustva, pronalaženje i rješavanje programskih pogrešaka ili drugih problema s njima i procjenu učinkovitosti naših kampanja. \",\"marketing_text\":\"Ovi kolačići trećih strana omogućuju našim marketinškim partnerima da prate neke od vaših aktivnosti na našoj web stranici (na primjer, kada preuzmete ili kupite naš program) kako bi saznali više o vašim interesima i potrebama i prikazivali vam relevantnije ciljane oglase.\"},\r\n  \"cs-CZ\":{\"title\":\"Vaše soukromí, váš výběr cookies\",\"description\":\"My a naši partneři používáme soubory cookie, abychom vám poskytli co nejlepší online zážitek, personalizovanou reklamu a dokázali jsme analyzovat návštěvnost webových stránek. Se shromažďováním všech cookies můžete souhlasit kliknutím na tlačítko <strong>Přijmout vše a zavřít</strong>, všechny volitelné soubory cookies můžete odmítnout vybráním možnosti <strong>Přijmout pouze nezbytné cookies</strong>, nebo si jejich nastavení přizpůsobit kliknutím na <strong>Spravovat cookies</strong>. Svůj souhlas se soubory cookie můžete kdykoli zrušit, případně změnit svůj výběr, po kliknutí na odkaz umístěný v patičce webové stránky nebo v nastavení vašeho účtu. Další informace naleznete v <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=cs-CZ>Zásadách používání souborů cookies</a>.\",\"essential_title\":\"Nezbytné cookies\",\"basic_title\":\"Základní analytické soubory cookies\",\"advanced_title\":\"Rozšířené analytické soubory cookies\",\"marketing_title\":\"Marketingové soubory cookies\",\"btn_decline\":\"Přijmout pouze nezbytné cookies\",\"btn_back\":\"Zpět\",\"btn_accept_selected\":\"Potvrdit moje volby\",\"btn_accept\":\"Přijmout vše a zavřít\",\"btn_manage\":\"Spravovat cookies\",\"essential_text\":\"Tyto soubory cookies první strany jsou nezbytné pro fungování a zajištění bezpečnosti naší webové stránky a vámi požadovaných služeb. Obvykle se nastavují v reakci na vámi provedené akce abyste mohli využít konkrétní funkce, jako je například zapamatování vašeho souhlasu se soubory cookies, přihlášení nebo uložení položek v košíku. Pro tento typ cookies proto není vyžadován váš souhlas. Jejich blokování ve vašem prohlížeči může ovlivnit funkčnost webové stránky.\",\"basic_text\":\"Tyto soubory cookies první strany nám umožňují měřit počet návštěvníků/uživatelů našich webových stránek a vytvářet souhrnné statistiky o používání a výkonnosti s pomocí našich důvěryhodných partnerů. Používáme je k získání základního přehledu o návštěvnosti našich webových stránek, výkonnosti našich kampaní a při řešení chyb na našich webových stránkách.\",\"advanced_text\":\"Tyto soubory cookies první nebo třetí strany nám pomáhají získat přehled o tom, jak používáte naši webovou stránku a jednotlivé služby tak, že doplňují naše data o údaje z nástrojů třetích stran. Používáme je k vylepšování našeho webu, služeb a uživatelského prostředí, k identifikaci a opravě chyb nebo jiných souvisejících problémů a vyhodnocování efektivity našich kampaní. \",\"marketing_text\":\"Tyto soubory cookies třetích stran umožňují našim marketingovým partnerům sledovat některé vaše aktivity na našich webových stránkách, například stažení nebo nákup produktu. Díky nim vám zobrazujeme jen relevantní reklamy.\"},\r\n  \"da-DK\":{\"title\":\"Dit valg af cookies, dine personlige oplysninger\",\"description\":\"Vi og vores partnere bruger cookies til at give dig den mest optimerede onlineoplevelse, analysere vores webstedstrafik og vise dig personligt tilpassede annoncer. Du kan acceptere indsamling af alle cookies ved at klikke på 'Acceptér alle, og luk', afvise alle uvæsentlige cookies ved at vælge 'Acceptér kun vigtige cookies' eller justere dine cookieindstillinger ved at klikke på 'Administrer cookies'. Du har også ret til når som helst at trække dit samtykke tilbage eller at ændre dine cookieindstillinger ved at klikke på linket 'Administrer cookies' i sidefoden på vores websted eller i dine kontoindstillinger (hvis de er tilgængelige). Du kan finde flere oplysninger i vores <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=da-DK>cookiepolitik</a>.\",\"essential_title\":\"Vigtige cookies\",\"basic_title\":\"Grundlæggende analytiske cookies\",\"advanced_title\":\"Avancerede analytiske cookies\",\"marketing_title\":\"Markedsføringscookies\",\"btn_decline\":\"Acceptér kun vigtige cookies\",\"btn_back\":\"Tilbage\",\"btn_accept_selected\":\"Bekræft mine valg\",\"btn_accept\":\"Acceptér alle, og luk\",\"btn_manage\":\"Administrer cookies\",\"essential_text\":\"Disse førstepartscookies er nødvendige for, at vores websted og de tjenester, du har brug for, kan fungere og er sikre. De er normalt indstillet i overensstemmelse med dine handlinger for at aktivere brugen af visse funktioner, såsom at huske dine cookieindstillinger, logge på eller bevare varer i din indkøbskurv. Du kan ikke fravælge disse cookies, og hvis du blokerer dem via en browser, kan det påvirke webstedets funktionalitet.\",\"basic_text\":\"Disse førstepartscookies gør det muligt for os at måle antallet af besøgende/brugere på vores websted og at oprette aggregerede brugs- og ydeevnestatistikker ved hjælp af vores betroede partnere. Vi bruger dem til at få grundlæggende indsigt i vores webstedstrafik og i vores kampagners effektivitet og til at løse fejl på vores websted.\",\"advanced_text\":\"Disse første- eller tredjepartscookies hjælper os med at forstå, hvordan du interagerer med vores websted og alle tilbudte tjenester, ved at forsyne vores datasæt med data fra tredjepartsværktøjer. Vi bruger disse cookies til at forbedre vores websted, tjenester og brugeroplevelse, finde og løse fejl eller andre problemer med dem og evaluere vores kampagners effektivitet. \",\"marketing_text\":\"Disse tredjepartscookies gør det muligt for vores marketingpartnere at spore nogle af dine aktiviteter på vores websted (f.eks. når du downloader eller køber vores produkt) for at få mere at vide om dine interesser og behov og vise dig mere relevante målrettede annoncer.\"},\r\n  \"nl-NL\":{\"title\":\"Uw cookiekeuze, uw privacy\",\"description\":\"Wij en onze partners maken gebruik van cookies om u een geoptimaliseerde online ervaring te bieden, ons websiteverkeer te analyseren en u gepersonaliseerde advertenties aan te bieden. U kunt akkoord gaan met het verzamelen van alle cookies door op 'Alles accepteren en sluiten' te klikken, alle niet-essentiële cookies te weigeren door 'Alleen essentiële cookies accepteren' te kiezen, of door uw cookie-instellingen aan te passen door op 'Cookies beheren' te klikken. U hebt ook het recht om uw toestemming omtrent cookies op elk gewenst moment in te trekken of uw cookievoorkeuren te wijzigen door op de koppeling 'Cookies beheren' te klikken in de voettekst op onze website of in uw accountinstellingen (indien beschikbaar). Voor meer informatie verwijzen u naar ons <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=nl-NL>Cookiebeleid</a>.\",\"essential_title\":\"Essentiële cookies\",\"basic_title\":\"Elementaire analytische cookies\",\"advanced_title\":\"Geavanceerde analytische cookies\",\"marketing_title\":\"Marketingcookies\",\"btn_decline\":\"Alleen essentiële cookies accepteren\",\"btn_back\":\"Vorige\",\"btn_accept_selected\":\"Mijn keuzes bevestigen\",\"btn_accept\":\"Alles accepteren en sluiten\",\"btn_manage\":\"Cookies beheren\",\"essential_text\":\"Deze cookies van onszelf zijn noodzakelijk voor het functioneren en de veiligheid van onze website en de diensten die u nodig hebt. Ze worden meestal ingesteld als reactie op uw acties om bepaalde functionaliteit mogelijk te maken, zoals het onthouden van uw cookievoorkeuren, aanmelden of het bewaren van items in uw winkelwagentje. U kunt zich niet afmelden voor deze cookies en het blokkeren ervan in een browser kan gevolgen hebben voor de functionaliteit van de website.\",\"basic_text\":\"Deze first-party cookies stellen ons in staat om het aantal bezoekers/gebruikers van onze website te meten en geaggregeerde gebruiks- en prestatiestatistieken samen te stellen met de hulp van onze vertrouwde partners. We gebruiken deze om basisinzicht te krijgen in ons websiteverkeer en onze campagneprestaties, en om bugs op onze website op te lossen.\",\"advanced_text\":\"Aan de hand van deze cookies van onszelf of cookies van derden kunnen wij begrijpen hoe u omgaat met onze website en elke aangeboden service doordat we onze gegevens uitbreiden met gegevens uit hulpmiddelen van derden. We gebruiken deze cookies om onze website, diensten en gebruikerservaring te verbeteren, bugs of andere problemen te vinden en op te lossen, en de effectiviteit van onze campagnes te beoordelen. \",\"marketing_text\":\"Dankzij deze cookies van derden kunnen onze marketingpartners sommige van uw activiteiten op onze website volgen (bijvoorbeeld wanneer u ons product downloadt of koopt) om meer te weten te komen over uw interesses en behoeften en om u relevantere, gerichte advertenties te tonen.\"},\r\n  \"et-EE\":{\"title\":\"Teie valitud küpsised, teie privaatsus\",\"description\":\"Kasutame koos partneritega küpsiseid, et pakkuda teile parimat optimeeritud veebilahendust, analüüsida veebisaidi liiklust ja pakkuda teile isikupärastatud reklaame. Kõigi küpsiste kogumisega nõustumiseks klõpsake nuppu <strong>Aktsepteeri kõik ja sule</strong>, kõigist ebaolulistest küpsistest keeldumiseks valige <strong>Nõustu ainult oluliste küpsistega</strong> või kohandage oma küpsiste sätteid, klõpsates nuppu <strong>Halda küpsiseid</strong>. Teil on ka igal ajal õigus nõusolek tagasi võtta või küpsiste eelistusi muuta, kui klõpsate linki <strong>Halda küpsiseid</strong> meie veebisaidi jaluses või oma kontosätetes (kui on saadaval). Lisateavet leiate lingilt <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=et-EE>Küpsiste poliitika</a>.\",\"essential_title\":\"Olulised küpsised\",\"basic_title\":\"Peamised analüütilised küpsised\",\"advanced_title\":\"Täpsemad analüütilised küpsised\",\"marketing_title\":\"Turundusküpsised\",\"btn_decline\":\"Nõustu ainult oluliste küpsistega\",\"btn_back\":\"Tagasi\",\"btn_accept_selected\":\"Kinnita minu valikud\",\"btn_accept\":\"Aktsepteeri kõik ja sule\",\"btn_manage\":\"Halda küpsiseid\",\"essential_text\":\"Need esimese osapoole küpsised on vajalikud meie veebisaidi ja vajalike teenuste toimimiseks ning turvalisuse tagamiseks. Need määratakse tavaliselt vastuseks teie toimingutele, et võimaldada teatud funktsioonide kasutamist, näiteks küpsise-eelistuste meeldejätmist, sisselogimist või toodete hoidmist ostukorvis. Te ei saa nendest küpsistest loobuda ja nende blokeerimine brauseri kaudu võib mõjutada saidi funktsionaalsust.\",\"basic_text\":\"Need esimese osapoole küpsised võimaldavad meil mõõta meie veebisaidi külastajate/kasutajate arvu ning luua meie usaldusväärsete partnerite abil koondatud kasutus- ja jõudlusstatistikat. Kasutame neid, et saada peamine ülevaade meie veebisaidi liiklusest ja kampaania tulemuslikkusest, ning et parandada meie veebisaidil olevaid vigu.\",\"advanced_text\":\"Need esimese või kolmanda osapoole küpsised aitavad meil aru saada sellest, kuidas te meie veebisaiti ja iga pakutavat teenust kasutate, rikastades meie andmekomplekte kolmanda osapoole tööriistade andmetega. Kasutame neid küpsiseid veebisaidi, teenuste ja kasutajaliidese parandamiseks, vigade või muude nendega seotud probleemide leidmiseks ja lahendamiseks ning kampaaniate tõhususe hindamiseks. \",\"marketing_text\":\"Need kolmanda osapoole küpsised võimaldavad meie turunduspartneritel jälgida mõningaid teie tegevusi meie veebisaidil (näiteks kui laadite alla või ostate meie toote), et saada teavet teie huvide ja vajaduste kohta ning näidata teile asjakohasemaid sihitud reklaame.\"},\r\n  \"fi-FI\":{\"title\":\"Evästevalintasi, yksityisyytesi\",\"description\":\"Me ja kumppanimme käytämme evästeitä, jotta voimme tarjota sinulle optimoidun verkon käyttökokemuksen, analysoida verkkosivustomme liikennettä ja näyttää sinulle räätälöityjä mainoksia. Voit hyväksyä kaikkien evästeiden keräämisen valitsemalla 'Hyväksy kaikki ja sulje', hylätä kaikki muut paitsi välttämättömät evästeet valitsemalla 'Hyväksy vain välttämättömät evästeet' tai säätää evästeasetuksia valitsemalla 'Evästeiden hallinta' -linkin verkkosivustomme alaviitteestä tai tilisi asetuksista (jos se on käytettävissä). Sinulla on myös oikeus peruuttaa evästesuostumuksesi milloin tahansa. Lisätietoja on <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=fi-FI>evästekäytännössämme</a>.\",\"essential_title\":\"Välttämättömät evästeet\",\"basic_title\":\"Analyyttiset perusevästeet\",\"advanced_title\":\"Edistyneet analyyttiset evästeet\",\"marketing_title\":\"Markkinointievästeet\",\"btn_decline\":\"Hyväksy vain välttämättömät evästeet\",\"btn_back\":\"Edellinen\",\"btn_accept_selected\":\"Vahvista valinnat\",\"btn_accept\":\"Hyväksy kaikki ja sulje\",\"btn_manage\":\"Evästeiden hallinta\",\"essential_text\":\"Nämä ensimmäisen osapuolen evästeet ovat välttämättömiä verkkosivustomme ja tarvitsemiesi palvelujen toiminnan ja turvallisuuden kannalta. Ne asetetaan yleensä tekemiesi toimien mukaisesti tietyille toiminnoille, kuten evästeasetustesi muistamiseen, sisäänkirjautumiseen ja tuotteiden säilyttämiseen ostoskorissa. Näistä evästeistä ei voi kieltäytyä, ja niiden estäminen selaimen kautta voi vaikuttaa sivuston toimimiseen.\",\"basic_text\":\"Näiden ensimmäisen osapuolen evästeiden avulla voimme mitata verkkosivustomme kävijöiden/käyttäjien määrää ja luoda koostettuja käyttö- ja suorituskykytilastoja luotettavien kumppaneidemme avulla. Käytämme niitä saadaksemme perustietoja verkkosivustomme tietoliikenteestä ja kampanjoidemme suorituskyvystä sekä ratkaistaksemme verkkosivustojemme vikatilanteita.\",\"advanced_text\":\"Näistä ensimmäisen tai kolmannen osapuolen evästeistä saamme käsityksen siitä, miten olet vuorovaikutuksessa verkkosivustomme ja kunkin tarjotun palvelun kanssa, kolmansien osapuolten työkalujen laajennettujen tietojen kautta. Käytämme näitä evästeitä, jotta voimme parantaa verkkosivustoamme, palvelujamme ja käyttökokemusta, löytää ja ratkaista niihin liittyviä virheitä tai muita ongelmia sekä arvioida kampanjoidemme tehokkuutta. \",\"marketing_text\":\"Näiden kolmansien osapuolten evästeiden avulla markkinointikumppanimme voivat seurata joitakin toimiasi verkkosivustollamme (esimerkiksi tuotteidemme lataamista ja ostamista), jotta he saavat tietoa kiinnostuksen kohteistasi ja tarpeistasi ja voivat näyttää sinulle osuvampia kohdennettuja mainoksia.\"},\r\n  \"fr-CA\":{\"title\":\"Choisissez vos préférences en matière de témoins et protégez la confidentialité de vos données\",\"description\":\"Nos partenaires et nous utilisons des témoins pour vous offrir la meilleure expérience optimisée en ligne, analyser le trafic sur notre site Web et vous fournir des publicités personnalisées. Vous pouvez accepter la collecte de tous les témoins en cliquant sur « Tout accepter et fermer », refuser tous les témoins non essentiels en choisissant « Accepter uniquement les témoins essentiels » ou régler vos paramètres concernant les témoins en cliquant sur « Gérer les témoins ». Vous avez également le droit de retirer votre consentement ou de modifier vos préférences en matière de témoins à tout moment en cliquant sur le lien « Gérer les témoins » dans le pied de notre page Web ou dans les paramètres de votre compte (le cas échéant). Pour en savoir plus, veuillez consulter notre <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=fr-CA>Politique relative aux témoins</a>.\",\"essential_title\":\"Témoins essentiels\",\"basic_title\":\"Témoins analytiques de base\",\"advanced_title\":\"Témoins analytiques avancés\",\"marketing_title\":\"Témoins de marketing\",\"btn_decline\":\"Acceptez uniquement les témoins essentiels\",\"btn_back\":\"Précédent\",\"btn_accept_selected\":\"Confirmer mes choix\",\"btn_accept\":\"Tous accepter et fermer\",\"btn_manage\":\"Gérer les témoins\",\"essential_text\":\"Ces témoins internes sont essentiels au bon fonctionnement et à la sécurité de notre site Web et des services dont vous avez besoin. Ils sont généralement définis en réponse à vos actions pour permettre l’utilisation de certaines fonctionnalités, telles que la mémorisation de vos préférences en matière de témoins, votre connexion ou le maintien d’articles dans votre panier. Vous ne pouvez pas refuser ces témoins, et les bloquer au moyen d’un navigateur peut nuire à la fonctionnalité du site.\",\"basic_text\":\"Ces témoins internes nous permettent de compter le nombre de visiteurs ou d’utilisateurs de notre site Web et de créer des statistiques agrégées d’utilisation et de performance avec l’aide de nos partenaires de confiance. Nous les utilisons pour obtenir les informations de base sur le trafic de notre site Web et les performances de notre campagne et pour résoudre les bogues sur notre site Web.\",\"advanced_text\":\"Ces témoins internes ou de tiers nous aident à mieux comprendre comment vous interagissez avec notre site Web et chacun des services offerts en enrichissant nos ensembles de données avec des données provenant d’outils tiers. Nous utilisons ces témoins dans le but d’améliorer notre site Web, nos services et l’expérience utilisateur, de trouver et de résoudre des bogues ou d’autres problèmes en lien avec ceux-ci, et d’évaluer l’efficacité de nos campagnes. \",\"marketing_text\":\"Ces témoins tiers permettent à nos partenaires marketing de suivre certaines de vos activités sur notre site Web (par exemple, lorsque vous téléchargez ou achetez notre produit) afin d’en savoir plus sur vos intérêts et vos besoins et pour vous fournir des publicités ciblées plus pertinentes.\"},\r\n  \"fr-FR\":{\"title\":\"Votre choix de cookies, votre vie privée\",\"description\":\"Nos partenaires et nous, utilisons des cookies pour optimiser votre expérience en ligne, analyser le trafic de notre site internet et vous proposer des annonces personnalisées. Vous pouvez accepter la collecte de tous les cookies en cliquant sur « Tout accepter et fermer », refuser ceux qui ne sont pas essentiels en cliquant sur « Accepter uniquement les cookies essentiels » ou ajuster vos paramètres en cliquant sur « Gérer les cookies ». Vous pouvez également retirer votre consentement ou modifier vos préférences à tout moment en cliquant sur « Gérer les cookies » en bas de page ou depuis les paramètres de votre compte (si disponible). Pour plus d’informations, veuillez consulter notre <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=fr-FR>politique en matière de cookies</a>.\",\"essential_title\":\"Cookies essentiels\",\"basic_title\":\"Cookies analytiques de base\",\"advanced_title\":\"Cookies analytiques avancés\",\"marketing_title\":\"Cookies marketing\",\"btn_decline\":\"Accepter uniquement les cookies essentiels\",\"btn_back\":\"Précédent\",\"btn_accept_selected\":\"Confirmer mes choix\",\"btn_accept\":\"Tout accepter et fermer\",\"btn_manage\":\"Gérer les cookies\",\"essential_text\":\"Ces cookies sont nécessaires au fonctionnement et à la sécurité de notre site web et des services dont vous avez besoin. Ils sont généralement définis en réponse à vos actions pour permettre l’utilisation de certaines fonctionnalités, telles que la mémorisation de vos préférences en matière de cookies, la connexion ou encore le maintien d’articles dans votre panier. Vous ne pouvez pas refuser ces cookies et essayer de les bloquer via un navigateur peut avoir une incidence sur les fonctionnalités du site.\",\"basic_text\":\"Ces cookies internes nous permettent de mesurer le nombre de visiteurs/d’utilisateurs sur notre site web et de créer des statistiques agrégées d’utilisation et de performances avec l’aide de nos partenaires de confiance. Nous les utilisons pour obtenir des informations sur le trafic de notre site web, les performances de nos campagnes et pour résoudre les bugs.\",\"advanced_text\":\"Ces cookies internes ou tiers permettent de comprendre la façon dont vous interagissez avec notre site web et avec chaque service proposé en enrichissant nos données avec des informations provenant d’outils tiers. Nous utilisons ces cookies pour améliorer notre site, nos services et l’expérience utilisateurs mais également pour trouver et résoudre des bogues ou d’autres problèmes, et évaluer l’efficacité de nos campagnes.\",\"marketing_text\":\"Ces cookies tiers permettent à nos partenaires marketing de suivre certaines de vos activités sur notre site web (par exemple, lorsque vous téléchargez ou achetez nos produit) afin de connaître vos intérêts et vos besoins et de vous montrer des publicités ciblées plus pertinentes.\"},\r\n  \"de-DE\":{\"title\":\"Ihre Cookie-Auswahl, Ihr Datenschutz\",\"description\":\"Wir und unsere Partner verwenden Cookies, um Ihnen ein optimales Onlineerlebnis zu bieten, den Datenverkehr unserer Website zu analysieren und Sie mit personalisierten Werbungen zu unterstützen. Sie können der Erfassung aller Cookies zustimmen, indem Sie auf 'Alle akzeptieren und schließen' klicken, alle unwichtigen Cookies ablehnen, indem Sie auf 'Nur wichtige Cookies akzeptieren' klicken, oder Ihre Cookie-Einstellungen anpassen, indem Sie auf 'Cookies verwalten' klicken. Außerdem haben Sie das Recht, Ihre Zustimmung zu Cookies jederzeit zu widerrufen oder Ihre Cookie-Einstellungen zu ändern, indem Sie in der Fußzeile Ihrer Website oder in den Einstellungen Ihres Benutzerkontos (sofern verfügbar) auf den Link 'Cookies verwalten' klicken. Weitere Informationen finden Sie in unserer <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=de-DE>Cookie-Richtlinie</a>.\",\"essential_title\":\"Wichtige Cookies\",\"basic_title\":\"Allgemeine Analyse-Cookies\",\"advanced_title\":\"Erweiterte Analyse-Cookies\",\"marketing_title\":\"Marketing-Cookies\",\"btn_decline\":\"Nur wichtige Cookies akzeptieren\",\"btn_back\":\"Zurück\",\"btn_accept_selected\":\"Auswahl bestätigen\",\"btn_accept\":\"Alle akzeptieren und schließen\",\"btn_manage\":\"Cookies verwalten\",\"essential_text\":\"Diese Erstanbieter-Cookies sind für die Funktion und Sicherheit unserer Website und der benötigten Dienste erforderlich. Die Cookies werden üblicherweise als Folge Ihrer Aktionen gesetzt, um die Nutzung bestimmter Funktionen zu ermöglichen, z. B. um Ihre Cookie-Einstellungen zu speichern, sich zu anmelden oder um Elemente in Ihrem Einkaufswagen abzulegen. Sie können diese Cookies nicht deaktivieren und wenn Sie sie in einem Browser blockieren, kann die Funktion der Website beeinträchtigt werden.\",\"basic_text\":\"Mit diesen Erstanbieter-Cookies können wir die Anzahl der Besuchern/Benutzer unserer Website messen und aggregierte Nutzungs- und Leistungsstatistiken mithilfe unserer vertrauenswürdigen Partner erstellen. Wir verwenden diese, um einen grundlegenden Überblick über den Website-Datenverkehr und die Kampagnenleistung zu erhalten und um Bugs auf unserer Website zu beheben.\",\"advanced_text\":\"Mithilfe dieser Erstanbieter- oder Drittanbieter-Cookies können wir besser verstehen, wie Sie mit unserer Webseite und mit den angebotenen Diensten interagieren, da sie unsere Datensätze mit Daten von Drittanbieter-Tools anreichern. Wir verwenden diese Cookies, um unsere Website, unsere Dienste und das Benutzererlebnis zu verbessern, Fehler oder andere Probleme zu ermitteln und zu beheben und die Wirksamkeit unserer Kampagnen zu bewerten. \",\"marketing_text\":\"Mit diesen Cookies von Drittanbietern können unsere Marketingpartner einige Ihrer Aktivitäten auf unserer Website nachverfolgen, z. B. wenn Sie unser Produkt herunterladen oder kaufen, um mehr über Ihre Interessen und Bedürfnisse zu erfahren und Ihnen relevante, personalisierte Werbungen anzuzeigen.\"},\r\n  \"el-GR\":{\"title\":\"Επιλογή cookies, το απόρρητό σας\",\"description\":\"Η εταιρεία και οι συνεργάτες της χρησιμοποιούν cookies για να παρέχουν βελτιστοποιημένη διαδικτυακή εμπειρία στον χρήστη, να αναλύουν την επισκεψιμότητα του ιστότοπου και να προβάλλουν στον χρήστη εξατομικευμένες διαφημίσεις. Μπορείτε να συμφωνήσετε με τη συλλογή όλων των cookies, κάνοντας κλικ στην επιλογή «Αποδοχή όλων και κλείσιμο», να απορρίψετε όλα τα μη απαραίτητα cookies επιλέγοντας «Αποδοχή μόνο των απαραίτητων cookies» ή να προσαρμόσετε τις ρυθμίσεις για τα cookies κάνοντας κλικ στην επιλογή «Διαχείριση cookies». Επίσης, έχετε το δικαίωμα να αποσύρετε τη συγκατάθεσή σας για τα cookies ή να αλλάξετε τις προτιμήσεις σας για τα cookies ανά πάσα στιγμή, κάνοντας κλικ στον σύνδεσμο «Διαχείριση cookies» που βρίσκεται στο υποσέλιδο του ιστότοπου της εταιρείας ή στις ρυθμίσεις λογαριασμού σας (εάν είναι διαθέσιμος). Για περισσότερες πληροφορίες, ανατρέξτε στην <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=el-GR>Πολιτική για τα cookies</a>.\",\"essential_title\":\"Απαραίτητα cookies\",\"basic_title\":\"Βασικά cookies ανάλυσης\",\"advanced_title\":\"Προηγμένα cookies ανάλυσης\",\"marketing_title\":\"Cookies εμπορικής προώθησης\",\"btn_decline\":\"Αποδοχή μόνο των απαραίτητων cookies\",\"btn_back\":\"Πίσω\",\"btn_accept_selected\":\"Επιβεβαίωση των επιλογών μου\",\"btn_accept\":\"Αποδοχή όλων και κλείσιμο\",\"btn_manage\":\"Διαχείριση cookies\",\"essential_text\":\"Αυτά τα cookies της εταιρείας είναι απαραίτητα για τη λειτουργία και την ασφάλεια του ιστότοπου, καθώς και των υπηρεσιών που χρειάζεστε. Συνήθως, αυτά εφαρμόζονται ως απόκριση στις ενέργειές σας έτσι ώστε να επιτρέπουν τη χρήση ορισμένων λειτουργιών, όπως την απομνημόνευση των προτιμήσεων για τα cookies και τη σύνδεση ή τη διατήρηση αντικειμένων στο καλάθι σας. Δεν μπορείτε να εξαιρεθείτε από τα cookies αυτά, ενώ ο αποκλεισμός τους μέσω ενός προγράμματος περιήγησης μπορεί να επηρεάσει τη λειτουργικότητα του ιστότοπου.\",\"basic_text\":\"Αυτά τα cookies της εταιρείας επιτρέπουν στην εταιρεία να μετράει τον αριθμό επισκεπτών/χρηστών του ιστότοπου και να δημιουργεί συγκεντρωτικά στατιστικά στοιχεία χρήσης και επιδόσεων με τη βοήθεια των αξιόπιστων συνεργατών της. Αυτά τα στατιστικά στοιχεία χρησιμοποιούνται για να έχει η εταιρεία μια βασική εικόνα για την επισκεψιμότητα στον ιστότοπο και για τις επιδόσεις της διαφημιστικής εκστρατείας της εταιρείας, καθώς και για την επίλυση σφαλμάτων στον ιστότοπο της εταιρείας.\",\"advanced_text\":\"Αυτά τα cookies της εταιρείας ή άλλων κατασκευαστών βοηθούν την εταιρεία να αποκτήσει πληροφορίες σχετικά με τον τρόπο που αλληλεπιδρούν οι χρήστες με τον ιστότοπο και κάθε προσφερόμενη υπηρεσία, εμπλουτίζοντας τα σύνολα δεδομένων της εταιρείας με δεδομένα από εργαλεία άλλων κατασκευαστών. Η εταιρεία χρησιμοποιεί αυτά τα cookies για τη βελτίωση του ιστότοπου, των υπηρεσιών και της εμπειρίας του χρήστη, καθώς επίσης και για τον εντοπισμό και την επίλυση σφαλμάτων ή άλλων προβλημάτων που σχετίζονται με τα παραπάνω, αλλά και για την αξιολόγηση της αποτελεσματικότητας των διαφημιστικών εκστρατειών της εταιρείας. \",\"marketing_text\":\"Αυτά τα cookies τρίτων μερών επιτρέπουν στους συνεργάτες μάρκετινγκ να καταγράφουν ορισμένες από τις δραστηριότητες των χρηστών στον ιστότοπο (για παράδειγμα, τη λήψη ή αγορά προϊόντος της εταιρείας) έτσι ώστε να μάθουν για τα ενδιαφέροντα και τις ανάγκες σας και για να προβάλλουν στο χρήστη πιο στοχευμένες διαφημίσεις σχετικά.\"},\r\n  \"he-IL\":{\"title\":\"בחירת קובצי ה-Cookie שלך, הפרטיות שלך\",\"description\":\"אנו והשותפים שלנו משתמשים בקובצי Cookie כדי להעניק לך את החוויה המקוונת הטובה ביותר, לנתח את התעבורה באתר שלנו ולהציג לך מודעות מותאמות אישית. ניתן לאשר איסוף של כל קובצי ה-Cookie על ידי לחיצה על 'קבל הכול וסגור', לדחות את כל קובצי ה-Cookie הלא חיוניים על ידי בחירת 'קבל קובצי Cookie חיוניים בלבד' או להתאים את הגדרות קובצי ה-Cookie על ידי לחיצה על 'ניהול קובצי Cookie'. בנוסף, יש לך זכות לבטל את הסכמתך או לשנות את העדפות קובצי ה-Cookie שלך בכל עת על ידי לחיצה על הקישור 'ניהול קובצי Cookie' בכותרת התחתונה של האתר או בהגדרות החשבון שלך (אם זמין). לקבלת מידע נוסף, יש לעיין ב<a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=he-IL>מדיניות קובצי ה-Cookie</a> שלנו.\",\"essential_title\":\"קובצי Cookie חיוניים\",\"basic_title\":\"קובצי Cookie אנליטיים בסיסיים\",\"advanced_title\":\"קובצי Cookie אנליטיים מתקדמים\",\"marketing_title\":\"קובצי Cookie של שיווק\",\"btn_decline\":\"קבל קובצי Cookie חיוניים בלבד\",\"btn_back\":\"חזרה\",\"btn_accept_selected\":\"אשר את הבחירות שלי\",\"btn_accept\":\"קבל הכול וסגור\",\"btn_manage\":\"ניהול קובצי Cookie\",\"essential_text\":\"קובצי Cookie של צד ראשון נחוצים לתפקוד ולאבטחה של אתר האינטרנט שלנו והשירותים הדרושים לך. הם בדרך כלל מוגדרים בתגובה לפעולות שלך כדי לאפשר שימוש בפונקציונליות מסוימת, כגון שמירת העדפות קובצי ה-Cookie שלך, התחברות או שמירת פריטים בעגלת הקניות. לא ניתן לבטל את השימוש בקובצי Cookie אלה, וחסימתם באמצעות דפדפן עשויה להשפיע על פונקציונליות האתר.\",\"basic_text\":\"קובצי Cookie אלה של צד ראשון מאפשרים לנו למדוד את מספר המבקרים/המשתמשים באתר שלנו וליצור נתונים סטטיסטיים מצטברים של שימוש וביצועים בעזרת השותפים המהימנים שלנו. אנו משתמשים בהם כדי לקבל תובנות בסיסיות לגבי התנועה באתר שלנו וביצועי הקמפיין שלנו וכדי לפתור באגים באתר שלנו.\",\"advanced_text\":\"קובצי Cookie של צד ראשון או שלישי עוזרים לנו להבין את האינטראקציה שלך עם אתר האינטרנט שלנו ועם כל שירות שמוצע על ידי העשרת ערכות הנתונים שלנו בנתונים מכלים של צד שלישי. אנו משתמשים בקובצי Cookie אלה כדי לשפר את אתר האינטרנט, השירותים וחוויית המשתמש שלנו, למצוא ולפתור באגים או בעיות אחרות בהם ולהעריך את יעילות הקמפיינים שלנו. \",\"marketing_text\":\"קובצי Cookie אלה של צד שלישי מאפשרים לשותפי השיווק שלנו לעקוב אחר חלק מהפעילויות שלך באתר האינטרנט שלנו (לדוגמה, כאשר אתה מוריד או קונה את המוצר שלנו) כדי ללמוד על תחומי העניין והצרכים שלך ולהציג לך מודעות ממוקדות ורלוונטיות יותר.\"},\r\n  \"hu-HU\":{\"title\":\"A kiválasztott sütik és az adatvédelem\",\"description\":\"Mi és partnereink sütiket használunk, hogy a legjobb optimalizált online élményt nyújthassuk Önnek, elemezzük weboldalunk forgalmát, hogy személyre szabott hirdetésekkel szolgálhassunk Önnek. A 'Mindet elfogadom és bezárom' gombra kattintva hozzájárulhat az összes süti begyűjtéséhez, a 'Csak az alapvető sütik elfogadása' gombra kattintva elutasíthatja az összes nem alapvető süti gyűjtését, a 'Sütik kezelése' gombra kattintva pedig módosíthatja a sütibeállításokat. Emellett bármikor joga van visszavonni a hozzájárulását vagy módosítani a sütibeállításokat a 'Sütik kezelése' gombra kattintva a webhelyünk láblécében vagy a fiókbeállításokban (ha van ilyen lehetőség). További információkért tekintse meg a <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=hu-HU>sütik kezelésével kapcsolatos szabályzatunkat</a>.\",\"essential_title\":\"Alapvető sütik\",\"basic_title\":\"Alapvető analitikai sütik\",\"advanced_title\":\"Fejlett analitikai sütik\",\"marketing_title\":\"Marketing sütik\",\"btn_decline\":\"Csak az alapvető sütik elfogadása\",\"btn_back\":\"Vissza\",\"btn_accept_selected\":\"A kiválasztott beállítások megerősítése\",\"btn_accept\":\"Mindet elfogadom és bezárom\",\"btn_manage\":\"Sütik kezelése\",\"essential_text\":\"Ezek az első féltől származó sütik a weboldalunk és az Ön által igényelt szolgáltatások működéséhez és védelméhez szükségesek. A sütik az Ön igényeinek figyelembevételével kerülnek beállításra, hogy lehetővé tegyük bizonyos funkciók használatát, például a sütibeállítások megjegyzését, a bejelentkezést, illetve a kosárba tett tételek megőrzését. Ezeket a sütiket nem lehet letiltani, és a böngészőn keresztül történő blokkolásuk befolyásolhatja a webhely működését.\",\"basic_text\":\"Az első féltől származó sütik lehetővé teszik számunkra, hogy lemérjük webhelyünk látogatóinak/felhasználóinak számát, és megbízható partnereink segítségével összesített használati és teljesítménybeli statisztikákat hozzunk létre. Ezeket a statisztikákat arra használjuk, hogy alapvető betekintést nyerhessünk webhelyünk forgalmi- és kampányaink teljesítmény-adataiba, valamint arra, hogy kijavíthassuk a webhelyünkön található hibákat.\",\"advanced_text\":\"Az első vagy harmadik féltől származó sütik segítségével jobban meg tudjuk érteni az Ön és a webhely, illetve az egyes felkínált szolgáltatások között történő interakciót azáltal, hogy adatkészleteinket harmadik féltől származó eszközök adataival töltjük fel. A sütiket arra használjuk, hogy fejlesszük webhelyünket, szolgáltatásainkat, növeljük a felhasználói élményt, megtaláljuk és elhárítsuk a hibákat vagy egyéb problémákat, és kiértékeljük kampányaink hatékonyságát. \",\"marketing_text\":\"A harmadik féltől származó sütik lehetővé teszik marketingpartnereink számára, hogy nyomon követhessék az Ön tevékenységeit a webhelyünkön (például amikor letölti vagy megvásárolja termékünket), ezáltal felmérhessék az Ön érdeklődési köreit és igényeit, és így relevánsabb célzott hirdetéseket jeleníthessenek meg Önnek.\"},\r\n  \"id-ID\":{\"title\":\"Pilihan cookie Anda, privasi Anda\",\"description\":\"Kami dan mitra kami menggunakan cookie untuk memberikan pengalaman online terbaik yang dioptimalkan, menganalisis lalu lintas situs web, dan melayani Anda dengan iklan yang dipersonalisasi. Anda dapat menyetujui pengumpulan semua cookie dengan mengeklik 'Terima semua dan tutup', menolak semua cookie non-esensial dengan memilih 'Terima cookie penting saja', atau menyesuaikan pengaturan cookie Anda dengan mengeklik 'Kelola cookie'. Anda juga memiliki hak untuk membatalkan persetujuan cookie kapan saja dengan mengeklik tautan 'Kelola cookie' di footer situs web kami atau di penyiapan akun (jika ada). Untuk informasi selengkapnya, silakan lihat <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=id-ID>Kebijakan Cookie</a> kami.\",\"essential_title\":\"Cookie penting\",\"basic_title\":\"Cookie analitis dasar\",\"advanced_title\":\"Cookie analitis tingkat lanjut\",\"marketing_title\":\"Cookie pemasaran\",\"btn_decline\":\"Terima cookie penting saja\",\"btn_back\":\"Kembali\",\"btn_accept_selected\":\"Konfirmasi pilihan saya\",\"btn_accept\":\"Terima semua dan tutup\",\"btn_manage\":\"Kelola cookie\",\"essential_text\":\"Cookie pihak pertama ini diperlukan untuk fungsi dan keamanan situs web kami serta layanan yang Anda butuhkan. Cookie ini biasanya diatur sebagai tanggapan atas tindakan Anda untuk memungkinkan penggunaan fungsi tertentu, seperti mengingat preferensi cookie, akses masuk, atau menyimpan barang di keranjang. Anda tidak dapat memilih keluar dari cookie ini, dan memblokir cookie melalui browser dapat memengaruhi fungsionalitas situs.\",\"basic_text\":\"Cookie pihak pertama ini memungkinkan kami mengukur jumlah pengunjung/pengguna situs web dan membuat statistik penggunaan dan kinerja agregat dengan bantuan mitra tepercaya kami. Kami menggunakannya untuk mendapatkan wawasan dasar tentang lalu lintas situs web dan kinerja kampanye, dan untuk memecahkan bug di situs web kami.\",\"advanced_text\":\"Cookie pihak pertama atau ketiga ini membantu kami memahami cara Anda berinteraksi dengan situs web kami dan setiap layanan yang ditawarkan dengan memperkaya kumpulan data kami menggunakan data dari perangkat pihak ketiga. Kami menggunakan cookie ini untuk meningkatkan situs web, layanan, dan pengalaman pengguna, menemukan dan memecahkan bug atau masalah lain, serta mengevaluasi efektivitas kampanye kami. \",\"marketing_text\":\"Cookie pihak ketiga ini memungkinkan mitra pemasaran kami untuk melacak beberapa aktivitas Anda di situs web kami (misalnya, ketika Anda mengunduh atau membeli produk kami) untuk mempelajari minat dan kebutuhan Anda serta untuk menunjukkan iklan bertarget yang lebih relevan.\"},\r\n  \"it-IT\":{\"title\":\"Gestisci la scelta dei cookie e della privacy\",\"description\":\"La Società e i relativi partner utilizzano i cookie per offrire all’utente un’esperienza online ottimizzata, analizzare il traffico sul proprio sito web e fornire annunci pubblicitari personalizzati. L’utente può accettare la raccolta di tutti i cookie facendo clic su “Accetta tutto e chiudi”, rifiutare tutti i cookie non essenziali scegliendo “Accetta solo cookie essenziali” o modificare le impostazioni relative ai cookie facendo clic su “Gestisci cookie”. L’utente ha anche il diritto di revocare il consenso ai cookie o di modificare le preferenze relative ai cookie in qualsiasi momento facendo clic sul collegamento “Gestisci cookie” presente nella nota a piè di pagina del sito web aziendale o nelle impostazioni dell’account (se disponibili). Per ulteriori informazioni, consultare la <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=it-IT>Politica aziendale sui cookie</a>.\",\"essential_title\":\"Cookie essenziali\",\"basic_title\":\"Cookie analitici di base\",\"advanced_title\":\"Cookie analitici avanzati\",\"marketing_title\":\"Cookie di marketing\",\"btn_decline\":\"Accetta solo cookie essenziali\",\"btn_back\":\"Indietro\",\"btn_accept_selected\":\"Conferma le scelte\",\"btn_accept\":\"Accetta tutto e chiudi\",\"btn_manage\":\"Gestisci cookie\",\"essential_text\":\"Questi cookie di prima parte sono necessari ai fini del funzionamento e della sicurezza del sito web aziendale e dei servizi richiesti dall’utente. Vengono solitamente impostati in risposta alle azioni dell’utente allo scopo di abilitare l’utilizzo di specifiche funzionalità, come ad esempio la memorizzazione delle preferenze relative ai cookie, l’autenticazione o il posizionamento di articoli nel carrello. Non è possibile rifiutarli e il blocco tramite browser potrebbe compromettere la funzionalità del sito.\",\"basic_text\":\"Questi cookie di prima parte consentono alla Società di misurare il numero di visitatori/utenti del proprio sito web e di creare statistiche aggregate sull’utilizzo e sulle prestazioni con l’aiuto dei propri partner fidati. Vengono utilizzati per ottenere informazioni di base sul traffico sul sito web aziendale e sulle prestazioni delle campagne e per risolvere bug sul sito web aziendale.\",\"advanced_text\":\"Questi cookie di prima o terza parte aiutano la Società a comprendere le modalità di interazione dell’utente con il sito web aziendale e con ciascun servizio offerto attraverso l’arricchimento dei set di dati aziendali con i dati ricavati dall’utilizzo di strumenti di terze parti. La Società utilizza questi cookie allo scopo di migliorare il sito web aziendale, i servizi e l’esperienza degli utenti, individuare e risolvere bug o altri problemi con questi cookie e valutare l’efficacia delle proprie campagne. \",\"marketing_text\":\"Questi cookie di terze parti consentono ai partner di marketing della Società di monitorare alcune attività dell’utente sul sito web aziendale (ad esempio, durante il download o l’acquisto del prodotto) allo scopo di conoscerne gli interessi, le esigenze e di mostrare gli annunci pubblicitari mirati più rilevanti.\"},\r\n  \"ja-JP\":{\"title\":\"Cookieの選択、プライバシー\",\"description\":\"ESETおよびESETのパートナーはCookieを使用して、最も最適化されたオンラインエクスペリエンスを実現し、ESET Webサイトのトラフィックを分析し、お客様にパーソナル化された広告を提供します。[すべてに同意して閉じる]をクリックしてすべてのCookieの収集に同意するか、[必須のCookieのみを許可]をクリックして、必須ではないCookieのすべてを拒否するか、[Cookieの管理]をクリックしてCookie設定を調整できます。また、お客様はいつでも、Webサイトのフッターまたはアカウント設定(使用可能な場合)の[Cookieの管理]リンクをクリックして、Cookieに対する同意を取り消したり、Cookie設定を変更したりする権利があります。詳細については、<a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ja-JP>Cookieポリシー</a>を参照してください。\",\"essential_title\":\"必須のCookie\",\"basic_title\":\"基本分析のためのCookie\",\"advanced_title\":\"高度な分析のためのCookie\",\"marketing_title\":\"マーケティングCookie\",\"btn_decline\":\"必須のCookieのみを許可\",\"btn_back\":\"戻る\",\"btn_accept_selected\":\"選択内容の確認\",\"btn_accept\":\"すべてに同意して閉じる\",\"btn_manage\":\"Cookieの管理\",\"essential_text\":\"これらのファーストパーティCookieは、当社のWebサイトおよびお客様が必要とするサービスの機能とセキュリティに必要です。これらは通常、Cookie設定の記憶、ログイン、カート内の品物の保存などの特定の機能の使用を有効にするために、ユーザーアクションに対応して設定されます。これらのCookieをオプトアウトし、ブラウザー経由でブロックすると、サイト機能に影響する可能性があります。\",\"basic_text\":\"このファーストパーティCookieを使用することによって、ESETは、信頼できるパートナーの支援を受け、ESET Webサイトの訪問者数/ユーザー数を測定し、集約された使用状況とパフォーマンス統計情報を作成できます。ESETはそれらを使用して、Webサイトトラフィックとキャンペーンパフォーマンスに関する基本的な分析情報を得て、Webサイトの不具合を解決します。\",\"advanced_text\":\"これらのファーストパーティCookieとサードパーティCookieは、サードパーティツールのデータを使用してデータセットを充実させることで、お客様がESETのWebサイトおよび各サービスを操作する方法を分析するために役立ちます。ESETは、これらのCookieを使用して、Webサイト、サービス、ユーザーエクスペリエンスの向上、不具合や他の問題の検出と解決、キャンペーン効果の評価を行います。\",\"marketing_text\":\"これらのサードパーティCookieを使用すると、ESETのマーケティングパートナーは、Webサイトでのアクティビティの一部(製品のダウンロードまたは購入など)を追跡して、お客様の関心とニーズを把握し、関連性が高いターゲット広告を表示できます。\"},\r\n  \"kk-KZ\":{\"title\":\"Құпиялылығыңыз қандай cookie файл таңдағаныңызға байланысты болады\",\"description\":\"Біз және серіктестеріміз сізге ең жақсы оңтайландырылған онлайн тәжірибені беру, веб-сайт трафигін талдау және сізге дербестендірілген хабарландырулармен қызмет көрсету үшін cookie файлдарын пайдаланамыз. «Барлығын қабылдау және жабу» түймешігін басу арқылы барлық cookie файлын жинауға келісе аласыз немесе «Негізгі Cookie файлдарын қабылдау» түймешігін таңдау арқылы барлық маңызды емес cookie файлынан бас тарта аласыз, я болмаса «Cookie файлдарын басқару» түймешігін басу арқылы cookie файлы орнатуларын реттей аласыз. Сондай-ақ кез келген уақытта cookie файлдарына қатысты берген келісіміңізді қайтарып алуға немесе cookie файлы параметрлерін өзгертуге құқығыңыз бар. Ол үшін кез келген уақытта веб-сайтымыздың төменгі жағындағы немесе есептік жазба орнатуларындағы (егер болса) «Cookie файлдарын басқару» сілтемесін басыңыз. Қосымша ақпарат алу үшін <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=kk-KZ>Cookie саясатын</a> қараңыз.\",\"essential_title\":\"Негізгі cookie файлдары\",\"basic_title\":\"Негізгі аналитикалық cookie файлдары\",\"advanced_title\":\"Алдыңғы қатарлы аналитикалық cookie файлдары\",\"marketing_title\":\"Маркетингтік cookies файлдары\",\"btn_decline\":\"Тек маңызды cookie файлдарын қабылдау\",\"btn_back\":\"Артқа\",\"btn_accept_selected\":\"Таңдауларымды растау\",\"btn_accept\":\"Барлығын қабылдау және жабу\",\"btn_manage\":\"Cookie файлдарын басқару\",\"essential_text\":\"Осы бірінші тарап cookie файлдары веб-сайтымыздың және қажетті қызметтердің жұмыс істеуі мен қауіпсіздігін қамтамасыз ету үшін қажет. Олар әдетте cookie параметрлерін есте сақтау, кіру немесе заттарды арбада ұстап тұру сияқты белгілі бір функцияларды пайдалануға мүмкіндік беретін әрекеттеріңізге жауап ретінде орнатылады. Бұл cookie файлдарынан бас тарту мүмкін емес және оларды браузер арқылы блоктау сайттың функционалдығына әсер етуі мүмкін.\",\"basic_text\":\"Осы бірінші тарап cookie файлдары веб-сайтымызға келушілер/пайдаланушылар санын есептеуге және сенімді серіктестеріміздің көмегімен біріктірілген пайдалану және өнімділік статистикасын жасауға мүмкіндік береді. Біз оларды веб-сайт трафигі мен үгіт-насихат көрсеткіштері туралы негізгі мағлұмат алу үшін және веб-сайтымыздағы қателерді шешу үшін пайдаланамыз.\",\"advanced_text\":\"Бірінші немесе үшінші тараптың осы cookie файлдары веб-сайтымызбен және ұсынылатын әр қызметпен қалай қарым-қатынас жасайтыныңызды түсінуге көмектеседі, дерекқорымызды үшінші тарап құралдарынан алынған мәліметтермен байытады. Біз осы cookie файлдарын веб-сайтымызды, қызметтерімізді және пайдаланушыларға ыңғайлылығымызды жақсарту, қателерді немесе басқа мәселелерді табу және жою, сондай-ақ науқандарымыздың тиімділігін бағалау үшін қолданамыз. \",\"marketing_text\":\"Бұл үшінші тараптық cookie файлдары біздің маркетингтік серіктестерімізге сіздің мүдделеріңіз бен қажеттіліктеріңіз туралы білу және сізге неғұрлым өзекті мақсатты хабарландыруларды көрсету үшін біздің веб-сайтымыздағы кейбір әрекеттеріңізді (мысалы, біздің өнімімізді жүктеген немесе сатып алған кезде) қадағалауға мүмкіндік береді.\"},\r\n  \"ko-KR\":{\"title\":\"쿠키 선택 사항, 개인 정보 보호\",\"description\":\"당사와 당사의 파트너는 쿠키를 사용하여 최적의 온라인 환경을 제공하고, 웹 사이트 트래픽을 분석하고, 개인화된 광고를 제공합니다. '모두 수락 및 닫기'를 클릭하여 모든 쿠키 수집에 동의하거나 '필수 쿠키만 수락'을 선택하여 필수가 아닌 쿠키를 모두 거부하거나 '쿠키 관리'를 클릭하여 쿠키 설정을 조정할 수 있습니다. 또한 웹 사이트 바닥글 또는 계정 설정(사용 가능한 경우)에서 '쿠키 관리' 링크를 클릭하여 언제든지 동의를 철회하거나 쿠키 기본 설정을 변경할 권한이 있습니다. 자세한 내용은 <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ko-KR>쿠키 정책</a>을 참조하십시오.\",\"essential_title\":\"필수 쿠키\",\"basic_title\":\"기본 분석 쿠키\",\"advanced_title\":\"고급 분석 쿠키\",\"marketing_title\":\"마케팅 쿠키\",\"btn_decline\":\"필수 쿠키만 수락\",\"btn_back\":\"뒤로\",\"btn_accept_selected\":\"선택 확인\",\"btn_accept\":\"모두 수락 및 닫기\",\"btn_manage\":\"쿠키 관리\",\"essential_text\":\"이러한 자사 쿠키는 당사 웹 사이트의 기능 및 보안과 귀하에게 필요한 서비스에 필요합니다. 해당 쿠키는 일반적으로 쿠키 기본 설정 기억, 로그인 또는 장바구니에 항목을 보관하는 등 특정 기능을 사용할 수 있도록 작업에 대한 응답으로 설정됩니다. 이러한 쿠키를 수신 거부할 수 없으며 브라우저를 통해 쿠키를 차단하면 사이트 기능에 영향을 줄 수 있습니다.\",\"basic_text\":\"이러한 자사 쿠키를 사용하면 웹 사이트의 방문자/사용자 수를 측정하고 신뢰할 수 있는 파트너의 도움을 받아 집계된 사용 및 성능 통계를 생성할 수 있습니다. 당사는 웹 사이트 트래픽과 캠페인 성과에 대한 기본적인 통찰력을 얻고 웹 사이트의 버그를 해결하기 위해 이를 사용합니다.\",\"advanced_text\":\"이러한 자사 또는 타사 쿠키는 타사 도구의 데이터로 데이터 집합을 보강하여 당사 웹 사이트 및 제공되는 각 서비스와 상호 작용하는 방식을 이해할 수 있도록 도와줍니다. 당사는 이러한 쿠키를 사용하여 웹 사이트, 서비스 및 사용자 환경을 개선하고 버그 또는 기타 문제를 찾아 해결하며 캠페인의 효과를 평가합니다. \",\"marketing_text\":\"당사의 마케팅 파트너는 이러한 타사 쿠키를 통해 당사 웹 사이트에서 귀하의 일부 활동을 추적하여(예: 귀하가 당사 제품을 다운로드하거나 구매할 때) 귀하의 관심사와 요구에 대해 알아보고 관련성이 있는 타겟 광고를 게재할 수 있습니다.\"},\r\n  \"lv-LV\":{\"title\":\"Jūsu sīkfailu izvēle, jūsu konfidencialitāte\",\"description\":\"Mūsu uzņēmums un mūsu partneri izmanto sīkfailus, lai nodrošinātu jums vislabāko optimizēto pieredzi tiešsaistē, analizētu mūsu tīmekļa vietnes datplūsmu un rādītu jums personalizētas reklāmas. Jūs varat piekrist visu sīkfailu vākšanai, noklikšķinot uz “Pieņemt visu un aizvērt”, noraidīt visus nebūtiskos sīkfailus, izvēloties “Pieņemt tikai būtiskos sīkfailus”, vai pielāgot sīkfailu iestatījumus, noklikšķinot uz “Pārvaldīt sīkfailus”. Jums ir arī tiesības jebkurā laikā atsaukt savu piekrišanu attiecībā uz sīkfailiem vai mainīt preferences attiecībā uz sīkfailiem, noklikšķinot uz saites “Pārvaldīt sīkfailus” mūsu tīmekļa vietnes kājenē vai konta iestatījumu sadaļā (ja tā ir pieejama). Papildinformāciju skatiet mūsu <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=lv-LV>sīkfailu politikā</a>.\",\"essential_title\":\"Būtiskie sīkfaili\",\"basic_title\":\"Pamata analītiskie sīkfaili\",\"advanced_title\":\"Papildu analītiskie sīkfaili\",\"marketing_title\":\"Mārketinga sīkfaili\",\"btn_decline\":\"Pieņemt tikai būtiskos sīkfailus\",\"btn_back\":\"Atpakaļ\",\"btn_accept_selected\":\"Apstiprināt manas izvēles\",\"btn_accept\":\"Pieņemt visu un aizvērt\",\"btn_manage\":\"Pārvaldīt sīkfailus\",\"essential_text\":\"Šie pirmās puses sīkfaili ir nepieciešami mūsu tīmekļa vietnes un jums nepieciešamo pakalpojumu darbības un drošības nodrošināšanai. Tie parasti tiek iestatīti, reaģējot uz jūsu darbībām, lai iespējotu noteiktas funkcijas izmantošanu, piemēram, atcerētos jūsu sīkfailu preferences, pieteikšanās informāciju vai saglabātu jūsu preces grozā. Jūs nevar atteikties no šiem sīkfailiem, un to bloķēšana, izmantojot pārlūkprogrammu, var ietekmēt vietnes funkcionalitāti.\",\"basic_text\":\"Šie pirmās puses sīkfaili sniedz iespēju noteikt mūsu tīmekļa vietnes apmeklētāju/lietotāju skaitu un izveidot apkopotu lietojuma un veiktspējas statistiku, izmantojot mūsu uzticamo partneru sniegto palīdzību. Mēs izmantojam šos sīkfailus, lai iegūtu pamata ieskatus par mūsu tīmekļa vietnes datplūsmu un kampaņu veiktspēju, kā arī, lai novērstu tīmekļa vietnes kļūdas.\",\"advanced_text\":\"Šie pirmās vai trešās puses sīkfaili palīdz mums izprast lietotāju mijiedarbību ar mūsu tīmekļa vietni un katru piedāvāto pakalpojumu, bagātinot mūsu datu kopas ar datiem no trešo pušu rīkiem. Mēs izmantojam šos sīkfailus, lai uzlabotu savu tīmekļa vietni, pakalpojumus un lietotāju pieredzi, atrastu un novērstu kļūdas vai citas problēmas un novērtētu savu kampaņu efektivitāti. \",\"marketing_text\":\"Šie trešo pušu sīkfaili ļauj mūsu mārketinga partneriem izsekot dažas no jūsu darbībām mūsu tīmekļa vietnē (piemēram, kad lejupielādējat vai iegādājaties mūsu produktu), lai uzzinātu par jūsu interesēm un vajadzībām un parādītu jums atbilstošākas mērķētas reklāmas.\"},\r\n  \"lt-LT\":{\"title\":\"Jūsų slapukų pasirinkimas, jūsų privatumas\",\"description\":\"Mes ir mūsų partneriai naudojame slapukus tam, kad suteiktume jums geriausią optimizuotą patirtį internete, analizuotume svetainės srautą ir teiktume jums pritaikytus skelbimus. Galite sutikti su visų slapukų rinkimu spustelėdami „Priimti visus ir uždaryti“, atmesti visus netechninius slapukus pasirinkdami „Priimti tik techninius slapukus“ arba koreguoti slapukų nustatymus spustelėdami „Tvarkyti slapukus“. Taip pat turite teisę bet kada atšaukti savo sutikimą arba pakeisti slapukų nustatymus spustelėdami nuorodą „Tvarkyti slapukus“ mūsų svetainės poraštėje arba savo paskyros nustatymuose (jei yra). Daugiau informacijos rasite mūsų <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=lt-LT>slapukų politikoje</a>.\",\"essential_title\":\"Techniniai slapukai\",\"basic_title\":\"Pagrindiniai veiklos slapukai\",\"advanced_title\":\"Išplėstiniai veiklos slapukai\",\"marketing_title\":\"Tiksliniai ar reklaminiai slapukai\",\"btn_decline\":\"Priimti tik techninius slapukus\",\"btn_back\":\"Atgal\",\"btn_accept_selected\":\"Patvirtinti mano pasirinkimus\",\"btn_accept\":\"Priimti visus ir uždaryti\",\"btn_manage\":\"Tvarkyti slapukus\",\"essential_text\":\"Šie slapukai yra būtini mūsų svetainės veikimui ir saugumui bei reikalingoms paslaugoms užtikrinti. Paprastai jie nustatomi atsižvelgiant į jūsų veiksmus, kad būtų galima naudotis tam tikromis funkcijomis, pvz., prisiminti jūsų slapukų nuostatas, prisijungti ar laikyti prekes krepšelyje. Negalite atsisakyti šių slapukų, o jų blokavimas naršyklėje gali turėti įtakos korektiškam svetainės veikimui.\",\"basic_text\":\"Šie pirmosios šalies slapukai leidžia įvertinti svetainės lankytojų skaičių ir, padedant patikimiems partneriams, kaupti naudojimo ir našumo statistiką. Juos naudojame norėdami gauti pagrindinę informaciją apie mūsų svetainės srautą ir našumą bei pašalinti klaidas svetainėje.\",\"advanced_text\":\"Šie slapukai padeda mums suprasti, kaip sąveikaujate su mūsų svetaine bei kiekviena siūloma paslauga, ir praturtina mūsų duomenų rinkinius trečiųjų šalių įrankių duomenimis. Šiuos slapukus naudojame norėdami patobulinti savo svetainę, paslaugas ir naudotojų patirtį, rasti ir išspręsti susijusias klaidas ar kitas problemas ir įvertinti kampanijų veiksmingumą. \",\"marketing_text\":\"Šie slapukai naudojami tam, kad rodytų reklaminius skelbimus, kurie turėtų būti įdomūs būtent Jums ir atitikti Jūsų interesus. Šie slapukai nerenka informacijos, leidžiančios atpažinti Svetainės lankytoją. Šie slapukai gali būti išjungti, o reklaminiai skelbimai nebus rodomi.\"},\r\n  \"nn-NO\":{\"title\":\"Ditt valg av informasjonskapsler – ditt personvern\",\"description\":\"Vi og partnerne våre bruker informasjonskapsler for å gi deg den best optimaliserte nettopplevelsen, analysere trafikken på nettstedet vårt og vise deg personlig tilpassede annonser. Du kan godta innsamling av alle informasjonskapsler ved å klikke på «Godta alle og lukk», avvise alle ikke-essensielle informasjonskapsler ved å velge «Godta kun essensielle informasjonskapsler» eller justere oppsettene for informasjonskapsler ved å klikke på «Administrer informasjonskapsler». Du har også rett til å trekke tilbake samtykket eller endre preferansene dine for informasjonskapsler når som helst ved å klikke på koblingen «Administrer informasjonskapsler» i bunnteksten på nettstedet vårt eller i kontooppsettene dine (dersom disse er tilgjengelige). For å få mer informasjon, se <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=nb-NO>retningslinjene våre for informasjonskapsler</a>.\",\"essential_title\":\"Viktige informasjonskapsler\",\"basic_title\":\"Grunnleggende analytiske informasjonskapsler\",\"advanced_title\":\"Avanserte analytiske informasjonskapsler\",\"marketing_title\":\"Markedsføringsinformasjonskapsler\",\"btn_decline\":\"Godta kun essensielle informasjonskapsler\",\"btn_back\":\"Tilbake\",\"btn_accept_selected\":\"Bekreft mine valg\",\"btn_accept\":\"Godta alle og lukk\",\"btn_manage\":\"Administrer informasjonskapsler\",\"essential_text\":\"Disse førsteparts informasjonskapslene er nødvendige for funksjonaliteten og sikkerheten til nettstedet vårt og tjenestene du trenger. De blir vanligvis angitt som følge av handlingene dine for å aktivere bruken av visse funksjoner, for eksempel for å huske preferansene dine for informasjonskapsler, logge på eller huske varer i handlekurven. Du kan ikke velge bort disse informasjonskapslene, og hvis du blokkerer dem via nettleseren, kan det påvirke nettstedets funksjonalitet.\",\"basic_text\":\"Med disse førsteparts informasjonskapslene kan vi måle antall besøkende / brukere av nettstedet vårt og lage sammenstilt bruks- og ytelsesstatistikk med hjelp fra våre betrodde partnere. Vi bruker dem til å få grunnleggende innsikt i nettstedstrafikken vår og kampanjeresultatene våre samt for å løse feil på nettstedet vårt.\",\"advanced_text\":\"Med disse første- eller tredjeparts informasjonskapslene kan vi forstå hvordan du samhandler med nettstedet vårt og de ulike tjenestene vi tilbyr, ved å berike datasettene våre med data fra tredjepartsverktøy. Vi bruker disse informasjonskapslene til å forbedre nettstedet vårt, tjenestene våre og brukeropplevelsen vår, finne og løse feil eller andre problemer samt evaluere effektiviteten av kampanjene våre. \",\"marketing_text\":\"Disse tredjeparts informasjonskapslene lar markedsføringspartnerne våre spore noen av aktivitetene dine på nettstedet vårt (for eksempel når du laster ned eller kjøper produktet vårt) for å lære om interessene og behovene dine og vise deg mer relevante målrettede annonser.\"},\r\n  \"nb-NO\":{\"title\":\"Ditt valg av informasjonskapsler – ditt personvern\",\"description\":\"Vi og partnerne våre bruker informasjonskapsler for å gi deg den best optimaliserte nettopplevelsen, analysere trafikken på nettstedet vårt og vise deg personlig tilpassede annonser. Du kan godta innsamling av alle informasjonskapsler ved å klikke på «Godta alle og lukk», avvise alle ikke-essensielle informasjonskapsler ved å velge «Godta kun essensielle informasjonskapsler» eller justere oppsettene for informasjonskapsler ved å klikke på «Administrer informasjonskapsler». Du har også rett til å trekke tilbake samtykket eller endre preferansene dine for informasjonskapsler når som helst ved å klikke på koblingen «Administrer informasjonskapsler» i bunnteksten på nettstedet vårt eller i kontooppsettene dine (dersom disse er tilgjengelige). For å få mer informasjon, se <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=nb-NO>retningslinjene våre for informasjonskapsler</a>.\",\"essential_title\":\"Viktige informasjonskapsler\",\"basic_title\":\"Grunnleggende analytiske informasjonskapsler\",\"advanced_title\":\"Avanserte analytiske informasjonskapsler\",\"marketing_title\":\"Markedsføringsinformasjonskapsler\",\"btn_decline\":\"Godta kun essensielle informasjonskapsler\",\"btn_back\":\"Tilbake\",\"btn_accept_selected\":\"Bekreft mine valg\",\"btn_accept\":\"Godta alle og lukk\",\"btn_manage\":\"Administrer informasjonskapsler\",\"essential_text\":\"Disse førsteparts informasjonskapslene er nødvendige for funksjonaliteten og sikkerheten til nettstedet vårt og tjenestene du trenger. De blir vanligvis angitt som følge av handlingene dine for å aktivere bruken av visse funksjoner, for eksempel for å huske preferansene dine for informasjonskapsler, logge på eller huske varer i handlekurven. Du kan ikke velge bort disse informasjonskapslene, og hvis du blokkerer dem via nettleseren, kan det påvirke nettstedets funksjonalitet.\",\"basic_text\":\"Med disse førsteparts informasjonskapslene kan vi måle antall besøkende / brukere av nettstedet vårt og lage sammenstilt bruks- og ytelsesstatistikk med hjelp fra våre betrodde partnere. Vi bruker dem til å få grunnleggende innsikt i nettstedstrafikken vår og kampanjeresultatene våre samt for å løse feil på nettstedet vårt.\",\"advanced_text\":\"Med disse første- eller tredjeparts informasjonskapslene kan vi forstå hvordan du samhandler med nettstedet vårt og de ulike tjenestene vi tilbyr, ved å berike datasettene våre med data fra tredjepartsverktøy. Vi bruker disse informasjonskapslene til å forbedre nettstedet vårt, tjenestene våre og brukeropplevelsen vår, finne og løse feil eller andre problemer samt evaluere effektiviteten av kampanjene våre. \",\"marketing_text\":\"Disse tredjeparts informasjonskapslene lar markedsføringspartnerne våre spore noen av aktivitetene dine på nettstedet vårt (for eksempel når du laster ned eller kjøper produktet vårt) for å lære om interessene og behovene dine og vise deg mer relevante målrettede annonser.\"},\r\n  \"pl-PL\":{\"title\":\"Twój wybór plików cookie, Twoja prywatność\",\"description\":\"Wraz z naszymi partnerami używamy plików cookie, aby zapewnić Ci optymalną obsługę online, analizować ruch na naszej stronie internetowej i dostarczać Ci spersonalizowane reklamy. Możesz zgodzić się na gromadzenie wszystkich plików cookie, klikając przycisk „Zaakceptuj wszystkie i zamknij”, odrzucić wszystkie niepotrzebne pliki cookie, wybierając opcję „Akceptuj tylko niezbędne pliki cookie”, lub dostosować ustawienia plików cookie, klikając link „Zarządzaj plikami cookie” w stopce naszej witryny lub w ustawieniach konta (jeśli są dostępne). Aby uzyskać więcej informacji, zapoznaj się z naszą <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=pl-PL>Polityką dotyczącą plików cookie</a>.\",\"essential_title\":\"Niezbędne pliki cookie\",\"basic_title\":\"Podstawowe analityczne pliki cookie\",\"advanced_title\":\"Zaawansowane analityczne pliki cookie\",\"marketing_title\":\"Marketingowe pliki cookie\",\"btn_decline\":\"Akceptuj tylko niezbędne pliki cookie\",\"btn_back\":\"Wstecz\",\"btn_accept_selected\":\"Potwierdź wybór\",\"btn_accept\":\"Zaakceptuj wszystkie i zamknij\",\"btn_manage\":\"Zarządzaj plikami cookie\",\"essential_text\":\"Własne pliki cookie są niezbędne do funkcjonowania i bezpieczeństwa naszej witryny oraz usług wymaganych przez użytkownika. Zazwyczaj są one ustawiane w odpowiedzi na działania użytkownika, aby umożliwić korzystanie z określonych funkcji, takich jak zapamiętywanie preferencji dotyczących plików cookie, logowanie lub przechowywanie produktów w koszyku. Nie można zrezygnować z tych plików cookie, a blokowanie ich przez przeglądarkę może negatywnie wpłynąć na funkcjonalność witryny.\",\"basic_text\":\"Własne pliki cookie umożliwiają nam pomiar liczby odwiedzających/użytkowników naszej strony internetowej i tworzenie zagregowanych statystyk użytkowania i wydajności z pomocą naszych zaufanych partnerów. Używamy ich, aby uzyskać podstawowy wgląd w ruch na naszej stronie i wydajność naszej kampanii oraz rozwiązywać błędy na naszej stronie internetowej.\",\"advanced_text\":\"Własne lub zewnętrzne pliki cookie pomagają nam rozumieć sposób interakcji użytkownika z naszą witryną i każdą oferowaną usługą przez wzbogacenie naszych zbiorów danych o dane pochodzące z narzędzi innych firm. Używamy tych plików cookie do ulepszania naszej witryny, usług i obsługi użytkownika, znajdowania i rozwiązywania błędów lub innych problemów oraz do oceny skuteczności naszych kampanii. \",\"marketing_text\":\"Zewnętrzne pliki cookie umożliwiają naszym partnerom marketingowym śledzenie niektórych działań użytkownika w naszej witrynie (na przykład podczas pobierania lub kupowania naszego produktu) w celu poznania jego zainteresowań i potrzeb oraz wyświetlania bardziej odpowiednich, ukierunkowanych reklam.\"},\r\n  \"pt-BR\":{\"title\":\"Sua escolha de cookies, sua privacidade\",\"description\":\"Nós e nossos parceiros usamos cookies para dar a você a melhor experiência on-line otimizada, analisar nosso tráfego de site e entregar a você anúncios personalizados. Você pode concordar com a coleta de todos os cookies clicando em 'Aceitar tudo e fechar', negar todos os cookies não essenciais escolhendo 'Aceitar apenas cookies essenciais' ou ajustar suas configurações de cookies clicando em 'Gerenciar cookies'. Você também tem o direito de retirar seu consentimento em relação aos cookies a qualquer momento clicando no link 'Gerenciar cookies' no rodapé do nosso site ou nas configurações da sua conta (se disponível). Para obter mais informações, consulte nossa <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=pt-BR>Política de Cookies</a>.\",\"essential_title\":\"Cookies essenciais\",\"basic_title\":\"Cookies analíticos básicos\",\"advanced_title\":\"Cookies analíticos avançados\",\"marketing_title\":\"Cookies de marketing\",\"btn_decline\":\"Aceitar apenas cookies essenciais\",\"btn_back\":\"Voltar\",\"btn_accept_selected\":\"Confirmar minha escolha\",\"btn_accept\":\"Aceitar tudo e fechar\",\"btn_manage\":\"Gerenciar cookies\",\"essential_text\":\"Esses cookies de primeira parte são necessários para o funcionamento e segurança de nosso site e para os serviços que você precisa. Normalmente eles são definidos em resposta a suas ações para permitir o uso de determinadas funcionalidades, como lembrar de suas preferências de cookies, entrar ou manter itens no seu carrinho. Não é possível optar por não coletar esses cookies, e bloqueá-los através de um navegador pode afetar a funcionalidade do site.\",\"basic_text\":\"Esses cookies de primeira parte nos permitem medir o número de visitantes/usuários de nosso site e criar estatísticas de uso e desempenho agregadas com a ajuda de nossos parceiros confiáveis. Usamos para obter informações básicas sobre o tráfego de nosso site e nosso desempenho de campanha e para resolver bugs em nosso site.\",\"advanced_text\":\"Esses cookies de primeira parte ou de terceiros nos ajudam a entender como você interage com nosso site e cada serviço oferecido, enriquecendo nossos conjuntos de dados com dados de ferramentas de terceiros. Usamos esses cookies para melhorar nosso site, serviços e experiência do usuário, encontrar e solucionar bugs ou outros problemas com eles, e avaliar a eficácia de nossas campanhas. \",\"marketing_text\":\"Esses cookies de terceiros permitem que nossos parceiros de marketing rastreiem algumas de suas atividades em nosso site (por exemplo, quando você faz download ou compra nosso produto) para aprender sobre seus interesses e necessidades e para mostrar a você anúncios direcionados mais relevantes.\"},\r\n  \"ro-RO\":{\"title\":\"Opțiunile dvs. pentru modulele cookie, confidențialitatea dvs.\",\"description\":\"Împreună cu partenerii noștri, folosim module cookie pentru a vă oferi cea mai bună experiență online optimizată, pentru a analiza traficul site-ului nostru web și pentru a vă prezenta reclame personalizate. Puteți fi de acord cu colectarea tuturor modulelor cookie făcând clic pe „Acceptare toate și închidere”, puteți să refuzați toate modulele cookie neesențiale făcând clic pe „Acceptare doar module cookie esențiale” sau puteți să ajustați setările privind modulele cookie făcând clic pe „Gestionare module cookie”. De asemenea, aveți dreptul să retrageți consimțământul sau să vă modificați preferințele pentru module cookie oricând, făcând clic pe linkul „Gestionare module cookie” din subsolul site-ului nostru web sau în setările contului dvs. (dacă opțiunea este disponibilă). Pentru mai multe informații, vă rugăm să consultați <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ro-RO>Politica noastră privind modulele cookie</a>.\",\"essential_title\":\"Module cookie esențiale\",\"basic_title\":\"Module cookie analitice de bază\",\"advanced_title\":\"Module cookie analitice avansate\",\"marketing_title\":\"Module cookie de marketing\",\"btn_decline\":\"Acceptare doar module cookie esențiale\",\"btn_back\":\"Înapoi\",\"btn_accept_selected\":\"Confirmare opțiuni\",\"btn_accept\":\"Acceptare toate și închidere\",\"btn_manage\":\"Gestionare module cookie\",\"essential_text\":\"Această categorie directă de module cookie sunt necesare pentru funcționarea și securitatea site-ului nostru web și a serviciilor de care aveți nevoie. Acestea sunt de obicei setate ca răspuns la acțiunile dvs., pentru a permite utilizarea anumitor funcționalități, cum ar fi memorarea preferințelor dvs. privind modulele cookie, conectarea sau păstrarea articolelor în coșul de cumpărături. Nu puteți renunța la aceste module cookie, iar blocarea lor prin intermediul unui browser poate afecta funcționarea optimă a site-ului.\",\"basic_text\":\"Această categorie directă de module cookie ne permit să măsurăm numărul de vizitatori/utilizatori ai site-ului nostru web și să creăm statistici agregate de utilizare și performanță, cu ajutorul partenerilor noștri de încredere. Le folosim pentru a obține informații de bază despre traficul de pe site-ul nostru web și performanța campaniei noastre și pentru a rezolva bug-uri pe site-ul nostru web.\",\"advanced_text\":\"Această categorie directă/ terță de module cookie ne ajută să înțelegem modul în care interacționați cu site-ul nostru web și cu fiecare serviciu oferit, completând seturile noastre de date cu date de la instrumente terțe. Utilizăm aceste module cookie pentru a ne îmbunătăți site-ul web, serviciile și experiența utilizatorului, pentru a găsi și rezolva bug-uri sau alte probleme cu acestea și pentru a evalua eficiența campaniilor noastre. \",\"marketing_text\":\"Această categorie terță de module cookie permite partenerilor noștri de marketing să urmărească unele dintre activitățile dvs. pe site-ul nostru web (de exemplu, atunci când descărcați sau cumpărați produsul nostru), pentru a afla mai multe despre interesele și nevoile dvs. și pentru a vă afișa reclame direcționate mai relevante.\"},\r\n  \"ro-MD\":{\"title\":\"Opțiunile dvs. pentru modulele cookie, confidențialitatea dvs.\",\"description\":\"Împreună cu partenerii noștri, folosim module cookie pentru a vă oferi cea mai bună experiență online optimizată, pentru a analiza traficul site-ului nostru web și pentru a vă prezenta reclame personalizate. Puteți fi de acord cu colectarea tuturor modulelor cookie făcând clic pe „Acceptare toate și închidere”, puteți să refuzați toate modulele cookie neesențiale făcând clic pe „Acceptare doar module cookie esențiale” sau puteți să ajustați setările privind modulele cookie făcând clic pe „Gestionare module cookie”. De asemenea, aveți dreptul să retrageți consimțământul sau să vă modificați preferințele pentru module cookie oricând, făcând clic pe linkul „Gestionare module cookie” din subsolul site-ului nostru web sau în setările contului dvs. (dacă opțiunea este disponibilă). Pentru mai multe informații, vă rugăm să consultați <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ro-RO>Politica noastră privind modulele cookie</a>.\",\"essential_title\":\"Module cookie esențiale\",\"basic_title\":\"Module cookie analitice de bază\",\"advanced_title\":\"Module cookie analitice avansate\",\"marketing_title\":\"Module cookie de marketing\",\"btn_decline\":\"Acceptare doar module cookie esențiale\",\"btn_back\":\"Înapoi\",\"btn_accept_selected\":\"Confirmare opțiuni\",\"btn_accept\":\"Acceptare toate și închidere\",\"btn_manage\":\"Gestionare module cookie\",\"essential_text\":\"Această categorie directă de module cookie sunt necesare pentru funcționarea și securitatea site-ului nostru web și a serviciilor de care aveți nevoie. Acestea sunt de obicei setate ca răspuns la acțiunile dvs., pentru a permite utilizarea anumitor funcționalități, cum ar fi memorarea preferințelor dvs. privind modulele cookie, conectarea sau păstrarea articolelor în coșul de cumpărături. Nu puteți renunța la aceste module cookie, iar blocarea lor prin intermediul unui browser poate afecta funcționarea optimă a site-ului.\",\"basic_text\":\"Această categorie directă de module cookie ne permit să măsurăm numărul de vizitatori/utilizatori ai site-ului nostru web și să creăm statistici agregate de utilizare și performanță, cu ajutorul partenerilor noștri de încredere. Le folosim pentru a obține informații de bază despre traficul de pe site-ul nostru web și performanța campaniei noastre și pentru a rezolva bug-uri pe site-ul nostru web.\",\"advanced_text\":\"Această categorie directă/ terță de module cookie ne ajută să înțelegem modul în care interacționați cu site-ul nostru web și cu fiecare serviciu oferit, completând seturile noastre de date cu date de la instrumente terțe. Utilizăm aceste module cookie pentru a ne îmbunătăți site-ul web, serviciile și experiența utilizatorului, pentru a găsi și rezolva bug-uri sau alte probleme cu acestea și pentru a evalua eficiența campaniilor noastre. \",\"marketing_text\":\"Această categorie terță de module cookie permite partenerilor noștri de marketing să urmărească unele dintre activitățile dvs. pe site-ul nostru web (de exemplu, atunci când descărcați sau cumpărați produsul nostru), pentru a afla mai multe despre interesele și nevoile dvs. și pentru a vă afișa reclame direcționate mai relevante.\"},\r\n  \"ru-RU\":{\"title\":\"Ваши настройки для файлов cookie — ваша конфиденциальность\",\"description\":\"Мы и наши партнеры используем файлы cookie, чтобы обеспечить для вас оптимальную работу в Интернете, анализировать трафик нашего веб-сайта и показывать вам персонализированную рекламу. Вы можете разрешить сбор всех файлов cookie, щелкнув 'Принять все и закрыть', отклонить все файлы cookie, кроме базовых, выбрав 'Принять только базовые файлы cookie', или настроить параметры файлов cookie, щелкнув 'Управлять файлами cookie'. Кроме того, вы можете в любой момент отозвать свое разрешение или изменить параметры файлов cookie, перейдя по ссылке 'Управлять файлами cookie' в нижней части нашего веб-сайта или в настройках вашей учетной записи (при наличии). Дополнительные сведения можно найти в нашей <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=ru-RU>политике в отношении файлов cookie</a>.\",\"essential_title\":\"Базовые файлы cookie\",\"basic_title\":\"Основные аналитические файлы cookie\",\"advanced_title\":\"Расширенные аналитические файлы cookie\",\"marketing_title\":\"Маркетинговые файлы cookie\",\"btn_decline\":\"Принять только базовые файлы cookie\",\"btn_back\":\"Назад\",\"btn_accept_selected\":\"Подтвердить мой выбор\",\"btn_accept\":\"Принять все и закрыть\",\"btn_manage\":\"Управлять файлами cookie\",\"essential_text\":\"Эти основные файлы cookie нужны для работы и защиты нашего веб-сайта и необходимых вам служб. Обычно они устанавливаются в ответ на ваши действия, чтобы обеспечить использование определенных функций, таких как запоминание ваших настроек cookie, авторизация или хранение элементов в корзине покупателя. От таких файлов cookie отказаться нельзя, а их блокировка через браузер может негативно повлиять на работу сайта.\",\"basic_text\":\"Эти основные файлы cookie позволяют нам измерять количество посетителей/пользователей нашего веб-сайта и создавать комплексную статистику использования и работоспособности с помощью наших надежных партнеров. Мы используем их для получения базового представления о трафике нашего веб-сайта и эффективности наших кампаний, а также для устранения ошибок на нашем веб-сайте.\",\"advanced_text\":\"Эти основные или сторонние файлы cookie дополняют наши наборы данных данными из сторонних средств и помогают нам понять, как вы взаимодействуете с нашим веб-сайтом и каждой из предлагаемых служб. Мы используем эти файлы cookie для улучшения нашего веб-сайта, служб и пользовательского опыта, для поиска и устранения ошибок и других проблем, а также для оценки эффективности наших кампаний. \",\"marketing_text\":\"Эти сторонние файлы cookie позволяют нашим маркетинговым партнерам отслеживать некоторые ваши действия на нашем веб-сайте (например, когда вы загружаете или покупаете наш продукт), чтобы узнать о ваших интересах и потребностях и показывать вам более актуальную целевую рекламу.\"},\r\n  \"sr-Latn-RS\":{\"title\":\"Vaš izbor kolačića, vaša privatnost\",\"description\":\"Mi i naši partneri koristimo kolačiće da bismo vam pružili najbolje optimizovano iskustvo na mreži, za analizu saobraćaja naše veb-lokacije i prikazivanje personalizovanih oglasa. Možete da prihvatite prikupljanje svih kolačića klikom na „Prihvati sve i zatvori“, da odbijete sve kolačiće koji nisu osnovni kolačići tako što ćete izabrati „Prihvati samo osnovne kolačiće“ ili da prilagodite podešavanja kolačića klikom na „Upravljanje kolačićima“. Takođe imate pravo da opozovete svoju saglasnost za kolačiće u bilo kom trenutku klikom na vezu „Upravljanje kolačićima“ u podnožju naše veb-lokacije ili u podešavanjima naloga (ako je dostupno). Više informacija potražite u delu <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sr-Latn-RS>Smernice u vezi sa kolačićima</a>.\",\"essential_title\":\"Osnovne kolačiće\",\"basic_title\":\"Osnovne analitičke kolačiće\",\"advanced_title\":\"Napredne analitičke kolačiće\",\"marketing_title\":\"Marketinške kolačiće\",\"btn_decline\":\"Prihvati samo osnovne kolačiće\",\"btn_back\":\"Nazad\",\"btn_accept_selected\":\"Potvrdi moj izbor\",\"btn_accept\":\"Prihvati sve i zatvori\",\"btn_manage\":\"Upravljanje kolačićima\",\"essential_text\":\"Ovi kolačići prve strane su neophodni za funkcionisanje i bezbednost naše veb-lokacije i usluga koje su vam potrebne. Obično se postavljaju kao odgovor na radnje koje ste obavili kako bi se omogućilo korišćenje određenih funkcionalnosti, kao što su beleženje vaših preferenci za kolačiće, prijavljivanje ili držanje stavki u korpi za kupovinu. Ne možete da odbijete ove kolačiće, a njihovo blokiranje preko pregledača može da utiče na funkcionalnost lokacije.\",\"basic_text\":\"Ovi kolačići prve strane nam omogućavaju da izmerimo broj posetilaca/korisnika naše veb-lokacije i kreiramo zbirnu statistiku korišćenja i učinka uz pomoć naših pouzdanih partnera. Koristimo ih da bismo dobili uvid u saobraćaj na našoj veb-lokaciji i učinak kampanje, kao i da bismo otklonili greške na našoj veb-lokaciji.\",\"advanced_text\":\"Ovi kolačići prve ili treće strane pomažu nam da razumemo način na koji komunicirate sa našom veb-lokacijom i svakom ponuđenom uslugom. Na taj način dobijamo podatke od alatki trećih strana koji obogaćuju naše skupove podataka. Ove kolačiće koristimo kako bismo poboljšali našu veb-lokaciju, usluge i korisničko iskustvo, pronašli i otklonili greške ili druge probleme sa njima i procenili efikasnost naših kampanja. \",\"marketing_text\":\"Ovi kolačići trećih strana omogućavaju našim marketinškim partnerima da prate neke od vaših aktivnosti na našoj veb-lokaciji (na primer, kada preuzmete ili kupite naš proizvod) kako bi se upoznali sa vašim interesovanjima i potrebama, i prikazali vam relevantnije ciljane oglase.\"},\r\n  \"sk-SK\":{\"title\":\"Váš výber súborov cookie, vaše súkromie\",\"description\":\"Spolu s partnermi používame súbory cookie s cieľom poskytnúť vám čo najlepšie optimalizované online prostredie, analyzovať návštevnosť stránky a ponúknuť vám prispôsobené reklamy. Zbieranie všetkých súborov cookie môžete odsúhlasiť kliknutím na tlačidlo „Prijať všetko a zavrieť“, všetky voliteľné súbory cookie môžete odmietnuť výberom možnosti „Prijať iba základné súbory cookie“ alebo môžete upraviť ich nastavenie kliknutím na možnosť „Spravovať súbory cookie“. Udelený súhlas s používaním súborov cookie môžete kedykoľvek zrušiť alebo svoj výber upraviť, a to kliknutím na odkaz „Spravovať súbory cookie“ uvedený v spodnej časti našej webovej stránky, prípadne v nastaveniach účtu. Viac informácií nájdete v dokumente <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sk-SK>Zásady používania súborov cookie</a>.\",\"essential_title\":\"Základné súbory cookie\",\"basic_title\":\"Základné analytické súbory cookie\",\"advanced_title\":\"Rozšírené analytické súbory cookie\",\"marketing_title\":\"Marketingové súbory cookie\",\"btn_decline\":\"Prijať iba základné súbory cookie\",\"btn_back\":\"Späť\",\"btn_accept_selected\":\"Potvrdiť môj výber\",\"btn_accept\":\"Prijať všetko a zavrieť\",\"btn_manage\":\"Spravovať súbory cookie\",\"essential_text\":\"Tieto súbory cookie prvej strany sú nevyhnutné na správne fungovanie a zabezpečenie webovej stránky a požadovaných služieb. Zvyčajne sa nastavia na základe vašej akcie a umožňujú využívanie funkcií, ako je napríklad zapamätanie si preferencií pre cookies, prihlásenie či uloženie položiek v nákupnom košíku. Stránka si vyžaduje súhlas s týmito súbormi cookie, ich blokovanie v prehliadači môže ovplyvniť funkčnosť nášho webu.\",\"basic_text\":\"Tieto súbory cookie prvej strany nám umožňujú merať počet návštevníkov/používateľov našej webovej stránky a vytvárať agregované štatistiky používania a výkonnosti s pomocou našich dôveryhodných partnerov. Používame ich na to, aby sme získali základný prehľad o návštevnosti nášho webu a účinnosti našich kampaní, ako aj na riešenie chýb na našej webovej stránke.\",\"advanced_text\":\"Tieto súbory cookie prvej alebo tretej strany nám poskytujú prehľad o tom, ako návštevníci pracujú s webovou stránkou a ponúkanými službami, a to vďaka rozširovaniu našich dát o údaje z nástrojov tretích strán. Používame ich na zlepšovanie nášho webu, služieb a používateľského prostredia, na hľadanie a riešenie chýb či iných súvisiacich problémov, ako aj na vyhodnocovanie účinnosti našich kampaní. \",\"marketing_text\":\"Tieto súbory cookie tretích strán umožňujú našim marketingovým partnerom sledovať niektoré činnosti na našej stránke (napríklad keď sťahujete alebo kupujete náš produkt), aby sa vám zobrazovali cielenejšie reklamy na základe vašich potrieb.\"},\r\n  \"sl-SI\":{\"title\":\"Vaša izbira piškotkov, vaša zasebnost\",\"description\":\"Mi in naši partnerji uporabljamo piškotke, da vam zagotovimo najoptimalnejšo izkušnjo v spletu, analiziramo promet našega spletnega mesta ter vam prikazujemo prilagojene oglase. Lahko privolite v zbiranje vseh piškotkov tako, da kliknete možnost »Sprejmi vse in zapri«, zavrnete vse neosnovne piškotke tako, da kliknete »Sprejmi samo osnovne piškotke«, ali pa prilagodite nastavitve piškotkov tako, da kliknete »Upravljanje piškotkov«. Svojo privolitev glede piškotkov imate pravico kadar koli preklicati ali spremeniti nastavitve piškotkov tako, da kliknete povezavo za »Upravljanje piškotkov« v nogi našega spletnega mesta ali v nastavitvah računa (če je na voljo). Za več informacij si oglejte naš <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sl-SI>pravilnik o piškotkih</a>.\",\"essential_title\":\"Osnovni piškotki\",\"basic_title\":\"Osnovni analitični piškotki\",\"advanced_title\":\"Napredni analitični piškotki\",\"marketing_title\":\"Marketinški piškotki\",\"btn_decline\":\"Sprejmi samo osnovne piškotke\",\"btn_back\":\"Nazaj\",\"btn_accept_selected\":\"Potrdi moje izbire\",\"btn_accept\":\"Sprejmi vse in zapri\",\"btn_manage\":\"Upravljanje piškotkov\",\"essential_text\":\"Ti lastni piškotki so potrebni za delovanje in varnost našega spletnega mesta in storitev, ki jih potrebujete. Običajno so nastavljeni kot odgovor na vaša dejanja, da omogočijo uporabo določene funkcije, kot je pomnjenje vaših nastavitev piškotkov, prijava ali hranjenje izdelkov v košarici. Teh piškotkov ne morete onemogočiti, njihovo blokiranje prek brskalnika pa lahko vpliva na delovanje spletnega mesta.\",\"basic_text\":\"Ti lastni piškotki nam omogočajo merjenje števila obiskovalcev/uporabnikov našega spletnega mesta ter ustvarjanje zbirne statistike uporabe in uspešnosti s pomočjo naših zaupanja vrednih partnerjev. Uporabljamo jih, da bi dobili osnovni vpogled v promet na našem spletnem mestu in uspešnost naše kampanje ter za reševanje napak na našem spletnem mestu.\",\"advanced_text\":\"Ti lastni piškotki ali piškotki drugih ponudnikov nam pomagajo razumeti, kako uporabljate naše spletno mesto in posamezno zagotovljeno storitev, in sicer z obogatitvijo naših naborov podatkov z orodji drugih ponudnikov. Te piškotke uporabljamo za izboljšanje svojega spletnega mesta, storitev in uporabniške izkušnje, iskanje in odpravljanje napak ali drugih težav s spletnim mestom ali storitvami ter ocenjevanje učinkovitosti naših kampanj. \",\"marketing_text\":\"Ti piškotki drugih ponudnikov omogočajo našim partnerjem pri trženju, da spremljajo nekatere vaše dejavnosti na našem spletnem mestu (npr. prenos ali nakup našega izdelka), s čimer pridobijo več informacij o vaših interesih in potrebah ter vam lahko prikazujejo ustreznejše ciljane oglase.\"},\r\n  \"es-CL\":{\"title\":\"Su elección de cookies, su privacidad\",\"description\":\"Tanto nosotros como nuestros socios usamos cookies para ofrecerle la mejor experiencia optimizada en línea, para analizar el tráfico de nuestro sitio web y para mostrarle anuncios personalizados. Para aceptar la recopilación de todas las cookies, haga clic en 'Aceptar todas y cerrar'; para rechazar todas las cookies que no son esenciales, seleccione 'Aceptar solo las cookies esenciales'; para ajustar la configuración de sus cookies, haga clic en 'Administrar cookies'. También tiene derecho a revocar su consentimiento o cambiar su preferencia de cookies en cualquier momento al hacer clic en el enlace 'Administrar cookies' en el pie de página de nuestro sitio web o en la configuración de su cuenta (si está disponible). Para obtener más información, consulte nuestra <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=es-CL>Política de cookies</a>.\",\"essential_title\":\"Cookies esenciales\",\"basic_title\":\"Cookies analíticas básicas\",\"advanced_title\":\"Cookies analíticas avanzadas\",\"marketing_title\":\"Cookies de marketing\",\"btn_decline\":\"Aceptar únicamente las cookies esenciales\",\"btn_back\":\"Atrás\",\"btn_accept_selected\":\"Confirmar mis elecciones\",\"btn_accept\":\"Aceptar todas y cerrar\",\"btn_manage\":\"Administrar perfiles\",\"essential_text\":\"Estas cookies de terceros son necesarias para el funcionamiento y la seguridad de nuestro sitio web y los servicios que usted solicite. Normalmente se crean en respuesta a sus acciones y permiten el uso de determinadas funciones, como recordar sus preferencias de cookies, iniciar sesión o añadir elementos a su carrito de compras. No puede excluir estas cookies, y bloquearlas desde un navegador podría afectar a la funcionalidad del sitio.\",\"basic_text\":\"Estas cookies de terceros nos permiten evaluar el número de visitantes o usuarios de nuestro sitio web, así como crear estadísticas de uso y rendimiento agregadas con la ayuda de nuestros socios de confianza. Las usamos para obtener información básica sobre el tráfico de sitios web y el rendimiento de la campaña y para resolver errores en nuestro sitio web.\",\"advanced_text\":\"Estas cookies directas o de terceros nos ayudan a comprender cómo interactúa usted con nuestro sitio web y con los servicios que ofrecemos complementando nuestros conjuntos de datos con datos obtenidos de herramientas de terceros. Usamos estas cookies para mejorar nuestro sitio web, nuestros servicios y la experiencia que le brindamos como usuario, para encontrar y resolver errores u otros problemas con ellos, y para evaluar la eficacia de nuestras campañas. \",\"marketing_text\":\"Estas cookies de terceros permiten a nuestros socios de marketing hacer un seguimiento de algunas de sus actividades en nuestro sitio web (por ejemplo, cuando descarga o compra nuestro producto), obtener más información sobre sus intereses y necesidades, y mostrarle anuncios dirigidos más relevantes.\"},\r\n  \"es-ES\":{\"title\":\"Su elección de cookies, su privacidad\",\"description\":\"Tanto nosotros como nuestros socios usamos cookies para ofrecer la experiencia en línea más optimizada posible, analizar el tráfico de nuestro sitio web y mostrarle anuncios personalizados. Para aceptar la recopilación de todas las cookies, haga clic en 'Aceptar todo y cerrar'; para rechazar todas las cookies que no sean esenciales, haga clic en 'Aceptar solo las cookies esenciales'; y para ajustar la configuración de las cookies, haga clic en 'Administrar cookies'. También tiene derecho a revocar su consentimiento y a cambiar sus preferencias para las cookies en cualquier momento. Para ello, haga clic en el vínculo 'Administrar cookies' ubicado en el pie de página de nuestro sitio web o en la configuración de su cuenta (si está disponible). Para obtener más información, consulte nuestra <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=es-ES>Política de cookies</a>.\",\"essential_title\":\"Cookies esenciales\",\"basic_title\":\"Cookies analíticas básicas\",\"advanced_title\":\"Cookies analíticas avanzadas\",\"marketing_title\":\"Cookies de marketing\",\"btn_decline\":\"Aceptar solo las cookies esenciales\",\"btn_back\":\"Atrás\",\"btn_accept_selected\":\"Confirmar mis elecciones\",\"btn_accept\":\"Aceptar todo y cerrar\",\"btn_manage\":\"Administrar cookies\",\"essential_text\":\"Estas cookies de origen son necesarias para el funcionamiento y la seguridad de nuestro sitio web y los servicios que usted necesita. Normalmente se establecen en respuesta a sus acciones para permitir el uso de determinadas funciones, como recordar sus preferencias de cookies, iniciar sesión o mantener elementos en su carro de la compra. No puede excluir estas cookies, y bloquearlas en el navegador podría afectar a la funcionalidad del sitio.\",\"basic_text\":\"Estas cookies de origen nos permiten medir el número de visitantes/usuarios de nuestro sitio web, así como crear estadísticas de uso y rendimiento agregadas con la ayuda de nuestros socios de confianza. Las usamos para obtener información básica sobre el tráfico de nuestro sitio web y el rendimiento de nuestras campañas, y para resolver errores en nuestro sitio web.\",\"advanced_text\":\"Estas cookies de origen o de terceros nos ayudan a entender cómo interactúa con nuestro sitio web y con cada servicio ofrecido al completar nuestros conjuntos de datos con datos procedentes de herramientas de terceros. Usamos estas cookies para mejorar nuestro sitio web, nuestros servicios y nuestra experiencia de usuario, encontrar y resolver errores u otros problemas en ellos, y evaluar la eficacia de nuestras campañas. \",\"marketing_text\":\"Estas cookies de terceros permiten a nuestros socios de marketing realizar un seguimiento de algunas de sus actividades en nuestro sitio web (por ejemplo, descargar o comprar nuestro producto) para obtener más información sobre sus intereses y necesidades, y para mostrarle anuncios dirigidos más pertinentes.\"},\r\n  \"sv-SE\":{\"title\":\"Ditt val av cookies, din integritet\",\"description\":\"Vi och våra partner använder cookies för att ge dig den bästa optimerade onlineupplevelsen, analysera vår webbplatstrafik och visa anpassade annonser. Du kan godkänna insamlingen av alla cookies genom att klicka på Godkänn alla och stäng, neka alla icke-nödvändiga cookies genom att välja Godkänn endast nödvändiga cookies eller justera dina cookieinställningar genom att klicka på Hantera cookies. Du har även rätt att återkalla ditt samtycke till cookies eller ändra dina cookiepreferenser när som helst genom att klicka på länken Hantera cookies i webbplatsens sidfot eller i kontoinställningarna (om dessa är tillgängliga). För mer information, se vår <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=sv-SE>cookiepolicy</a>.\",\"essential_title\":\"Viktiga cookies\",\"basic_title\":\"Grundläggande analytiska cookies\",\"advanced_title\":\"Avancerade analytiska cookies\",\"marketing_title\":\"Marknadsföringscookies\",\"btn_decline\":\"Godkänn endast nödvändiga cookies\",\"btn_back\":\"Bakåt\",\"btn_accept_selected\":\"Bekräfta mina val\",\"btn_accept\":\"Godkänn alla och stäng\",\"btn_manage\":\"Hantera cookies\",\"essential_text\":\"Dessa förstapartscookies är nödvändiga för att vår webbplats och de tjänster du behöver ska fungera och vara säkra. De ställs vanligtvis in som svar på dina åtgärder för att möjliggöra användning av vissa funktioner, till exempel att komma ihåg dina cookieinställningar, logga in eller behålla artiklar i kundvagnen. Du kan inte välja bort dessa cookies, och att blockera dem via en webbläsare kan påverka webbplatsens funktionalitet.\",\"basic_text\":\"Dessa förstapartscookies gör det möjligt för oss att mäta antalet besökare/användare på vår webbplats och skapa aggregerad användnings- och prestandastatistik med hjälp av våra betrodda partners. Vi använder detta för att få en grundläggande inblick i vår webbplatstrafik och våra kampanjer samt för att korrigera fel på vår webbplats.\",\"advanced_text\":\"Dessa första- eller tredjepartscookies hjälper oss att förstå hur du interagerar med vår webbplats och varje erbjuden tjänst genom att berika våra datamängder med data från tredjepartsverktyg. Vi använder dessa cookies för att förbättra vår webbplats, våra tjänster och användarupplevelse, hitta och lösa buggar eller andra problem med dem och utvärdera våra kampanjers effektivitet. \",\"marketing_text\":\"Dessa tredjepartscookies gör det möjligt för våra marknadsföringspartner att spåra vissa av dina aktiviteter på vår webbplats (till exempel när du laddar ned eller köper vår produkt), för att lära sig om dina intressen och behov och för att visa dig mer relevanta riktade annonser.\"},\r\n  \"th-TH\":{\"title\":\"ตัวเลือกคุกกี้ส่งผลต่อความเป็นส่วนตัวของคุณ\",\"description\":\"เราและพาร์ทเนอร์ของเราใช้คุกกี้เพื่อมอบประสบการณ์ออนไลน์ที่ดีที่สุดให้แก่คุณ วิเคราะห์การเข้าชมเว็บไซต์ของเรา และแสดงโฆษณาที่เกี่ยวข้องกับความสนใจของคุณ คุณสามารถยอมรับการเก็บรวบรวมคุกกี้ได้โดยคลิก 'ยอมรับทั้งหมดและปิด', ปฏิเสธคุกกี้ที่ไม่จำเป็นทั้งหมดโดยเลือก 'ยอมรับคุกกี้ที่จำเป็นเท่านั้น' หรือปรับการตั้งค่าคุกกี้ของคุณโดยคลิกที่ 'จัดการคุกกี้' นอกจากนี้คุณยังมีสิทธิยกเลิกการยินยอมหรือเปลี่ยนการตั้งค่าคุกกี้เมื่อใดก็ได้โดยคลิกที่ลิงก์ 'จัดการคุกกี้' ในส่วนท้ายของหน้าเว็บไซต์ของเราหรือในการตั้งค่าบัญชีของคุณ (หากมี) สำหรับข้อมูลเพิ่มเติมโปรดดู<a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=th-TH>นโยบายคุกกี้</a>ของเรา\",\"essential_title\":\"คุกกี้ที่จำเป็น\",\"basic_title\":\"คุกกี้เชิงวิเคราะห์ขั้นพื้นฐาน\",\"advanced_title\":\"คุกกี้เชิงวิเคราะห์ขั้นสูง\",\"marketing_title\":\"คุกกี้เพื่อการตลาด\",\"btn_decline\":\"ยอมรับคุกกี้ที่จำเป็นเท่านั้น\",\"btn_back\":\"ย้อนกลับ\",\"btn_accept_selected\":\"ยืนยันการตั้งค่าของฉัน\",\"btn_accept\":\"ยอมรับทั้งหมดและปิด\",\"btn_manage\":\"จัดการคุกกี้\",\"essential_text\":\"คุกกี้ของเราเหล่านี้เป็นสิ่งจำเป็นสำหรับการทำงานและความปลอดภัยของเว็บไซต์ของเรารวมถึงบริการที่คุณต้องการ โดยปกติแล้วระบบจะตั้งค่าคุกกี้เหล่านี้ให้ตอบสนองต่อการกระทำของคุณเพื่อให้ใช้ฟังก์ชันการทำงานบางอย่างได้ เช่น การจดจำการตั้งค่าคุกกี้ของคุณ การเข้าสู่ระบบ หรือการเก็บสินค้าไว้ในรถเข็น เป็นต้น คุณไม่สามารถเลือกไม่รับคุกกี้เหล่านี้ได้ และการบล็อกคุกกี้นี้ผ่านเบราว์เซอร์อาจส่งผลต่อการทำงานของเว็บไซต์\",\"basic_text\":\"คุกกี้ของเราเหล่านี้ช่วยให้เราสามารถวัดจำนวนผู้เข้าชม/ผู้ใช้เว็บไซต์ของเราและสร้างสถิติการใช้งานและประสิทธิภาพโดยรวมด้วยความช่วยเหลือจากพาร์ทเนอร์ที่เชื่อถือได้ของเรา เราใช้คุกกี้เหล่านี้เพื่อรับข้อมูลเชิงลึกขั้นพื้นฐานเกี่ยวกับการเข้าชมเว็บไซต์และประสิทธิภาพของแคมเปญของเรา รวมถึงเพื่อแก้ปัญหาข้อบกพร่องในเว็บไซต์ของเรา\",\"advanced_text\":\"คุกกี้ของเราหรือพาร์ทเนอร์เหล่านี้ช่วยให้เราเข้าใจลักษณะที่คุณใช้งานเว็บไซต์ของเราและบริการแต่ละรายการที่นำเสนอด้วยการนำข้อมูลจากเครื่องมือของพาร์ทเนอร์มาเสริมให้ชุดข้อมูลของเรา เราใช้คุกกี้เหล่านี้เพื่อปรับปรุงเว็บไซต์ บริการ และประสบการณ์ใช้งานของผู้ใช้ รวมถึงใช้ในการค้นหาและแก้ไขข้อบกพร่องหรือปัญหาอื่นๆ ที่เกิดขึ้น ตลอดจนประเมินประสิทธิภาพของแคมเปญของเรา \",\"marketing_text\":\"คุกกี้ของพาร์ทเนอร์ช่วยให้ทีมงานการตลาดของเราสามารถติดตามกิจกรรมบางอย่างของคุณขณะใช้งานเว็บไซต์ของเรา (ตัวอย่างเช่น เมื่อคุณดาวน์โหลดหรือซื้อผลิตภัณฑ์ของเรา) เพื่อเรียนรู้เกี่ยวกับความสนใจและความต้องการของคุณ และแสดงโฆษณาได้ตรงตามความต้องการของคุณได้ดียิ่งขึ้น\"},\r\n  \"tr-TR\":{\"title\":\"Sizin çerez seçiminiz, sizin gizliliğiniz\",\"description\":\"İş ortaklarımızla birlikte, sizin için en iyi şekilde optimize edilmiş bir çevrimiçi deneyim sunmak, web sitesi trafiğimizi analiz etmek ve size kişiselleştirilmiş reklamlar sunmak için çerezleri kullanırız. 'Tümünü kabul et ve kapat' seçeneğini tıklayarak tüm çerezlerin toplanmasını kabul edebilir, 'Yalnızca gerekli çerezleri kabul et' seçeneğini tıklayarak gerekli olmayan tüm çerezleri reddedebilir veya 'Çerezleri yönet' seçeneğini tıklayarak çerez ayarlarınızı yapabilirsiniz. Ayrıca dilediğiniz zaman web sitemizin altbilgi bölümünde 'Çerezleri yönet' bağlantısını tıklayarak veya hesap ayarlarınızda (varsa) çerezlere verdiğiniz onayı geri çekebilir ya da çerez tercihlerinizi değiştirebilirsiniz. Daha fazla bilgi için <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=tr-TR>Çerez Politikamıza</a> bakın.\",\"essential_title\":\"Zorunlu çerezler\",\"basic_title\":\"Temel analitik çerezler\",\"advanced_title\":\"Gelişmiş analitik çerezler\",\"marketing_title\":\"Pazarlama çerezleri\",\"btn_decline\":\"Yalnızca gerekli çerezleri kabul et\",\"btn_back\":\"Geri\",\"btn_accept_selected\":\"Seçimlerimi onayla\",\"btn_accept\":\"Tümünü kabul et ve kapat\",\"btn_manage\":\"Çerezleri yönet\",\"essential_text\":\"Bu birinci grup çerezler, web sitemizin işleyişi ve güvenliğinin yanı sıra ihtiyaç duyduğunuz hizmetler için de gereklidir. Bunlar genellikle, çerez tercihlerinizi hatırlama, giriş yapma veya öğeleri sepetinizde tutma gibi belirli işlevlerin kullanımını etkinleştirmek için işlemlerinize yanıt olarak ayarlanır. Bu çerezleri devre dışı bırakamazsınız ve bunların bir tarayıcı üzerinden engellenmesi site işlevselliğini etkileyebilir.\",\"basic_text\":\"Bu birinci grup çerezler, web sitemizin ziyaretçi/kullanıcı sayısını ölçmemize ve güvenilir iş ortaklarımızın yardımıyla toplu kullanım ve performans istatistikleri oluşturmamıza olanak sağlar. Bunları, web sitesi trafiğimiz ve kampanya performansımızla ilgili temel bilgileri almak ve web sitemizdeki hataları gidermek için kullanırız.\",\"advanced_text\":\"Bu birinci veya üçüncü grup çerezler, üçüncü taraf araçlardan elde edilen veriler sayesinde veri kümelerimizi zenginleştirerek web sitemizle ve sunulan her bir hizmetle nasıl etkileşim kurduğunuzu anlamamıza yardımcı olur. Bu çerezleri web sitemizi, hizmetlerimizi ve kullanıcı deneyimini iyileştirmek, hataları veya diğer sorunları bulup çözmek ve kampanyalarımızın etkinliğini değerlendirmek için kullanırız. \",\"marketing_text\":\"Bu üçüncü grup çerezler, pazarlama iş ortaklarımızın web sitemizdeki etkinliklerinizden bazılarını (örneğin ürünümüzü indirme veya satın alma gibi) izlemelerine, ilgi alanlarınız ve ihtiyaçlarınız hakkında bilgi edinmelerine ve sizinle daha alakalı olan hedefli reklamlar göstermelerine olanak sağlar.\"},\r\n  \"uk-UA\":{\"title\":\"Ваш вибір файлів cookie, ваша конфіденційність\",\"description\":\"Файли cookie, які використовуємо ми й наші партнери, дають змогу найкращим чином оптимізувати для вас інтернет-середовище, аналізувати трафік веб-сайту, а також персоналізувати рекламні оголошення залежно від ваших уподобань. Щоб надати згоду на збирання файлів cookie всіх типів, клацніть 'Прийняти все й закрити'. Щоб заборонити збір всіх файлів cookie, які не є основними, виберіть 'Приймати лише основні файли cookie'. Щоб надати згоду на збирання лише певних типів файлів cookie, клацніть посилання 'Керувати файлами cookie' в нижній частині нашого веб-сайту або в параметрах облікового запису (якщо вони доступні). Докладніше див. в нашому документі <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=uk-UA>Політика щодо файлів cookie</a>.\",\"essential_title\":\"Основні файли cookie\",\"basic_title\":\"Базові аналітичні файли cookie\",\"advanced_title\":\"Розширені аналітичні файли cookie\",\"marketing_title\":\"Рекламні файли cookie\",\"btn_decline\":\"Приймати лише основні файли cookie\",\"btn_back\":\"Назад\",\"btn_accept_selected\":\"Підтвердити вибрані варіанти\",\"btn_accept\":\"Прийняти все й закрити\",\"btn_manage\":\"Керувати файлами cookie\",\"essential_text\":\"Ці основні файли cookie необхідні для роботи й безпеки нашого веб-сайту й потрібних вам служб. Вони зазвичай активуються після виконання вами певних дій, щоб забезпечити роботу відповідних функцій (зокрема, щоб запам’ятати налаштування файлів cookie, облікові дані для входу, вибрані позиції в кошику). Не можна відмовитися від використання цих файлів cookie. Якщо заблокувати їх у браузері, це може вплинути на функціональність веб-сайту.\",\"basic_text\":\"Ці основні файли cookie дають нам змогу відстежувати кількість відвідувачів (користувачів) нашого веб-сайту, а також створювати агреговану статистику про використання й роботу за допомогою наших довірених партнерів. Ці дані допомагають нам краще розуміти характеристики трафіку нашого веб-сайту й нашої кампанії, а також усувати помилки на нашому веб-сайті.\",\"advanced_text\":\"Ці основні або сторонні файли cookie дають нам змогу поповнювати набори даних даними зі сторонніх інструментів і допомагають нам дізнатися, як саме ви користуєтеся нашим веб-сайтом і всіма запропонованими службами. Ми використовуємо ці файли cookie для вдосконалення веб-сайту, служб і взаємодії з користувачами, для пошуку й усунення помилок і проблем, а також для оцінювання ефективності наших кампаній. \",\"marketing_text\":\"Ці сторонні файли cookie дають змогу нашим партнерам із маркетингу відстежувати певні операції, які ви виконуєте на нашому веб-сайті (наприклад, завантаження або покупка нашого продукту), щоб дізнатися про ваші інтереси й потреби та краще персоналізувати рекламні оголошення.\"},\r\n  \"vi-VN\":{\"title\":\"Lựa chọn cookie của bạn, quyền riêng tư của bạn\",\"description\":\"Chúng tôi và các đối tác của chúng tôi sử dụng cookie để đem tới cho bạn trải nghiệm trực tuyến được tối ưu hóa tốt nhất, bạn có thể phân tích lưu lượng truy cập trang web của chúng tôi và chúng tôi sẽ mang tới quảng cáo phù hợp cho bạn. Bạn có thể đồng ý với việc thu thập tất cả cookie bằng cách nhấp vào 'Chấp nhận tất cả và đóng', từ chối tất cả các cookie không cần thiết bằng cách chọn 'Chỉ chấp nhận các cookie cần thiết' hoặc điều chỉnh cài đặt cookie của bạn bằng cách nhấp vào 'Quản lý cookie'. Bạn cũng có quyền thu hồi lại sự đồng ý của mình với cookie hoặc thay đổi các tùy chọn cookie bất cứ lúc nào bằng cách nhấp vào đường dẫn 'Quản lý cookie' ngay tại chân trang web của chúng tôi hoặc trong phần cài đặt tài khoản của bạn (nếu có). Để biết thêm thông tin, vui lòng xem <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=vi-VN>Chính sách Cookie</a> của chúng tôi.\",\"essential_title\":\"Cookie thiết yếu\",\"basic_title\":\"Cookie phân tích cơ bản\",\"advanced_title\":\"Cookie phân tích nâng cao\",\"marketing_title\":\"Cookie tiếp thị\",\"btn_decline\":\"Chỉ chấp nhận các cookie cần thiết\",\"btn_back\":\"Trở lại\",\"btn_accept_selected\":\"Xác nhận lựa chọn của tôi\",\"btn_accept\":\"Chấp nhận tất cả và đóng\",\"btn_manage\":\"Quản lý cookie\",\"essential_text\":\"Những cookie của bên thứ nhất này rất cần thiết để trang web của chúng tôi và các dịch vụ mà bạn yêu cầu có thể hoạt động và được bảo mật. Chúng thường được thiết lập để đáp ứng các hoạt động của bạn nhằm cho phép sử dụng một số chức năng nhất định, như ghi nhớ tùy chọn cookie, đăng nhập hoặc lưu các mặt hàng trong giỏ hàng của bạn. Bạn không thể từ chối những cookie này và việc chặn chúng thông qua trình duyệt có thể ảnh hưởng đến chức năng của trang web.\",\"basic_text\":\"Các cookie của bên thứ nhất này cho phép chúng tôi đo lường số lượng khách/người dùng truy cập trên trang web của chúng tôi và tạo số liệu thống kê tổng hợp về việc sử dụng cũng như hiệu suất với sự trợ giúp của các đối tác mà chúng tôi tin cậy. Chúng tôi sử dụng chúng để phân tích cơ bản về lưu lượng truy cập trang web và hiệu suất chiến dịch của mình và để giải quyết các lỗi trên trang web.\",\"advanced_text\":\"Những cookie của bên thứ nhất hoặc thứ ba này giúp chúng tôi hiểu rõ hơn về cách bạn tương tác với trang web và mỗi dịch vụ được cung cấp bằng cách đa dạng hóa các tập dữ liệu của mình với dữ liệu từ các công cụ của bên thứ ba. Chúng tôi sử dụng những cookie này để cải thiện trang web, dịch vụ và trải nghiệm người dùng nhằm tìm kiếm cũng như giải quyết các lỗi hoặc các vấn đề khác, đồng thời đánh giá hiệu quả chiến dịch của chúng tôi. \",\"marketing_text\":\"Những cookie của bên thứ ba này cho phép các đối tác tiếp thị của chúng tôi theo dõi một số hoạt động của bạn trên trang web của chúng tôi (ví dụ: khi bạn tải xuống hoặc mua sản phẩm của chúng tôi) để tìm hiểu về sở thích và nhu cầu của bạn và để hiển thị cho bạn những quảng cáo được nhắm mục tiêu phù hợp hơn.\"},\r\n  \"hy-AM\":{\"title\":\"Թխուկների ձեր ընտրությունը՝ ձեր գաղտնիությունն է\",\"description\":\"Մենք և մեր գործընկերներն օգտագործում ենք թխուկներ՝ ձեզ լավագույնս օպտիմիլացված առցանց աշխատանք ապահովելու, մեր կայքի տվյալների հոսքը վերլուծելու և ձեզ անհատականացված գովազդներ տրամադրելու համար: Դուք կարող եք համաձայնել բոլոր թխուկների հավաքմանը՝ սեղմելով «Ընդունել բոլորը և փակել», մերժել բոլոր ոչ կարևոր թխուկները՝ սեղմելով «Ընդունել միայն կարևոր թխուկները» կամ սահմանել ձեր թխուկների կարգավորումները՝ սեղմելով «Կառավարել թխուկները»: Դուք նաև իրավունք ունեք ցանկացած պահի չեղարկել թխուկների համար տրված ձեր համաձայնությունը կամ փոխել թխուկների նախընտրությունները՝ մեր կայքի էջատակում կամ ձեր հաշվի կարգավորումներում (առկայության դեպքում) սեղմելով «Կառավարել թխուկները» հղումը։ Լրացուցիչ տեղեկությունների համար ծանոթացեք մեր <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=hy-AM>Թխուկների քաղաքականությանը</a>։\",\"essential_title\":\"Հիմնական թխուկներ\",\"basic_title\":\"Հիմնական վերլուծական թխուկներ\",\"advanced_title\":\"Ընդլայնված վերլուծական թխուկներ\",\"marketing_title\":\"Մարքեթինգային թխուկներ\",\"btn_decline\":\"Ընդունել միայն կարևոր թխուկները\",\"btn_back\":\"Հետ\",\"btn_accept_selected\":\"Հաստատել իմ ընտրությունները\",\"btn_accept\":\"Ընդունել բոլորը և փակել\",\"btn_manage\":\"Կառավարել թխուկները\",\"essential_text\":\"Այս առաջին կողմի թխուկներն անհրաժեշտ են մեր կայքի աշխատանքի և ձեր պահանջած ծառայությունների տրամադրման և անվտանգության համար: Դրանք սովորաբար տեղադրվում են ի պատասխան ձեր գործողությունների՝ կոնկրետ գործառույթի օգտագործման հնարավորություն ընձեռելու համար, ինչպես օրինակ՝ ձեր թխուկների նախապատությունները հիշելը, մուտք գործելը կամ ձեր զամբյուղում առարկաները պահելը: Դուք չեք կարող հրաժարվել այս թխուկներից, իսկ դրանց արգելափակումը զննիչի միջոցով կարող է ազդել կայքի աշխատանքի վրա։\",\"basic_text\":\"Այս առաջին կողմի թխուկները հնարավորություն են տալիս տեսնել մեր կայքի այցելուների/օգտվողների քանակը և մեր վստահելի գործընկերների օգնությամբ ստեղծել օգտագործման և արտադրողականության ընդհանուր վիճակագրություն: Մենք օգտագործում ենք դրանք մեր կայքի տվյալների հոսքի մասին հիմնական պատկերացում ունենալու, մեր քարոզարշավի իրականացման, ինչպես նաև մեր կայքի վրիպակները շտկելու համար:\",\"advanced_text\":\"Այս առաջին կամ երրորդ կողմի թխուկներն օգնում են մեզ հասկանալ, թե ինչպես եք օգտագործում մեր կայքը և յուրաքանչյուր առաջարկվող ծառայությունը՝ ընդլայնելով մեր տվյալների բազաները երրորդ կողմի գործիքների միջոցով ստացված տվյալներով: Մենք օգտագործում ենք այդ թխուկները` մեր կայքը, ծառայությունները և օգտագործողի աշխատանքը բարելավելու, սխալներ կամ դրանց հետ կապված այլ խնդիրներ գտնելու ու լուծելու և մեր քարոզարշավների արդյունավետությունը գնահատելու նպատակով:\",\"marketing_text\":\"Այս երրորդ կողմի թխուկները մեր մարքեթինգային գործընկերներին հնարավորություն են տալիս հետևել ձեր որոշ գործողություններին մեր կայքում (օրինակ՝ երբ եք դուք ներբեռնում կամ գնում մեր ապրանքները)՝ ձեր հետաքրքրությունների և կարիքների մասին տեղեկանալու և ձեզ ավելի համապատասխան ու նպատակային գովազդներ ցուցադրելու համար:\"},\r\n  \"ca-ES\":{\"title\":\"La teva elecció de galetes, la teva privacitat\",\"description\":\"Nosaltres i els nostres socis utilitzem galetes per oferir-te la millor experiència en línia optimitzada, analitzar el trànsit del nostre lloc web i oferir-te anuncis personalitzats. Pots acceptar la recopilació de totes les galetes fent clic a \\\"Acceptar-ho tot i tancar\\\", rebutjar totes les galetes no essencials escollint \\\"Acceptar només les galetes essencials\\\", o ajustar la configuració de les galetes fent clic a \\\"Administrar les galetes\\\". També tens dret a retirar el teu consentiment o canviar les teves preferències de galetes en qualsevol moment fent clic a l'enllaç \\\"Administrar les galetes\\\" al peu de pàgina del nostre lloc web o a la configuració del teu compte (si està disponible). Per a més informació, consulta la nostra <a target=_blank href=https://go.eset.com/cookie-policy/?type=CC_PRODUCT&lang=en-US>Política de galetes</link>.\",\"essential_title\":\"Galetes essencials\",\"basic_title\":\"Galetes analítiques bàsiques\",\"advanced_title\":\"Galetes analítiques avançades\",\"marketing_title\":\"Galetes de màrqueting\",\"btn_decline\":\"Acceptar només les galetes essencials\",\"btn_back\":\"Tornar\",\"btn_accept_selected\":\"Confirmar les meves opcions\",\"btn_accept\":\"Acceptar-ho tot i tancar\",\"btn_manage\":\"Administrar les galetes\",\"essential_text\":\"Aquestes galetes pròpies són necessàries per al funcionament i la seguretat del nostre lloc web i dels serveis que necessites. Normalment s'estableixen en resposta a les teves accions per permetre l'ús de determinades funcionalitats, com ara recordar les teves preferències de galetes, iniciar la sessió o mantenir articles al carret de la compra. No pots desactivar aquestes galetes, i bloquejar-les mitjançant un navegador pot afectar la funcionalitat del lloc.\",\"basic_text\":\"Aquestes galetes pròpies ens permeten mesurar el nombre de visitants / usuaris del nostre lloc web i crear estadístiques agregades d'ús i rendiment amb l'ajuda dels nostres socis de confiança. Les utilitzem per obtenir informació bàsica sobre el trànsit del nostre lloc web i el rendiment de les nostres campanyes i per resoldre errors al nostre lloc web.\",\"advanced_text\":\"Aquestes galetes pròpies o de tercers ens ajuden a entendre com interactues amb el nostre lloc web i amb cada servei ofert enriquint els nostres conjunts de dades amb dades d'eines de tercers. Utilitzem aquestes galetes per millorar el nostre lloc web, els serveis i l'experiència de l'usuari, detectar i resoldre errors o altres problemes i avaluar l'eficàcia de les nostres campanyes.\",\"marketing_text\":\"Aquestes galetes de tercers permeten als nostres socis de màrqueting fer un seguiment d'algunes de les teves activitats al nostre lloc web (per exemple, quan descarregues o compres el nostre producte) per conèixer els teus interessos i necessitats i mostrar-te anuncis personalitzats més rellevants.\"}\r\n}"},"redirectURL":"","headersSize":608,"bodySize":40382,"_status":"completed","_startTimestamp":1780540360691682,"_endTimestamp":1780540362030948},"cache":{},"timings":{"send":-1,"wait":-1,"receive":-1},"serverIPAddress":"91.228.165.46","connection":"26","comment":"","_id":123,"_uid":"08392fb3-7d09-4770-b8c8-e57b14090e50","_cid":26,"_ctime":1780540356458,"_sid":1,"_stime":1780540356458,"_serverAddress":"91.228.165.46","_serverAddressFamily":0,"_serverPort":443,"_clientAddress":"127.0.0.1","_clientAddressFamily":0,"_clientPort":60375,"_app":{"name":"chrome","id":"chrome.exe","path":"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe","stackTrace":null}},{"startedDateTime":"2026-06-04T02:31:19.582Z","time":356,"request":{"method":"GET","url":"https://cdn.esetstatic.com/cookie-consent/v3/app.min.js","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":method","value":"GET"},{"name":":authority","value":"cdn.esetstatic.com"},{"name":":path","value":"/cookie-consent/v3/app.min.js"},{"name":":scheme","value":"https"},{"name":"pragma","value":"no-cache"},{"name":"cache-control","value":"no-cache"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.7390.55 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Not/A)Brand\";v=