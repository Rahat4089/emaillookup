    this situation can be prevented by forcing the loading of new index.html\r\n    -->\r\n    <meta\r\n      http-equiv=\"Cache-Control\"\r\n      content=\"no-cache, no-store, must-revalidate\"\r\n    />\r\n    <meta http-equiv=\"Pragma\" content=\"no-cache\" />\r\n    <meta http-equiv=\"Expires\" content=\"0\" />\r\n\r\n    <!-- add to homescreen for ios -->\r\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\r\n    <meta name=\"apple-mobile-web-app-title\" content=\"ESET HOME\" />\r\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\" />\r\n  <script defer src=\"/static/js/lib-uilib.7652aef1.js\"></script><script defer src=\"/static/js/lib-react.bb9f74b7.js\"></script><script defer src=\"/static/js/lib-router.3b47c37b.js\"></script><script defer src=\"/static/js/857.013f80f0.js\"></script><script defer src=\"/static/js/index.3563adc5.js\"></script><link href=\"/static/css/index.d5a31622.css\" rel=\"stylesheet\"></head>\r\n\r\n  <body style=\"width: 100vw; height: 100vh\">\r\n    <div id=\"root\"></div>\r\n\r\n    <!-- Environment variables -->\r\n    <script type=\"application/javascript\">\r\n      // Namespace that is used for web<->native communication\r\n      // This will already exist inside the Webviews, On desktop\r\n      // simply assign an empty object.\r\n      var nativeAppBridge = nativeAppBridge ? nativeAppBridge : {}\r\n      var myESET = {\r\n        isLocalEnv: 'false',\r\n        envData: {\r\n          passwordManagerUrl: 'https://home.eset.com/security-features?feature=pwm',\r\n          parentalControlUrl: 'https://parentalcontrol.eset.com',\r\n          antitheftUrl: 'https://anti-theft.eset.com',\r\n          authority: 'https://login.eset.com',\r\n          MyEsetHelpPage: 'https://help.eset.com/getHelp?product=home_eset&lang=<0>',\r\n          SupportReportIssueUrl: 'https://go.eset.eu/supportform?lng=<0>',\r\n          hubUrl: 'https://home.eset.com',\r\n          GooglePlayUrl: 'https://play.google.com/store/apps/details?id=com.eset.myeset',\r\n          GooglePlayAppsUrl: 'https://play.google.com/store/apps',\r\n          AppStoreUrl: 'https://apps.apple.com/us/app/myeset/id1533672833',\r\n          betaTag: 'false',\r\n          EMSGooglePlayUrl: 'https://play.google.com/store/apps/details?id=com.eset.ems2.gp',\r\n          EMSHelpUrl: 'https://help.eset.com/ems_gp/8/<0>/license_gp.html',\r\n          privacyPolicyUrl: 'https://help.eset.com/getHelp?product=home_eset&lang=<0>&topic=privacy_policy',\r\n          socialMediaEnv: 'true',\r\n          qrCodeEnv: 'true',\r\n          termsOfUseUrl: 'https://help.eset.com/getHelp?product=home_eset&lang=<0>&topic=terms_of_use',\r\n          buildVersion: '274.2.19',\r\n          leakedHelpUrl: 'https://help.eset.com/getHelp?product=home_eset&lang=<0>&topic=leaked_credentials',\r\n          interviewSignUpUrl: 'https://survey.eset.com/index.php?r=survey/index&sid=383171&lang=<0>',\r\n          cookiePolicyUrl: 'https://help.eset.com/getHelp?product=home_eset&lang=<0>&topic=cookie_policy',\r\n          cookieBarEnabled: 'true',\r\n          parentalAndroidIntent: 'intent://parentalcontrol/#Intent;scheme=empc;package=com.eset.parental;end',\r\n          ARMDownloadInstallerUrl: 'https://download.eset.com/com/eset/apps/home/eis/windows/latest/eis_arm64.exe',\r\n          ARMInstallerLearnMoreUrl: 'https://help.eset.com/getHelp?product=home_eset&lang=<0>&topic=new_device&anchor=arm',\r\n          ARMInstallerEnabled: 'false',\r\n          AIEnabled: 'true',\r\n          AIInstrumentationKey: 'af6b60d4-b22d-410c-9b1f-92f60c900477',\r\n          AIEndpointUrl: 'https://dc.services.visualstudio.com/v2/track',\r\n          AIThrottleEventLimit: '500',\r\n          AIThrottleIntervalMs: '60000',\r\n          TwoFactorAuthenticationEnabled: 'true',\r\n          HomeAssetUrl: 'https://assets.eset.com',\r\n          TwoFactorIssuer: 'ESET HOME',\r\n          TwoFactorSetupHelpUrl: 'https://help.eset.com/getHelp?product=hom