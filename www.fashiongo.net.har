            "mimeType": "application/javascript",
            "text": "(function($) {\n\t'use strict';\n})(jQuery);\n\n$(function () {\n\t'use strict';\n\t$('.header_signIn').click(function(){\n\t\tif (window.location.pathname === \"/login\") {\n\t\t\twindow.location.href = window.location.pathname;\n\t\t} else if (window.location.pathname === \"/register/buyer\") {\n\t\t\tloginRedirect('/');\n\t\t} else {\n\t\t\tloginRedirect(window.location.pathname + window.location.search + window.location.hash);\n\t\t}\n\t})\n\n    $(document).on('click', '.sign-out, a[href*=\"/logout\"]', function(e) {\n        e.preventDefault();\n        localStorage.setItem('gnat_logout_pending', true);\n        window.location.href = '/logout';\n    });\n\n    $.getJSON('/live-show/next-live', function (jsonData) {\n\t\tif (jsonData.success) {\n\t\t\tif (jsonData.data == 'LIVE') {\n\t\t\t\tvar $sticky = $('.live_follow');\n\t\t\t\t$sticky.show();\n\t\t\t\tsetTimeout(function () {\n\t\t\t\t\t$sticky.css('right','-54px');\n\t\t\t\t}, 7000);\n\t\t\t\t$sticky.css('right','0');\n\n\t\t\t\t$sticky.hover(function() {\n\t\t\t\t\t$sticky.css('right','0');\n\t\t\t\t},function() {\n\t\t\t\t\t$sticky.css('right','-54px');\n\t\t\t\t})\n\t\t\t}\n\t\t}\n\t});\n\n\tappendNclickToImgTag($('.gnb'));\n\n\tinitGnbNewBadge('gnb-new-in', 'newInBadgeClicked', '2026-03-19');\n\tinitGnbNewBadge('gnb-the-edit', 'theEditBadgeClicked', '2026-03-24');\n\tinitGnbNewBadge('gnb-vendors', 'vendorsBadgeClicked', '2026-05-01');\n});\n\n// GNB NEW badge (show for 1 month from deploy date, hide after first click)\nfunction initGnbNewBadge(elementId, badgeKey, deployDateStr) {\n\tvar $el = $('#' + elementId);\n\tvar deployDate = new Date(deployDateStr);\n\tvar expiryDate = new Date(deployDate);\n\texpiryDate.setMonth(expiryDate.getMonth() + 1);\n\n\tif (!localStorage.getItem(badgeKey) && Date.now() <= expiryDate.getTime()) {\n\t\t$el.addClass('new-badge');\n\t}\n\n\t$el.find('a').on('click', function() {\n\t\tif ($el.hasClass('new-badge')) {\n\t\t\tlocalStorage.setItem(badgeKey, 'true');\n\t\t\t$el.removeClass('new-badge');\n\t\t}\n\t});\n}\n\nfunction appendNclickToImgTag() {\n\tfor (var i = 0; i < arguments.length; i++) {\n\t\targuments[i].find('img[name=\"productImage\"]').each(function(idx, el) {\n\t\t\tvar imgSrc = $(el).attr('src');\n\t\t\tvar nclickname = $(el).closest(\".nclick\").attr('data-nclick-name');\n\t\t\tvar r = $(el).closest(\".nclick\").attr('data-nclick-rank');\n\t\t\tvar rid = $('#user').attr('rid');\n\t\t\tvar nnb = $.cookie('NNB');\n\t\t\tvar phase = $('#g_Phase').val();\n\t\t\tvar nsc = 'fgv2';\n\t\t\tvar productId = '';\n\t\t\tvar vendorId = '';\n\t\t\tvar sort = '';\n\t\t\tvar searchquery = '';\n\t\t\tvar pn = '';\n\t\t\tvar ps = '';\n\n\t\t\tvar nClickExtra = $(el).closest(\".nclick\").attr('data-nclick-extra') != null ? $(el).closest(\".nclick\").attr('data-nclick-extra') : ''\n\n\t\t\tif (nClickExtra != '') {\n\t\t\t\tvar nclickExtraItem = nClickExtra.split(\",\");\n\t\t\t\tnclickExtraItem.forEach((item, index) => {\n\t\t\t\t\titem = item.trim();\n\t\t\t\t\tif(item.startsWith(\"vid:\")) {\n\t\t\t\t\t\tvendorId = item.substr(\"vid:\".length).trim();\n\t\t\t\t\t} else if(item.startsWith(\"i:\")) {\n\t\t\t\t\t\tproductId = item.substr(\"i:\".length).trim();\n\t\t\t\t\t} else if(item.startsWith(\"sort:\")) {\n\t\t\t\t\t\tsort = item.substr(\"sort:\".length).trim();\n\t\t\t\t\t} else if(item.startsWith(\"searchquery:\")) {\n\t\t\t\t\t\tsearchquery = item.substr(\"searchquery:\".length).trim();\n\t\t\t\t\t} else if(item.startsWith(\"pn:\")) {\n\t\t\t\t\t\tpn = item.substr(\"pn:\".length).trim();\n\t\t\t\t\t} else if(item.startsWith(\"ps:\")) {\n\t\t\t\t\t\tps = item.substr(\"ps:\".length).trim();\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t}\n\n\t\t\tvar paramObj = {};\n\t\t\tvar [rootPath, qrystr] = imgSrc.split('?');\n\t\t\tif(qrystr) {\n\t\t\t\tqrystr.split('&').forEach((item) => {\n\t\t\t\t\tvar [key, value] = item.split('=');\n\t\t\t\t\tparamObj[key] = value;\n\t\t\t\t});\n\t\t\t}\n\t\t\tparamObj['nsc'] = nsc;\n\t\t\tparamObj['a'] = nclickname;\n\t\t\tparamObj['rid'] = rid;\n\t\t\tparamObj['r'] = r;\n\t\t\tparamObj['p'] = phase;\n\t\t\tif(nnb !== undefined) {\n\t\t\t\tparamObj['nnb'] = nnb;\n\t\t\t}\n\t\t\tif(productId !== '') {\n\t\t\t\tparamObj['i'] = productId;\n\t\t\t}\n\t\t\tif(vendorId !== '') {\n\t\t\t\tparamObj['vid'] = vendorId;\n\t\t\t}\n\t\t\tif(sort !== '') {\n\t\t\t\tparamObj['sort'] = sort;\n\t\t\t}\n\t\t\tif(searchquery !== '') {\n\t\t\t\tparamObj['searchquery'] = searchquery;\n\t\t\t}\n\t\t\tif(pn !== '') {\n\t\t\t\tparamObj['pn'] = pn;\n\t\t\t}\n\t\t\tif(ps !== '') {\n\t\t\t\tparamObj['ps'] = ps;\n\t\t\t}\n\t\t\tvar params = [];\n\t\t\tObject.entries(paramObj).forEach((el) => {params.push(el.join('='))});\n\t\t\timgSrc = rootPath + '?' + params.join('&');\n\n\t\t\t$(el).attr('src', imgSrc);\n\n\t\t\t//console.log(nClickExtra + \"   \" + imgSrc);\n\n\t\t});\n\t}\n}\n"
