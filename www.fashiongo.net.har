          "content": {
            "size": 3306,
            "mimeType": "application/javascript",
            "text": "function encrypt(plain, isDefault) {\n    var deferred = new $.Deferred();\n    try {\n        var encryptObject = aseEncrypt(plain + '');\n        var encryptedText = encryptObject.encryptedText;\n        var pass = encryptObject.pass;\n\n        rsaEncrypt(pass, isDefault)\n            .then(function(data) {\n                var rsa = data;\n                deferred.resolve({\n                    secureKey: rsa.secureKey, // KEK ID.\n                    passphrase: rsa.encryptedKey, // DEK (encrypted by KEK)\n                    encrypted: encryptedText // Encrypted message.\n                })\n            })\n    } catch (e) {\n        console.error(e);\n        throw Error('Encryption failed.');\n    }\n\n    return deferred.promise();\n};\n\n// async function encryptArray(plains, isDefault) {\n//     try {\n//         var {encryptedTexts, pass} = aseEncryptMultipleMessage(plains);\n//         var rsa = await rsaEncrypt(pass, isDefault);\n//         return {\n//             secureKey: rsa.secureKey, // KEK ID.\n//             passphrase: rsa.encryptedKey, // DEK (encrypted by KEK)\n//             encrypted: encryptedTexts // Encrypted messages.\n//         }\n//     } catch (e) {\n//         console.error(e);\n//         throw Error('Encryption failed.');\n//     }\n// };\n\nfunction aseEncrypt(plain) {\n    var passphrase = generateHexString(32);\n    var key = CryptoJS.enc.Latin1.parse(passphrase);\n    var vector = CryptoJS.enc.Latin1.parse(passphrase.substring(0, 16));\n    var encrypt = CryptoJS.AES.encrypt(plain, key, { iv: vector });\n    return { encryptedText: encrypt.toString(), pass: passphrase};\n};\n\n// function aseEncryptMultipleMessage(plains) {\n//     var passphrase = generateHexString(32);\n//     var key = CryptoJS.enc.Latin1.parse(passphrase);\n//     var vector = CryptoJS.enc.Latin1.parse(passphrase.substring(0, 16));\n//     var encryptMessages = [];\n//\n//     plains.forEach(p => {\n//         var encrypt = CryptoJS.AES.encrypt(p, key, { iv: vector });\n//         encryptMessages.push(encrypt.toString())\n//     });\n//     return { encryptedTexts: encryptMessages, pass: passphrase};\n// };\n\n\nfunction rsaEncrypt(plain, isDefault) {\n    var deferred = new $.Deferred();\n    var rsa = new RSAKey();\n    var res = {secureKey: '', encryptedKey: ''};\n\n    $.getJSON('/crypto/key?default=' + isDefault, {\n        type: 'GET',\n        dataType: 'json',\n        contentType: 'application/json',\n        mimeType: 'application/json'\n    })\n    .fail(function(jqxhr, textStatus, error) {\n        var err = textStatus + \", \" + error;\n        console.log( \"Request Failed: \" + err );\n        deferred.reject();\n    })\n    .done(function(jsonResult) {\n        if (jsonResult.success) {\n            rsa.setPublic(jsonResult.data.modulus, jsonResult.data.exponent);\n            var encryptedPass = rsa.encrypt(plain);\n            var base64BinaryEncoding = btoa(encryptedPass);\n            res.secureKey = jsonResult.data.keyId;\n            res.encryptedKey = base64BinaryEncoding;\n            deferred.resolve(res);\n        } else {\n            deferred.reject();\n        }\n    });\n\n    return deferred.promise();\n};\n\n\nfunction generateHexString(length) {\n    var ret = '';\n    while (ret.length < length) {\n        ret += Math.random().toString(16).substring(2);\n    }\n    return ret.substring(0, length);\n};\n"
          },
