          "content": {
            "size": 16777,
            "mimeType": "application/javascript",
            "text": "function heapTrack(type, event, el) {\n    // console.log(type, event, el);\n    try {\n        let heapEventName;\n        if (type && type.startsWith('NewIn.')) {\n            trackNewInItem(type, el);\n            return;\n        }\n        switch (type) {\n            case \"catalog\":\n                heapEventName = \"WS - Product List & Search Result Page - Click - Product\";\n                break;\n            case \"component\":\n                heapEventName = \"WS - Any Page_Component - Click - Product\";\n                break;\n            case \"banner\":\n                heapEventName = \"WS - Any Page - Click - Promotional Elements\";\n                break;\n            case \"addCart\":\n                heapEventName = \"WS - Product Detail & Quickshop Page - Click - Add to Cart\";\n                break;\n            case \"favorite\":\n                heapEventName = \"WS - Product Detail & Quickshop Page - Click - Favorite\";\n                break;\n            case \"vendor\":\n                heapEventName = \"WS - Any Page_Component - Click - Vendor\";\n                break;\n            case \"keyword\":\n                heapEventName = \"WS - Search Box - Click - Keyword\";\n                break;\n            case \"teditViewAll\":\n                heapEventName = \"WS - The Edit - Click - View All\";\n                break;\n            case \"teditCollection\":\n                heapEventName = \"WS - The Edit - Click - Collection\";\n                break;\n            case \"teditKeyword\":\n                heapEventName = \"WS - The Edit - Click - Keyword\";\n                break;\n            case \"teditVideoBannerCta\":\n                heapEventName = \"WS - The Edit - Click - Video Banner CTA\";\n                break;\n            case \"popup\":\n                heapEventName = \"Event: WS - Home Page - Click - PopUp\";\n                break;\n            case \"UB\":\n            case \"RECOMMEND\":\n                heapEventName = \"WS - Product List & Search Result Page - Click - Product\";\n                break;\n            case \"popupView\":\n                heapEventName = \"Event: WS - Home Page - Page View - PopUp\";\n                break;\n            // FG Live List Page\n            case \"fglive-item-curation\":\n                heapEventName = \"WS - FG Live List Page - Click - Item Curation\";\n                break;\n            case \"fglive-item-curation-viewmore\":\n                heapEventName = \"WS - FG Live List Page - Click - Item Curation View More\";\n                break;\n            case \"fglive-vendor-curation\":\n                heapEventName = \"WS - FG Live List Page - Click - Vendor Curation\";\n                break;\n            case \"fglive-image-banner\":\n                heapEventName = \"WS - FG Live List Page - Click - Image Banner\";\n                break;\n            // FG Live Detail Page\n            case \"fglive-detail-item\":\n                heapEventName = \"WS - FG Live Detail Page - Click - Featured Item\";\n                break;\n            case \"fglive-detail-item-vendor\":\n                heapEventName = \"WS - FG Live Detail Page - Click - Featured Item Vendor\";\n                break;\n            case \"fglive-detail-vendor\":\n                heapEventName = \"WS - FG Live Detail Page - Click - Vendor\";\n                break;\n            case \"fglive-detail-vendor-favorite\":\n                heapEventName = \"WS - FG Live Detail Page - Click - Vendor Favorite\";\n                break;\n            case \"fglive-detail-chat-signup\":\n                heapEventName = \"WS - FG Live Detail Page - Click - Live Chat Sign Up\";\n                break;\n            case \"fglive-detail-visitor-signup\":\n                heapEventName = \"WS - FG Live Detail Page - Click - Visitor Popup Sign Up\";\n                break;\n            case \"fglive-detail-visitor-signin\":\n                heapEventName = \"WS - FG Live Detail Page - Click - Visitor Popup Sign In\";\n                break;\n        }\n\n        if (type == 'keyword') sessionStorage.setItem('heap-search-type', getSearchType($(el)));\n        heap.track(heapEventName, setHeapProperties());\n\n        // console.log(heapEventName, setHeapProperties());\n\n        function setHeapProperties() {\n            let attrs = {};\n            switch (type) {\n                case \"addCart\":\n                    const $dcr = $(el).closest('.detail-content-right');\n                    const fromPageDcr = $dcr.data('frompage');\n                    const sFromDcr    = $dcr.data('sfrom');\n                    attrs['data-heap-click-type']             = fromPageDcr === 'itemPage' ? 'pdp' : 'quickshop';\n                    attrs['data-heap-product-totalqty']       = String($dcr.data('heap-total-qty') ?? '');\n                    attrs['data-heap-product-totalamount']    = String($dcr.data('heap-total-amount') ?? '');\n                    attrs['data-heap-previouspage-name']      = sFromDcr;\n                    attrs['data-heap-previouscomponent-name'] = sFromDcr === 'cart' ? 'recommendation' : null;\n                    attrs['data-heap-product-id']             = String($dcr.data('product-id') ?? '');\n                    attrs['data-heap-product-name']           = $dcr.data('product-name') ?? '';\n                    attrs['data-heap-vendor-id']              = String($dcr.data('wholesaler-id') ?? '');\n                    attrs['data-heap-vendor-name']            = $dcr.data('vendor-name') ?? '';\n                    attrs['data-heap-category-id']            = String($dcr.data('category-id') ?? '');\n                    attrs['data-heap-category-name']          = null;\n                    attrs['data-heap-freeshipping-active']    = $dcr.data('is-free-shipping') === true;\n                    attrs['data-heap-promotion-type']         = $dcr.data('is-collection-promotion') === true ? 'collection' : null;\n                    break;\n                case \"favorite\":\n                    const $dcrFav     = $(el).closest('.detail-content-right');\n                    const fromPageFav = $dcrFav.data('frompage');\n                    const sFromFav    = $dcrFav.data('sfrom') || '';\n                    const contextFav  = fromPageFav === 'itemPage' ? 'detail' : 'qview';\n                    attrs['data-heap-name']            = sFromFav ? `${sFromFav}.${contextFav}.favorite` : null;\n                    attrs['data-heap-click-type']      = fromPageFav === 'itemPage' ? 'pdp' : 'quickshop';\n                    attrs['data-heap-product-id']      = String($dcrFav.data('product-id') ?? '');\n                    attrs['data-heap-product-name']    = $dcrFav.data('product-name') ?? '';\n                    attrs['data-heap-vendor-id']       = String($dcrFav.data('wholesaler-id') ?? '');\n                    attrs['data-heap-vendor-name']     = $dcrFav.data('vendor-name') ?? '';\n                    attrs['data-heap-category-id']     = String($dcrFav.data('category-id') ?? '');\n                    attrs['data-heap-category-name']   = null;\n                    attrs['data-heap-favorite-type']   = 'product';\n                    attrs['data-heap-favorite-action'] = $(el).data('heap-favorite-action');\n                    break;\n                case \"keyword\":\n                    const $el = $(el)\n                    const className = $el.attr('class');\n                    attrs['data-heap-name'] = className == 'btn-search' ? null : $el.data('nclickName');\n                    attrs['data-heap-search-keyword '] = className == 'btn-search' ? $('#lb_sch').val().trim() : $el.text();\n                    attrs['data-heap-search-type'] = getSearchType($el);\n                    attrs['data-heap-search-suggestion-position'] = className == 'btn-search' ? null : $el.data('nclickRank');\n                    break;\n                case \"popup\":\n                case \"popupView\":\n                    const $popupEl = $(el);\n                    attrs['data-heap-name'] = $popupEl.data('heap-name') || null;\n                    attrs['data-heap-popup-id'] = null;\n                    attrs['data-heap-popup-name'] = $popupEl.data('heap-popup-name') || null;\n                    attrs['data-heap-cta-type'] = $popupEl.data('heap-cta-type') || null;\n                    break;\n                default:\n                    attrs = extractHeapData(el);\n                    if (type == 'catalog' || type == 'component' | type == 'UB' || type == 'RECOMMEND') {\n                        if (!attrs['data-heap-component-name']) delete attrs['data-heap-component-name'];\n                        attrs['data-heap-product-click-type'] = el.href ? 'pdp' : 'quickshop';\n                        // 012-search-ai-fields-rollout: search page no longer emits cohort attribute.\n                        // Non-search pages (newarrival, category, recommendation) retain legacy emission via else branch.\n                        if (typeof aiFieldsAbTestGroup !== 'undefined' && aiFieldsAbTestGroup !== '') {\n                            // Search result page: do NOT set attrs['data-heap-abtest-group'] — key must be absent (FR-002, SC-002).\n                        } else {\n                            attrs['data-heap-abtest-group'] = (typeof isUserLogged != 'undefined' && typeof isEnabledFeaturedRanking != 'undefined' && isUserLogged === 'true')\n                                ? (isEnabledFeaturedRanking ? 'variant' : 'control')\n                                : null;\n                        }\n                        var $searchQueryId = $('#searchQueryId');\n                        if ($searchQueryId.length > 0 && $searchQueryId.text() !== '') {\n                            attrs['data-heap-query-id'] = $searchQueryId.text();\n                        }\n                        attrs['data-heap-freeshipping-active'] = attrs['data-heap-freeshipping-active'] === undefined ? null : attrs['data-heap-freeshipping-active'] === 'true' ? true : false;\n                        // attrs['data-heap-promotion-type'] = attrs['data-heap-promotion-type'] === undefined ? null : attrs['data-heap-promotion-type'] ? 'collection' : null;\n                        if (type == 'UB') {\n                            attrs['data-heap-product-click-model'] = 'cluster/ultimatepurchase'\n                        } else if (type == 'RECOMMEND') {\n                            attrs['data-heap-product-click-model'] = 'vector/product'\n                        }\n                    }\n\n\n                    if (attrs['data-heap-page-name'] == 'search') {\n                        attrs['data-heap-search-keyword'] = jsonParam.q;\n                        attrs['data-heap-search-type'] = sessionStorage.getItem('heap-search-type');\n                        attrs['data-heap-product-cnt'] = totalCount;\n                    }\n            }\n            // console.log('Total attributes:', Object.keys(attrs).length);\n            // for (let key in attrs) {\n            //     console.log(key, ':', attrs[key]);\n            // }\n            return attrs;\n        }\n\n        function getSearchType($el) {\n            switch ($el.data('nclickName')) {\n                case 'site.searchhistory.keyword':\n                    return 'recent';\n                case 'site.trend.keyword':\n                    return 'trendingnow';\n                case 'site.keyword.isuggest':\n                    if ($el.data('index') == 2) { // 2 is the index for product suggestions, 10 is for style no only suggestions\n                        return 'productsuggestion';\n                    } else {\n                        return 'stylenoonly';\n                    }\n                case 'site.keyword.vsuggest':\n                    return 'vendorsuggestion';\n                default:\n                    return 'input';\n            }\n        }\n\n    } catch (error) {\n        console.error('Error occurred while trying to heapTrack', type, error);\n    }\n}\nfunction heapTrackVendor(type, event, el) {\n    if(type&& type.startsWith('NewIn.')) {\n        trackNewInVendor(type, el);\n    }\n}\n\nfunction trackNewInItem(type, el) {\n    const attrs = extractHeapData(el);\n    attrs['data-heap-click-type'] = el.href ? 'pdp' : 'quickshop';\n    attrs['data-heap-product-click-type'] = el.href ? 'pdp' : 'quickshop';\n    attrs['data-heap-freeshipping-active'] = attrs['data-heap-freeshipping-active'] === undefined ? null : attrs['data-heap-freeshipping-active'] === 'true' ? true : false;\n\n    attrs['data-heap-page-name'] = 'new'\n    delete attrs['data-heap-search-query-id']\n    delete attrs['data-heap-search-keyword']\n    delete attrs['data-heap-search-type']\n    const $el = $(el);\n    const $heap = $el.closest('.heapData');\n    const source = $heap.data('source');\n    attrs['data-heap-product-click-model'] = getNewInDataClickModel(type, $heap.data('source'));\n    attrs['data-heap-name'] = getNewInHeapName(type);\n    let eventName = 'WS - Product List & Search Result Page - Click - Product'\n    if(type.startsWith('NewIn.FavoriteVendors') || type.startsWith('NewIn.NewVendors')) {\n        attrs['data-heap-layout-row-index'] = $el.closest('.heap-row').data('heap-row-position');\n        attrs['data-heap-layout-column-index'] = attrs['data-heap-product-click-position'];\n        delete attrs['data-heap-product-click-position'];\n        eventName = 'WS - Any Page_Component - Click - Product'\n        attrs['data-heap-component-name'] = getNewInComponentName(type, source);\n    } else {\n        attrs['data-heap-product-cnt'] = totalCount;\n    }\n    console.log(eventName, attrs);\n    heap.track(eventName, attrs);\n}\n\nfunction trackNewInVendor(type, el) {\n    const attrs = {};\n    const $el = $(el);\n    const $heap = $el.closest('.heapData');\n    const source = $heap.data('source');\n    attrs['data-heap-page-name'] = 'new';\n    attrs['data-heap-name'] = getNewInHeapName(type);\n    attrs['data-heap-vendor-click-position'] = $heap.data('heap-product-click-position');\n    attrs['data-heap-vendor-click-model'] = getNewInDataClickModel(type, source);\n    attrs['data-heap-vendor-id'] = $heap.data('heap-vendor-id');\n    attrs['data-heap-vendor-name'] = $heap.data('heap-vendor-name');\n    let eventName = 'WS - Product List & Search Result Page - Click - Vendor';\n    if(type.startsWith('NewIn.FavoriteVendors') || type.startsWith('NewIn.NewVendors')) {\n        attrs['data-heap-layout-row-index'] = $el.closest('.heap-row').data('heap-row-position');\n        // attrs['data-heap-layout-column-index'] = attrs['data-heap-product-click-position'];\n        delete attrs['data-heap-vendor-click-position'];\n        eventName = 'WS - Any Page_Component - Click - Vendor'\n        attrs['data-heap-component-name'] = getNewInComponentName(type, source);\n    } else {\n        attrs['data-heap-vendor-cnt'] = totalCount;\n    }\n    console.log(eventName, attrs);\n    heap.track(eventName, attrs);\n}\n\nfunction getNewInHeapName(type) {\n    if(type.startsWith('NewIn.ItemsForYou')) {\n        return 'newin.list_item1.item'\n    } else  if (type.startsWith('NewIn.FavoriteVendors')) {\n        return 'newin.list_vendor1.item'\n    } else if (type.startsWith('NewIn.JustDropped')) {\n        return 'newin.list_item2.item'\n    } else if (type.startsWith('NewIn.NewVendors')) {\n        return 'newin.list_vendor2.item'\n    } else {\n        return null;\n    }\n}\n\nfunction getNewInDataClickModel(type, source) {\n    if(type.startsWith('NewIn.ItemsForYou')) {\n        if(source === 'recommend.recent_interest') {\n            return 'recentinterest'\n        } else if(source === 'recommend.search') {\n            return 'productrecommendation'\n        }\n    } else  if (type.startsWith('NewIn.FavoriteVendors')) {\n        if(source === 'FavoriteVendors.recentPurchased') {\n            return 'previouslypurchased';\n        } else if(source === 'FavoriteVendors.recommended') {\n            return 'vendorrecommendation'\n        }\n        return null;\n    } else if (type.startsWith('NewIn.JustDropped')) {\n        return 'justdropped'\n    } else if (type.startsWith('NewIn.NewVendors')) {\n        return null;\n    } else {\n        return null;\n    }\n}\n\nfunction getNewInComponentName(type, source) {\n    if (type.startsWith('NewIn.FavoriteVendors')) {\n        if(source === 'FavoriteVendors.recentPurchased' || source === 'FavoriteVendors.recommended') {\n            return 'more vendors you\\'ll love';\n        } else if(source === 'FavoriteVendors.favorite') {\n            return 'favorite vendor'\n        }\n        return null;\n    } else if (type.startsWith('NewIn.NewVendors')) {\n        return 'new vendors';\n    } else {\n        return null;\n    }\n\n}\n\nfunction extractHeapData(el) {\n    const attrs = {};\n    const heapDataElement = el.closest('.heapData')\n    if (heapDataElement) {\n        $.each(heapDataElement.attributes, function (index, attr) {\n            if (attr.name.startsWith(\"data-heap\")) {\n                attrs[attr.name] = attr.value;\n            }\n        });\n    }\n    return attrs;\n}\n\n"
