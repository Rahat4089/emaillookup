            "text": "$(function() {\n    $('a.authVerify').click(function(e) {\n        e.preventDefault();\n        var directUrl;\n        if ($(this).attr('href')) {\n            directUrl = $(this).attr('href');\n        }\n        validateToken(directUrl);\n    });\n})\n\nfunction authVerifyByToken(_this, callBackFunction) {\n    var callBackEventData = {};\n        callBackEventData._this = _this;\n        callBackEventData._function = callBackFunction;\n    return validateToken('', callBackEventData);\n}\n\nfunction bindAuthVerifyModalEvents(directUrl, callBackEventData) {\n    $('.authVerifyModal .item-close').click(function() {\n        $('.authVerifyModal').remove();\n    });\n\n    $('.authVerifyModal .txt-tip').click(function() {\n        $('.authVerifyModal .popup-item-handle').hide();\n        $('.authVerifyModal .modal_email').show();\n        hideErrorMsg();\n        resetInput();\n        $('#email_input').focus();\n    });\n\n    $('.authVerifyModal .btn-goBack').click(function() {\n        $('.authVerifyModal .popup-item-handle').hide();\n        $('.authVerifyModal .modal_password').show();\n        hideErrorMsg();\n        resetInput();\n        $('#pwd_input').focus();\n    });\n\n    $('.authVerifyModal .btn-summit').click(function() {\n        var pw = $('#pwd_input').val();\n        if (!pw) {\n            showErrorMsg('Please enter your password!');\n        } else {\n            authVerify(pw, directUrl, callBackEventData);\n        }\n    });\n\n    $('#pwd_input, #email_input').focus(function() {hideErrorMsg();});\n\n    $('.authVerifyModal #pwd_input').keyup(function() {\n        if ($(this).val()) {\n            $(this).prev('.placeholder').hide();\n        } else {\n            $(this).prev('.placeholder').show();\n        }\n    });\n\n    $('.authVerifyModal .eye').click(function() {\n        var $pwd_input = $('#pwd_input');\n        if ($pwd_input.attr('type') == 'password') {\n            $(this).closest('.base-input').addClass('open');\n            $pwd_input.attr('type', 'text');\n        } else {\n            $(this).closest('.base-input').removeClass('open');\n            $pwd_input.attr('type', 'password');\n        }\n    });\n\n    $('.authVerifyModal .btn-reset').click(function() {\n        var email = $('#email_input').val();\n        if (!email) {\n            showErrorMsg('Please enter email address!');\n        } else if(!checkEmail(email)) {\n            showErrorMsg('Please enter a valid email address!');\n        } else {\n            sendEmail(email.trim());\n        }\n    });\n\n    $('.authVerifyModal .btn-sendAgain').click(function() {\n        var email = $('#email_input').val();\n        sendEmail(email.trim());\n    });\n}\n\nfunction checkEmail(email) {\n    var reg_email = /^([0-9a-zA-Z_\\.-]+)@([0-9a-zA-Z_-]+)(\\.[0-9a-zA-Z_-]+){1,2}$/;\n    if(!reg_email.test(email)) {\n        return false;\n    } else {\n        return true;\n    }\n}\n\nfunction sendEmail(email) {\n    showLoading();\n    $.ajax({\n        url: '/membership/sendResetPasswordEmail?userName=' + email,\n        type: \"GET\",\n        dataType: 'json',\n        contentType: \"application/json; charset=utf-8\",\n    }).done(function(result) {\n        if (result.success) {\n            hideLoading();\n            $('.authVerifyModal .popup-item-handle').hide();\n            $('.authVerifyModal .modal_emailSent').show();\n        } else {\n            hideLoading();\n            $.fn.showError(result.reason);\n        }\n    }).fail(function(request, status, error) {\n        hideLoading();\n        console.log(\"request.statusText: \", request.status);\n        console.log(\"error: \", JSON.stringify(error));\n    });\n}\n\nfunction validateToken(directUrl, callBackEventData) {\n    var result = false;\n    var requestData = {'userName': user.email}\n\n    $.ajax({\n        async: false,\n        url: globalAuthUrl + '/api/auth/validate/session',\n        xhrFields: {\n            withCredentials: true\n        },\n        data: JSON.stringify(requestData),\n        type: 'POST',\n        dataType: 'json',\n        contentType: 'application/json; charset=UTF-8',\n        headers : getValidateTokenHeader(),\n        success: function(jsonData, textStatus, jqXHR) {\n            if (jsonData) {\n                if (directUrl) {\n                    window.location = directUrl;\n                } else {\n                    result = true;\n                }\n            } else {\n                dust.render('authVerifyModal', {}, function(err, out) {\n                    $('body').append(out);\n                    bindAuthVerifyModalEvents(directUrl, callBackEventData);\n                    $('#pwd_input').focus();\n                    if (err) console.log(\"err: \", err);\n                });\n            }\n        },\n        error: function(jqXHR, textStatus, errorThrown) {\n            console.log('fail:' + jqXHR.statusText + \": \" + jqXHR.status);\n        }\n    });\n    if (!directUrl) return result;\n}\n\nfunction getValidateTokenHeader() {\n  var headers = {'Referer-Application-Type' : 'FgWeb'};\n  headers[updateTokenCookieName] = $.cookie(updateTokenCookieName);\n\n  return headers;\n}\n\nfunction authVerify(pw, directUrl, callBackEventData) {\n    showLoading();\n    encryptPassword(pw, false);\n\n    function encryptPassword(pw, isDefault) {\n        encrypt(pw, isDefault).then(function(data) {\n            const requestData = {\n                userName: user.email,\n                password: data.encrypted,\n                secureKey: data.secureKey,\n                passphrase: data.passphrase\n            };\n            updateToken(requestData)\n        });\n    }\n\n    function updateToken(requestData) {\n        $.ajax({\n              url: globalAuthUrl + '/api/auth/validate/password',\n              xhrFields: {\n                withCredentials: true\n              },\n            data: JSON.stringify(requestData),\n            type: \"POST\",\n            dataType: 'json',\n            contentType: \"application/json; charset=UTF-8\",\n            headers : {\"Referer-Application-Type\" : \"FgWeb\"},\n            success: function(jsonData, textStatus, jqXHR) {\n                if (jsonData.header.isSuccessful) {\n                    hideLoading();\n                    jsonData.data.content.cookies.forEach(cookie => document.cookie = cookie);\n                    if (directUrl) {\n                        window.location = directUrl;\n                    } else {\n                        $('.authVerifyModal').remove();\n                        callBackEventData._function.apply(callBackEventData._this);\n                    }\n                } else {\n                    if (jsonData.header.resultMessage == \"Invalid username and/or password!\") {\n                        hideLoading();\n                        showErrorMsg('Password Incorrect!')\n                    } else if (jsonData.header.resultMessage == \"Too Many Attempts. Please try again later or contact Fashion Go\") {\n                        hideLoading();\n                        showErrorMsg('Too many attemps, please try again later or contact Fashion Go.')\n                    }\n                }\n            },\n            error: function(jqXHR, textStatus, errorThrown) {\n                hideLoading();\n                console.log('fail:' + jqXHR.statusText + \": \" + jqXHR.status);\n            }\n        });\n    }\n}\n\nfunction showErrorMsg(message) {\n    $('.authVerifyModal .error_tip').text(message).show();\n}\n\nfunction hideErrorMsg() {\n    $('.authVerifyModal .error_tip').text('').hide();\n}\n\nfunction resetInput() {\n    $('.authVerifyModal input').val('');\n    $('.authVerifyModal .placeholder').show();\n}\n"
          },
