            "size": 3945,
            "mimeType": "application/javascript",
            "text": "/**\n * @filename: dust-helpers-format.js\n * @purpose: format helpers for dust template\n * @author: Andy Min\n * @create: 12/16/2014\n * @update: 12/16/2014\n * \n * @commemt: //test code - delete for production\n */\ndust.helpers.formatDateYear = function (chunk, context, bodies, params) {\n    var value = dust.helpers.tap(params.value, chunk, context);\n    var rtn = \"\";\n\n    // Passing date through Date applies Date.parse, if necessary\n    var date = value ? new Date(value) : new Date;\n    if (isNaN(date)) {\n        rtn = value;\n    } else {\n        rtn = dateFormat(date, \"mm/dd/yyyy\");\n    }\n\n    return chunk.write(rtn);\n};\n\ndust.helpers.formatDate = function (chunk, context, bodies, params) {\n    var value = dust.helpers.tap(params.value, chunk, context);\n    var rtn = \"\";\n    if (value != null) {\n\t    var timestamp = new Date(value);\n    \tvar month = timestamp.getMonth() + 1;\n\t    var date = timestamp.getDate();\n    \tvar year = timestamp.getFullYear().toString().substr(-2);\n    \t\n    \tif(month<10) month = \"0\"+ month;\n    \tif(date<10) date = \"0\"+ date;\n    \t\t\n    \trtn = month + '/' + date + '/' + year;\n    }\n    return chunk.write(rtn);\n};\n\ndust.helpers.formatShortDate = function (chunk, context, bodies, params) {\n    var value = dust.helpers.tap(params.value, chunk, context);\n    var rtn = \"\";\n    \n    // Passing date through Date applies Date.parse, if necessary\n    var date = value ? new Date(value) : new Date;\n    if (isNaN(date)) {\n    \trtn = value;\n    } else {\n    \trtn = dateFormat(date, \"mm.dd\");\n    }\n    \n    return chunk.write(rtn);\n};\n\ndust.helpers.formatCurrency = function (chunk, context, bodies, params) {\n    var value = dust.helpers.tap(params.value, chunk, context);\n    var fixed = 2;\n    try{\n        if(params.fixed != undefined && params.fixed != null && !isNaN(Number(params.fixed))){\n            fixed = Number(params.fixed);\n        }\n    }catch(e){}\n\n    var rtn = \"\";\n    if (value != null) {\n    \trtn = '$' + parseFloat(value).toFixed(fixed).replace(/(\\d)(?=(\\d{3})+\\.)/g, \"$1,\");\n    }\n    return chunk.write(rtn);\n};\ndust.helpers.formatCount = function (chunk, context, bodies, params) {\n    var value = dust.helpers.tap(params.value, chunk, context);\n    var rtn = \"\";\n    if (value != null) {\n    \t//rtn = parseInt(value).toLocaleString();\n    \trtn = parseInt(value).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n    }\n    return chunk.write(rtn);\n};\n\ndust.helpers.formatDateTime = function(chunk, context, bodies, params) {\n\tvar value = dust.helpers.tap(params.value, chunk, context);\n    var rtn = \"\";\n    if (value != null) {\n\t    var timestamp = new Date(value);\n    \tvar month = timestamp.getMonth() + 1;\n\t    var date = timestamp.getDate();\n    \tvar year = timestamp.getFullYear();\n    \tvar time = timestamp.toLocaleTimeString();\n    \trtn = month + '/' + date + '/' + year + ' ' + time;\n    }\n    return chunk.write(rtn);\n}\n\ndust.helpers.encodeQueryString = function(chunk, context, bodies, params) {\n    var value = dust.helpers.tap(params.value, chunk, context);\n    if (!value) return chunk.write(\"\");\n    var encodedValue = encodeURIComponent(new DOMParser().parseFromString('<!doctype html><body>' + value, 'text/html').body.textContent);\n    return chunk.write(encodedValue);\n};\n\ndust.helpers.repeat = function(chunk, context, bodies, params) {\n    var count = params.count || 0;\n    for (var i = 0; i < count; i++) {\n        chunk = chunk.render(bodies.block, context.push({ index: i }));\n    }\n    return chunk;\n};\n\ndust.helpers.toFixed = function (chunk, context, bodies, params) {\n  var value = dust.helpers.tap(params.value, chunk, context);\n  var fixed = 2;\n  try{\n    if(params.fixed != undefined && params.fixed != null && !isNaN(Number(params.fixed))){\n      fixed = Number(params.fixed);\n    }\n  }catch(e){}\n\n  var rtn = \"\";\n  if (value != null) {\n    rtn = parseFloat(value).toFixed(fixed).replace(/(\\d)(?=(\\d{3})+\\.)/g, \"$1,\");\n  }\n  return chunk.write(rtn);\n};\n"
