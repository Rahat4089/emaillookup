          "content": {
            "size": 13017,
            "mimeType": "application/javascript",
            "text": "class CouponClaimService {\n    claimableCoupons;\n    timerIds= [];\n\n    getClaimableCoupons() {\n        $.ajax({\n            url: '/buyer-coupon/eligible-list',\n            type: 'GET',\n            dataType: 'json',\n            contentType: 'application/json',\n            mimeType: 'application/json',\n            success: (result) => {\n                if (result.success && result.data.totalCount > 0) {\n                    this.claimableCoupons = result.data.coupons;\n                    this.renderClaimableCouponModal();\n                    this.renderFloatingBnr();\n                    $('.btn-floating-bnr').show();\n\n                    $('.btn-floating-bnr').click(function() {\n                        $('.claimableCouponList_modal').show();\n                        $('html').css('overflow', 'hidden');\n                    });\n                } else if (!result.success) {\n                    console.error('getClaimableCoupons() not success: ', result);\n                }\n            },\n            error: function (request, status, error) {\n                console.error('getClaimableCoupons() error: ', status, error);\n            }\n        });\n    }\n\n    renderClaimableCouponModal() {\n        const data = {};\n        data.isGlobal = true;\n        data.coupons = this.claimableCoupons;\n        dust.render(\"couponModal\", data, function(err, out) {\n            $('.claimableCouponList_modal').html(out);\n            if (err) console.log(\"err: \", err);\n        });\n        this.bindClaimableCouponModalEvents($('.claimableCouponList_modal'));\n\n        const storedCoupon = this.getStoredCoupon();\n        if (storedCoupon) {\n            $('.claimableCouponList_modal .coupon-item').each(function() {\n                if ($(this).data('issueId') == storedCoupon.issueId || $(this).data('couponId') == storedCoupon.conditions[0].couponId ) {\n                    $(this).addClass('selected-tip');\n                }\n            })\n        }\n\n        new Swiper(\".claimableCouponList_modal .coupon-swiper\", {\n            effect: \"flip\",\n            speed: 600,\n            allowTouchMove: false,\n            grabCursor: true,\n            navigation: {\n                nextEl: \".claimableCouponList_modal .js-view-details\",\n                prevEl: \".claimableCouponList_modal .js-back\",\n            },\n        });\n    }\n\n    bindClaimableCouponModalEvents($modal) {\n        $modal.find('.item-close').click(() => {\n            $('.claimableCouponList_modal').hide();\n            $('html').css('overflow', '');\n        });\n\n        $modal.find('.btn-coupon-apply').click((e) => {\n            this.claimCoupon(e.target);\n        });\n\n        $modal.find('.btn-coupon-cancel').click(() => {\n            this.unclaimCoupon();\n        });\n    }\n\n    getRemainingDays(coupon, $elem) {\n        const targetTime = new Date(\n            new Date(coupon.endDate)).getTime();\n\n        this.timerIds.forEach(id => clearInterval(id));\n        this.timerIds = [];\n\n        updateCountdown();\n        const timerId = setInterval(updateCountdown, 1000);\n        this.timerIds.push(timerId);\n\n        function updateCountdown() {\n\n            const now = new Date();\n            const nowLa = new Date(\n                now.toLocaleString('en-US', { timeZone: 'America/Los_Angeles' })\n            ).getTime();\n\n            const diff = targetTime - nowLa;\n            if (diff <= 0) {\n                $elem.text(\"00:00:00\");\n                clearInterval(timerId);\n                return;\n            }\n            const hours = Math.floor(diff / (1000 * 60 * 60));\n            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));\n            const seconds = Math.floor((diff % (1000 * 60)) / 1000);\n\n            let text = \"\";\n            if (diff >= 24 * 60 * 60 * 1000) {\n                const days = Math.floor(diff / (1000 * 60 * 60 * 24));\n                text = days + \" days\";\n            } else {\n                text = (hours < 10 ? \"0\" + hours : hours) + \":\" +\n                       (minutes < 10 ? \"0\" + minutes : minutes) + \":\" +\n                       (seconds < 10 ? \"0\" + seconds : seconds);\n            }\n            $elem.text(text);\n        }\n    }\n\n\n    getEarlierExpiringCoupon(couponList) {\n        return couponList.reduce((earliest, current) =>\n            new Date(current.endDate) < new Date(earliest.endDate) ? current : earliest\n        );\n    }\n    updateCouponDiscountText(coupon, $elem) {\n        if (!!coupon.conditions && coupon.conditions.length > 0) {\n            console.log('has conditions');\n            coupon.couponDiscountType = coupon.conditions[0].discountType;\n            coupon.couponDiscountAmount = coupon.conditions[0].discountAmount;\n            coupon.couponDiscountRate = coupon.conditions[0].discountRate;\n        }\n        if(coupon.couponDiscountType === 1) {\n            $elem.text('$' + coupon.couponDiscountAmount + ' off')\n        }\n        if(coupon.couponDiscountType === 2) {\n            $elem.text(coupon.couponDiscountRate * 100 + '% off')\n        }\n    }\n\n\n\n    /*\n    * Claim before\n    *   Default : Expiring soon! $500 off 3days left\n    *   > 24hrs : Expiring soon! $500 off 00:00:00 left\n    * Claim after\n    *   Default : Hurry!  $500 off 3ays left\n    *  > 24hrs : Hurry!  $500 off 00:00:00 left\n    * */\n\n    renderFloatingBnr() {\n        const storedCoupon = this.getStoredCoupon();\n        if (storedCoupon) {\n            $('.btn-floating-bnr').find('.dsc-float-bnr').html('Hurry!')\n            $('.btn-floating-bnr').removeClass('bg-deep-blue').addClass('bg-light-blue');\n            $('.btn-floating-bnr .icon-common').removeClass('icon-time').addClass('icon-circle-check');\n            console.log(storedCoupon);\n            this.getRemainingDays(storedCoupon, $('.btn-floating-bnr').find('.dsc-time .time-con'));\n            this.updateCouponDiscountText(storedCoupon, $('.btn-floating-bnr .dsc-area .dsc-data'));\n        } else {\n            $('.btn-floating-bnr').find('.dsc-float-bnr').html('Expiring soon!');\n            $('.btn-floating-bnr').removeClass('bg-light-blue').addClass('bg-deep-blue');\n            $('.btn-floating-bnr .icon-common').removeClass('icon-circle-check').addClass('icon-time');\n            var earlierExpiringCoupon = this.getEarlierExpiringCoupon(this.claimableCoupons);\n            console.log(earlierExpiringCoupon);\n            this.getRemainingDays(earlierExpiringCoupon, $('.btn-floating-bnr').find('.dsc-time .time-con'));\n            this.updateCouponDiscountText(earlierExpiringCoupon, $('.btn-floating-bnr .dsc-area .dsc-data'));\n        }\n    }\n\n    createCouponCookie(issuedCoupon, couponIssueOrigin, isChanged) {\n        issuedCoupon.issueOrigin = couponIssueOrigin;\n        issuedCoupon.isIssuedCouponChanged = isChanged;\n        $.cookie('FG_CLAIMED_COUPON', JSON.stringify(issuedCoupon), {path: '/' });\n    }\n\n    removeCouponCookie() {\n        $.removeCookie('FG_CLAIMED_COUPON', {path: '/'});\n    }\n\n    getStoredCoupon() {\n        return $.cookie('FG_CLAIMED_COUPON') ? JSON.parse($.cookie('FG_CLAIMED_COUPON')) : null;\n    }\n\n    async claimCoupon(claimBtn) {\n        let couponCode;\n        let couponIssueOrigin;\n\n        if (claimBtn.classList.contains('btn-coupon-apply')) {\n            couponCode = $(claimBtn).closest('.coupon-item').data('couponCode');\n            couponIssueOrigin = 'modal_couponlist';\n        } else {\n            couponCode = $(claimBtn).data('couponCode');\n            couponIssueOrigin = 'popup_coupon';\n        }\n\n        try {\n            const issuedCoupon = await this.issueCoupon(couponCode);\n            this.createCouponCookie(issuedCoupon, couponIssueOrigin, false);\n\n            $('.claimableCouponList_modal').hide();\n            $('html').css('overflow', '');\n            $('#fg-coupon-popup-black-mask').hide();\n            $('.popup-flash-msg').show().delay(2000).fadeOut(500);\n            this.renderClaimableCouponModal();\n            this.renderFloatingBnr();\n        } catch (error) {\n            console.error('Failed to claim coupon:', error);\n        }\n    }\n\n    unclaimCoupon() {\n        this.removeCouponCookie();\n        $('.claimableCouponList_modal .coupon-item').removeClass('selected-tip');\n        this.renderFloatingBnr();\n    }\n\n    async issueCoupon(code) {\n        $.fn.showLoader();\n        const encryptedCouponCode = await encrypt(code, true);\n        return new Promise((resolve, reject) => {\n            $.ajax({\n                url: '/buyer-coupon/apply',\n                type: 'POST',\n                dataType: 'json',\n                data: JSON.stringify(encryptedCouponCode),\n                contentType: 'application/json',\n                mimeType: 'application/json',\n                success: (result) => {\n                    $.fn.hideLoader();\n                    if (result.success) {\n                        resolve(result.data);\n                    } else {\n                        reject(new Error('Coupon application failed'));\n                    }\n                },\n                error: (xhr, status, error) => {\n                    $.fn.hideLoader();\n                    console.error('issueCoupon() failed:', status, error);\n                    reject(error);\n                }\n            });\n        });\n    }\n}\n\nconst couponClaimService = new CouponClaimService();\n$(function() {\n    const whitePaths = [\n        'category', 'catalog', 'newarrival', 'search', 'asia-direct-plus', 'premium',\n        'sale', 'best', 'imagesearch', 'stylematch', 'item-collection', 'infocus', 'item', 'recommendation'\n    ];\n\n    const currentPath = window.location.pathname.slice(1).split('/')[0].toLowerCase();\n\n    if (typeof user != 'undefined' && user.email) {\n        if (whitePaths.includes(currentPath) || (typeof ctrlName !== 'undefined' && ctrlName === 'VC')) {\n            if ( currentPath === 'item' && window.location.pathname.slice(1).split('/')[1] !== 'all') {\n                return;\n            }\n            couponClaimService.getClaimableCoupons();\n        }\n    } else {\n        couponClaimService.removeCouponCookie();\n        $.removeCookie('FG_COUPON_POPUP_EXPOSED', {path: '/'});\n    }\n\n\n\n    if ($('#fg-coupon-popup-black-mask').length > 0) {\n        const modalType = getExposeModalType();\n        if (modalType) {\n            $('#fg-coupon-popup-black-mask').show();\n\n            if (modalType === 'loginType') {\n                $('.ex-fg-coupon').addClass('loginMode');\n                $.cookie('FG_COUPON_POPUP_EXPOSED', 'YES', {path: '/', expires: 6/24});\n            } else if (modalType === 'unloginType') {\n                $('.ex-fg-coupon .login').hide();\n                $('.ex-fg-coupon .unlogin').show();\n            }\n\n            $('.ex-fg-coupon .item-close').click(function() {\n                $('#fg-coupon-popup-black-mask').hide();\n            });\n            $('.ex-fg-coupon .link-footer-sub').click(function() {\n                $('#fg-coupon-popup-black-mask').hide();\n                $.cookie('FG_COUPON_POPUP', 'HIDE', {expires: 1, path: '/' });\n            });\n\n            $('.ex-fg-coupon .date-ex-coupoon span').text(new Date($('.ex-fg-coupon').data('couponEndDate')).toLocaleDateString('en-US'));\n\n            if (!$('.ex-fg-coupon').data('remainingDays')) {\n                let targetTime = new Date($('.ex-fg-coupon').data('couponEndDate') + '-07:00').getTime();\n                updateCountdown();\n                setInterval(updateCountdown, 1000);\n                function updateCountdown() {\n                    let now = new Date().getTime();\n                    let diff = targetTime - now;\n\n                    let hours = Math.floor(diff / (1000 * 60 * 60));\n                    let minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));\n                    let seconds = Math.floor((diff % (1000 * 60)) / 1000);\n\n                    $(\".ex-fg-coupon .txt-ex-coupon span\").text(\n                        (hours < 10 ? \"0\" + hours : hours) + \":\" +\n                        (minutes < 10 ? \"0\" + minutes : minutes) + \":\" +\n                        (seconds < 10 ? \"0\" + seconds : seconds)\n                    );\n                }\n            }\n        }\n    }\n\n    function getExposeModalType() {\n        if (typeof isFromFgCouponEmail != 'undefined' && isFromFgCouponEmail === 'true' && $.cookie(\"FG_COUPON_POPUP\") !== 'HIDE') {\n            return 'unloginType';\n        }\n\n        const currentPath = window.location.pathname.slice(1).split('/')[0].toLowerCase();\n        let flag = true;\n        if (typeof user === 'undefined' || !user.email) {\n            flag = false;\n        }\n        if ($.cookie('FG_COUPON_POPUP_EXPOSED') === 'YES' || $.cookie(\"FG_COUPON_POPUP\") === 'HIDE' || $.cookie('FG_CLAIMED_COUPON')) {\n            flag = false;\n        }\n        if (['cart', 'checkout', 'checkoutconfirm', 'customerservice', 'myaccount', 'dynamicnetterms', 'chat'].includes(currentPath)) {\n            flag = false;\n        }\n\n        if (flag) {\n            return 'loginType';\n        } else {\n            return '';\n        }\n    }\n});\n\n\n\n\n"
          },
