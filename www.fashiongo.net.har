            "mimeType": "application/javascript",
            "text": "$(function() {\n  'use strict';\n\n  var pathFrom = '';\n  var categoryNames = [];\n\n  $.each(['show', 'fadeIn'], function (i, ev) {\n\t\tvar el = $.fn[ev];\n\t\t$.fn[ev] = function () {\n\t\t\tthis.trigger(ev);\n\t\t\treturn el.apply(this, arguments);\n\t\t};\n  });\n\n  gtag.quickViewOpened = function() {\n    // Todo: common quickview log\n  };\n  \n  gtag.getBreadCrumbs().then(function() {\n    categoryNames = [];\n\t\t\n\t\t$('.breadcrumbs .location li').each(function(index, el) {\n      if (index === 1) {\n        pathFrom = gtag.getPathFrom($(el).text());\n      }\n\t\t\tif (index > 1) {\n\t\t\t\tcategoryNames.push($(el).find('a').text());\n      }\n    });\n\n    // In item page, the last breadcrumb is an item name\n    if (location.pathname.match(/^\\/Item\\//) && categoryNames.length > 0) {\n      categoryNames.pop();\n    }\n  });\n\n\t// Message bar - center message\n\t$('.notice_popup .slide>a').click(function() {\n\t\tvar index = $(this).parent().index() + 1;\n\t\tgtag.selectContentItem([], {\n      browsingPath: pathFrom,\n      category1: categoryNames[0] || '',\n      category2: categoryNames[1] || '',\n      category3: categoryNames[2] || '',\n\t\t\tpageType: 'Notice Bar',\n      contentsName: 'Notice Detail',\n      contentsId: gtag.getNoticeIdFromAnchor(this)\n\t\t});\n  });\n  \n  // Message bar - prev button\n\t$('.notice_popup #prev').click(function() {\n\t\tvar index = $(this).parent().index() + 1;\n\t\tgtag.selectContentItem([], {\n      browsingPath: pathFrom,\n      category1: categoryNames[0] || '',\n      category2: categoryNames[1] || '',\n      category3: categoryNames[2] || '',\n\t\t\tpageType: 'Notice Bar',\n\t\t\tcontentsName: 'Notice Bar_Prev'\n\t\t});\n  });\n  \n  // Message bar - next button\n\t$('.notice_popup #next').click(function(e) {\n    if (!e.isTrigger) {\n      var index = $(this).parent().index() + 1;\n      gtag.selectContentItem([], {\n        browsingPath: pathFrom,\n        category1: categoryNames[0] || '',\n        category2: categoryNames[1] || '',\n        category3: categoryNames[2] || '',\n        pageType: 'Notice Bar',\n        contentsName: 'Notice Bar_Next'\n      });\n    }\n  });\n  \n  // Message bar - close button\n\t$('.notice_popup #notice-modal-hide').click(function() {\n\t\tvar index = $(this).parent().index() + 1;\n\t\tgtag.selectContentItem([], {\n      browsingPath: pathFrom,\n      category1: categoryNames[0] || '',\n      category2: categoryNames[1] || '',\n      category3: categoryNames[2] || '',\n\t\t\tpageType: 'Notice Bar',\n\t\t\tcontentsName: 'Notice Bar_Close for today'\n\t\t});\n\t});\n\n  // AJAX data event\n\tgtag.commonAjaxEvent = function(event, data) {\n    var getItem, getViewItem;\n    switch(event) {\n      case 'right-favoriteStyles':  // favoriteStyles\n        gtag.selectContentItem([{\n          id: 'side_r_010',\n          name: 'Side Right Layer',\n          list_name: 'Side right bar Favorite Styles',\n          list_position: 'Fv_fstyle_0'\n        }]);\n\n        getItem = function(id, img, index) {\n          return {\n            id: id,\n            name: 'Side Right Layer',\n            list_name: 'Side right bar Favorite Styles',\n            brand: gtag.getVendorFromImage(img),\n            list_position: index+1\n          };\n        }\n        getViewItem = function(id, img, index) {\n          return {\n            id: id,\n            name: '',\n            list: 'Side right bar Favorite Styles',\n            brand: gtag.getVendorFromImage(img),\n            list_position: index+1\n          };\n        }\n        var items = [];\n        $('#favItem .lst_pdt .pic img').each(function(index) {\n          items.push(getViewItem($(this).parent().attr('href').replace('/Item/', ''), this, index));\n        });\n        gtag.viewItemList(items);\n        $('#favItem .lst_pdt .pic').each(function(index) {\n          $(this).on('click', function() {\n            gtag.selectContentItem([getItem('side_r_011', $(this).find('img'), index)]);\n          });\n        });\n        break;\n      case 'right-favoriteStores':  // favoriteStores\n        gtag.selectContentItem([{\n          id: 'side_r_020',\n          name: 'Side Right Layer',\n          list_name: 'Side Right Favorite Stores',\n          list_position: 'Fv_fstyle_0'\n        }]);\n\n        getItem = function(id, img, index) {\n          return {\n            id: id === 1 ? 'side_r_021' : 'side_r_v_itm',\n            name: 'Side Right Layer',\n            list: 'Side Right Favorite Stores',\n            list_name: 'Side Right Favorite Stores',\n            brand: $gtag.getVendorFromImage(img),\n            list_position: 'Fv_fstore_'+(index+1)\n          };\n        }\n\n        $('#favVendor .lst_pdt .pic').each(function(index) {\n          $(this).on('click', function() {\n            gtag.selectContentItem([getItem(1, $(this).find('img'), index)]);\n          });\n        });\n        break;\n      case 'right-viewedItems':  //viewedItems\n        gtag.selectContentItem([{\n          id: 'side_r_030',\n          name: 'Side Right Layer',\n          list_name: 'Side Right Viewed Item',\n          list_position: 'Fv_vitem_0'\n        }]);\n\n        getItem = function(id, img, index) {\n          return {\n\t\t\t\t\t\tid: id,\n            name: 'Side Right Layer',\n            list: 'Side right bar viewed Items',\n\t\t\t\t\t\tlist_name: 'Side right bar viewed Items',\n\t\t\t\t\t\tbrand: gtag.getVendorFromImage(img),\n\t\t\t\t\t\tlist_position: index+1\n          };\n        }\n        getViewItem = function(id, img, index) {\n          return {\n\t\t\t\t\t\tid: id,\n            name: '',\n            list: 'Side right bar viewed Items',\n\t\t\t\t\t\tbrand: gtag.getVendorFromImage(img),\n\t\t\t\t\t\tlist_position: index+1\n          };\n        }\n        var items = [];\n        $('#viewItem .lst_pdt .pic img').each(function(index) {\n          items.push(getViewItem($(this).parent().attr('href').replace('/Item/', ''), this, index));\n        });\n        gtag.viewItemList(items);\n        $('#viewItem .lst_pdt .pic').each(function(index) {\n          $(this).on('click', function() {\n            gtag.selectContentItem([getItem('side_r_031', $(this).find('img'), index)]);\n          });\n        });\n        break;\n      case 'right-adVendorItem':  // adVendorItem\n        var ads = data || [];\n        getItem = function(id, img, price, index) {\n          return {\n            id: (id === 1 ? 'side_r_ads_pic_' : 'side_r_ads_vttl_')+(index+1),\n            name: 'Side right ads',\n            brand: gtag.getVendorFromImage(img),\n            price: price,\n            list_position: index+1\n          };\n        }\n\n        $('#ad-vendor-item .item_img').each(function(index) {\n          var price = $(this).parent().find('.price').text();\n          $(this).on('click', function() {\n            var items = [getItem(1, $(this).find('img'), price, index)];\n            gtag.selectContentItem(items);\n            gtag.selectContentPromotion(items);\n          });\n          $(this).next().on('click', function() {\n            var items = [getItem(2, $(this).prev().find('img'), price, index)];\n            gtag.selectContentItem(items);\n            gtag.selectContentPromotion(items);\n          });\n        });\n        break;\n    }\n  };\n\n  //**** GNB ****/\n\n  // Product data\n  // Event : select_content (Click)\n  // Id : gnb_vendor_000\n  // Name : GNB Vendors\n  $('.gnb .v_vendors>a').on('click', function() {\n    gtag.selectContentItem([{\n      id: 'gnb_vendor_000',\n      name: 'GNB Vendors'\n    }]);\n  });\n\n  // Product data\n  // Event : select_content (Click)\n  // Id : gnb_vendor_a-z_0~26\n  // Name : GNB Vendors \n  // List_name : GNB Vendors A-Z\n  // Variant : All...\n  // List_position : 0~26\n  $('.gnb .article.v_az li').on('click', function() {\n    var index = $(this).attr('data-nclick-rank') - 1;\n    gtag.selectContentItem([{\n      id: 'gnb_vendor_a-z_'+index,\n      name: 'GNB Vendors',\n      list_name: 'GNB Vendors A-Z',\n      variant: $(this).find('a').text(),\n      list_position: index\n    }]);\n  });\n\n  // Product data\n  // Event : select_content (Click)\n  // Id : gnb_vendor_cat_0~\n  // Name : GNB Vendors\n  // List name : GNB Vendors Category\n  // Category : \n  // List_position : 1~\n  $('.gnb .v_vendors .article').eq(1).find('li').each(function(index) {\n    $(this).on('click', function() {\n      gtag.selectContentItem([{\n        id: 'gnb_vendor_cat_'+index,\n        name: 'GNB Vendors',\n        list_name: 'GNB Vendors Category',\n        brand: $(this).find('a:first-child').text().toUpperCase(),\n        list_position: index\n      }]);\n    })\n  });\n\n  // Product data\n  // Event : select_content (Click)\n  // Id : gnb_vendor_nv_0~\n  // Name : GNB Vendors\n  // List name : GNB Vendors New vendor\n  // Brand : vendor 명\n  // List_position : 1~\n  $('.gnb .v_vendors .article.v_nv').find('li').each(function(index) {\n    $(this).on('click', function() {\n      gtag.selectContentItem([{\n        id: 'gnb_vendor_nv_'+index,\n        name: 'GNB Vendors',\n        list_name: 'GNB Vendors New vendor',\n        brand: gtag.getVendorFromAnchor($(this).find('a')),\n        list_position: index\n      }]);\n    })\n  });\n\n  // Product data\n  // Event : select_content (Click)\n  // Id : gnb_vendor_prm_0~\n  // Name : GNB Vendors\n  // List_name : GNB Vendors Promotion\n  // brand : vendor명\n  // List_position : 1~\n  $('.gnb .v_vendors .article').eq(3).find('li').each(function(index) {\n    $(this).on('click', function() {\n      gtag.selectContentItem([{\n        id: 'gnb_vendor_prm_'+index,\n        name: 'GNB Vendors',\n        list_name: 'GNB Vendors Promotion',\n        brand: $(this).find('a').attr('href').replace('/Promotion/','').toUpperCase(),\n        list_position: index\n      }]);\n    })\n  });\n  \n  // Product data\n  // Event : select_content (Click)\n  // Id : gnb_vendor_v_combo\n  // Name : GNB Vendors\n  // List name : GNB vendor right_combo\n  // brand : vendor명\n  // List position : 1~\n  $('.gnb .sel_vendor').on('change', function() {\n    if (!$(this).val()) return;\n    gtag.selectContentItem([{\n      id: 'gnb_vendor_v_combo',\n      name: 'GNB Vendors',\n      list_name: 'GNB vendor right_combo',\n      brand: $(this).val().replace('/', ''),\n      list_position: this.options.selectedIndex\n    }]);\n  });\n\n/*\n  // Promotion data\n  // Event : select_content (Click)\n  // Id : gnb_vendor_ft_vnd\n  // Name : GNB Vendors\n  // creative_name : GNB Vendors Featured vendor\n  // creative_slot : GNB Vendors Featured vendor\n  $('#featuredVendors a').on('click', function() {\n    gtag.selectContentPromotion([{\n      id: 'gnb_vendor_ft_vnd',\n      name: 'GNB Vendors',\n      creative_name: gtag.getVendorFromAnchor(this),\n      creative_slot: 'GNB Vendors Featured vendor'\n    }]);\n  });\n\n  // gnb vendors view\n  $('.gnb .v_vendors .ly_navi').on('show', function() {\n    gtag.viewPromotion([{\n      id: 'gnb_vendor_ft_vnd',\n      name: 'GNB Vendors',\n      creative_name: gtag.getVendorFromAnchor($('#featuredVendors a')),\n      creative_slot: 'GNB Vendors Featured vendor'\n    }]);\n  })\n*/\n  \n  // Product data\n  // Event : select_content (Click)\n  // Id : gnb_new_arv_date_1(~n)\n  // Name : GNB Category\n  // category : 1st Category\n  // Variant : plus\n  // List_Position : 1~6\n  $('#newArrival .article').eq(0).find('li').each(function(index) {\n    $(this).on('click', function() {\n      gtag.selectContentItem([{\n        id: 'gnb_new_arv_date_'+(index+1),\n        name: 'GNB Category',\n        category: $(this).find('a').text().replace(/[\\r\\n\\t]+/g, '').toUpperCase(),\n        list_position: index+1\n      }]);\n    });\n  });\n\n  // Product data\n  // Event : select_content (Click)\n  // Id : gnb_new_arv_cat_1(~n)\n  // Name : GNB Category\n  // category : 1st Category\n  // Variant : plus\n  // List_Position : 1~6\n  $('#newArrival .article').eq(1).find('li').each(function(index) {\n    $(this).on('click', function() {\n      gtag.selectContentItem([{\n        id: 'gnb_new_arv_date_'+(index+1),\n        name: 'GNB Category',\n        category: $(this).find('a').text().replace(/\\([^\\)]*\\)/, '').replace(/[\\r\\n\\t]+/g, '').toUpperCase(),\n        list_position: index+1\n      }]);\n    });\n  });\n\n  // Product data\n  // Event : select_content (Click)\n  // (View_item_list)\n  // Id : gnb_cate_0(~n)_0(~n)_0(~n)\n  // Name : GNB Category\n  // List name : GNB 2nd  Category\n  // category : 1st category/2nd category\n  // List_position : 1~\n  $('.gnb .v_woman .article>a:first-child').each(function(index) {\n    $(this).on('click', function() {\n      gtag.selectContentItem([{\n        id: 'gnb_cate_'+index,\n        name: 'GNB Category',\n        list_name: 'GNB 2nd  Category',\n        category: 'WOMEN/'+$(this).text().toUpperCase(),\n        list_position: index\n      }]);\n    });\n  });\n\n  // Product data\n  // Event : select_content (Click)\n  // (View_item_list)\n  // Id : gnb_cate_0(~n)_0(~n)_0(~n)\n  // Name : GNB Category\n  // List_Name : GNB 3rd Category\n  // category : 1st category/2nd category/3rd category\n  // List_position : 1~\n  $('.gnb>ul>li:nth-child(n+4) .ly_navi .article li').each(function(index) {\n    $(this).on('click', function() {\n      var categories = [\n        $(this).parent().parent().parent().parent().find('>a:first-child').text(),\n        $(this).parent().parent().find('>a:first-child').text(),\n        $(this).find('a').text()\n      ].filter(function(category) {\n        return category.replace(/[\\r\\n\\t ]/g, '').length;\n      });\n      gtag.selectContentItem([{\n        id: 'gnb_cate_'+index,\n        name: 'GNB Category',\n        list_name: 'GNB 3rd Category',\n        category: categories.join('/').toUpperCase(),\n        list_position: index\n      }]);\n    });\n  });\n\n  // Product data\n  // Event : select_content (Click)\n  // (View_item_list)\n  // Id : gnb_cate_0(~n)_0(~n)_0(~n)\n  // Name : GNB Category\n  // List name : GNB 1st Category\n  // category : 1st category\n  // List_position : 1~\n  $('.gnb>ul>li>a:first-child').each(function(index) {\n    $(this).on('click', function() {\n      gtag.selectContentItem([{\n        id: 'gnb_cate_'+index,\n        name: 'GNB Category',\n        list_name: 'GNB 1st Category',\n        category: $(this).text().toUpperCase(),\n        list_position: index\n      }]);\n    });\n  });\n\n  // Product data\n  // Event : select_content (Click)\n  // Id : gnb_cate_ft_shp_1(~6)\n  // Name : GNB Category\n  // List_name : featured shop\n  // category : 1st Category\n  // Variant : plus\n  // List_Position : 1~6\n  $('.v_woman .article.featured li').each(function(index) {\n    $(this).on('click', function() {\n      gtag.selectContentItem([{\n        id: 'gnb_cate_ft_shp_'+(index+1),\n        name: 'GNB Category',\n        list_name: 'featured shop',\n        category: 'WOMEN',\n        variant: 'plus',\n        list_position: index+1\n      }]);\n    });\n  });\n});\n"
