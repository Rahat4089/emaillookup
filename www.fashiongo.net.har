            "text": "(function() {\n\t'use strict';\n\t\n\tgtag = window.gtag || {};\n\t\n\tvar breadCrumbsDefers = [], breadCrumbsReady = false;\n\t\n\tgtag.config = function(config) {\n\t\tdataLayer.push(['config', gtag.GA_TAG_ID, config || {}]);\n\t}\n\n\tgtag.set = function(param) {\n\t\tgtag('set', param);\n\t}\n\t\n\tgtag.getBreadCrumbs = function() {\n\t\tvar breadCrumbsDefer = new $.Deferred();\n\t\t\n\t\tif (breadCrumbsReady) {\n\t\t\tbreadCrumbsDefer.resolve();\n\t\t} else {\n\t\t\tbreadCrumbsDefers.push(breadCrumbsDefer);\n\t\t}\n\t\t\n\t\treturn breadCrumbsDefer.promise()\n\t}\n\t\n\tgtag.readyBreadCrumbs = function() {\n\t\tbreadCrumbsDefers.forEach(function(breadCrumbsDefer) {\n\t\t\tbreadCrumbsDefer.resolve();\n\t\t});\n\n\t\tbreadCrumbsDefers = [];\n\t\t\n\t\tbreadCrumbsReady = true;\n\t}\n\t\n\t// events\n//\tselect_content\tA click on a product or product link for one or more products.\n//\tview_item\tA view of product details.\n//\tadd_to_cart\tAdding one or more products to a shopping bag.\n//\tremove_from_cart\tRemoving one or more products from a shopping bag.\n//\tbegin_checkout\tInitiating the checkout process for one or more products.\n//\tset_checkout_option\tSending the option value for a given checkout step.\n//\tpurchase\tThe sale of one or more products.\n//\trefund\tThe refund of one or more products.\n//\tview_promotion\tA click on an internal promotion.\n\t\n\tgtag.viewPromotion = function(promotions, additionalInfo) {\n\t\tgtag.event('view_promotion', {\n\t\t\t'promotions': promotions\n\t\t\t}, additionalInfo);\n\t};\n\t\n\tgtag.selectContentItem = function(items, additionalInfo) {\n\t\tgtag.event('select_content', {\n\t\t\t//'content_type': contentType || 'product',\n\t\t\t'items': items\n\t\t\t}, additionalInfo);\n\t};\n\t\n\tgtag.selectContentPromotion = function(promotions, additionalInfo) {\n\t\tgtag.event('select_content', {\n\t\t\t'promotions': promotions\n\t\t\t}, additionalInfo);\n\t};\n\t\n\tgtag.viewItem = function(items, additionalInfo) {\n\t\tgtag.event('view_item', {\n\t\t\t'items': items\n\t\t\t}, additionalInfo);\n\t};\n\tgtag.viewItemList = function(items, additionalInfo) {\n\t\tgtag.event('view_item_list', {\n\t\t\t'items': items\n\t\t\t}, additionalInfo);\n\t};\n\n\tgtag.addToWishlist = function(items, value, currency, additionalInfo) {\n\t\tgtag('add_to_wishlist', {\n\t\t\t'items': items,\n\t\t\t'value': value,\n\t\t\t'currency': currency\n\t\t}, additionalInfo);\n\t}\n\t\n\tgtag.addToCart = function(items, additionalInfo) {\n\t\tgtag.event('add_to_cart', {\n\t\t\t'items': items\n\t\t}, additionalInfo);\n\t};\n\t\n\tgtag.removeFromCart = function(items, additionalInfo) {\n\t\tgtag.event('remove_from_cart', {\n\t\t\t'items': items\n\t\t\t}), additionalInfo;\n\t};\n\t\n\tgtag.beginCheckout = function(items, value, currency, coupon, customDimensions, additionalInfo) {\n\t\tgtag.event('begin_checkout', {\n\t\t\t'value': value,\n\t\t\t'currency': currency,\n\t\t\t'coupon': coupon,\n\t\t\t'items': items\n\t\t\t}, additionalInfo);\n\t};\n\t\n\tgtag.checkoutProgress = function(items, value, currency, coupon, additionalInfo) {\n\t\tgtag.event('checkout_progress', {\n\t\t\t'value': value,\n\t\t\t'currency': currency,\n\t\t\t'coupon': coupon,\n\t\t\t'items': items\n\t\t\t}, additionalInfo);\n\t};\n\t\n\tgtag.setCheckoutOption = function(step, option, value, additionalInfo) {\n\t\tgtag.event('set_checkout_option', {\n\t\t\t'checkout_step': step,\n\t\t\t'checkout_option': option,\n\t\t\t'value': value\n\t\t\t}, additionalInfo);\n\t};\n\t\n\tgtag.purchase = function(transactionId, affiliation, value, currency, tax, shipping, items, additionalInfo) {\n\t\tgtag.event('purchase', {\n\t\t\t'transaction_id': transactionId,\n\t\t\t'affiliation': affiliation,\n\t\t\t'value': value,\n\t\t\t'currency': currency,\n\t\t\t'tax': tax,\n\t\t\t'shipping': shipping,\n\t\t\t'items': items\n\t\t\t}, additionalInfo);\n\n\t\t\tgtag.removeCheckoutInfo();\n\t};\n\t\n\tgtag.refund = function(transactionId, additionalInfo) {\n\t\tgtag.event('refund', {\n\t\t\t'transactionId': transactionId\n\t\t\t}, additionalInfo);\n\t};\n\t\n\tgtag.refundPartial = function(transactionId, affiliation, value, currency, tax, shipping, items, additionalInfo) {\n\t\tgtag.event('refund', {\n\t\t\t'transaction_id': transactionId,\n\t\t\t'affiliation': affiliation,\n\t\t\t'value': value,\n\t\t\t'currency': currency,\n\t\t\t'tax': tax,\n\t\t\t'shipping': shipping,\n\t\t\t'items': items\n\t\t\t}, additionalInfo);\n\t};\n\t\n\tgtag.pageView = function(dimensions) {\n//\t\t 'dimension1': 'browsingPath',\n//\t\t 'dimension2': 'category1',\n//\t\t 'dimension3': 'category2',\n//\t\t 'dimension4': 'category3',\n//\t\t 'dimension5': 'vendorName',\n//\t\t 'dimension6': 'vendorCategory1',\n//\t\t 'dimension7': 'vendorCategory2',\n//\t\t 'dimension8': 'pageType',\n//\t\t 'dimension9': 'itemName'\n\t\tgtag.event('page_view', dimensions || {});\n\t}\n\n\tgtag.newPage = function(url, dimensions) {\n\t\tgtag('set', {\n\t\t\t'page_path': url\n\t\t});\n\n\t\tgtag.pageView(dimensions || {});\n\t}\n\n\tgtag.setCustomDimension = function() {\n\t\tgtag('config', gtag.GA_TAG_ID, {\n\t\t\t'custom_map': {\n\t\t\t\t'dimension1': 'browsingPath',\n\t\t\t\t'dimension2': 'category1',\n\t\t\t\t'dimension3': 'category2',\n\t\t\t\t'dimension4': 'category3',\n\t\t\t\t'dimension5': 'vendorName',\n\t\t\t\t'dimension6': 'vendorCategory1',\n\t\t\t\t'dimension7': 'vendorCategory2',\n\t\t\t\t'dimension8': 'pageType',\n\t\t\t\t'dimension9': 'itemName',\n\t\t\t\t'dimension10': 'contentsName',\n\t\t\t\t'dimension11': 'contentsId'\n\t\t\t},\n\t\t\t'send_page_view': false\n\t\t});\n\t}\n\n\tgtag.event = function(eventName, dimensions, additionalInfo) {\n\t\tgtag.setCustomDimension();\n\n\t\tgtag('event', eventName, $.extend({}, dimensions || {}, additionalInfo || {}));\n\t}\n\n\tgtag.getVendorFromImage = function(imgElement) {\n\t\treturn decodeURIComponent($(imgElement).attr('src').match(/\\/Vendors\\/([^\\/]+)\\//)[1]);\n\t}\n\n\tgtag.getVendorFromAnchor = function(anchor) {\n\t\treturn decodeURIComponent($(anchor).attr('href').replace('/',''));\n\t}\n\n\tgtag.getProductIdFromAnchor = function(anchor) {\n\t\treturn decodeURIComponent($(anchor).attr('href').replace(/\\/Item\\/([0-9]+).*/,'$1'));\n\t}\n\n\tgtag.getNoticeIdFromAnchor = function(anchor) {\n\t\treturn decodeURIComponent($(anchor).attr('href').replace(/\\/gateway\\#([a-z0-9]+)$/i,'$1'))\n\t}\n\n\tgtag.saveCheckoutInfo = function(checkoutInfo) {\n\t\tsessionStorage.setItem('gtagCheckoutInfo', JSON.stringify(checkoutInfo));\n\t}\n\n\tgtag.loadCheckoutInfo = function() {\n\t\treturn JSON.parse(sessionStorage.getItem('gtagCheckoutInfo'));\n\t}\n\n\tgtag.removeCheckoutInfo = function() {\n\t\tsessionStorage.removeItem('gtagCheckoutInfo');\n\t}\n\n\tgtag.getPathFrom = function(breadCrumbString) {\n\t\tif (breadCrumbString.match(/New Arrival$/i)) {\n\t\t\treturn 'New Arrival';\n\t\t} else if (breadCrumbString.match(/Shop by Category$/i)) {\n\t\t\treturn 'Shop by Category';\n\t\t} else if (breadCrumbString.match(/Shop by Vendor$/i)) {\n\t\t\treturn 'Shop by Vendor';\n\t\t} else if (breadCrumbString.match(/Shop by Vendor Category$/i)) {\n\t\t\treturn 'Shop by Vendor Category';\n\t\t} else if (breadCrumbString.match(/In Focus$/i)) {\n\t\t\treturn 'Trend Report';\n\t\t} else if (breadCrumbString.match(/New Vendors$/i)) {\n\t\t\treturn 'New Vendors';\n\t\t} else if (breadCrumbString.match(/Today.s Deal$/i)) {\n\t\t\treturn 'Today’s Deal';\n\t\t} else if (breadCrumbString.match(/Special Offers$/i)) {\n\t\t\treturn 'Special Offers';\n\t\t} else if (breadCrumbString.match(/Best Items$/i)) {\n\t\t\treturn 'Best Items';\n\t\t} else if (breadCrumbString.match(/Customer Service$/i)) {\n\t\t\treturn 'Customer Service';\n\t\t} else if (breadCrumbString.match(/My Account$/i)) {\n\t\t\treturn 'My Account';\n\t\t} else if (breadCrumbString.match(/(WOMEN|SHOES|ACCESSORIES|HANDBAGS|MEN|KIDS|OTHER)$/i)) {\n\t\t\treturn 'My Account';\n\t\t} else if (breadCrumbString.match(/Search for/i)) {\n\t\t\treturn 'Shop by Search keyword';\n\t\t} else {\n\t\t\treturn 'Direct';\n\t\t}\n\t}\n})();"
          },
