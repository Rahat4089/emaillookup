            "text": "//jQuery Plugin\n(function($) {\n\t'use strict';\n})(jQuery);\n\nfunction checkSignInAvailable() {\n\tvar userName = $('#email-inp').val().trim();\n\tvar password = $('#pwd_inp').val().trim();\n\n\tif (userName === '' || password === '') {\n\t\t$('#btn-signin').prop('disabled', true);\n\t} else {\n\t\t$('#btn-signin').prop('disabled', false);\n\t}\n}\n\n$(function () {\n\t'use strict';\n\tvar divLoginForm = $('#div-login-form');\n\tvar divForgotPassword = $('#div-forgot-password');\n\tvar emailInp = $('#email-inp');\n\tvar pwdInp = $('#pwd_inp');\n\tvar emailInpForgot = $('#email-inp-forgot');\n\t// var chkRmbChk = $('#rmb_chk');\n\n\t$('#email-inp, #pwd_inp').on('keyup', function(e){\n\t\tcheckSignInAvailable();\n\t});\n\t\n\tvar btnForgotPassword = $('#forgot-password');\n\tbtnForgotPassword.click(function() {\n\t\t$(\".warning\").hide();\n\t\tdivLoginForm.removeClass('active');\n\t\tdivForgotPassword.addClass('active');\n\t\tdivLoginForm.hide();\n\t\tdivForgotPassword.show();\n\t\t//divForgotPassword.hide().slideToggle(300);\n\t\temailInpForgot.focus();\n\t});\n\t\n\tvar btnReturnLogin = $('#btn-return-login');\n\tbtnReturnLogin.click(function() {\n\t\t$(\".warning\").hide();\n\t\tdivForgotPassword.removeClass('active');\n\t\tdivLoginForm.addClass('active');\n\t\tdivForgotPassword.hide();\n\t\tdivLoginForm.show();\n\t\t//divLoginForm.hide().slideToggle(300);\n\t\temailInp.focus();\n\t});\n\t\n\tvar btnGetPassword = $('#btn-get-password');\n\tbtnGetPassword.click(function() {\n\t\tvar userName = emailInpForgot.val();\n\t\t\n\t\tif (!userName.trim()) {\n\t\t\t//$.fn.showError(\"Please enter your email!\", 3000);\n\t\t\t$('#forgot-error_msg').addClass('show');\n\t\t\temailInpForgot.parent().addClass('error');\n\t\t\temailInpForgot.val('');\n\t\t\temailInpForgot.focus();\n\t\t} else {\n\t\t\tuserName = userName.trim();\n\t\t\t$('#forgot-error_msg').removeClass('show');\n\t\t\temailInpForgot.parent().removeClass('error');\n\t\t\t//console.log('userName: ', userName);\n\t\t\t$.ajax({\n\t\t\t\turl: '/membership/sendResetPasswordEmail?userName=' + userName,\n\t\t        type: \"GET\",\n\t\t        dataType: 'json',\n\t\t        contentType: \"application/json; charset=utf-8\",\n\t\t    }).done(function(result) {\n\t\t        if (result.success) {\n\t        \t\t$.fn.showSuccess(\"If \" + userName + \" is associated with a FASHIONGO account, you should receive an email containing instructions on how to create a new password.\", 5000);\n\t        \t\tdivForgotPassword.removeClass('active');\n\t        \t\tdivLoginForm.addClass('active');\n\t        \t\tdivForgotPassword.hide();\n\t        \t\temailInpForgot.val('');\n\t        \t\tdivLoginForm.show();\n\t        \t\t//divLoginForm.hide().slideToggle(300);\n\t\t        } else {\n\t\t        \t$.fn.showError(result.reason);\n\t\t        }\n\t\t    }).fail(function(request, status, error) {\n\t\t    \tconsole.log(\"request.statusText: \", request.status);\n\t\t    \tconsole.log(\"error: \", JSON.stringify(error));\n\t\t    });\n\t\t}\n\t});\n\n\t// FGM/1377 Password Security\n\tvar btnSignIn = $('#btn-signin');\n\tbtnSignIn.click(function() {\n\t\tvar userName = $('#email-inp').val();\n\t\tvar password = $('#pwd_inp').val();\n\t\tvar authURL = $('#authURL').val();\n\n\t\t// var rememberMe = $('#rmb_chk').is(\":checked\");\n\t\tencryptPassword(password, false);\n\n\t\tfunction encryptPassword(pw, isDefault) {\n\t\t\tencrypt(pw, isDefault).then(function(data) {\n\t\t\t\tvar encryptedPassword = data;\n\n\t\t\t\tvar urlIndex = window.location.href.indexOf(\"?\");\n\t\t\t\tvar urlParam = urlIndex === -1 ? '' : window.location.href.substring(urlIndex);\n\n\t\t\t\tvar urlTagIndex = window.location.href.indexOf(\"#\");\n\t\t\t\tvar urlTagParam = urlTagIndex === -1 ? '' : window.location.href.substring(urlTagIndex);\n\n\t\t\t\tconst requestData = {\n\t\t\t\t\tuserName: userName,\n\t\t\t\t\tpassword: data.encrypted,\n\t\t\t\t\t// rememberMe: rememberMe,\n\t\t\t\t\tsecureKey: data.secureKey,\n\t\t\t\t\tpassphrase: data.passphrase\n\t\t\t\t}\n\n\t\t\t\t$.ajax({\n\t\t\t\t\turl: authURL + '/api/auth/login' + urlParam,\n\t\t\t\t\txhrFields: {\n\t\t\t\t\t\twithCredentials: true\n\t\t\t\t\t},\n\t\t\t\t\tdata: JSON.stringify(requestData),\n\t\t\t\t\ttype: \"POST\",\n\t\t\t\t\tdataType: 'json',\n\t\t\t\t\tcontentType: \"application/json; charset=UTF-8\",\n\t\t\t\t\theaders : {\"Referer-Application-Type\" : \"FgWeb\"},\n\t\t\t\t\tsuccess: function(jsonData, textStatus, jqXHR) {\n\n\t\t\t\t\t\tif (jsonData.header.isSuccessful) {\n\t\t\t\t\t\t\tjsonData.data.content.cookies.forEach(cookie => document.cookie = cookie);\n\t\t\t\t\t\t\t// for(var i in jsonData.data.content.cookies) {\n\t\t\t\t\t\t\t// \tdocument.cookie = jsonData.data.content.cookies[i];\n\t\t\t\t\t\t\t// }\n\n\t\t\t\t\t\t\tvar redirectUrl;\n\t\t\t\t\t\t\tif(encodedCheckedReturnUrl && encodedCheckedReturnUrl.length > 0) {\n\t\t\t\t\t\t\t\tredirectUrl = decodeURIComponent(encodedCheckedReturnUrl);\n\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\tredirectUrl = jsonData.data.content.redirectUrl + encodeURIComponent(urlTagParam);\n\t\t\t\t\t\t\t}\n\n                            localStorage.setItem('gnat_login_success', true);\n                            // console.log('gnat set to:', localStorage.getItem('gnat_login_success'));\n\t\t\t\t\t\t\twindow.location.replace(redirectUrl);\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\tif (jsonData.header.resultMessage === \"Password decryption failed. Please try again!\") {\n\t\t\t\t\t\t\t\tencryptPassword(password, true);\n\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\talertLoginFailure(jsonData.header.resultMessage);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\terror: function(jqXHR, textStatus, errorThrown) {\n\t\t\t\t\t\tconsole.log('fail:' + jqXHR.statusText + \": \" + jqXHR.status);\n\t\t\t\t\t\talertLoginFailure('Password encryption failed. Please try again!');\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t})\n\t\t}\n\n\t})\n\n\tfunction alertLoginFailure(message) {\n\t\tvar $alert = $('.error_msg');\n\t\tvar $inputField = $('.signin_field');\n\n\t\t$alert.removeClass('show').find('span').text('');\n\t\t$inputField.removeClass('error');\n\n\t\t$alert.addClass('show').find('span').text(message);\n\t\t$inputField.addClass('error');\n\t}\n\n//\tbtnGetPassword.click(function() {\n//\t\tvar userName = emailInpForgot.val();\n//\t\tif (!userName.trim()) {\n//\t\t\t$.fn.showError(\"Please enter your email!\");\n//\t\t\temailInpForgot.val('');\n//\t\t\temailInpForgot.focus();\n//\t\t} else {\n//\t\t\t$.ajax({\n//\t\t\t\turl: '/sendPasswordRetrieval?userName=' + userName,\n//\t\t        type: \"GET\",\n//\t\t        dataType: 'json',\n//\t\t        contentType: \"application/json; charset=utf-8\",\n//\t\t    }).done(function(result) {\n//\t\t        if (result.success) {\n//\t        \t\t$.fn.showSuccess(\"Password Successfully Sent!\");\n//\t        \t\tdivForgotPassword.removeClass('active');\n//\t        \t\tdivLoginForm.addClass('active');\n//\t        \t\tdivForgotPassword.hide();\n//\t        \t\tdivLoginForm.hide().slideToggle(300);\n//\t\t        } else {\n//\t\t        \t$.fn.showError(\"Please enter a valid email address!\");\n//\t\t        }\n//\t\t    }).fail(function(request, status, error) {\n//\t\t    \tconsole.log(\"request.statusText: \", request.status);\n//\t\t    \tconsole.log(\"error: \", error);\n//\t\t    });\n//\t\t}\n//\t});\n\t\n\t// var userIdt = $.cookie(\"userIdt\") || null;\n\t// if (userIdt && userIdt.trim()) {\n\t// \tvar user = userIdt.split('::');\n\t// \temailInp.val(user[0]);\n\t// \tchkRmbChk.prop('checked', true);\n\t// \tvar pwd = encodeURIComponent(user[1]);\n\t// \t$.ajax({\n\t// \t\turl: '/getRememberMe',\n\t//         type: \"POST\",\n\t//         dataType: 'json',\n\t//         contentType: \"application/json; charset=utf-8\",\n\t//         data: pwd\n\t//     }).done(function(result) {\n\t//         if (result.success) {\n\t//         \tpwdInp.val(result.data);\n\t//         }\n\t//     }).fail(function(request, status, error) {\n\t//     \tconsole.log(\"request.statusText: \", request.status);\n\t//     \tconsole.log(\"error: \", error);\n\t//     });\n\t// } else {\n\t// \temailInp.val('');\n\t// \tchkRmbChk.prop('checked', false);\n\t// \tpwdInp.val('');\n\t// }\n\n\tfunction preFilled(){\n\t\tif(emailFromShow){\n\t\t\t$('#email-inp').val(emailFromShow);\n\t\t}\n\t}\n\n\tpreFilled();\n});\n"
