ow);\n</script>\n<!-- End Impact Universal Tracking Tag -->\n\n\n<script src=\"/js/page/login.js?202606012231\"></script>\n\n\n<script src=\"/js/lib/slick.min.js\"></script>\n<body>\n  \t\n<div id=\"wrap\">\n\t\n\t\t\n\t\t\n\t\t\t\n\n\n<content tag=\"local_script\">\n    <script src=\"/js/page/header.js?202606012231\"></script>\n</content>\n<header id=\"global-header\">\n    <div class=\"header-wrapper\">\n        <div class=\"info-area\">\n            <div class=\"fg-logo\">\n                <a href=\"/\" class=\"nclick\" data-nclick-name=\"site.top.logo\" data-nclick-id=\"7\" data-nclick-extra=\"rid:,mobile:0,url:/login\">\n                    <img src=\"/img/fg_logo_new.svg\" alt=\"\">\n                </a>\n                <div class=\"link-area\">\n                    <ul class=\"link-list\">\n                        <li>\n                            <a href=\"/\" class=\"nclick\" data-nclick-name=\"site.top.logowholesale\" data-nclick-extra=\"rid:,mobile:0,url:/login\">Wholesale</a>\n                        </li>\n                        <li class=\"dropshipping\">\n                            <a class=\"btn-goto nclick\" data-nclick-name=\"site.top.logodropshipping\" data-nclick-extra=\"rid:,mobile:0,url:/login\">Dropshipping</a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            \n                \n                \n                    <span class=\"catalogue\">SIGN IN</span>\n                \n            \n        </div>\n\n        \n            <div class=\"tool-area\">\n                <div class=\"wholesale\">\n                    <button class=\"btn-goto nclick\" data-nclick-name=\"site.top.gotowholesale\" data-nclick-extra=\"rid:,mobile:0,url:/login\"><span>GO TO <strong>WHOLESALE</strong></span></button>\n                </div>\n                <div class=\"dropshipping\">\n                    <button class=\"btn-goto nclick\" data-nclick-id=\"7\" data-nclick-name=\"site.top.gotodropshipping\" data-nclick-extra=\"rid:,mobile:0,url:/login\"><span>GO TO <strong>DROPSHIPPING</strong></span></button>\n                </div>\n                <ul class=\"fun-area\">\n                    <li class=\"btn-header-black\">\n                        <a class=\"nclick\" href=\"https://membership.fashiongo.net\"\n                           data-nclick-id=\"7\"\n                           data-nclick-name=\"site.top.register\"\n                           data-nclick-extra=\"rid:,mobile:0,url:/login\">REGISTER</a>\n                    </li>\n                    <li class=\"link-header-black register\">\n                        <a class=\"header_signIn nclick\"\n                           data-nclick-id=\"7\"\n                           data-nclick-name=\"site.top.signin\"\n                           data-nclick-extra=\"rid:,mobile:0,url:/login\">SIGN IN</a>\n                    </li>\n                </ul>\n            </div>\n        \n    </div>\n</header>\n\n\n\n\n\n\n\n\n\n\n\n\t\t\n\t\n\t\t\t\n\t<!-- container -->\n\t<div id=\"container\">\n\t\t<div id=\"content_cover\"></div>\n\t\t<!-- content -->\n\t\t\t\n\t\n\t\n\t<div id=\"content--login\">\n        <input id=\"authURL\" name=\"authURL\" type=\"hidden\" value=\"https://id.fashiongo.net\">\n        \n        <div class=\"signin_wrap\">\n          <div id=\"div-login-form\" class=\"signin_left\">\n          \t<form id=\"loginForm\" method=\"post\" name=\"loginRequestData\" onsubmit=\"return false\">\n            <h2>Welcome back!</h2>\n            <p class=\"start_txt\">Sign in to start shopping.</p>\n\n\n\n\n\n\n\n\n\n            <div class=\"error_msg\"><i></i><span></span></div>\n\n            <div class=\"signin_field\">\n              <input id=\"email-inp\" name=\"userName\" type=\"text\" value=\"\" placeholder=\"Email\">\n            </div>\n\n            <div class=\"signin_field\">\n              <input id=\"pwd_inp\" name=\"password\" type=\"password\" value=\"\" placeholder=\"Password\">\n              <a id=\"forgot-password\" class=\"btn_forgot nclick\" data-nclick-name=\"loginhome.forgotpassword\">Forgot?</a>\n            </div>\n\n\n\n\n            <div class=\"signin_btn\">\n              <button id=\"btn-signin\" type=\"submit\" class=\"btn btn-white nclick\" data-nclick-name=\"loginhome.login\" name=\"signin\" disabled>SIGN IN</button>\n              <a class=\"guide-sign-in\" href=\"https://vendoradmin.fashiongo.net/#/auth/login\">Are you a vendor? Sign in</a>\n            </div>\n            </form>\n          </div>\n          <div id=\"div-forgot-password\" class=\"signin_left forgot\" style=\"display: none;\">\n          \t\n            <h2>Forgot Your Password?</h2>\n            <p class=\"start_txt\">Enter the email address you use to sign in and<br>\n              we’ll send you a link to reset your password.</p>\n            <div id=\"forgot-error_msg\" class=\"error_msg\"><i></i> Please enter email address</div>\n            <div class=\"signin_field\">\n              <input id=\"email-inp-forgot\" class=\"forgot_pw\" name=\"email\" type=\"email\" value=\"\" placeholder=\"Email\">\n            </div>\n            <div class=\"forgot_btn\">\n              <a id=\"btn-get-password\" class=\"btn btn-white nclick\" data-nclick-name=\"loginhome.forgotpassword.reset\">RESET MY PASSWORD</a>\n              <a id=\"btn-return-login\" class=\"btn btn-line\">BACK TO SIGN IN PAGE</a>\n            </div>\n          </div>\n          <div class=\"signin_right\">\n            <h2>Not a member? Join today!</h2>\n            <p class=\"info_txt\"><p class=\"info_txt\">Limited time only! Get 50% off your first order</p></p>\n            <div id=\"slider\" class=\"slider_img\">\n                <div class=\"num0 img\">\n                  <img src=\"/img/img_slider1.png\" alt=\"\">\n                    <p>Shop 3M+ styles with thousands of<br>\n                        daily new arrivals</p>\n                </div>\n                <div class=\"num4 img\">\n                  <img src=\"/img/img_slider2.png\" alt=\"\">\n                    <p>11 fashion categories and thousands of<br>\n                        wholesale vendors</p>\n                </div>\n                <div class=\"num5 img\">\n                    <img src=\"/img/img_slider5.png\" alt=\"\" style=\"width: 219px; margin: 49px auto 39px;\">\n                    <p>FG Free Shipping for Everyone, <br>\n                        No subscription needed</p>\n                </div>\n                <div class=\"num2 img\">\n                  <img src=\"/img/img_slider3.png\" alt=\"\">\n                    <p>Dynamic Net Terms to grow your store<br>\n                        at zero cost</p>\n                </div>\n\n\n\n\n\n            </div>\n            <div id=\"slider-nav\" class=\"cs_bullets\"></div>\n            \n            <!-- <div class=\"cs_bullets\">\n                <label class=\"num0 checked\" for=\"cs_slide1_0\"></label>\n                <label class=\"num1\" for=\"cs_slide1_1\"></label>\n                <label class=\"num2\" for=\"cs_slide1_2\"></label>\n            </div>\n             -->\n            <div class=\"create_btn\">\n              <a href=\"/register/buyer\" class=\"btn btn-black on-gradient nclick\" data-nclick-name=\"loginhome.bebuyer\">CREATE FREE ACCOUNT</a>\n            </div>\n          </div>\n        </div>\n\n      </div>\n      \n    <script>\n\n        var emailFromShow = \"\";\n        var encodedCheckedReturnUrl = \"http%3A%2F%2Fwww.fashiongo.net%2F\";\n\t\t$(document).ready(function() {\n\t\t\t$('#slider').slick({\n\t\t\t  autoplay: true,\n\t\t\t  autoplaySpeed: 1500,\n\t\t\t  arrows: false,\n\t\t      infinite: true,\n\t\t      dots: true,\n\t\t      dotsClass: 'cs_bullets',\n\t\t      slidesToShow: 1,\n\t\t      speed: 300,\n\t\t      pauseOnHover: true\n\t\t    });\n\t\t\t\n\t\t\t$('#email-inp, #pwd_inp').focus(function() {\n\t\t\t\temptyChecker($(this).parent());\n\t\t\t});\n\t\t});\n\t\t\n\t\tfunction emptyChecker(elm) {\n\t\t\tif($(elm).hasClass('error')) {\n\t\t\t\t$(elm).find('input').val('');\n\t\t\t\tsetTimeout(function() {\n\t\t\t\t\tkeyupInput(elm);\n\t\t\t\t}, 500);\n\t\t\t}\n\t\t}\n\t\t\n\t\tfunction keyupInput(elm) {\n\t\t\t$(elm).find('input').keyup(function() {\n\t\t\t\tif($(this).val() != '') {\n\t\t\t\t\t$(elm).removeClass('error');\n\t\t\t\t} else {\n\t\t\t\t\t$(elm).addClass('error');\n\t\t\t\t}\n\t\t\t});\n\t\t}\n\t</script>\n\n\t\t<!-- //content -->\n\t</div>\n\t<!-- //container -->\n\t\n\t\n\n\n\n\n\n\n\n    \n    \n        \n    \n\n\n    \n    \n        \n    \n\n\n<div class=\"footer footer_r01\">\n    \n    <div class=\"ft_wrap\">\n        <div class=\"ft_info\">\n            <strong class=\"ft_txt_logo\"></strong>\n            <ul class=\"ft_contact\">\n                <li>\n                    <dl>\n                        <dt>Customer Service</dt>\n                        <dd>\n                            <a href=\"mailto:info@fashiongo.net\" class=\"fg_email nclick\" data-nclick-name=\"site.info.fgemail\" data-nclick-id=\"7\" data-nclick-extra=\"rid: 0, mobile:0, url: /login\">\n                                info@fashiongo.net\n                            </a>\n                        </dd>\n                    </dl>\n                </li>\n                <li>\n                    <dl>\n                        <dt>Tech Support</dt>\n                        <dd>\n                            <a href=\"mailto:techsupport@fashiongo.net\" class=\"fg_email nclick\" data-nclick-name=\"site.info.techemail\" data-nclick-id=\"7\" data-nclick-extra=\"rid: 0, mobile:0, url: /login\">\n                                techsupport@fashiongo.net\n                            </a>\n                        </dd>\n                    </dl>\n                </li>\n            </ul>\n            <div class=\"ft_btn_wrap\">\n                <a href=\"/register/buyer?lang=en\" class=\"ft_btn ft_buyer nclick\" data-nclick-name=\"site.info.bebuyer\" data-nclick-id=\"7\" dat